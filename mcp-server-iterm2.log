":["result"],"title":"read_terminal_outputOutput","type":"object"}},{"name":"clear_screen","description":"\n    🧹 PRIORITY 4 - SCREEN CLEANER 🧹\n    \n    Clears terminal screen using ANSI escape codes.\n    \n    🎯 USE FOR: Cleaning cluttered terminal display.\n    TERMINAL-SPECIFIC: Clears current iTerm2 session screen only.\n\n    Returns:\n        str: A JSON string confirming the screen was cleared.\n    ","inputSchema":{"properties":{},"title":"clear_screenArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"clear_screenOutput","type":"object"}},{"name":"list_profiles","description":"\n    📋 PRIORITY 4 - PROFILE LISTER 📋\n    \n    Lists available iTerm2 profiles for theme/config selection.\n    \n    🎯 USE FOR: Discovering available terminal profiles.\n    READ-ONLY: Safe profile enumeration.\n\n    Returns:\n        str: A JSON string containing a list of profile names.\n    ","inputSchema":{"properties":{},"title":"list_profilesArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"list_profilesOutput","type":"object"}},{"name":"switch_profile","description":"\n    🎨 PRIORITY 4 - PROFILE SWITCHER 🎨\n    \n    Switches iTerm2 profile (theme, colors, settings).\n    \n    🎯 USE FOR: Changing terminal appearance/behavior.\n    TERMINAL-SPECIFIC: Affects current session only.\n\n    Args:\n        profile (str): The name of the profile to switch to.\n\n    Returns:\n        str: A JSON string confirming the profile switch.\n    ","inputSchema":{"properties":{"profile":{"title":"Profile","type":"string"}},"required":["profile"],"title":"switch_profileArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"switch_profileOutput","type":"object"}},{"name":"get_session_info","description":"\n    ℹ️  PRIORITY 4 - SESSION INFO ℹ️\n   