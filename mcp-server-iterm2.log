2025-12-18T10:33:56.701Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"content":"\"\"\"\nResponse extractor for the Oral History Research System.\n\nUses LLM to extract structured metadata from interview responses.\n\"\"\"\n\nfrom typing import List, Optional, Callable\nimport json\n\nfrom .client import LLMClient\nfrom ..models import Response, ResponseExtraction, ExtractedDate, ExtractedPerson, WritingPotential\n\n\nEXTRACTION_SYSTEM_PROMPT = \"\"\"You are analyzing WWII oral history interview responses. \nYour task is to extract structured metadata that will help a book researcher find and use this material.\nBe accurate and conservative - only extract what's clearly stated or strongly implied.\nFocus on details valuable for historical writing: vivid details, named individuals, specific dates and places.\"\"\"\n\nEXTRACTION_PROMPT_TEMPLATE = \"\"\"Analyze this WWII oral history interview response and extract structured metadata.\n\nINTERVIEWER: {interviewer}\n\nVETERAN: {veteran}\n\nExtract the following as JSON:\n\n{{\n  \"summary\": \"One sentence summary of what the veteran discusses\",\n  \"dates\": [\n    {{\n      \"value\": \"The date or time period mentioned\",\n      \"context\": \"What this date refers to\",\n      \"precision\": \"stated | inferred | approximate\"\n    }}\n  ],\n  \"locations\": [\"List of geographic locations mentioned\"],\n  \"people\": [\n    {{\n      \"name\": \"Name or nickname as stated\",\n      \"role\": \"Their role if clear (sergeant, friend, officer, etc.)\",\n      \"context\": \"Brief context of how they're mentioned\"\n    }}\n  ],\n  \"units\": [\"Military units mentioned\"],\n  \"events\": [\"Specific events or incidents described\"],\n  \"topics\": [\"Relevant topics from: combat, training, daily-life, hardship, humor, loss, equipment, medical, prisoners, civilians, leadership, fear, friendship, home-front, post-war, pre-war, biographical\"],\n  \"writing_potential\": \"low | medium | high\",\n  \"writing_note\": \"If medium or high potential, explain why (vivid detail, unique perspective, emotional resonance, action, humor). null if low.\"\n}}\n\nGuidelines:\n- For dates: \"stated\" = explicit date, \"inferred\" = derived from context, \"approximate\" = vague terms like \"about\" or \"around\"\n- For people: capture ALL name variants (e.g., \"Tip\" and \"Tipton\" for same person)\n- writing_potential is HIGH if: vivid sensory detail, strong narrative moment, emotional resonance, unique perspective, humor, action sequence, named characters\n- writing_potential is MEDIUM if: useful context, fills gaps, corroborates other accounts\n- writing_potential is LOW if: routine biographical info, vague recollections, administrative details\n- If nothing found for a field, use empty array []\n\"\"\"\n\n\nclass ResponseExtractor:\n    \"\"\"Extracts structured metadata from interview responses using LLM.\"\"\"\n    \n    def __init__(self, client: LLMClient):\n        \"\"\"\n        Initialize extractor.\n        \n        Args:\n            client: LLM client to use\n        \"\"\"\n        self.client = client\n    \n    def extract_single(self, response: Response) -> ResponseExtraction:\n        \"\"\"\n        Extract metadata from a single response.\n        \n        Args:\n            response: Response to process\n            \n        Returns:\n            ResponseExtraction with metadata\n        \"\"\"\n        prompt = EXTRACTION_PROMPT_TEMPLATE.format(\n            interviewer=response.interviewer,\n            veteran=response.veteran\n        )\n        \n        try:\n            data = self.client.complete_json(\n                prompt=prompt,\n                system=EXTRACTION_SYSTEM_PROMPT,\n                max_tokens=2048\n            )\n            \n            # Parse dates\n            dates = []\n            for d in data.get(\"dates\", []):\n                if isinstance(d, dict):\n                    dates.append(ExtractedDate(\n                        value=d.get(\"value\", \"\"),\n                        context=d.get(\"context\", \"\"),\n                        precision=d.get(\"precision\", \"stated\")\n                    ))\n            \n            # Parse people\n            people = []\n            for p in data.get(\"people\", []):\n                if isinstance(p, dict):\n                    people.append(ExtractedPerson(\n                        name=p.get(\"name\", \"\"),\n                        role=p.get(\"role\"),\n                        context=p.get(\"context\")\n                    ))\n            \n            # Parse writing potential\n            wp_str = data.get(\"writing_potential\", \"low\").lower()\n            try:\n                writing_potential = WritingPotential(wp_str)\n            except ValueError:\n                writing_potential = WritingPotential.LOW\n            \n            return ResponseExtraction(\n                summary=data.get(\"summary\", \"\"),\n                dates=dates,\n                locations=data.get(\"locations\", []),\n                people=people,\n                units=data.get(\"units\", []),\n                events=data.get(\"events\", []),\n                topics=data.get(\"topics\", []),\n                writing_potential=writing_potential,\n                writing_note=data.get(\"writing_note\")\n            )\n            \n        except (json.JSONDecodeError, KeyError) as e:\n            # Return minimal extraction on error\n            return ResponseExtraction(\n                summary=f\"[Extraction error: {str(e)}]\",\n                writing_potential=WritingPotential.LOW\n            )\n    \n    def extract_batch(\n        self, \n        responses: List[Response],\n        progress_callback: Optional[Callable[[int, int], None]] = None\n    ) -> List[Response]:\n        \"\"\"\n        Extract metadata from multiple responses.\n        \n        Args:\n            responses: Responses to process\n            progress_callback: Optional callback(current, total) for progress\n            \n        Returns:\n            Responses with extracted metadata added\n        \"\"\"\n        total = len(responses)\n        \n        for i, response in enumerate(responses):\n            extraction = self.extract_single(response)\n            response.extracted = extraction\n            \n            if progress_callback:\n                progress_callback(i + 1, total)\n        \n        return responses\n","file_path":"~/Documents/Projects/Current/writer/src/llm/extractor.py"}},"jsonrpc":"2.0","id":19} { metadata: undefined }
