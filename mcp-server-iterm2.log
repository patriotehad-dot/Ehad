2025-12-18T10:31:38.604Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"content":"\"\"\"\nConfiguration handling for the Oral History Research System.\n\nLoads configuration from:\n1. Environment variables (.env file)\n2. config.yaml in project root\n3. Default values\n\"\"\"\n\nimport os\nfrom pathlib import Path\nfrom typing import Optional\nimport yaml\nfrom dotenv import load_dotenv\n\nfrom .models import Config, LLMConfig, EmbeddingsConfig\n\n\ndef find_project_root(start_path: Optional[Path] = None) -> Optional[Path]:\n    \"\"\"\n    Find the project root by looking for config.yaml or .git directory.\n    \n    Args:\n        start_path: Starting path to search from (defaults to cwd)\n        \n    Returns:\n        Path to project root, or None if not found\n    \"\"\"\n    if start_path is None:\n        start_path = Path.cwd()\n    \n    current = start_path.resolve()\n    \n    while current != current.parent:\n        # Look for config.yaml (our project marker)\n        if (current / \"config.yaml\").exists():\n            return current\n        # Also check for veterans directory as a marker\n        if (current / \"veterans\").exists():\n            return current\n        current = current.parent\n    \n    return None\n\n\ndef load_env(project_root: Optional[Path] = None) -> None:\n    \"\"\"\n    Load environment variables from .env file.\n    \n    Args:\n        project_root: Project root directory (will search if not provided)\n    \"\"\"\n    if project_root is None:\n        project_root = find_project_root()\n    \n    if project_root:\n        env_file = project_root / \".env\"\n        if env_file.exists():\n            load_dotenv(env_file)\n    \n    # Also try loading from current directory\n    load_dotenv()\n\n\ndef load_config(project_root: Optional[Path] = None) -> Config:\n    \"\"\"\n    Load configuration from config.yaml and environment.\n    \n    Args:\n        project_root: Project root directory (will search if not provided)\n        \n    Returns:\n        Config object with merged settings\n    \"\"\"\n    # Load environment variables first\n    load_env(project_root)\n    \n    if project_root is None:\n        project_root = find_project_root()\n    \n    config_data = {}\n    \n    # Load from config.yaml if it exists\n    if project_root:\n        config_file = project_root / \"config.yaml\"\n        if config_file.exists():\n            with open(config_file, \"r\") as f:\n                config_data = yaml.safe_load(f) or {}\n    \n    # Override with environment variables where applicable\n    if \"llm\" not in config_data:\n        config_data[\"llm\"] = {}\n    \n    # LLM provider from env\n    if os.getenv(\"LLM_PROVIDER\"):\n        config_data[\"llm\"][\"provider\"] = os.getenv(\"LLM_PROVIDER\")\n    \n    # Anthropic settings\n    if os.getenv(\"ANTHROPIC_MODEL\"):\n        config_data[\"llm\"][\"model\"] = os.getenv(\"ANTHROPIC_MODEL\")\n    \n    # OpenAI settings (for embeddings primarily)\n    if \"embeddings\" not in config_data:\n        config_data[\"embeddings\"] = {}\n    \n    return Config(**config_data)\n\n\ndef get_api_key(provider: str) -> Optional[str]:\n    \"\"\"\n    Get API key for a provider from environment.\n    \n    Args:\n        provider: Provider name (anthropic, openai, etc.)\n        \n    Returns:\n        API key string or None\n    \"\"\"\n    env_var_map = {\n        \"anthropic\": \"ANTHROPIC_API_KEY\",\n        \"openai\": \"OPENAI_API_KEY\",\n        \"portkey\": \"PORTKEY_API_KEY\",\n    }\n    \n    env_var = env_var_map.get(provider.lower())\n    if env_var:\n        return os.getenv(env_var)\n    \n    return None\n\n\ndef ensure_project_structure(root: Path) -> None:\n    \"\"\"\n    Ensure the project directory structure exists.\n    \n    Args:\n        root: Project root directory\n    \"\"\"\n    directories = [\n        \"veterans\",\n        \"annotations\",\n        \"index\",\n        \"exports\",\n    ]\n    \n    for dir_name in directories:\n        (root / dir_name).mkdir(parents=True, exist_ok=True)\n\n\ndef create_default_config(root: Path) -> Path:\n    \"\"\"\n    Create a default config.yaml file.\n    \n    Args:\n        root: Project root directory\n        \n    Returns:\n        Path to created config file\n    \"\"\"\n    default_config = {\n        \"llm\": {\n            \"provider\": \"anthropic\",\n            \"model\": \"claude-sonnet-4-20250514\",\n            \"api_key_env\": \"ANTHROPIC_API_KEY\",\n        },\n        \"embeddings\": {\n            \"provider\": \"openai\",\n            \"model\": \"text-embedding-3-small\",\n            \"api_key_env\": \"OPENAI_API_KEY\",\n        },\n        \"chunking\": {\n            \"method\": \"double_newline\",\n            \"min_paragraph_length\": 50,\n        },\n        \"search\": {\n            \"default_limit\": 20,\n            \"hybrid_weight\": 0.7,\n        },\n        \"export\": {\n            \"default_format\": \"markdown\",\n        },\n    }\n    \n    config_path = root / \"config.yaml\"\n    with open(config_path, \"w\") as f:\n        yaml.dump(default_config, f, default_flow_style=False, sort_keys=False)\n    \n    return config_path\n\n\nclass ProjectContext:\n    \"\"\"\n    Context manager for working within a project.\n    Provides easy access to paths and configuration.\n    \"\"\"\n    \n    def __init__(self, root: Optional[Path] = None):\n        \"\"\"\n        Initialize project context.\n        \n        Args:\n            root: Project root (will search if not provided)\n        \"\"\"\n        self._root = root.resolve() if root else find_project_root()\n        if self._root is None:\n            raise ValueError(\"Not in an oralhistory project. Run 'oralhistory init' first.\")\n        \n        load_env(self._root)\n        self._config = load_config(self._root)\n    \n    @property\n    def root(self) -> Path:\n        \"\"\"Project root directory.\"\"\"\n        return self._root\n    \n    @property\n    def config(self) -> Config:\n        \"\"\"Project configuration.\"\"\"\n        return self._config\n    \n    @property\n    def veterans_dir(self) -> Path:\n        \"\"\"Veterans directory.\"\"\"\n        return self._root / \"veterans\"\n    \n    @property\n    def annotations_dir(self) -> Path:\n        \"\"\"Annotations directory.\"\"\"\n        return self._root / \"annotations\"\n    \n    @property\n    def index_dir(self) -> Path:\n        \"\"\"Index directory.\"\"\"\n        return self._root / \"index\"\n    \n    @property\n    def exports_dir(self) -> Path:\n        \"\"\"Exports directory.\"\"\"\n        return self._root / \"exports\"\n    \n    @property\n    def embeddings_db(self) -> Path:\n        \"\"\"Path to embeddings SQLite database.\"\"\"\n        return self._root / \"index\" / \"embeddings.sqlite\"\n    \n    @property\n    def relationships_db(self) -> Path:\n        \"\"\"Path to relationships SQLite database.\"\"\"\n        return self._root / \"index\" / \"relationships.sqlite\"\n    \n    def veteran_file(self, veteran_id: str) -> Path:\n        \"\"\"Get path to a veteran's YAML file.\"\"\"\n        return self.veterans_dir / f\"{veteran_id}.yaml\"\n    \n    def annotations_file(self, veteran_id: str) -> Path:\n        \"\"\"Get path to a veteran's annotations file.\"\"\"\n        return self.annotations_dir / f\"{veteran_id}.yaml\"\n","file_path":"~/Documents/Projects/Current/writer/src/config.py"}},"jsonrpc":"2.0","id":14} { metadata: undefined }
