      case_sensitive (bool): Whether the search should be case-sensitive. Defaults to True.\n\n    Returns:\n        str: A JSON string containing a list of search results or an error.\n    ","inputSchema":{"properties":{"query":{"title":"Query","type":"string"},"search_path":{"default":".","title":"Search Path","type":"string"},"case_sensitive":{"default":true,"title":"Case Sensitive","type":"boolean"}},"required":["query"],"title":"search_codeArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"search_codeOutput","type":"object"}},{"name":"cleanup_connections","description":"\n    🧹 Manual cleanup tool for memory management during long sessions.\n    \n    Use this tool periodically during long coding sessions to free up memory\n    and reset connections. Especially useful after many tool calls.\n    ","inputSchema":{"properties":{},"title":"cleanup_connectionsArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"cleanup_connectionsOutput","type":"object"}},{"name":"get_memory_stats","description":"\n    📊 Get basic memory usage stats for debugging long sessions.\n    \n    Returns current memory usage and connection status. Useful for\n    monitoring memory during long coding sessions or debugging issues.\n    ","inputSchema":{"properties":{},"title":"get_memory_statsArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"get_memory_statsOutput","type":"object"}}]}} { metadata: undefined }
