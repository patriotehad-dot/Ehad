2025-12-18T10:32:54.888Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"content":"\"\"\"\nTranscript parser for the Oral History Research System.\n\nParses interview transcripts into Q&A responses.\nHandles various transcript formats and speaker patterns.\n\"\"\"\n\nimport re\nfrom typing import List, Tuple, Optional\nfrom pathlib import Path\nfrom dataclasses import dataclass\n\nfrom .models import Response, Paragraph\n\n\n@dataclass\nclass ParsedResponse:\n    \"\"\"A parsed response before full processing.\"\"\"\n    interviewer: str\n    veteran: str\n    raw_index: int  # Original position in transcript\n\n\nclass TranscriptParser:\n    \"\"\"\n    Parses interview transcripts into structured Q&A responses.\n    \n    Supports various speaker patterns:\n    - \"INTERVIEWER:\" / \"VETERAN:\"\n    - \"Q:\" / \"A:\"\n    - \"Interviewer:\" / \"[Name]:\"\n    - Speaker names followed by colons\n    \"\"\"\n    \n    # Common patterns for speaker detection\n    INTERVIEWER_PATTERNS = [\n        r\"^INTERVIEWER\\s*:\",\n        r\"^Q\\s*:\",\n        r\"^Interviewer\\s*:\",\n        r\"^INT\\s*:\",\n        r\"^I\\s*:\",\n    ]\n    \n    VETERAN_PATTERNS = [\n        r\"^VETERAN\\s*:\",\n        r\"^A\\s*:\",\n        r\"^(?:Mr\\.|Mrs\\.|Ms\\.|Sgt\\.|Sergeant|Captain|Lt\\.|Lieutenant|Private|Corporal|Staff Sergeant)\\s+\\w+\\s*:\",\n    ]\n    \n    def __init__(self, min_paragraph_length: int = 50):\n        \"\"\"\n        Initialize parser.\n        \n        Args:\n            min_paragraph_length: Minimum characters for a paragraph\n        \"\"\"\n        self.min_paragraph_length = min_paragraph_length\n        \n        # Compiled patterns\n        self._interviewer_re = [re.compile(p, re.IGNORECASE | re.MULTILINE) for p in self.INTERVIEWER_PATTERNS]\n        self._veteran_re = [re.compile(p, re.IGNORECASE | re.MULTILINE) for p in self.VETERAN_PATTERNS]\n    \n    def detect_speakers(self, text: str) -> Tuple[Optional[re.Pattern], Optional[re.Pattern], Optional[str]]:\n        \"\"\"\n        Detect speaker patterns in the transcript.\n        \n        Args:\n            text: Transcript text\n            \n        Returns:\n            Tuple of (interviewer_pattern, veteran_pattern, veteran_name)\n        \"\"\"\n        # Try standard patterns first\n        for pattern in self._interviewer_re:\n            if pattern.search(text):\n                interviewer_pattern = pattern\n                break\n        else:\n            interviewer_pattern = None\n        \n        # Try to detect veteran's name from the pattern\n        veteran_name = None\n        veteran_pattern = None\n        \n        for pattern in self._veteran_re:\n            match = pattern.search(text)\n            if match:\n                veteran_pattern = pattern\n                # Extract name if it's in the pattern\n                matched_text = match.group(0)\n                if \":\" in matched_text:\n                    veteran_name = matched_text.split(\":\")[0].strip()\n                break\n        \n        # If we didn't find standard patterns, try to detect from text\n        if interviewer_pattern is None or veteran_pattern is None:\n            # Look for any \"Name:\" patterns\n            name_pattern = re.compile(r\"^([A-Z][a-z]+ [A-Z][a-z]+)\\s*:\", re.MULTILINE)\n            names = name_pattern.findall(text)\n            \n            if len(names) >= 2:\n                # Assume first unique name is interviewer, second is veteran\n                unique_names = list(dict.fromkeys(names))\n                if len(unique_names) >= 2:\n                    if interviewer_pattern is None:\n                        interviewer_pattern = re.compile(f\"^{re.escape(unique_names[0])}\\\\s*:\", re.MULTILINE)\n                    if veteran_pattern is None:\n                        veteran_name = unique_names[1]\n                        veteran_pattern = re.compile(f\"^{re.escape(unique_names[1])}\\\\s*:\", re.MULTILINE)\n        \n        return interviewer_pattern, veteran_pattern, veteran_name\n    \n    def parse(self, text: str, veteran_name: Optional[str] = None) -> List[ParsedResponse]:\n        \"\"\"\n        Parse a transcript into Q&A responses.\n        \n        Args:\n            text: Transcript text\n            veteran_name: Optional veteran name for speaker detection\n            \n        Returns:\n            List of parsed responses\n        \"\"\"\n        # Detect speaker patterns\n        interviewer_pattern, veteran_pattern, detected_name = self.detect_speakers(text)\n        \n        if veteran_name:\n            # Create pattern for provided name\n            escaped_name = re.escape(veteran_name)\n            # Match various patterns with the name\n            name_patterns = [\n                f\"^{escaped_name}\\\\s*:\",\n                f\"^(?:Mr\\\\.|Mrs\\\\.|Ms\\\\.)\\\\s*{escaped_name.split()[-1]}\\\\s*:\" if \" \" in veteran_name else f\"^{escaped_name}\\\\s*:\",\n            ]\n            combined_pattern = \"|\".join(name_patterns)\n            veteran_pattern = re.compile(combined_pattern, re.IGNORECASE | re.MULTILINE)\n        \n        if interviewer_pattern is None or veteran_pattern is None:\n            # Fall back to simple Q:/A: if we can't detect\n            interviewer_pattern = re.compile(r\"^(?:Q|Interviewer)\\s*:\", re.IGNORECASE | re.MULTILINE)\n            veteran_pattern = re.compile(r\"^(?:A|[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)?)\\s*:\", re.IGNORECASE | re.MULTILINE)\n        \n        # Combine patterns to find all speaker turns\n        all_speakers = []\n        \n        for match in interviewer_pattern.finditer(text):\n            all_speakers.append((\"interviewer\", match.start(), match.end()))\n        \n        for match in veteran_pattern.finditer(text):\n            all_speakers.append((\"veteran\", match.start(), match.end()))\n        \n        # Sort by position\n        all_speakers.sort(key=lambda x: x[1])\n        \n        if not all_speakers:\n            # No speaker patterns found - return entire text as single response\n            return [ParsedResponse(\n                interviewer=\"[No interviewer question detected]\",\n                veteran=text.strip(),\n                raw_index=0\n            )]\n        \n        # Parse into responses\n        responses = []\n        current_interviewer = None\n        current_veteran_parts = []\n        response_index = 0\n        \n        for i, (speaker_type, start, end) in enumerate(all_speakers):\n            # Get text until next speaker or end\n            if i + 1 < len(all_speakers):\n                next_start = all_speakers[i + 1][1]\n                speaker_text = text[end:next_start].strip()\n            else:\n                speaker_text = text[end:].strip()\n            \n            if speaker_type == \"interviewer\":\n                # Save previous response if we have one\n                if current_interviewer is not None and current_veteran_parts:\n                    responses.append(ParsedResponse(\n                        interviewer=current_interviewer,\n                        veteran=\" \".join(current_veteran_parts),\n                        raw_index=response_index\n                    ))\n                    response_index += 1\n                \n                current_interviewer = speaker_text\n                current_veteran_parts = []\n            \n            else:  # veteran\n                if speaker_text:\n                    current_veteran_parts.append(speaker_text)\n        \n        # Don't forget the last response\n        if current_interviewer is not None and current_veteran_parts:\n            responses.append(ParsedResponse(\n                interviewer=current_interviewer,\n                veteran=\" \".join(current_veteran_parts),\n                raw_index=response_index\n            ))\n        \n        return responses\n    \n    def split_paragraphs(self, text: str) -> List[str]:\n        \"\"\"\n        Split text into paragraphs for embedding.\n        \n        Args:\n            text: Text to split\n            \n        Returns:\n            List of paragraph texts\n        \"\"\"\n        # Split on double newlines primarily\n        parts = re.split(r\"\\n\\s*\\n\", text)\n        \n        paragraphs = []\n        current = \"\"\n        \n        for part in parts:\n            part = part.strip()\n            if not part:\n                continue\n            \n            # If this part is too short, merge with previous\n            if len(part) < self.min_paragraph_length and current:\n                current += \" \" + part\n            elif len(current) < self.min_paragraph_length and current:\n                current += \" \" + part\n            else:\n                if current:\n                    paragraphs.append(current)\n                current = part\n        \n        if current:\n            paragraphs.append(current)\n        \n        # If we ended up with no paragraphs, just return the whole text\n        if not paragraphs and text.strip():\n            paragraphs = [text.strip()]\n        \n        return paragraphs\n    \n    def create_responses(\n        self, \n        parsed: List[ParsedResponse],\n        id_prefix: str = \"\"\n    ) -> List[Response]:\n        \"\"\"\n        Convert parsed responses to Response objects with paragraphs.\n        \n        Args:\n            parsed: List of parsed responses\n            id_prefix: Optional prefix for response IDs\n            \n        Returns:\n            List of Response objects\n        \"\"\"\n        responses = []\n        \n        for i, pr in enumerate(parsed):\n            response_id = f\"{id_prefix}{str(i + 1).zfill(3)}\"\n            \n            # Split veteran's answer into paragraphs\n            paragraph_texts = self.split_paragraphs(pr.veteran)\n            paragraphs = []\n            \n            for j, para_text in enumerate(paragraph_texts):\n                para_id = f\"{response_id}_p{j + 1}\"\n                paragraphs.append(Paragraph(id=para_id, text=para_text))\n            \n            responses.append(Response(\n                id=response_id,\n                interviewer=pr.interviewer,\n                veteran=pr.veteran,\n                paragraphs=paragraphs\n            ))\n        \n        return responses\n\n\ndef parse_transcript_file(\n    file_path: Path,\n    veteran_name: Optional[str] = None,\n    min_paragraph_length: int = 50\n) -> List[Response]:\n    \"\"\"\n    Parse a transcript file into responses.\n    \n    Args:\n        file_path: Path to transcript file\n        veteran_name: Optional veteran name\n        min_paragraph_length: Minimum paragraph length\n        \n    Returns:\n        List of Response objects\n    \"\"\"\n    with open(file_path, \"r\", encoding=\"utf-8\") as f:\n        text = f.read()\n    \n    parser = TranscriptParser(min_paragraph_length=min_paragraph_length)\n    parsed = parser.parse(text, veteran_name=veteran_name)\n    \n    return parser.create_responses(parsed)\n\n\ndef extract_header_info(text: str) -> dict:\n    \"\"\"\n    Try to extract header information from transcript.\n    \n    Looks for patterns like:\n    - \"Interview with Sergeant James Mitchell\"\n    - \"6th Armored Division, Company B\"\n    - \"Interviewed on March 15, 1995\"\n    \n    Args:\n        text: Transcript text\n        \n    Returns:\n        Dict with extracted info (name, unit, rank, date, location, interviewer)\n    \"\"\"\n    info = {}\n    \n    # Look at first few lines for header info\n    lines = text.split(\"\\n\")[:20]\n    header = \"\\n\".join(lines)\n    \n    # Name patterns\n    name_patterns = [\n        r\"Interview with (?:Sergeant|Sgt\\.|Captain|Capt\\.|Lieutenant|Lt\\.|Private|Pvt\\.|Corporal|Cpl\\.|Staff Sergeant)?\\s*([A-Z][a-z]+ (?:[A-Z]\\. )?[A-Z][a-z]+)\",\n        r\"^([A-Z][a-z]+ [A-Z][a-z]+)\\s*$\",\n    ]\n    \n    for pattern in name_patterns:\n        match = re.search(pattern, header, re.MULTILINE)\n        if match:\n            info[\"name\"] = match.group(1).strip()\n            break\n    \n    # Unit patterns\n    unit_patterns = [\n        r\"(\\d+(?:st|nd|rd|th)\\s+(?:Armored|Infantry|Airborne|Tank|Artillery)[^,\\n]+)\",\n        r\"([A-Z][a-z]+ Company[^,\\n]+)\",\n    ]\n    \n    for pattern in unit_patterns:\n        match = re.search(pattern, header)\n        if match:\n            info[\"unit\"] = match.group(1).strip()\n            break\n    \n    # Date patterns\n    date_patterns = [\n        r\"(?:Interviewed|Recorded)\\s+(?:on\\s+)?([A-Z][a-z]+ \\d{1,2},? \\d{4})\",\n        r\"(\\d{4}-\\d{2}-\\d{2})\",\n    ]\n    \n    for pattern in date_patterns:\n        match = re.search(pattern, header)\n        if match:\n            info[\"date_recorded\"] = match.group(1).strip()\n            break\n    \n    # Rank patterns\n    rank_patterns = [\n        r\"(Sergeant|Sgt\\.|Captain|Capt\\.|Lieutenant|Lt\\.|Private|Pvt\\.|Corporal|Cpl\\.|Staff Sergeant|Major|Colonel|General)\",\n    ]\n    \n    for pattern in rank_patterns:\n        match = re.search(pattern, header)\n        if match:\n            info[\"rank\"] = match.group(1).strip()\n            break\n    \n    return info\n","file_path":"~/Documents/Projects/Current/writer/src/parser.py"}},"jsonrpc":"2.0","id":16} { metadata: undefined }
