  window, start_idx, end_idx = get_context_window(\\n        v.responses, target_idx, before, after\\n    )\\n    \\n    # Header\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        f\\\"[bold]CONTEXT WINDOW[/bold] \\u2014 {v.name} [{response_id}]\\\\n\\\"\\n        f\\\"[dim]Showing {before} before, {after} after (responses {start_idx+1}-{end_idx})[/dim]\\\",\\n        box=box.DOUBLE,\\n        border_style=\\\"cyan\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Display each response in the window\\n    for i, r in enumerate(window):\\n        actual_idx = start_idx + i\\n        is_target = (actual_idx == target_idx)\\n        \\n        # Determine panel style based on whether this is the target\\n        if is_target:\\n            border_style = \\\"yellow\\\"\\n            title_prefix = \\\">>> TARGET >>> \\\"\\n        else:\\n            border_style = \\\"dim\\\"\\n            title_prefix = \\\"\\\"\\n        \\n        # Build title with metadata\\n        title_parts = [f\\\"{title_prefix}[{r.id}]\\\"]\\n        if r.extracted:\\n            if r.extracted.writing_potential == WritingPotential.HIGH:\\n                title_parts.append(\\\"[yellow]\\u2605 HIGH[/yellow]\\\")\\n            elif r.extracted.writing_potential == WritingPotential.MEDIUM:\\n                title_parts.append(\\\"[dim]MEDIUM[/dim]\\\")\\n        \\n        title = \\\" \\\".join(title_parts)\\n        \\n        # Question panel\\n        q_style = \\\"bold\\\" if is_target else \\\"dim\\\"\\n        console.print(f\\\"[{q_style}]Q: {r.interviewer}[/{q_style}]\\\")\\n        console.print(\\\"\\\")\\n        \\n        # Answer panel\\n        answer_panel = Panel(\\n            r.veteran,\\n            title=title,\\n            title_align=\\\"left\\\",\\n            box=box.ROUNDED,\\n            border_style=border_style,\\n            padding=(0, 1)\\n        )\\n        console.print(answer_panel)\\n        \\n        # Add summary if available and this is the target\\n        if is_target and r.extracted and r.extracted.summary:\\n            console.print(f\\\"[dim italic]   Summary: {r.extracted.summary}[/dim italic]\\\")\\n        \\n        console.print(\\\"\\\")\\n    \\n    # Quick actions\\n    console.print(\\\"[dim]Quick actions:[/dim]\\\")\\n    console.print(f\\\"[dim]  \\u2192 View single: oralhistory view {veteran_id} {response_id}[/dim]\\\")\\n    console.print(f\\\"[dim]  \\u2192 Wider context: oralhistory context {veteran_id} {response_id} --before 5 --after 5[/dim]\\\")\\n    console.print(f\\\"[dim]  \\u2192 Add note: oralhistory annotate {veteran_id} {response_id} --note \\\\\\\"...\\\\\\\"[/dim]\\\")\\n\\n\\n# ============================================================================\\n# Annotate Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.argument(\\\"response_id\\\", required=False)\\n@click.option(\\\"--note\\\", \\\"-n\\\", help=\\\"Add a note\\\")\\n\",\n  \"file_size_bytes\": 89215,\n  \"content_length\": 4256\n}"}],"structuredContent":{"result":"{\n  \"success\": true,\n  \"file_path\": \"/Users/happyhawking/Documents/Projects/Current/writer/src/cli.py\",\n  \"content\": \"# Context Command (Parent-Child Windowing)\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.argument(\\\"response_id\\\")\\n@click.option(\\\"--before\\\", \\\"-b\\\", default=2, help=\\\"Number of responses before target\\\")\\n@click.option(\\\"--after\\\", \\\"-a\\\", default=2, help=\\\"Number of responses after target\\\")\\ndef context(veteran_id: str, response_id: str, before: int, after: int):\\n    \\\"\\\"\\\"Show context window around a response (Parent-Child view).\\n    \\n    This is the \\\"Journalist\\\" query mode - when you find a quote, you need\\n    to see what came before and af