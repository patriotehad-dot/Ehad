2025-12-21T17:17:15.596Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"content":"\"\"\"\nEntity Graph for the Oral History Research System.\n\nBuilds and queries a knowledge graph of entities (people, places, units, events)\nand their relationships across veteran interviews.\n\nThis enables:\n- \"Who else served with Captain Thompson?\"\n- \"What happened at Bastogne?\" (find all connected events/people)\n- \"Show everything connected to the 6th Armored\"\n\"\"\"\n\nimport sqlite3\nfrom typing import List, Optional, Dict, Any, Set, Tuple\nfrom pathlib import Path\nfrom dataclasses import dataclass, field\nfrom enum import Enum\n\nfrom .models import Veteran, Response\n\n\nclass EntityType(Enum):\n    PERSON = \"person\"\n    PLACE = \"place\"\n    UNIT = \"unit\"\n    EVENT = \"event\"\n    DATE = \"date\"\n    EQUIPMENT = \"equipment\"\n\n\nclass RelationType(Enum):\n    # Person relationships\n    SERVED_WITH = \"served_with\"\n    COMMANDED_BY = \"commanded_by\"\n    COMMANDED = \"commanded\"\n    MENTIONED_BY = \"mentioned_by\"\n    \n    # Place relationships  \n    LOCATED_AT = \"located_at\"\n    OCCURRED_AT = \"occurred_at\"\n    MOVED_TO = \"moved_to\"\n    \n    # Unit relationships\n    MEMBER_OF = \"member_of\"\n    PART_OF = \"part_of\"\n    FOUGHT_AGAINST = \"fought_against\"\n    \n    # Event relationships\n    PARTICIPATED_IN = \"participated_in\"\n    WITNESSED = \"witnessed\"\n    OCCURRED_DURING = \"occurred_during\"\n    \n    # General\n    RELATED_TO = \"related_to\"\n    MENTIONED_WITH = \"mentioned_with\"\n\n\n@dataclass\nclass Entity:\n    \"\"\"An entity in the knowledge graph.\"\"\"\n    id: str\n    name: str\n    type: EntityType\n    aliases: List[str] = field(default_factory=list)\n    attributes: Dict[str, Any] = field(default_factory=dict)\n    source_veteran_ids: Set[str] = field(default_factory=set)\n    source_response_ids: Set[str] = field(default_factory=set)\n\n\n@dataclass\nclass Relationship:\n    \"\"\"A relationship between two entities.\"\"\"\n    source_id: str\n    target_id: str\n    relation: RelationType\n    weight: float = 1.0  # Strength of relationship (1.0 = mentioned together, higher = explicit)\n    source_veteran_id: Optional[str] = None\n    source_response_id: Optional[str] = None\n    context: Optional[str] = None  # Brief context snippet\n\n\n@dataclass\nclass GraphSearchResult:\n    \"\"\"Result from graph traversal.\"\"\"\n    entity: Entity\n    path: List[Tuple[Entity, RelationType]]  # How we got here\n    distance: int  # Hops from query entity\n    relevance: float\n\n\nclass EntityGraph:\n    \"\"\"\n    Knowledge graph of entities and relationships.\n    \n    Uses SQLite for storage with simple edge-list representation.\n    \"\"\"\n    \n    def __init__(self, db_path: Path):\n        self.db_path = db_path\n        self._conn = None\n        self._init_db()\n    \n    def _get_conn(self) -> sqlite3.Connection:\n        if self._conn is None:\n            self._conn = sqlite3.connect(str(self.db_path))\n            self._conn.row_factory = sqlite3.Row\n        return self._conn\n    \n    def _init_db(self):\n        \"\"\"Initialize database schema.\"\"\"\n        conn = self._get_conn()\n        \n        # Entities table\n        conn.execute(\"\"\"\n            CREATE TABLE IF NOT EXISTS entities (\n                id TEXT PRIMARY KEY,\n                name TEXT NOT NULL,\n                type TEXT NOT NULL,\n                aliases TEXT,  -- JSON array\n                attributes TEXT,  -- JSON object\n                source_veteran_ids TEXT,  -- JSON array\n                source_response_ids TEXT  -- JSON array\n            )\n        \"\"\")\n        \n        # Relationships (edges) table\n        conn.execute(\"\"\"\n            CREATE TABLE IF NOT EXISTS relationships (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                source_id TEXT NOT NULL,\n                target_id TEXT NOT NULL,\n                relation TEXT NOT NULL,\n                weight REAL DEFAULT 1.0,\n                source_veteran_id TEXT,\n                source_response_id TEXT,\n                context TEXT,\n                FOREIGN KEY (source_id) REFERENCES entities(id),\n                FOREIGN KEY (target_id) REFERENCES entities(id)\n            )\n        \"\"\")\n        \n        # Indexes\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_rel_source ON relationships(source_id)\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_rel_target ON relationships(target_id)\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_rel_type ON relationships(relation)\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_entity_type ON entities(type)\")\n        conn.execute(\"CREATE INDEX IF NOT EXISTS idx_entity_name ON entities(name)\")\n        \n        conn.commit()\n    \n    def add_entity(self, entity: Entity):\n        \"\"\"Add or update an entity.\"\"\"\n        import json\n        conn = self._get_conn()\n        \n        conn.execute(\"\"\"\n            INSERT OR REPLACE INTO entities \n            (id, name, type, aliases, attributes, source_veteran_ids, source_response_ids)\n            VALUES (?, ?, ?, ?, ?, ?, ?)\n        \"\"\", (\n            entity.id,\n            entity.name,\n            entity.type.value,\n            json.dumps(entity.aliases),\n            json.dumps(entity.attributes),\n            json.dumps(list(entity.source_veteran_ids)),\n            json.dumps(list(entity.source_response_ids))\n        ))\n        conn.commit()\n    \n    def add_relationship(self, rel: Relationship):\n        \"\"\"Add a relationship between entities.\"\"\"\n        conn = self._get_conn()\n        \n        conn.execute(\"\"\"\n            INSERT INTO relationships \n            (source_id, target_id, relation, weight, source_veteran_id, source_response_id, context)\n            VALUES (?, ?, ?, ?, ?, ?, ?)\n        \"\"\", (\n            rel.source_id,\n            rel.target_id,\n            rel.relation.value,\n            rel.weight,\n            rel.source_veteran_id,\n            rel.source_response_id,\n            rel.context\n        ))\n        conn.commit()\n    \n    def get_entity(self, entity_id: str) -> Optional[Entity]:\n        \"\"\"Get entity by ID.\"\"\"\n        import json\n        conn = self._get_conn()\n        \n        row = conn.execute(\n            \"SELECT * FROM entities WHERE id = ?\", \n            (entity_id,)\n        ).fetchone()\n        \n        if not row:\n            return None\n        \n        return Entity(\n            id=row[\"id\"],\n            name=row[\"name\"],\n            type=EntityType(row[\"type\"]),\n            aliases=json.loads(row[\"aliases\"] or \"[]\"),\n            attributes=json.loads(row[\"attributes\"] or \"{}\"),\n            source_veteran_ids=set(json.loads(row[\"source_veteran_ids\"] or \"[]\")),\n            source_response_ids=set(json.loads(row[\"source_response_ids\"] or \"[]\"))\n        )\n    \n    def find_entity(self, name: str, entity_type: Optional[EntityType] = None) -> Optional[Entity]:\n        \"\"\"Find entity by name (case-insensitive) or alias.\"\"\"\n        import json\n        conn = self._get_conn()\n        \n        # Try exact name match first\n        query = \"SELECT * FROM entities WHERE LOWER(name) = LOWER(?)\"\n        params = [name]\n        \n        if entity_type:\n            query += \" AND type = ?\"\n            params.append(entity_type.value)\n        \n        row = conn.execute(query, params).fetchone()\n        \n        if row:\n            return Entity(\n                id=row[\"id\"],\n                name=row[\"name\"],\n                type=EntityType(row[\"type\"]),\n                aliases=json.loads(row[\"aliases\"] or \"[]\"),\n                attributes=json.loads(row[\"attributes\"] or \"{}\"),\n                source_veteran_ids=set(json.loads(row[\"source_veteran_ids\"] or \"[]\")),\n                source_response_ids=set(json.loads(row[\"source_response_ids\"] or \"[]\"))\n            )\n        \n        # Try alias search\n        for row in conn.execute(\"SELECT * FROM entities\"):\n            aliases = json.loads(row[\"aliases\"] or \"[]\")\n            if name.lower() in [a.lower() for a in aliases]:\n                if entity_type and row[\"type\"] != entity_type.value:\n                    continue\n                return Entity(\n                    id=row[\"id\"],\n                    name=row[\"name\"],\n                    type=EntityType(row[\"type\"]),\n                    aliases=aliases,\n                    attributes=json.loads(row[\"attributes\"] or \"{}\"),\n                    source_veteran_ids=set(json.loads(row[\"source_veteran_ids\"] or \"[]\")),\n                    source_response_ids=set(json.loads(row[\"source_response_ids\"] or \"[]\"))\n                )\n        \n        return None\n    \n    def get_relationships(\n        self, \n        entity_id: str,\n        direction: str = \"both\",  # \"outgoing\", \"incoming\", \"both\"\n        relation_type: Optional[RelationType] = None\n    ) -> List[Relationship]:\n        \"\"\"Get relationships for an entity.\"\"\"\n        conn = self._get_conn()\n        results = []\n        \n        if direction in (\"outgoing\", \"both\"):\n            query = \"SELECT * FROM relationships WHERE source_id = ?\"\n            params = [entity_id]\n            if relation_type:\n                query += \" AND relation = ?\"\n                params.append(relation_type.value)\n            \n            for row in conn.execute(query, params):\n                results.append(Relationship(\n                    source_id=row[\"source_id\"],\n                    target_id=row[\"target_id\"],\n                    relation=RelationType(row[\"relation\"]),\n                    weight=row[\"weight\"],\n                    source_veteran_id=row[\"source_veteran_id\"],\n                    source_response_id=row[\"source_response_id\"],\n                    context=row[\"context\"]\n                ))\n        \n        if direction in (\"incoming\", \"both\"):\n            query = \"SELECT * FROM relationships WHERE target_id = ?\"\n            params = [entity_id]\n            if relation_type:\n                query += \" AND relation = ?\"\n                params.append(relation_type.value)\n            \n            for row in conn.execute(query, params):\n                results.append(Relationship(\n                    source_id=row[\"source_id\"],\n                    target_id=row[\"target_id\"],\n                    relation=RelationType(row[\"relation\"]),\n                    weight=row[\"weight\"],\n                    source_veteran_id=row[\"source_veteran_id\"],\n                    source_response_id=row[\"source_response_id\"],\n                    context=row[\"context\"]\n                ))\n        \n        return results\n    \n    def traverse(\n        self,\n        start_entity_id: str,\n        max_depth: int = 2,\n        relation_types: Optional[List[RelationType]] = None\n    ) -> List[GraphSearchResult]:\n        \"\"\"\n        Traverse graph from starting entity.\n        \n        Returns all reachable entities within max_depth hops.\n        \"\"\"\n        visited = set()\n        results = []\n        \n        # BFS traversal\n        queue = [(start_entity_id, [], 0)]  # (entity_id, path, depth)\n        \n        while queue:\n            current_id, path, depth = queue.pop(0)\n            \n            if current_id in visited:\n                continue\n            visited.add(current_id)\n            \n            entity = self.get_entity(current_id)\n            if not entity:\n                continue\n            \n            # Don't include start entity in results\n            if depth > 0:\n                relevance = 1.0 / (depth + 1)  # Closer = more relevant\n                results.append(GraphSearchResult(\n                    entity=entity,\n                    path=path,\n                    distance=depth,\n                    relevance=relevance\n                ))\n            \n            if depth >= max_depth:\n                continue\n            \n            # Get relationships and continue traversal\n            rels = self.get_relationships(current_id)\n            \n            for rel in rels:\n                if relation_types and rel.relation not in relation_types:\n                    continue\n                \n                # Determine next entity\n                next_id = rel.target_id if rel.source_id == current_id else rel.source_id\n                \n                if next_id not in visited:\n                    next_entity = self.get_entity(next_id)\n                    if next_entity:\n                        new_path = path + [(next_entity, rel.relation)]\n                        queue.append((next_id, new_path, depth + 1))\n        \n        # Sort by relevance\n        results.sort(key=lambda x: x.relevance, reverse=True)\n        return results\n    \n    def find_path(\n        self,\n        source_id: str,\n        target_id: str,\n        max_depth: int = 4\n    ) -> Optional[List[Tuple[Entity, RelationType]]]:\n        \"\"\"Find shortest path between two entities.\"\"\"\n        if source_id == target_id:\n            return []\n        \n        visited = set()\n        queue = [(source_id, [])]\n        \n        while queue:\n            current_id, path = queue.pop(0)\n            \n            if current_id in visited:\n                continue\n            visited.add(current_id)\n            \n            if len(path) >= max_depth:\n                continue\n            \n            rels = self.get_relationships(current_id)\n            \n            for rel in rels:\n                next_id = rel.target_id if rel.source_id == current_id else rel.source_id\n                next_entity = self.get_entity(next_id)\n                \n                if not next_entity:\n                    continue\n                \n                new_path = path + [(next_entity, rel.relation)]\n                \n                if next_id == target_id:\n                    return new_path\n                \n                if next_id not in visited:\n                    queue.append((next_id, new_path))\n        \n        return None  # No path found\n    \n    def get_stats(self) -> Dict[str, Any]:\n        \"\"\"Get graph statistics.\"\"\"\n        conn = self._get_conn()\n        \n        entity_count = conn.execute(\"SELECT COUNT(*) FROM entities\").fetchone()[0]\n        rel_count = conn.execute(\"SELECT COUNT(*) FROM relationships\").fetchone()[0]\n        \n        type_counts = {}\n        for row in conn.execute(\"SELECT type, COUNT(*) as cnt FROM entities GROUP BY type\"):\n            type_counts[row[\"type\"]] = row[\"cnt\"]\n        \n        rel_type_counts = {}\n        for row in conn.execute(\"SELECT relation, COUNT(*) as cnt FROM relationships GROUP BY relation\"):\n            rel_type_counts[row[\"relation\"]] = row[\"cnt\"]\n        \n        return {\n            \"entities\": entity_count,\n            \"relationships\": rel_count,\n            \"entity_types\": type_counts,\n            \"relationship_types\": rel_type_counts\n        }\n    \n    def close(self):\n        \"\"\"Close database connection.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n\n\nclass GraphBuilder:\n    \"\"\"\n    Builds knowledge graph from veteran interviews.\n    \n    Extracts entities and relationships from:\n    - Veteran metadata (name, unit, rank)\n    - Extracted response data (people, places, topics)\n    - Timeline events\n    - Co-occurrence analysis\n    \"\"\"\n    \n    def __init__(self, graph: EntityGraph):\n        self.graph = graph\n        self._entity_cache: Dict[str, Entity] = {}\n    \n    def _normalize_id(self, name: str, entity_type: EntityType) -> str:\n        \"\"\"Create normalized ID from name and type.\"\"\"\n        import re\n        normalized = re.sub(r'[^a-z0-9]+', '_', name.lower()).strip('_')\n        return f\"{entity_type.value}:{normalized}\"\n    \n    def _get_or_create_entity(\n        self,\n        name: str,\n        entity_type: EntityType,\n        veteran_id: str,\n        response_id: Optional[str] = None\n    ) -> Entity:\n        \"\"\"Get existing entity or create new one.\"\"\"\n        entity_id = self._normalize_id(name, entity_type)\n        \n        if entity_id in self._entity_cache:\n            entity = self._entity_cache[entity_id]\n            entity.source_veteran_ids.add(veteran_id)\n            if response_id:\n                entity.source_response_ids.add(response_id)\n            return entity\n        \n        # Check database\n        existing = self.graph.get_entity(entity_id)\n        if existing:\n            existing.source_veteran_ids.add(veteran_id)\n            if response_id:\n                existing.source_response_ids.add(response_id)\n            self._entity_cache[entity_id] = existing\n            return existing\n        \n        # Create new\n        entity = Entity(\n            id=entity_id,\n            name=name,\n            type=entity_type,\n            source_veteran_ids={veteran_id},\n            source_response_ids={response_id} if response_id else set()\n        )\n        self._entity_cache[entity_id] = entity\n        return entity\n    \n    def index_veteran(self, veteran: Veteran):\n        \"\"\"\n        Extract entities and relationships from a veteran's interview.\n        \"\"\"\n        # Create veteran entity (as a person)\n        vet_entity = self._get_or_create_entity(\n            veteran.name,\n            EntityType.PERSON,\n            veteran.id\n        )\n        vet_entity.attributes[\"is_veteran\"] = True\n        vet_entity.attributes[\"rank\"] = veteran.rank\n        \n        # Create unit entity if present\n        if veteran.unit:\n            unit_entity = self._get_or_create_entity(\n                veteran.unit,\n                EntityType.UNIT,\n                veteran.id\n            )\n            \n            # Relationship: veteran -> member_of -> unit\n            self.graph.add_relationship(Relationship(\n                source_id=vet_entity.id,\n                target_id=unit_entity.id,\n                relation=RelationType.MEMBER_OF,\n                weight=2.0,  # Strong relationship\n                source_veteran_id=veteran.id\n            ))\n        \n        # Process relationships from veteran metadata\n        if veteran.relationships:\n            for rel in veteran.relationships:\n                person_entity = self._get_or_create_entity(\n                    rel.name,\n                    EntityType.PERSON,\n                    veteran.id\n                )\n                if rel.rank:\n                    person_entity.attributes[\"rank\"] = rel.rank\n                if rel.unit:\n                    person_entity.attributes[\"unit\"] = rel.unit\n                \n                # Add relationship\n                self.graph.add_relationship(Relationship(\n                    source_id=vet_entity.id,\n                    target_id=person_entity.id,\n                    relation=RelationType.SERVED_WITH,\n                    weight=1.5,\n                    source_veteran_id=veteran.id,\n                    context=rel.relationship\n                ))\n        \n        # Process timeline for places and events\n        if veteran.timeline:\n            for event in veteran.timeline:\n                # Create event entity\n                event_entity = self._get_or_create_entity(\n                    event.event[:50],  # Truncate for ID\n                    EntityType.EVENT,\n                    veteran.id\n                )\n                event_entity.attributes[\"date\"] = event.date\n                event_entity.attributes[\"full_description\"] = event.event\n                \n                # Veteran participated in event\n                self.graph.add_relationship(Relationship(\n                    source_id=vet_entity.id,\n                    target_id=event_entity.id,\n                    relation=RelationType.PARTICIPATED_IN,\n                    source_veteran_id=veteran.id\n                ))\n                \n                # Create date entity if we have a date\n                if event.date:\n                    date_entity = self._get_or_create_entity(\n                        event.date,\n                        EntityType.DATE,\n                        veteran.id\n                    )\n                    self.graph.add_relationship(Relationship(\n                        source_id=event_entity.id,\n                        target_id=date_entity.id,\n                        relation=RelationType.OCCURRED_DURING,\n                        source_veteran_id=veteran.id\n                    ))\n        \n        # Process individual responses for co-occurring entities\n        for response in veteran.responses:\n            if not response.extracted:\n                continue\n            \n            # Get entities mentioned in this response\n            response_entities = []\n            \n            # People\n            for name in response.extracted.people:\n                entity = self._get_or_create_entity(\n                    name,\n                    EntityType.PERSON,\n                    veteran.id,\n                    response.id\n                )\n                response_entities.append(entity)\n            \n            # Places\n            for place in response.extracted.places:\n                entity = self._get_or_create_entity(\n                    place,\n                    EntityType.PLACE,\n                    veteran.id,\n                    response.id\n                )\n                response_entities.append(entity)\n            \n            # Create co-occurrence relationships (mentioned together)\n            for i, entity1 in enumerate(response_entities):\n                for entity2 in response_entities[i+1:]:\n                    if entity1.id != entity2.id:\n                        self.graph.add_relationship(Relationship(\n                            source_id=entity1.id,\n                            target_id=entity2.id,\n                            relation=RelationType.MENTIONED_WITH,\n                            weight=0.5,  # Weaker than explicit relationships\n                            source_veteran_id=veteran.id,\n                            source_response_id=response.id\n                        ))\n        \n        # Save all entities\n        for entity in self._entity_cache.values():\n            self.graph.add_entity(entity)\n    \n    def build_from_veterans(self, veterans: List[Veteran]):\n        \"\"\"Build graph from multiple veterans.\"\"\"\n        for veteran in veterans:\n            self.index_veteran(veteran)\n","file_path":"/Users/happyhawking/Documents/Projects/Current/writer/src/graph.py"}},"jsonrpc":"2.0","id":100} { metadata: undefined }
