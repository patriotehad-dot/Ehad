2025-12-20T16:52:08.182Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":8,"result":{"content":[{"type":"text","text":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/json_parser.py\",\"content\":\"\\\"\\\"\\\"\\nJSON Transcript Parser for the Oral History Research System.\\n\\nParses turn-based JSON transcripts (from speech-to-text services) into \\nQ&A responses. This is the \\\"new format\\\" that preserves speaker attribution\\nat the turn level.\\n\\nJSON Format Expected:\\n[\\n  {\\\"speaker\\\": \\\"Interviewer 2\\\", \\\"text\\\": \\\"Where were you born?\\\"},\\n  {\\\"speaker\\\": \\\"Levere Watson\\\", \\\"text\\\": \\\"I was born at Foreston, Illinois...\\\"},\\n  ...\\n]\\n\\\"\\\"\\\"\\n\\nimport json\\nimport re\\nfrom typing import List, Tuple, Optional, Dict, Any\\nfrom pathlib import Path\\nfrom dataclasses import dataclass, field\\n\\nfrom .models import Response, Paragraph\\n\\n\\n@dataclass\\nclass Turn:\\n    \\\"\\\"\\\"A single turn in the conversation.\\\"\\\"\\\"\\n    speaker: str\\n    text: str\\n    index: int  # Position in original transcript\\n\\n\\n@dataclass \\nclass ParsedQAPair:\\n    \\\"\\\"\\\"A question-answer pair extracted from turns.\\\"\\\"\\\"\\n    interviewer_text: str\\n    veteran_text: str\\n    veteran_name: str\\n    turn_indices: List[int] = field(default_factory=list)  # Which turns this came from\\n\\n\\nclass JSONTranscriptParser:\\n    \\\"\\\"\\\"\\n    Parses JSON transcripts with speaker attribution into Q&A responses.\\n    \\n    Key insight from the expert: \\\"Question + Answer = atomic unit of history\\\"\\n    \\n    This parser:\\n    1. Identifies interviewer vs veteran by speaker name\\n    2. Groups consecutive veteran turns into single answers\\n    3. Pairs interviewer questions with veteran answers\\n    4. Preserves turn indices for context windowing\\n    \\\"\\\"\\\"\\n    \\n    # Common interviewer speaker patterns\\n    INTERVIEWER_PATTERNS = [\\n        r\\\"^interviewer\\\",\\n        r\\\"^int\\\\s*\\\\d*$\\\",\\n        r\\\"^q\\\\s*$\\\",\\n        r\\\"^host\\\",\\n        r\\\"^moderator\\\",\\n    ]\\n    \\n    def __init__(self, min_paragraph_length: int = 50):\\n        \\\"\\\"\\\"\\n        Initialize parser.\\n        \\n        Args:\\n            min_paragraph_length: Minimum characters for a paragraph chunk\\n        \\\"\\\"\\\"\\n        self.min_paragraph_length = min_paragraph_length\\n        self._interviewer_patterns = [\\n            re.compile(p, re.IGNORECASE) for p in self.INTERVIEWER_PATTERNS\\n        ]\\n    \\n    def _is_interviewer(self, speaker: str) -> bool:\\n        \\\"\\\"\\\"\\n        Determine if a speaker is the interviewer.\\n        \\n        Args:\\n            speaker: Speaker name from JSON\\n            \\n        Returns:\\n            True if this is likely the interviewer\\n        \\\"\\\"\\\"\\n        speaker_lower = speaker.lower().strip()\\n        \\n        for pattern in self._interviewer_patterns:\\n            if pattern.match(speaker_lower):\\n                return True\\n        \\n        return False\\n    \\n    def _detect_speakers(self, turns: List[Turn]) -> Tuple[str, str]:\\n        \\\"\\\"\\\"\\n        Detect interviewer and veteran names from turns.\\n        \\n        Strategy:\\n        1. Find speakers matching interviewer patterns \\u2192 interviewer\\n        2. The other speaker(s) \\u2192 veteran (pick most frequent if multiple)\\n        \\n        Args:\\n            turns: List of conversation turns\\n            \\n        Returns:\\n            Tuple of (interviewer_name, veteran_name)\\n        \\\"\\\"\\\"\\n        speaker_counts: Dict[str, int] = {}\\n        interviewer_candidates = set()\\n        \\n        for turn in turns:\\n            speaker = turn.speaker.strip()\\n            speaker_counts[speaker] = speaker_counts.get(speaker, 0) + 1\\n            \\n            if self._is_interviewer(speaker):\\n                interviewer_candidates.add(speaker)\\n        \\n        # Determine interviewer\\n        if interviewer_candidates:\\n            # Pick the most frequent interviewer if multiple\\n            interviewer_name = max(\\n                interviewer_candidates, \\n                key=lambda s: speaker_counts.get(s, 0)\\n            )\\n        else:\\n            # No clear interviewer pattern - assume the less frequent speaker\\n            # is the interviewer (they ask short questions)\\n            sorted_speakers = sorted(speaker_counts.items(), key=lambda x: x[1])\\n            if len(sorted_speakers) >= 2:\\n                interviewer_name = sorted_speakers[0][0]\\n            else:\\n                interviewer_name = \\\"Interviewer\\\"\\n        \\n        # Determine veteran - the most frequent non-interviewer\\n        veteran_candidates = [\\n            (name, count) for name, count in speaker_counts.items()\\n            if name != interviewer_name\\n        ]\\n        \\n        if veteran_candidates:\\n            veteran_name = max(veteran_candidates, key=lambda x: x[1])[0]\\n        else:\\n            veteran_name = \\\"Veteran\\\"\\n        \\n        return interviewer_name, veteran_name\\n    \\n    def parse_json(self, json_data: List[Dict[str, Any]]) -> List[ParsedQAPair]:\\n        \\\"\\\"\\\"\\n        Parse JSON transcript data into Q&A pairs.\\n        \\n        Args:\\n            json_data: List of {\\\"speaker\\\": \\\"...\\\", \\\"text\\\": \\\"...\\\"} dicts\\n            \\n        Returns:\\n            List of ParsedQAPair objects\\n        \\\"\\\"\\\"\\n        # Convert to Turn objects\\n        turns = []\\n        for i, item in enumerate(json_data):\\n            speaker = item.get(\\\"speaker\\\", \\\"Unknown\\\")\\n            text = item.get(\\\"text\\\", \\\"\\\").strip()\\n            if text:  # Skip empty turns\\n                turns.append(Turn(speaker=speaker, text=text, index=i))\\n        \\n        if not turns:\\n            return []\\n        \\n        # Detect speakers\\n        interviewer_name, veteran_name = self._detect_speakers(turns)\\n        \\n        # Group turns into Q&A pairs\\n        pairs = []\\n        current_interviewer_text = []\\n        current_interviewer_indices = []\\n        current_veteran_text = []\\n        current_veteran_indices = []\\n        \\n        for turn in turns:\\n            is_interviewer = (turn.speaker == interviewer_name)\\n            \\n            if is_interviewer:\\n                # If we have accumulated veteran text, save the previous Q&A pair\\n                if current_veteran_text:\\n                    pairs.append(ParsedQAPair(\\n                        interviewer_text=\\\" \\\".join(current_interviewer_text),\\n                        veteran_text=\\\" \\\".join(current_veteran_text),\\n                        veteran_name=veteran_name,\\n                        turn_indices=current_interviewer_indices + current_veteran_indices\\n                    ))\\n                    current_veteran_text = []\\n                    current_veteran_indices = []\\n                    current_interviewer_text = []\\n                    current_interviewer_indices = []\\n                \\n                # Accumulate interviewer text (might be multiple turns)\\n                current_interviewer_text.append(turn.text)\\n                current_interviewer_indices.append(turn.index)\\n            else:\\n                # Veteran turn - accumulate\\n                current_veteran_text.append(turn.text)\\n                current_veteran_indices.append(turn.index)\\n        \\n        # Don't forget the last pair\\n        if current_veteran_text:\\n            pairs.append(ParsedQAPair(\\n                interviewer_text=\\\" \\\".join(current_interviewer_text) if current_interviewer_text else \\\"[No question recorded]\\\",\\n                veteran_text=\\\" \\\".join(current_veteran_text),\\n                veteran_name=veteran_name,\\n                turn_indices=current_interviewer_indices + current_veteran_indices\\n            ))\\n        \\n        return pairs\\n    \\n    def split_into_paragraphs(self, text: str) -> List[str]:\\n        \\\"\\\"\\\"\\n        Split text into paragraphs for embedding.\\n        \\n        Uses sentence boundaries and minimum length requirements.\\n        \\n        Args:\\n            text: Text to split\\n            \\n        Returns:\\n            List of paragraph strings\\n        \\\"\\\"\\\"\\n        # First try splitting on double newlines\\n        parts = re.split(r\\\"\\\\n\\\\s*\\\\n\\\", text)\\n        \\n        paragraphs = []\\n        current = \\\"\\\"\\n        \\n        for part in parts:\\n            part = part.strip()\\n            if not part:\\n                continue\\n            \\n            # If part is too short, merge with current\\n            if len(part) < self.min_paragraph_length and current:\\n                current += \\\" \\\" + part\\n            elif len(current) < self.min_paragraph_length and current:\\n                current += \\\" \\\" + part\\n            else:\\n                if current:\\n                    paragraphs.append(current)\\n                current = part\\n        \\n        if current:\\n            paragraphs.append(current)\\n        \\n        # If no paragraphs from splitting, just return the whole text\\n        if not paragraphs and text.strip():\\n            paragraphs = [text.strip()]\\n        \\n        return paragraphs\\n    \\n    def create_responses(\\n        self, \\n        pairs: List[ParsedQAPair],\\n        id_prefix: str = \\\"\\\"\\n    ) -> List[Response]:\\n        \\\"\\\"\\\"\\n        Convert parsed Q&A pairs to Response objects with paragraphs.\\n        \\n        Args:\\n            pairs: List of parsed Q&A pairs\\n            id_prefix: Optional prefix for response IDs\\n            \\n        Returns:\\n            List of Response objects\\n        \\\"\\\"\\\"\\n        responses = []\\n        \\n        for i, pair in enumerate(pairs):\\n            response_id = f\\\"{id_prefix}{str(i + 1).zfill(3)}\\\"\\n            \\n            # Split veteran's answer into paragraphs\\n            paragraph_texts = self.split_into_paragraphs(pair.veteran_text)\\n            paragraphs = []\\n            \\n            for j, para_text in enumerate(paragraph_texts):\\n                para_id = f\\\"{response_id}_p{j + 1}\\\"\\n                paragraphs.append(Paragraph(id=para_id, text=para_text))\\n            \\n            responses.append(Response(\\n                id=response_id,\\n                interviewer=pair.interviewer_text,\\n                veteran=pair.veteran_text,\\n                paragraphs=paragraphs\\n            ))\\n        \\n        return responses\\n\\n\\ndef parse_json_transcript_file(\\n    file_path: Path,\\n    min_paragraph_length: int = 50\\n) -> Tuple[List[Response], str]:\\n    \\\"\\\"\\\"\\n    Parse a JSON transcript file into responses.\\n    \\n    Args:\\n        file_path: Path to JSON transcript file\\n        min_paragraph_length: Minimum paragraph length\\n        \\n    Returns:\\n        Tuple of (List of Response objects, detected veteran name)\\n    \\\"\\\"\\\"\\n    with open(file_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n        json_data = json.load(f)\\n    \\n    parser = JSONTranscriptParser(min_paragraph_length=min_paragraph_length)\\n    pairs = parser.parse_json(json_data)\\n    \\n    # Extract veteran name from first pair (they're all the same)\\n    veteran_name = pairs[0].veteran_name if pairs else \\\"Unknown Veteran\\\"\\n    \\n    responses = parser.create_responses(pairs)\\n    \\n    return responses, veteran_name\\n\\n\\ndef extract_veteran_info_from_filename(filename: str) -> Dict[str, str]:\\n    \\\"\\\"\\\"\\n    Extract veteran info from JSON filename.\\n    \\n    Expected format: \\