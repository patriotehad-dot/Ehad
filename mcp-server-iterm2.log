2025-12-18T11:20:23.276Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"file_path":"~/Documents/Projects/Current/writer/src/export.py","content":"\"\"\"\nExport functionality for the Oral History Research System.\n\nGenerates markdown exports for chapters, veterans, and search results.\n\"\"\"\n\nfrom pathlib import Path\nfrom typing import List, Optional, Dict\nfrom datetime import datetime\n\nfrom .models import (\n    Veteran, Response, SearchResults, VeteranAnnotations,\n    ResponseAnnotation, WritingPotential\n)\nfrom .config import ProjectContext\nfrom .storage import VeteranStorage, AnnotationStorage\n\n\ndef format_response_md(\n    response: Response,\n    annotation: Optional[ResponseAnnotation] = None,\n    include_extraction: bool = True\n) -> str:\n    \"\"\"\n    Format a response as markdown.\n    \n    Args:\n        response: Response to format\n        annotation: Optional annotations\n        include_extraction: Whether to include extracted metadata\n        \n    Returns:\n        Markdown string\n    \"\"\"\n    lines = []\n    \n    # Header with ID and writing potential\n    header = f\"### [{response.id}]\"\n    if response.extracted:\n        header += f\" {response.extracted.summary}\"\n        if response.extracted.writing_potential == WritingPotential.HIGH:\n            header += \" ★\"\n    lines.append(header)\n    lines.append(\"\")\n    \n    # Metadata\n    if response.extracted and include_extraction:\n        if response.extracted.writing_potential in [WritingPotential.HIGH, WritingPotential.MEDIUM]:\n            lines.append(f\"**Writing potential:** {response.extracted.writing_potential.value.upper()}\")\n        if response.extracted.writing_note:\n            lines.append(f\"**LLM note:** {response.extracted.writing_note}\")\n    \n    # Annotations\n    if annotation:\n        if annotation.notes:\n            lines.append(\"**Your notes:**\")\n            for note in annotation.notes:\n                lines.append(f\"- {note.text}\")\n        if annotation.flags:\n            lines.append(f\"**Flags:** {', '.join(annotation.flags)}\")\n    \n    if lines[-1] != \"\":\n        lines.append(\"\")\n    \n    # Question\n    lines.append(f\"**Q:** {response.interviewer}\")\n    lines.append(\"\")\n    \n    # Answer (as blockquote)\n    veteran_lines = response.veteran.split(\"\\n\")\n    for line in veteran_lines:\n        lines.append(f\"> {line}\")\n    lines.append(\"\")\n    \n    # Extracted metadata\n    if response.extracted and include_extraction:\n        extracted = response.extracted\n        meta_parts = []\n        \n        if extracted.topics:\n            meta_parts.append(f\"Topics: {', '.join(extracted.topics)}\")\n        if extracted.dates:\n            date_strs = [f\"{d.value} ({d.context})\" for d in extracted.dates]\n            meta_parts.append(f\"Dates: {'; '.join(date_strs)}\")\n        if extracted.locations:\n            meta_parts.append(f\"Locations: {', '.join(extracted.locations)}\")\n        if extracted.people:\n            people_strs = [p.name for p in extracted.people]\n            meta_parts.append(f\"People: {', '.join(people_strs)}\")\n        \n        if meta_parts:\n            lines.append(\"**Extracted:**\")\n            for part in meta_parts:\n                lines.append(f\"- {part}\")\n            lines.append(\"\")\n    \n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    return \"\\n\".join(lines)\n\n\ndef export_veteran(\n    veteran: Veteran,\n    annotations: VeteranAnnotations,\n    output_path: Path\n) -> Path:\n    \"\"\"\n    Export a veteran's complete material.\n    \n    Args:\n        veteran: Veteran to export\n        annotations: Veteran's annotations\n        output_path: Where to save\n        \n    Returns:\n        Path to exported file\n    \"\"\"\n    lines = []\n    \n    # Header\n    lines.append(f\"# {veteran.name} - Complete Research Material\")\n    lines.append(\"\")\n    lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-NaN')}\")\n    if veteran.source:\n        lines.append(f\"> Source: {veteran.source.file}\")\n        if veteran.source.date_recorded:\n            lines.append(f\"> Recorded: {veteran.source.date_recorded}\")\n        if veteran.source.location:\n            lines.append(f\"> Location: {veteran.source.location}\")\n    lines.append(\"\")\n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    # Profile\n    lines.append(\"## Profile\")\n    lines.append(\"\")\n    if veteran.unit:\n        lines.append(f\"- **Unit:** {veteran.unit}\")\n    if veteran.rank:\n        lines.append(f\"- **Rank:** {veteran.rank}\")\n    if veteran.service_dates:\n        dates = []\n        if veteran.service_dates.start:\n            dates.append(veteran.service_dates.start)\n        if veteran.service_dates.end:\n            dates.append(veteran.service_dates.end)\n        if dates:\n            lines.append(f\"- **Service:** {' - '.join(dates)}\")\n    lines.append(\"\")\n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    # Timeline\n    if veteran.timeline:\n        lines.append(\"## Timeline\")\n        lines.append(\"\")\n        lines.append(\"| Date | Event | Confidence | Response |\")\n        lines.append(\"|------|-------|------------|----------|\")\n        \n        for event in veteran.timeline:\n            date_str = event.date\n            if event.date_precision.value == \"approximate\":\n                date_str = f\"{date_str} (~)\"\n            \n            conf = event.confidence.value\n            if event.note:\n                conf += \" ⚠\"\n            \n            resp_ids = \", \".join([f\"[{r}]\" for r in event.response_ids])\n            \n            lines.append(f\"| {date_str} | {event.event} | {conf} | {resp_ids} |\")\n        \n        lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n    \n    # Relationships\n    if veteran.relationships:\n        lines.append(\"## Relationships\")\n        lines.append(\"\")\n        \n        for rel in veteran.relationships:\n            lines.append(f\"### {rel.canonical}\")\n            if rel.role:\n                lines.append(f\"- **Role:** {rel.role}\")\n            if len(rel.names) > 1:\n                lines.append(f\"- **Also known as:** {', '.join(n for n in rel.names if n != rel.canonical)}\")\n            if rel.context:\n                lines.append(f\"- **Context:** {rel.context}\")\n            lines.append(f\"- **Responses:** {', '.join([f'[{r}]' for r in rel.response_ids])}\")\n            lines.append(\"\")\n        \n        lines.append(\"---\")\n        lines.append(\"\")\n    \n    # Notable Stories\n    if veteran.notable_stories:\n        lines.append(\"## Notable Stories\")\n        lines.append(\"\")\n        \n        for story in veteran.notable_stories:\n            lines.append(f\"### ★ {story.title}\")\n            lines.append(f\"**Response:** {', '.join([f'[{r}]' for r in story.response_ids])}\")\n            if story.writing_note:\n                lines.append(f\"**Writing note:** {story.writing_note}\")\n            lines.append(\"\")\n            lines.append(f\"> {story.summary}\")\n            lines.append(\"\")\n        \n        lines.append(\"---\")\n        lines.append(\"\")\n    \n    # Verification Needed\n    if veteran.verification_needed:\n        lines.append(\"## Verification Needed\")\n        lines.append(\"\")\n        \n        for item in veteran.verification_needed:\n            lines.append(f\"- **{item.issue}:** {item.detail}\")\n            if item.response_ids:\n                lines.append(f\"  - Responses: {', '.join([f'[{r}]' for r in item.response_ids])}\")\n        \n        lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n    \n    # All Responses\n    lines.append(\"## All Responses\")\n    lines.append(\"\")\n    \n    for response in veteran.responses:\n        resp_annot = annotations.response_annotations.get(response.id)\n        lines.append(format_response_md(response, resp_annot))\n    \n    # Write file\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n    with open(output_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(lines))\n    \n    return output_path\n\n\ndef export_chapter(\n    chapter: int,\n    veterans: Dict[str, Veteran],\n    annotations: Dict[str, VeteranAnnotations],\n    response_ids: Dict[str, List[str]],\n    output_path: Path\n) -> Path:\n    \"\"\"\n    Export a chapter's material.\n    \n    Args:\n        chapter: Chapter number\n        veterans: Dict of veteran_id -> Veteran\n        annotations: Dict of veteran_id -> annotations\n        response_ids: Dict of veteran_id -> list of response_ids for this chapter\n        output_path: Where to save\n        \n    Returns:\n        Path to exported file\n    \"\"\"\n    lines = []\n    \n    # Header\n    total_responses = sum(len(rids) for rids in response_ids.values())\n    lines.append(f\"# Chapter {chapter} - Research Material\")\n    lines.append(\"\")\n    lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-%d')}\")\n    lines.append(f\"> Responses: {total_responses} from {len(veterans)} veterans\")\n    lines.append(\"\")\n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    # Each veteran's contributions\n    for veteran_id, resp_ids in response_ids.items():\n        veteran = veterans.get(veteran_id)\n        annots = annotations.get(veteran_id)\n        \n        if not veteran:\n            continue\n        \n        lines.append(f\"## {veteran.name}\")\n        if veteran.unit or veteran.rank:\n            parts = []\n            if veteran.unit:\n                parts.append(veteran.unit)\n            if veteran.rank:\n                parts.append(veteran.rank)\n            lines.append(f\"**{' | '.join(parts)}**\")\n        lines.append(\"\")\n        \n        # Find and format each response\n        for resp_id in resp_ids:\n            response = None\n            for r in veteran.responses:\n                if r.id == resp_id:\n                    response = r\n                    break\n            \n            if response:\n                resp_annot = None\n                if annots:\n                    resp_annot = annots.response_annotations.get(resp_id)\n                \n                lines.append(format_response_md(response, resp_annot))\n        \n        lines.append(\"\")\n    \n    # Write file\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n    with open(output_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(lines))\n    \n    return output_path\n\n\ndef export_search_results(\n    results: SearchResults,\n    output_path: Path\n) -> Path:\n    \"\"\"\n    Export search results.\n    \n    Args:\n        results: Search results\n        output_path: Where to save\n        \n    Returns:\n        Path to exported file\n    \"\"\"\n    lines = []\n    \n    # Header\n    lines.append(f\"# Search Results: \\\"{results.query}\\\"\")\n    lines.append(\"\")\n    lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-%d')}\")\n    lines.append(f\"> Results: {results.total_hits} from {results.veteran_count} veterans\")\n    lines.append(\"\")\n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    # Group by veteran\n    veterans_hits: Dict[str, List] = {}\n    for hit in results.hits:\n        if hit.veteran_id not in veterans_hits:\n            veterans_hits[hit.veteran_id] = []\n        veterans_hits[hit.veteran_id].append(hit)\n    \n    # Format each veteran's hits\n    for veteran_id, hits in veterans_hits.items():\n        first_hit = hits[0]\n        \n        lines.append(f\"## {first_hit.veteran_name}\")\n        parts = []\n        if first_hit.unit:\n            parts.append(first_hit.unit)\n        if first_hit.rank:\n            parts.append(first_hit.rank)\n        if parts:\n            lines.append(f\"**{' | '.join(parts)}**\")\n        lines.append(\"\")\n        \n        for hit in hits:\n            annotation = None\n            if hit.notes or hit.flags or hit.chapter:\n                annotation = ResponseAnnotation(\n                    chapter=hit.chapter,\n                    notes=hit.notes,\n                    flags=hit.flags\n                )\n            \n            lines.append(format_response_md(hit.response, annotation))\n        \n        lines.append(\"\")\n    \n    # Write file\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n    with open(output_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(lines))\n    \n    return output_path\n\n\ndef export_timeline(\n    veterans: List[Veteran],\n    output_path: Path,\n    start_date: Optional[str] = None,\n    end_date: Optional[str] = None\n) -> Path:\n    \"\"\"\n    Export combined timeline across all veterans.\n    \n    Args:\n        veterans: List of veterans\n        output_path: Where to save\n        start_date: Optional start date filter\n        end_date: Optional end date filter\n        \n    Returns:\n        Path to exported file\n    \"\"\"\n    lines = []\n    \n    # Header\n    lines.append(\"# Combined Timeline\")\n    lines.append(\"\")\n    lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-%d')}\")\n    lines.append(f\"> Veterans: {len(veterans)}\")\n    if start_date or end_date:\n        date_range = f\"{start_date or 'start'} to {end_date or 'end'}\"\n        lines.append(f\"> Date range: {date_range}\")\n    lines.append(\"\")\n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    # Collect all events\n    all_events = []\n    for veteran in veterans:\n        for event in veteran.timeline:\n            all_events.append({\n                \"date\": event.date,\n                \"event\": event.event,\n                \"veteran\": veteran.name,\n                \"veteran_id\": veteran.id,\n                \"confidence\": event.confidence.value,\n                \"note\": event.note,\n                \"response_ids\": event.response_ids,\n            })\n    \n    # Sort by date (simple string sort works for ISO dates)\n    all_events.sort(key=lambda x: x[\"date\"])\n    \n    # Filter by date range if specified\n    if start_date:\n        all_events = [e for e in all_events if e[\"date\"] >= start_date]\n    if end_date:\n        all_events = [e for e in all_events if e[\"date\"] <= end_date]\n    \n    # Format as table\n    lines.append(\"| Date | Veteran | Event | Confidence | Notes |\")\n    lines.append(\"|------|---------|-------|------------|-------|\")\n    \n    for event in all_events:\n        note = event[\"note\"] or \"\"\n        lines.append(\n            f\"| {event['date']} | {event['veteran']} | {event['event']} | \"\n            f\"{event['confidence']} | {note} |\"\n        )\n    \n    lines.append(\"\")\n    \n    # Write file\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n    with open(output_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(lines))\n    \n    return output_path\n\n\ndef export_stories(\n    veterans: List[Veteran],\n    output_path: Path\n) -> Path:\n    \"\"\"\n    Export all notable stories across veterans.\n    \n    Args:\n        veterans: List of veterans\n        output_path: Where to save\n        \n    Returns:\n        Path to exported file\n    \"\"\"\n    lines = []\n    \n    # Header\n    lines.append(\"# Notable Stories\")\n    lines.append(\"\")\n    lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-%d')}\")\n    \n    total_stories = sum(len(v.notable_stories) for v in veterans)\n    lines.append(f\"> Total: {total_stories} stories from {len(veterans)} veterans\")\n    lines.append(\"\")\n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    # Group by veteran\n    for veteran in veterans:\n        if not veteran.notable_stories:\n            continue\n        \n        lines.append(f\"## {veteran.name}\")\n        if veteran.unit:\n            lines.append(f\"*{veteran.unit}*\")\n        lines.append(\"\")\n        \n        for story in veteran.notable_stories:\n            lines.append(f\"### ★ {story.title}\")\n            lines.append(f\"**Responses:** {', '.join([f'[{r}]' for r in story.response_ids])}\")\n            lines.append(f\"**Potential:** {story.writing_potential.value.upper()}\")\n            if story.writing_note:\n                lines.append(f\"**Note:** {story.writing_note}\")\n            lines.append(\"\")\n            lines.append(f\"> {story.summary}\")\n            lines.append(\"\")\n        \n        lines.append(\"---\")\n        lines.append(\"\")\n    \n    # Write file\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n    with open(output_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(lines))\n    \n    return output_path\n\n\nclass Exporter:\n    \"\"\"High-level exporter that uses project context.\"\"\"\n    \n    def __init__(self, ctx: ProjectContext):\n        \"\"\"\n        Initialize exporter.\n        \n        Args:\n            ctx: Project context\n        \"\"\"\n        self.ctx = ctx\n        self.veteran_storage = VeteranStorage(ctx)\n        self.annotation_storage = AnnotationStorage(ctx)\n    \n    def export_veteran(self, veteran_id: str, filename: Optional[str] = None) -> Path:\n        \"\"\"Export a veteran's material.\"\"\"\n        veteran = self.veteran_storage.load(veteran_id)\n        if not veteran:\n            raise ValueError(f\"Veteran not found: {veteran_id}\")\n        \n        annotations = self.annotation_storage.load(veteran_id)\n        \n        if filename is None:\n            filename = f\"veteran_{veteran_id}.md\"\n        \n        output_path = self.ctx.exports_dir / filename\n        return export_veteran(veteran, annotations, output_path)\n    \n    def export_chapter(self, chapter: int, filename: Optional[str] = None) -> Path:\n        \"\"\"Export a chapter's material.\"\"\"\n        # Get all responses for this chapter\n        chapter_responses = self.annotation_storage.get_chapter_responses(chapter)\n        \n        if not chapter_responses:\n            raise ValueError(f\"No responses assigned to chapter {chapter}\")\n        \n        # Load veterans and annotations\n        veterans = {}\n        annotations = {}\n        \n        for veteran_id in chapter_responses.keys():\n            veteran = self.veteran_storage.load(veteran_id)\n            if veteran:\n                veterans[veteran_id] = veteran\n                annotations[veteran_id] = self.annotation_storage.load(veteran_id)\n        \n        if filename is None:\n            filename = f\"chapter_{str(chapter).zfill(2)}.md\"\n        \n        output_path = self.ctx.exports_dir / filename\n        return export_chapter(chapter, veterans, annotations, chapter_responses, output_path)\n    \n    def export_search_results(\n        self, \n        results: SearchResults, \n        filename: Optional[str] = None\n    ) -> Path:\n        \"\"\"Export search results.\"\"\"\n        if filename is None:\n            # Create filename from query\n            safe_query = results.query.replace(\" \", \"_\")[:30]\n            filename = f\"search_{safe_query}.md\"\n        \n        output_path = self.ctx.exports_dir / filename\n        return export_search_results(results, output_path)\n    \n    def export_timeline(\n        self,\n        start_date: Optional[str] = None,\n        end_date: Optional[str] = None,\n        filename: Optional[str] = None\n    ) -> Path:\n        \"\"\"Export combined timeline.\"\"\"\n        veterans = self.veteran_storage.get_all()\n        \n        if filename is None:\n            filename = \"timeline.md\"\n        \n        output_path = self.ctx.exports_dir / filename\n        return export_timeline(veterans, output_path, sta