. Query Expansion - Generate multiple query variants for broader coverage\\n2. Re-ranking - Cross-encoder scoring for precision\\n3. Self-Reflection - Quality grading with automatic retry\\n\\nThese strategies can be combined in a pipeline for optimal retrieval.\\n\\\"\\\"\\\"\\n\\nimport json\\nfrom typing import List, Optional, Dict, Any, Tuple\\nfrom dataclasses import dataclass\\n\\nfrom .client import LLMClient\\n\\n\\n@dataclass\\nclass QueryExpansion:\\n    \\\"\\\"\\\"Result of query expansion.\\\"\\\"\\\"\\n    original: str\\n    variants: List[str]\\n    \\n\\n@dataclass \\nclass RetrievalGrade:\\n    \\\"\\\"\\\"Result of self-reflection grading.\\\"\\\"\\\"\\n    score: int  # 1-5\\n    reasoning: str\\n    refined_query: Optional[str]  # Suggested refinement if score < 3\\n\\n\\nclass QueryExpander:\\n    \\\"\\\"\\\"\\n    Expands a single query into multiple variants for broader coverage.\\n    \\n    Example:\\n        \\\"Bastogne cold\\\" -> [\\n            \\\"Bastogne cold\\\",\\n            \\\"Bastogne freezing winter December 1944\\\",\\n            \\\"Battle of Bulge weather conditions frozen\\\",\\n            \\\"siege frozen soldiers foxholes snow\\\"\\n        ]\\n    \\\"\\\"\\\"\\n    \\n    EXPANSION_PROMPT = \\\"\\\"\\\"You are helping search a WWII oral history archive of veteran interviews.\\n\\nGiven this search query, generate 3-4 alternative search queries that would help find relevant content.\\n\\nConsider:\\n- Synonyms and related terms\\n- Specific historical details (dates, places, unit names)\\n- Different phrasings of the same concept\\n- Both broad and narrow variants\\n\\nOriginal query: \\\"{query}\\\"\\n\\nReturn a JSON object with a \\\"variants\\\" array of strings. Include the original query as the first variant.\\n\\nExample output:\\n{{\\\"variants\\\": [\\\"Bastogne cold\\\", \\\"Bastogne freezing winter 1944\\\", \\\"Battle of Bulge weather\\\", \\\"frozen foxholes snow\\\"]}}\\n\\nJSON output:\\\"\\\"\\\"\\n\\n    def __init__(self, llm_client: LLMClient):\\n        self.llm = llm_client\\n    \\n    def expand(self, query: str) -> QueryExpansion:\\n        \\\"\\\"\\\"\\n        Expand a query into multiple variants.\\n        \\n        Args:\\n            query: Original search query\\n            \\n        Returns:\\n            QueryExpansion with original and variant queries\\n        \\\"\\\"\\\"\\n        prompt = self.EXPANSION_PROMPT.format(query=query)\\n        \\n        try:\\n            response = self.llm.complete(prompt, max_tokens=300)\\n            \\n            # Parse JSON response\\n            response = response.strip()\\n            if response.startswith(\\\"```\\\"):\\n                response = response.split(\\\"```\\\")[1]\\n                if response.startswith(\\\"json\\\"):\\n                    response = response[4:]\\n            \\n            data = json.loads(response)\\n            variants = data.get(\\\"variants\\\", [query])\\n            \\n            # Ensure original is included\\n            if query not in variants:\\n                variants.insert(0, query)\\n            \\n            return QueryExpansion(original=query, variants=variants[:5])  # Max 5 variants\\n            \\n        except Exception as e:\\n\",\n  \"file_size_bytes\": 16229,\n  \"content_length\": 2982\n}"},"isError":false}} { metadata: undefined }
