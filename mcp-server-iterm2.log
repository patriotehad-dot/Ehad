2025-12-20T16:40:57.774Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":29,"result":{"content":[{"type":"text","text":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/parser.py\",\"content\":\"\\\"\\\"\\\"\\nTranscript parser for the Oral History Research System.\\n\\nParses interview transcripts into Q&A responses.\\nHandles various transcript formats and speaker patterns.\\n\\\"\\\"\\\"\\n\\nimport re\\nfrom typing import List, Tuple, Optional\\nfrom pathlib import Path\\nfrom dataclasses import dataclass\\n\\nfrom .models import Response, Paragraph\\n\\n\\n@dataclass\\nclass ParsedResponse:\\n    \\\"\\\"\\\"A parsed response before full processing.\\\"\\\"\\\"\\n    interviewer: str\\n    veteran: str\\n    raw_index: int  # Original position in transcript\\n\\n\\nclass TranscriptParser:\\n    \\\"\\\"\\\"\\n    Parses interview transcripts into structured Q&A responses.\\n    \\n    Supports various speaker patterns:\\n    - \\\"INTERVIEWER:\\\" / \\\"VETERAN:\\\"\\n    - \\\"Q:\\\" / \\\"A:\\\"\\n    - \\\"Interviewer:\\\" / \\\"[Name]:\\\"\\n    - Speaker names followed by colons (e.g., \\\"Jim Mitchell:\\\")\\n    \\\"\\\"\\\"\\n    \\n    # Common patterns for speaker detection\\n    INTERVIEWER_PATTERNS = [\\n        r\\\"^INTERVIEWER\\\\s*:\\\",\\n        r\\\"^Q\\\\s*:\\\",\\n        r\\\"^Interviewer\\\\s*:\\\",\\n        r\\\"^INT\\\\s*:\\\",\\n        r\\\"^I\\\\s*:\\\",\\n    ]\\n    \\n    VETERAN_PATTERNS = [\\n        r\\\"^VETERAN\\\\s*:\\\",\\n        r\\\"^A\\\\s*:\\\",\\n        r\\\"^(?:Mr\\\\.|Mrs\\\\.|Ms\\\\.|Sgt\\\\.|Sergeant|Captain|Lt\\\\.|Lieutenant|Private|Corporal|Staff Sergeant)\\\\s+\\\\w+\\\\s*:\\\",\\n    ]\\n    \\n    def __init__(self, min_paragraph_length: int = 50):\\n        \\\"\\\"\\\"\\n        Initialize parser.\\n        \\n        Args:\\n            min_paragraph_length: Minimum characters for a paragraph\\n        \\\"\\\"\\\"\\n        self.min_paragraph_length = min_paragraph_length\\n        \\n        # Compiled patterns\\n        self._interviewer_re = [re.compile(p, re.IGNORECASE | re.MULTILINE) for p in self.INTERVIEWER_PATTERNS]\\n        self._veteran_re = [re.compile(p, re.IGNORECASE | re.MULTILINE) for p in self.VETERAN_PATTERNS]\\n    \\n    def _preprocess_single_line(self, text: str) -> str:\\n        \\\"\\\"\\\"\\n        Insert line breaks before speaker patterns in single-line transcripts.\\n        \\n        Handles transcripts that are all on one line by detecting Q&A boundaries\\n        and inserting synthetic line breaks.\\n        \\n        Handles various speaker marker formats:\\n        - `>>` as Q&A delimiter: `>> Was that the Enfield?`\\n        - `-` as speaker change: `- Had you ever fired a rifle before? -`\\n        - Named speakers: `HURST:`, `HALL:`, `Heldreth:`\\n        \\n        Args:\\n            text: Transcript text\\n            \\n        Returns:\\n            Text with line breaks inserted at speaker boundaries\\n        \\\"\\\"\\\"\\n        # If text has reasonable line breaks, return as-is\\n        # Threshold: expect at least 1 newline per 2000 chars for a formatted transcript\\n        if text.count('\\\\n') >= len(text) / 2000:\\n            return text\\n        \\n        # First, handle >> speaker markers (common in some transcript formats)\\n        # These alternate between Q and A\\n        if '>>' in text:\\n            text = self._convert_chevron_markers(text)\\n        \\n        # Handle - wrapped questions: \\\"- Question here? -\\\"\\n        # Pattern: text surrounded by dashes ending with a question mark\\n        text = re.sub(\\n            r'\\\\s*-\\\\s+([^-]+\\\\?)\\\\s*-\\\\s*',\\n            r'\\\\nQ: \\\\1\\\\n',\\n            text\\n        )\\n        \\n        # Handle UPPERCASE_NAME: patterns (e.g., HURST:, HALL:, HELDRETH:)\\n        # Insert newline before speaker name after sentence-ending punctuation\\n        text = re.sub(\\n            r'(?<=[.?!\\\"\\\\'])\\\\s+([A-Z][A-Z]+)\\\\s*:',\\n            r'\\\\n\\\\1:',\\n            text\\n        )\\n        \\n        # Also handle mixed case names like \\\"Heldreth:\\\" or \\\"Smith:\\\"\\n        # These typically follow sentence-ending punctuation\\n        text = re.sub(\\n            r'(?<=[.?!\\\"\\\\'])\\\\s+([A-Z][a-z]+)\\\\s*:',\\n            r'\\\\n\\\\1:',\\n            text\\n        )\\n        \\n        # Insert breaks before common Q&A patterns (with explicit markers)\\n        # These patterns look for speaker markers preceded by sentence-ending punctuation\\n        explicit_patterns = [\\n            (r'(?<=[.?!\\\"])\\\\s+(?=Q\\\\s*:)', '\\\\n'),           # Before \\\"Q:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=A\\\\s*:)', '\\\\n'),           # Before \\\"A:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=INTERVIEWER\\\\s*:)', '\\\\n'), # Before \\\"INTERVIEWER:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=VETERAN\\\\s*:)', '\\\\n'),     # Before \\\"VETERAN:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=Interviewer\\\\s*:)', '\\\\n'), # Before \\\"Interviewer:\\\"\\n        ]\\n        \\n        for pattern, replacement in explicit_patterns:\\n            text = re.sub(pattern, replacement, text, flags=re.IGNORECASE)\\n        \\n        # Check if we found any speaker markers after explicit patterns\\n        has_markers = bool(re.search(r'^(?:Q|A|INTERVIEWER|VETERAN|[A-Z][A-Z]+|[A-Z][a-z]+)\\\\s*:', text, re.MULTILINE | re.IGNORECASE))\\n        \\n        if not has_markers:\\n            # No explicit markers - try to detect Q&A boundaries in conversational text\\n            # This handles natural interview transcripts without Q:/A: markers\\n            text = self._split_conversational_transcript(text)\\n        \\n        return text\\n    \\n    def _convert_chevron_markers(self, text: str) -> str:\\n        \\\"\\\"\\\"\\n        Convert >> markers to alternating Q:/A: format.\\n        \\n        The >> pattern is commonly used in some transcription software\\n        to indicate speaker changes. This converts them to Q:/A: alternating\\n        pattern for consistent parsing.\\n        \\n        Args:\\n            text: Text containing >> markers\\n            \\n        Returns:\\n            Text with >> converted to Q:/A: markers\\n        \\\"\\\"\\\"\\n        # Split on >> markers\\n        parts = re.split(r'\\\\s*>>\\\\s*', text)\\n        \\n        if len(parts) <= 1:\\n            return text\\n        \\n        result = []\\n        is_question = True  # Start with question (interviewer)\\n        \\n        for i, part in enumerate(parts):\\n            part = part.strip()\\n            if not part:\\n                continue\\n            \\n            if i == 0:\\n                # First part (before any >>) - check if it looks like intro/question\\n                # If it ends with punctuation and is substantial, keep it as Q\\n                if part:\\n                    result.append(f\\\"Q: {part}\\\")\\n                    is_question = False  # Next should be answer\\n            else:\\n                marker = \\\"Q:\\\" if is_question else \\\"A:\\\"\\n                result.append(f\\\"\\\\n{marker} {part}\\\")\\n                is_question = not is_question\\n        \\n        return \\\"\\\\n\\\".join(result) if result else text\\n    \\n    def _split_conversational_transcript(self, text: str) -> str:\\n        \\\"\\\"\\\"\\n        Split a conversational transcript into Q&A pairs based on question patterns.\\n        \\n        Detects interviewer questions (ending with ?) and veteran answers.\\n        \\n        Args:\\n            text: Single-line transcript text\\n            \\n        Returns:\\n            Text with Q: and A: markers inserted\\n        \\\"\\\"\\\"\\n        # Split into sentences (rough approximation)\\n        # We'll look for question marks followed by answers\\n        \\n        # First, find all sentences\\n        sentences = []\\n        current = \\\"\\\"\\n        i = 0\\n        \\n        while i < len(text):\\n            char = text[i]\\n            current += char\\n            \\n            # Check for sentence end\\n            if char in '.?!':\\n                # Look ahead to see if this is really the end (not abbreviation)\\n                lookahead = text[i+1:i+3] if i+1 < len(text) else \\\"\\\"\\n                if lookahead.startswith(' ') or lookahead.startswith('\\\"') or not lookahead:\\n                    # Skip any trailing quotes or spaces\\n                    while i + 1 < len(text) and text[i + 1] in ' \\\"\\\\'':\\n                        i += 1\\n                        current += text[i]\\n                    sentences.append(current.strip())\\n                    current = \\\"\\\"\\n            i += 1\\n        \\n        if current.strip():\\n            sentences.append(current.strip())\\n        \\n        # Now identify which sentences are questions vs answers\\n        # Questions typically:\\n        # - End with ?\\n        # - Are shorter (interviewer prompts are usually brief)\\n        # - Start with question words (What, Where, When, How, Did, Do, Can, etc.)\\n        \\n        question_starters = [\\n            'what', 'where', 'when', 'how', 'why', 'who', 'which',\\n            'did', 'do', 'does', 'can', 'could', 'would', 'should',\\n            'are', 'is', 'was', 'were', 'have', 'has', 'had',\\n            'explain', 'describe', 'tell', 'let'\\n        ]\\n        \\n        result_parts = []\\n        current_role = None  # 'interviewer' or 'veteran'\\n        current_text = []\\n        \\n        for sentence in sentences:\\n            sentence_lower = sentence.lower().strip()\\n            first_word = sentence_lower.split()[0] if sentence_lower.split() else \\\"\\\"\\n            \\n            # Determine if this is likely interviewer or veteran speech\\n            is_question = (\\n                sentence.rstrip().endswith('?') or\\n                any(sentence_lower.startswith(q) for q in question_starters) or\\n                # Short statements like \\\"I see.\\\" or \\\"Interesting.\\\" are interviewer\\n                (len(sentence) < 50 and not sentence_lower.startswith(('well', 'yes', 'no', 'i ', 'we ', 'my ', 'our ')))\\n            )\\n            \\n            # Veteran answers typically start with these\\n            is_answer = (\\n                sentence_lower.startswith(('well,', 'well ', 'yes,', 'yes ', 'no,', 'no ', \\n                                          'i ', 'we ', 'my ', 'our ', 'the ', 'it ', 'that'))\\n                and len(sentence) > 80  # Answers are usually longer\\n            )\\n            \\n            # Determine role\\n            if is_question and not is_answer:\\n                new_role = 'interviewer'\\n            elif is_answer:\\n                new_role = 'veteran'\\n            else:\\n                # Ambiguous - continue with current role, or default to context\\n                if current_role is None:\\n                    # First sentence - check if it's introductory (interviewer sets scene)\\n                    if \\\"today\\\" in sentence_lower or \\\"interview\\\" in sentence_lower or \\\"welcome\\\" in sentence_lower:\\n                        new_role = 'interviewer'\\n                    else:\\n                        new_role = 'veteran'\\n                else:\\n                    new_role = current_role\\n            \\n            # If role changed, save current and start new\\n            if new_role != current_role and current_text:\\n                marker = \\\"Q:\\\" if current_role == 'interviewer' else \\\"A:\\\"\\n                result_parts.append(f\\\"\\\\n{marker} \\\" + \\\" \\\".join(current_text))\\n                current_text = []\\n            \\n            current_text.append(sentence)\\n            current_role = new_role\\n        \\n        # Don't forget the last part\\n        if current_text:\\n            marker = \\\"Q:\\\" if current_role == 'interviewer' else \\\"A:\\\"\\n            result_parts.append(f\\\"\\\\n{marker} \\\" + \\\" \\\".join(current_text))\\n        \\n        return \\\"\\\".join(result_parts).strip()\\n    \\n    def _find_speaker_names(self, text: str) -> Tuple[Optional[str], Optional[str]]:\\n        \\\"\\\"\\\"\\n        Find speaker names by analyzing the transcript structure.\\n        \\n        Looks for patterns like:\\n        - \\\"Interviewer:\\\" followed by \\\"Name Name:\\\" \\n        - Alternating speaker patterns\\n        \\n        Returns:\\n            Tuple of (interviewer_name, veteran_name)\\n        \\\"\\\"\\\"\\n        # Pattern to find \\\"Name:\\\" or \\\"Name Name:\\\" at start of line\\n        name_pattern = re.compile(r\\\"^([A-Z][a-zA-Z]*(?:\\\\s+[A-Z][a-zA-Z]*)*)\\\\s*:\\\", re.MULTILINE)\\n        \\n        # Find all unique speaker names in order\\n        speakers = []\\n        for match in name_pattern.finditer(text):\\n            name = match.group(1).strip()\\n            if name not in speakers:\\n                speakers.append(name)\\n        \\n        interviewer_name = None\\n        veteran_name = None\\n        \\n        for speaker in speakers:\\n            speaker_lower = speaker.lower()\\n            if speaker_lower == \\\"interviewer\\\" or speaker_lower == \\\"int\\\":\\n                interviewer_name = speaker\\n            elif speaker_lower not in [\\\"interviewer\\\", \\\"int\\\", \\\"q\\\", \\\"a\\\"]:\\n                # Likely a person's name\\n                if veteran_name is None:\\n                    veteran_name = speaker\\n        \\n        return interviewer_name, veteran_name\\n    \\n    def detect_speakers(self, text: str) -> Tuple[Optional[re.Pattern], Optional[re.Pattern], Optional[str]]:\\n        \\\"\\\"\\\"\\n        Detect speaker patterns in the transcript.\\n        \\n        Args:\\n            text: Transcript text\\n            \\n        Returns:\\n            Tuple of (interviewer_pattern, veteran_pattern, veteran_name)\\n        \\\"\\\"\\\"\\n        # First, try to find speaker names dynamically\\n        int_name, vet_name = self._find_speaker_names(text)\\n        \\n        interviewer_pattern = None\\n        veteran_pattern = None\\n        \\n        # Try standard patterns first\\n        for pattern in self._interviewer_re:\\n            if pattern.search(text):\\n                interviewer_pattern = pattern\\n                break\\n        \\n        # If we found an interviewer name, create a pattern for it\\n        if int_name and interviewer_pattern is None:\\n            interviewer_pattern = re.compile(f\\\"^{re.escape(int_name)}\\\\\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        # Try standard veteran patterns\\n        for pattern in self._veteran_re:\\n            if pattern.search(text):\\n                veteran_pattern = pattern\\n                break\\n        \\n        # If we found a veteran name, create a pattern for it\\n        if vet_name and veteran_pattern is None:\\n            veteran_pattern = re.compile(f\\\"^{re.escape(vet_name)}\\\\\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        return interviewer_pattern, veteran_pattern, vet_name\\n    \\n    def parse(self, text: str, veteran_name: Optional[str] = None) -> List[ParsedResponse]:\\n        \\\"\\\"\\\"\\n        Parse a transcript into Q&A responses.\\n        \\n        Args:\\n            text: Transcript text\\n            veteran_name: Optional veteran name for speaker detection\\n            \\n        Returns:\\n            List of parsed responses\\n        \\\"\\\"\\\"\\n        # Preprocess single-line transcripts\\n        text = self._preprocess_single_line(text)\\n        \\n        # Detect speaker patterns\\n        interviewer_pattern, veteran_pattern, detected_name = self.detect_speakers(text)\\n        \\n        if veteran_name:\\n            # Create pattern for provided name\\n            escaped_name = re.escape(veteran_name)\\n            # Match various patterns with the name\\n            name_patterns = [\\n                f\\\"^{escaped_name}\\\\\\\\s*:\\\",\\n            ]\\n            # Also try just last name or first name\\n            name_parts = veteran_name.split()\\n            if len(name_parts) > 1:\\n                for part in name_parts:\\n                    name_patterns.append(f\\\"^{re.escape(part)}\\\\\\\\s+{re.escape(name_parts[-1])}\\\\\\\\s*:\\\")\\n                    name_patterns.append(f\\\"^{re.escape(part)}\\\\\\\\s*:\\\")\\n            \\n            combined_pattern = \\\"|\\\".join(name_patterns)\\n            name_based_pattern = re.compile(combined_pattern, re.IGNORECASE | re.MULTILINE)\\n            \\n            # Only use name-based pattern if it actually matches something\\n            # Otherwise, keep the detected pattern (e.g., \\\"A:\\\")\\n            if name_based_pattern.search(text):\\n                veteran_pattern = name_based_pattern\\n        \\n        if interviewer_pattern is None:\\n            # Fall back to simple patterns\\n            interviewer_pattern = re.compile(r\\\"^(?:Q|Interviewer)\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        if veteran_pattern is None:\\n            # Fall back to any \\\"Name Name:\\\" pattern that's not the interviewer\\n            veteran_pattern = re.compile(r\\\"^(?:A|[A-Z][a-z]+(?:\\\\s+[A-Z][a-z]+)+)\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        # Combine patterns to find all speaker turns\\n        all_speakers = []\\n        \\n        for match in interviewer_pattern.finditer(text):\\n            all_speakers.append((\\\"interviewer\\\", match.start(), match.end()))\\n        \\n        for match in veteran_pattern.finditer(text):\\n            all_speakers.append((\\\"veteran\\\", match.start(), match.end()))\\n        \\n        # Sort by position\\n        all_speakers.sort(key=lambda x: x[1])\\n        \\n        if not all_speakers:\\n            # No speaker patterns found - return entire text as single response\\n            return [ParsedResponse(\\n                interviewer=\\\"[No interviewer question detected]\\\",\\n                veteran=text.strip(),\\n                raw_index=0\\n            )]\\n        \\n        # Parse into responses\\n        responses = []\\n        current_interviewer = None\\n        current_veteran_parts = []\\n        response_index = 0\\n        \\n        for i, (speaker_type, start, end) in enumerate(all_speakers):\\n            # Get text until next speaker or end\\n            if i + 1 < len(all_speakers):\\n                next_start = all_speakers[i + 1][1]\\n                speaker_text = text[end:next_start].strip()\\n            else:\\n                speaker_text = text[end:].strip()\\n            \\n            if speaker_type == \\\"interviewer\\\":\\n                # Save previous response if we have one\\n                if current_interviewer is not None and current_veteran_parts:\\n                    responses.append(ParsedResponse(\\n                        interviewer=current_interviewer,\\n                        veteran=\\\" \\\".join(current_veteran_parts),\\n                        raw_index=response_index\\n                    ))\\n                    response_index += 1\\n                \\n                current_interviewer = speaker_text\\n                current_veteran_parts = []\\n            \\n            else:  # veteran\\n                if speaker_text:\\n                    current_veteran_parts.append(speaker_text)\\n        \\n        # Don't forget the last response\\n        if current_interviewer is not None and current_veteran_parts:\\n            responses.append(ParsedResponse(\\n                interviewer=current_interviewer,\\n                veteran=\\\" \\\".join(current_veteran_parts),\\n                raw_index=response_index\\n            ))\\n        \\n        return responses\\n    \\n    def split_paragraphs(self, text: str) -> List[str]:\\n        \\\"\\\"\\\"\\n        Split text into paragraphs for embedding.\\n        \\n        Args:\\n            text: Text to split\\n            \\n        Returns:\\n            List of paragraph texts\\n        \\\"\\\"\\\"\\n        # Split on double newlines primarily\\n        parts = re.split(r\\\"\\\\n\\\\s*\\\\n\\\", text)\\n        \\n        paragraphs = []\\n        current = \\\"\\\"\\n        \\n        for part in parts:\\n            part = part.strip()\\n            if not part:\\n                continue\\n            \\n            # If this part is too short, merge with previous\\n            if len(part) < self.min_paragraph_length and current:\\n                current += \\\" \\\" + part\\n            elif len(current) < self.min_paragraph_length and current:\\n                current += \\\" \\\" + part\\n            else:\\n                if current:\\n                    paragraphs.append(current)\\n                current = part\\n        \\n        if current:\\n            paragraphs.append(current)\\n        \\n        # If we ended up with no paragraphs, just return the whole text\\n        if not paragraphs and text.strip():\\n            paragraphs = [text.strip()]\\n        \\n        return paragraphs\\n    \\n    def create_responses(\\n        self, \\n        parsed: List[ParsedResponse],\\n        id_prefix: str = \\\"\\\"\\n    ) -> List[Response]:\\n        \\\"\\\"\\\"\\n        Convert parsed responses to Response objects with paragraphs.\\n        \\n        Args:\\n            parsed: List of parsed responses\\n            id_prefix: Optional prefix for response IDs\\n            \\n        Returns:\\n            List of Response objects\\n        \\\"\\\"\\\"\\n        responses = []\\n        \\n        for i, pr in enumerate(parsed):\\n            response_id = f\\\"{id_prefix}{str(i + 1).zfill(3)}\\\"\\n            \\n            # Split veteran's answer into paragraphs\\n            paragraph_texts = self.split_paragraphs(pr.veteran)\\n            paragraphs = []\\n            \\n            for j, para_text in enumerate(paragraph_texts):\\n                para_id = f\\\"{response_id}_p{j + 1}\\\"\\n                paragraphs.append(Paragraph(id=para_id, text=para_text))\\n            \\n            responses.append(Response(\\n                id=response_id,\\n                interviewer=pr.interviewer,\\n                veteran=pr.veteran,\\n                paragraphs=paragraphs\\n            ))\\n        \\n        return responses\\n\\n\\ndef parse_transcript_file(\\n    file_path: Path,\\n    veteran_name: Optional[str] = None,\\n    min_paragraph_length: int = 50\\n) -> List[Response]:\\n    \\\"\\\"\\\"\\n    Parse a transcript file into responses.\\n    \\n    Args:\\n        file_path: Path to transcript file\\n        veteran_name: Optional veteran name\\n        min_paragraph_length: Minimum paragraph length\\n        \\n    Returns:\\n        List of Response objects\\n    \\\"\\\"\\\"\\n    with open(file_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n        text = f.read()\\n    \\n    parser = TranscriptParser(min_paragraph_length=min_paragraph_length)\\n    parsed = parser.parse(text, veteran_name=veteran_name)\\n    \\n    return parser.create_responses(parsed)\\n\\n\\ndef extract_header_info(text: str) -> dict:\\n    \\\"\\\"\\\"\\n    Try to extract header information from transcript.\\n    \\n    Looks for patterns like:\\n    - \\\"Interview with Sergeant James Mitchell\\\"\\n    - \\\"6th Armored Division, Company B\\\"\\n    - \\\"Interviewed on March 15, 1995\\\"\\n    \\n    Args:\\n        text: Transcript text\\n        \\n    Returns:\\n        Dict with extracted info (name, unit, rank, date, location, interviewer)\\n    \\\"\\\"\\\"\\n    info = {}\\n    \\n    # Look at first few lines for header info\\n    lines = text.split(\\\"\\\\n\\\")[:20]\\n    header = \\\"\\\\n\\\".join(lines)\\n    \\n    # Name patterns\\n    name_patterns = [\\n        r\\\"Interview with (?:Sergeant|Sgt\\\\.|Captain|Capt\\\\.|Lieutenant|Lt\\\\.|Private|Pvt\\\\.|Corporal|Cpl\\\\.|Staff Sergeant)?\\\\s*([A-Z][a-z]+ (?:[A-Z]\\\\. )?[A-Z][a-z]+)\\\",\\n        r\\\"^([A-Z][a-z]+ [A-Z][a-z]+)\\\\s*$\\\",\\n    ]\\n    \\n    for pattern in name_patterns:\\n        match = re.search(pattern, header, re.MULTILINE)\\n        if match:\\n            info[\\\"name\\\"] = match.group(1).strip()\\n            break\\n    \\n    # Unit patterns\\n    unit_patterns = [\\n        r\\\"(\\\\d+(?:st|nd|rd|th)\\\\s+(?:Armored|Infantry|Airborne|Tank|Artillery)[^,\\\\n]+)\\\",\\n        r\\\"([A-Z][a-z]+ Company[^,\\\\n]+)\\\",\\n    ]\\n    \\n    for pattern in unit_patterns:\\n        match = re.search(pattern, header)\\n        if match:\\n            info[\\\"unit\\\"] = match.group(1).strip()\\n            break\\n    \\n    # Date patterns\\n    date_patterns = [\\n        r\\\"(?:Interviewed|Recorded)\\\\s+(?:on\\\\s+)?([A-Z][a-z]+ \\\\d{1,2},? \\\\d{4})\\\",\\n        r\\\"(\\\\d{4}-\\\\d{2}-\\\\d{2})\\\",\\n    ]\\n    \\n    for pattern in date_patterns:\\n        match = re.search(pattern, header)\\n        if match:\\n            info[\\\"date_recorded\\\"] = match.group(1).strip()\\n            break\\n    \\n    # Rank patterns\\n    rank_patterns = [\\n        r\\\"(Sergeant|Sgt\\\\.|Captain|Capt\\\\.|Lieutenant|Lt\\\\.|Private|Pvt\\\\.|Corporal|Cpl\\\\.|Staff Sergeant|Major|Colonel|General)\\\",\\n    ]\\n    \\n    for pattern in rank_patterns:\\n        match = re.search(pattern, header)\\n        if match:\\n            info[\\\"rank\\\"] = match.group(1).strip()\\n            break\\n    \\n    return info\\n\",\"file_size_bytes\":23114,\"content_length\":23114}"}],"structuredContent":{"result":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/parser.py\",\"content\":\"\\\"\\\"\\\"\\nTranscript parser for the Oral History Research System.\\n\\nParses interview transcripts into Q&A responses.\\nHandles various transcript formats and speaker patterns.\\n\\\"\\\"\\\"\\n\\nimport re\\nfrom typing import List, Tuple, Optional\\nfrom pathlib import Path\\nfrom dataclasses import dataclass\\n\\nfrom .models import Response, Paragraph\\n\\n\\n@dataclass\\nclass ParsedResponse:\\n    \\\"\\\"\\\"A parsed response before full processing.\\\"\\\"\\\"\\n    interviewer: str\\n    veteran: str\\n    raw_index: int  # Original position in transcript\\n\\n\\nclass TranscriptParser:\\n    \\\"\\\"\\\"\\n    Parses interview transcripts into structured Q&A responses.\\n    \\n    Supports various speaker patterns:\\n    - \\\"INTERVIEWER:\\\" / \\\"VETERAN:\\\"\\n    - \\\"Q:\\\" / \\\"A:\\\"\\n    - \\\"Interviewer:\\\" / \\\"[Name]:\\\"\\n    - Speaker names followed by colons (e.g., \\\"Jim Mitchell:\\\")\\n    \\\"\\\"\\\"\\n    \\n    # Common patterns for speaker detection\\n    INTERVIEWER_PATTERNS = [\\n        r\\\"^INTERVIEWER\\\\s*:\\\",\\n        r\\\"^Q\\\\s*:\\\",\\n        r\\\"^Interviewer\\\\s*:\\\",\\n        r\\\"^INT\\\\s*:\\\",\\n        r\\\"^I\\\\s*:\\\",\\n    ]\\n    \\n    VETERAN_PATTERNS = [\\n        r\\\"^VETERAN\\\\s*:\\\",\\n        r\\\"^A\\\\s*:\\\",\\n        r\\\"^(?:Mr\\\\.|Mrs\\\\.|Ms\\\\.|Sgt\\\\.|Sergeant|Captain|Lt\\\\.|Lieutenant|Private|Corporal|Staff Sergeant)\\\\s+\\\\w+\\\\s*:\\\",\\n    ]\\n    \\n    def __init__(self, min_paragraph_length: int = 50):\\n        \\\"\\\"\\\"\\n        Initialize parser.\\n        \\n        Args:\\n            min_paragraph_length: Minimum characters for a paragraph\\n        \\\"\\\"\\\"\\n        self.min_paragraph_length = min_paragraph_length\\n        \\n        # Compiled patterns\\n        self._interviewer_re = [re.compile(p, re.IGNORECASE | re.MULTILINE) for p in self.INTERVIEWER_PATTERNS]\\n        self._veteran_re = [re.compile(p, re.IGNORECASE | re.MULTILINE) for p in self.VETERAN_PATTERNS]\\n    \\n    def _preprocess_single_line(self, text: str) -> str:\\n        \\\"\\\"\\\"\\n        Insert line breaks before speaker patterns in single-line transcripts.\\n        \\n        Handles transcripts that are all on one line by detecting Q&A boundaries\\n        and inserting synthetic line breaks.\\n        \\n        Handles various speaker marker formats:\\n        - `>>` as Q&A delimiter: `>> Was that the Enfield?`\\n        - `-` as speaker change: `- Had you ever fired a rifle before? -`\\n        - Named speakers: `HURST:`, `HALL:`, `Heldreth:`\\n        \\n        Args:\\n            text: Transcript text\\n            \\n        Returns:\\n            Text with line breaks inserted at speaker boundaries\\n        \\\"\\\"\\\"\\n        # If text has reasonable line breaks, return as-is\\n        # Threshold: expect at least 1 newline per 2000 chars for a formatted transcript\\n        if text.count('\\\\n') >= len(text) / 2000:\\n            return text\\n        \\n        # First, handle >> speaker markers (common in some transcript formats)\\n        # These alternate between Q and A\\n        if '>>' in text:\\n            text = self._convert_chevron_markers(text)\\n        \\n        # Handle - wrapped questions: \\\"- Question here? -\\\"\\n        # Pattern: text surrounded by dashes ending with a question mark\\n        text = re.sub(\\n            r'\\\\s*-\\\\s+([^-]+\\\\?)\\\\s*-\\\\s*',\\n            r'\\\\nQ: \\\\1\\\\n',\\n            text\\n        )\\n        \\n        # Handle UPPERCASE_NAME: patterns (e.g., HURST:, HALL:, HELDRETH:)\\n        # Insert newline before speaker name after sentence-ending punctuation\\n        text = re.sub(\\n            r'(?<=[.?!\\\"\\\\'])\\\\s+([A-Z][A-Z]+)\\\\s*:',\\n            r'\\\\n\\\\1:',\\n            text\\n        )\\n        \\n        # Also handle mixed case names like \\\"Heldreth:\\\" or \\\"Smith:\\\"\\n        # These typically follow sentence-ending punctuation\\n        text = re.sub(\\n            r'(?<=[.?!\\\"\\\\'])\\\\s+([A-Z][a-z]+)\\\\s*:',\\n            r'\\\\n\\\\1:',\\n            text\\n        )\\n        \\n        # Insert breaks before common Q&A patterns (with explicit markers)\\n        # These patterns look for speaker markers preceded by sentence-ending punctuation\\n        explicit_patterns = [\\n            (r'(?<=[.?!\\\"])\\\\s+(?=Q\\\\s*:)', '\\\\n'),           # Before \\\"Q:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=A\\\\s*:)', '\\\\n'),           # Before \\\"A:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=INTERVIEWER\\\\s*:)', '\\\\n'), # Before \\\"INTERVIEWER:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=VETERAN\\\\s*:)', '\\\\n'),     # Before \\\"VETERAN:\\\"\\n            (r'(?<=[.?!\\\"])\\\\s+(?=Interviewer\\\\s*:)', '\\\\n'), # Before \\\"Interviewer:\\\"\\n        ]\\n        \\n        for pattern, replacement in explicit_patterns:\\n            text = re.sub(pattern, replacement, text, flags=re.IGNORECASE)\\n        \\n        # Check if we found any speaker markers after explicit patterns\\n        has_markers = bool(re.search(r'^(?:Q|A|INTERVIEWER|VETERAN|[A-Z][A-Z]+|[A-Z][a-z]+)\\\\s*:', text, re.MULTILINE | re.IGNORECASE))\\n        \\n        if not has_markers:\\n            # No explicit markers - try to detect Q&A boundaries in conversational text\\n            # This handles natural interview transcripts without Q:/A: markers\\n            text = self._split_conversational_transcript(text)\\n        \\n        return text\\n    \\n    def _convert_chevron_markers(self, text: str) -> str:\\n        \\\"\\\"\\\"\\n        Convert >> markers to alternating Q:/A: format.\\n        \\n        The >> pattern is commonly used in some transcription software\\n        to indicate speaker changes. This converts them to Q:/A: alternating\\n        pattern for consistent parsing.\\n        \\n        Args:\\n            text: Text containing >> markers\\n            \\n        Returns:\\n            Text with >> converted to Q:/A: markers\\n        \\\"\\\"\\\"\\n        # Split on >> markers\\n        parts = re.split(r'\\\\s*>>\\\\s*', text)\\n        \\n        if len(parts) <= 1:\\n            return text\\n        \\n        result = []\\n        is_question = True  # Start with question (interviewer)\\n        \\n        for i, part in enumerate(parts):\\n            part = part.strip()\\n            if not part:\\n                continue\\n            \\n            if i == 0:\\n                # First part (before any >>) - check if it looks like intro/question\\n                # If it ends with punctuation and is substantial, keep it as Q\\n                if part:\\n                    result.append(f\\\"Q: {part}\\\")\\n                    is_question = False  # Next should be answer\\n            else:\\n                marker = \\\"Q:\\\" if is_question else \\\"A:\\\"\\n                result.append(f\\\"\\\\n{marker} {part}\\\")\\n                is_question = not is_question\\n        \\n        return \\\"\\\\n\\\".join(result) if result else text\\n    \\n    def _split_conversational_transcript(self, text: str) -> str:\\n        \\\"\\\"\\\"\\n        Split a conversational transcript into Q&A pairs based on question patterns.\\n        \\n        Detects interviewer questions (ending with ?) and veteran answers.\\n        \\n        Args:\\n            text: Single-line transcript text\\n            \\n        Returns:\\n            Text with Q: and A: markers inserted\\n        \\\"\\\"\\\"\\n        # Split into sentences (rough approximation)\\n        # We'll look for question marks followed by answers\\n        \\n        # First, find all sentences\\n        sentences = []\\n        current = \\\"\\\"\\n        i = 0\\n        \\n        while i < len(text):\\n            char = text[i]\\n            current += char\\n            \\n            # Check for sentence end\\n            if char in '.?!':\\n                # Look ahead to see if this is really the end (not abbreviation)\\n                lookahead = text[i+1:i+3] if i+1 < len(text) else \\\"\\\"\\n                if lookahead.startswith(' ') or lookahead.startswith('\\\"') or not lookahead:\\n                    # Skip any trailing quotes or spaces\\n                    while i + 1 < len(text) and text[i + 1] in ' \\\"\\\\'':\\n                        i += 1\\n                        current += text[i]\\n                    sentences.append(current.strip())\\n                    current = \\\"\\\"\\n            i += 1\\n        \\n        if current.strip():\\n            sentences.append(current.strip())\\n        \\n        # Now identify which sentences are questions vs answers\\n        # Questions typically:\\n        # - End with ?\\n        # - Are shorter (interviewer prompts are usually brief)\\n        # - Start with question words (What, Where, When, How, Did, Do, Can, etc.)\\n        \\n        question_starters = [\\n            'what', 'where', 'when', 'how', 'why', 'who', 'which',\\n            'did', 'do', 'does', 'can', 'could', 'would', 'should',\\n            'are', 'is', 'was', 'were', 'have', 'has', 'had',\\n            'explain', 'describe', 'tell', 'let'\\n        ]\\n        \\n        result_parts = []\\n        current_role = None  # 'interviewer' or 'veteran'\\n        current_text = []\\n        \\n        for sentence in sentences:\\n            sentence_lower = sentence.lower().strip()\\n            first_word = sentence_lower.split()[0] if sentence_lower.split() else \\\"\\\"\\n            \\n            # Determine if this is likely interviewer or veteran speech\\n            is_question = (\\n                sentence.rstrip().endswith('?') or\\n                any(sentence_lower.startswith(q) for q in question_starters) or\\n                # Short statements like \\\"I see.\\\" or \\\"Interesting.\\\" are interviewer\\n                (len(sentence) < 50 and not sentence_lower.startswith(('well', 'yes', 'no', 'i ', 'we ', 'my ', 'our ')))\\n            )\\n            \\n            # Veteran answers typically start with these\\n            is_answer = (\\n                sentence_lower.startswith(('well,', 'well ', 'yes,', 'yes ', 'no,', 'no ', \\n                                          'i ', 'we ', 'my ', 'our ', 'the ', 'it ', 'that'))\\n                and len(sentence) > 80  # Answers are usually longer\\n            )\\n            \\n            # Determine role\\n            if is_question and not is_answer:\\n                new_role = 'interviewer'\\n            elif is_answer:\\n                new_role = 'veteran'\\n            else:\\n                # Ambiguous - continue with current role, or default to context\\n                if current_role is None:\\n                    # First sentence - check if it's introductory (interviewer sets scene)\\n                    if \\\"today\\\" in sentence_lower or \\\"interview\\\" in sentence_lower or \\\"welcome\\\" in sentence_lower:\\n                        new_role = 'interviewer'\\n                    else:\\n                        new_role = 'veteran'\\n                else:\\n                    new_role = current_role\\n            \\n            # If role changed, save current and start new\\n            if new_role != current_role and current_text:\\n                marker = \\\"Q:\\\" if current_role == 'interviewer' else \\\"A:\\\"\\n                result_parts.append(f\\\"\\\\n{marker} \\\" + \\\" \\\".join(current_text))\\n                current_text = []\\n            \\n            current_text.append(sentence)\\n            current_role = new_role\\n        \\n        # Don't forget the last part\\n        if current_text:\\n            marker = \\\"Q:\\\" if current_role == 'interviewer' else \\\"A:\\\"\\n            result_parts.append(f\\\"\\\\n{marker} \\\" + \\\" \\\".join(current_text))\\n        \\n        return \\\"\\\".join(result_parts).strip()\\n    \\n    def _find_speaker_names(self, text: str) -> Tuple[Optional[str], Optional[str]]:\\n        \\\"\\\"\\\"\\n        Find speaker names by analyzing the transcript structure.\\n        \\n        Looks for patterns like:\\n        - \\\"Interviewer:\\\" followed by \\\"Name Name:\\\" \\n        - Alternating speaker patterns\\n        \\n        Returns:\\n            Tuple of (interviewer_name, veteran_name)\\n        \\\"\\\"\\\"\\n        # Pattern to find \\\"Name:\\\" or \\\"Name Name:\\\" at start of line\\n        name_pattern = re.compile(r\\\"^([A-Z][a-zA-Z]*(?:\\\\s+[A-Z][a-zA-Z]*)*)\\\\s*:\\\", re.MULTILINE)\\n        \\n        # Find all unique speaker names in order\\n        speakers = []\\n        for match in name_pattern.finditer(text):\\n            name = match.group(1).strip()\\n            if name not in speakers:\\n                speakers.append(name)\\n        \\n        interviewer_name = None\\n        veteran_name = None\\n        \\n        for speaker in speakers:\\n            speaker_lower = speaker.lower()\\n            if speaker_lower == \\\"interviewer\\\" or speaker_lower == \\\"int\\\":\\n                interviewer_name = speaker\\n            elif speaker_lower not in [\\\"interviewer\\\", \\\"int\\\", \\\"q\\\", \\\"a\\\"]:\\n                # Likely a person's name\\n                if veteran_name is None:\\n                    veteran_name = speaker\\n        \\n        return interviewer_name, veteran_name\\n    \\n    def detect_speakers(self, text: str) -> Tuple[Optional[re.Pattern], Optional[re.Pattern], Optional[str]]:\\n        \\\"\\\"\\\"\\n        Detect speaker patterns in the transcript.\\n        \\n        Args:\\n            text: Transcript text\\n            \\n        Returns:\\n            Tuple of (interviewer_pattern, veteran_pattern, veteran_name)\\n        \\\"\\\"\\\"\\n        # First, try to find speaker names dynamically\\n        int_name, vet_name = self._find_speaker_names(text)\\n        \\n        interviewer_pattern = None\\n        veteran_pattern = None\\n        \\n        # Try standard patterns first\\n        for pattern in self._interviewer_re:\\n            if pattern.search(text):\\n                interviewer_pattern = pattern\\n                break\\n        \\n        # If we found an interviewer name, create a pattern for it\\n        if int_name and interviewer_pattern is None:\\n            interviewer_pattern = re.compile(f\\\"^{re.escape(int_name)}\\\\\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        # Try standard veteran patterns\\n        for pattern in self._veteran_re:\\n            if pattern.search(text):\\n                veteran_pattern = pattern\\n                break\\n        \\n        # If we found a veteran name, create a pattern for it\\n        if vet_name and veteran_pattern is None:\\n            veteran_pattern = re.compile(f\\\"^{re.escape(vet_name)}\\\\\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        return interviewer_pattern, veteran_pattern, vet_name\\n    \\n    def parse(self, text: str, veteran_name: Optional[str] = None) -> List[ParsedResponse]:\\n        \\\"\\\"\\\"\\n        Parse a transcript into Q&A responses.\\n        \\n        Args:\\n            text: Transcript text\\n            veteran_name: Optional veteran name for speaker detection\\n            \\n        Returns:\\n            List of parsed responses\\n        \\\"\\\"\\\"\\n        # Preprocess single-line transcripts\\n        text = self._preprocess_single_line(text)\\n        \\n        # Detect speaker patterns\\n        interviewer_pattern, veteran_pattern, detected_name = self.detect_speakers(text)\\n        \\n        if veteran_name:\\n            # Create pattern for provided name\\n            escaped_name = re.escape(veteran_name)\\n            # Match various patterns with the name\\n            name_patterns = [\\n                f\\\"^{escaped_name}\\\\\\\\s*:\\\",\\n            ]\\n            # Also try just last name or first name\\n            name_parts = veteran_name.split()\\n            if len(name_parts) > 1:\\n                for part in name_parts:\\n                    name_patterns.append(f\\\"^{re.escape(part)}\\\\\\\\s+{re.escape(name_parts[-1])}\\\\\\\\s*:\\\")\\n                    name_patterns.append(f\\\"^{re.escape(part)}\\\\\\\\s*:\\\")\\n            \\n            combined_pattern = \\\"|\\\".join(name_patterns)\\n            name_based_pattern = re.compile(combined_pattern, re.IGNORECASE | re.MULTILINE)\\n            \\n            # Only use name-based pattern if it actually matches something\\n            # Otherwise, keep the detected pattern (e.g., \\\"A:\\\")\\n            if name_based_pattern.search(text):\\n                veteran_pattern = name_based_pattern\\n        \\n        if interviewer_pattern is None:\\n            # Fall back to simple patterns\\n            interviewer_pattern = re.compile(r\\\"^(?:Q|Interviewer)\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        if veteran_pattern is None:\\n            # Fall back to any \\\"Name Name:\\\" pattern that's not the interviewer\\n            veteran_pattern = re.compile(r\\\"^(?:A|[A-Z][a-z]+(?:\\\\s+[A-Z][a-z]+)+)\\\\s*:\\\", re.IGNORECASE | re.MULTILINE)\\n        \\n        # Combine patterns to find all speaker turns\\n        all_speakers = []\\n        \\n        for match in interviewer_pattern.finditer(text):\\n            all_speakers.append((\\\"interviewer\\\", match.start(), match.end()))\\n        \\n        for match in veteran_pattern.finditer(text):\\n            all_speakers.append((\\\"veteran\\\", match.start(), match.end()))\\n        \\n        # Sort by position\\n        all_speakers.sort(key=lambda x: x[1])\\n        \\n        if not all_speakers:\\n            # No speaker patterns found - return entire text as single response\\n            return [ParsedResponse(\\n                interviewer=\\\"[No interviewer question detected]\\\",\\n                veteran=text.strip(),\\n                raw_index=0\\n            )]\\n        \\n        # Parse into responses\\n        responses = []\\n        current_interviewer = None\\n        current_veteran_parts = []\\n        response_index = 0\\n        \\n        for i, (speaker_type, start, end) in enumerate(all_speakers):\\n            # Get text until next speaker or end\\n            if i + 1 < len(all_speakers):\\n                next_start = all_speakers[i + 1][1]\\n                speaker_text = text[end:next_start].strip()\\n            else:\\n                speaker_text = text[end:].strip()\\n            \\n            if speaker_type == \\\"interviewer\\\":\\n                # Save previous response if we have one\\n                if current_interviewer is not None and current_veteran_parts:\\n                    responses.append(ParsedResponse(\\n                        interviewer=current_interviewer,\\n                        veteran=\\\" \\\".join(current_veteran_parts),\\n                        raw_index=response_index\\n                    ))\\n                    response_index += 1\\n                \\n                current_interviewer = speaker_text\\n                current_veteran_parts = []\\n            \\n            else:  # veteran\\n                if speaker_text:\\n                    current_veteran_parts.append(speaker_text)\\n        \\n        # Don't forget the last response\\n        if current_interviewer is not None and current_veteran_parts:\\n            responses.append(ParsedResponse(\\n                interviewer=current_interviewer,\\n                veteran=\\\" \\\".join(current_veteran_parts),\\n                raw_index=response_index\\n            ))\\n        \\n        return responses\\n    \\n    def split_paragraphs(self, text: str) -> List[str]:\\n        \\\"\\\"\\\"\\n        Split text into paragraphs for embedding.\\n        \\n        Args:\\n            text: Text to split\\n            \\n        Returns:\\n            List of paragraph texts\\n        \\\"\\\"\\\"\\n        # Split on double newlines primarily\\n        parts = re.split(r\\\"\\\\n\\\\s*\\\\n\\\", text)\\n        \\n        paragraphs = []\\n        current = \\\"\\\"\\n        \\n        for part in parts:\\n            part = part.strip()\\n            if not part:\\n                continue\\n            \\n            # If this part is too short, merge with previous\\n            if len(part) < self.min_paragraph_length and current:\\n                current += \\\" \\\" + part\\n            elif len(current) < self.min_paragraph_length and current:\\n                current += \\\" \\\" + part\\n            else:\\n                if current:\\n                    paragraphs.append(current)\\n                current = part\\n        \\n        if current:\\n            paragraphs.append(current)\\n        \\n        # If we ended up with no paragraphs, just return the whole text\\n        if not paragraphs and text.strip():\\n            paragraphs = [text.strip()]\\n        \\n        return paragraphs\\n    \\n    def create_responses(\\n        self, \\n        parsed: List[ParsedResponse],\\n        id_prefix: str = \\\"\\\"\\n    ) -> List[Response]:\\n        \\\"\\\"\\\"\\n        Convert parsed responses to Response objects with paragraphs.\\n        \\n        Args:\\n            parsed: List of parsed responses\\n            id_prefix: Optional prefix for response IDs\\n            \\n        Returns:\\n            List of Response objects\\n        \\\"\\\"\\\"\\n        responses = []\\n        \\n        for i, pr in enumerate(parsed):\\n            response_id = f\\\"{id_prefix}{str(i + 1).zfill(3)}\\\"\\n            \\n            # Split veteran's answer into paragraphs\\n            paragraph_texts = self.split_paragraphs(pr.veteran)\\n            paragraphs = []\\n            \\n            for j, para_text in enumerate(paragraph_texts):\\n                para_id = f\\\"{response_id}_p{j + 1}\\\"\\n                paragraphs.append(Paragraph(id=para_id, text=para_text))\\n            \\n            responses.append(Response(\\n                id=response_id,\\n                interviewer=pr.interviewer,\\n                veteran=pr.veteran,\\n                paragraphs=paragraphs\\n            ))\\n        \\n        return responses\\n\\n\\ndef parse_transcript_file(\\n    file_path: Path,\\n    veteran_name: Optional[str] = None,\\n    min_paragraph_length: int = 50\\n) -> List[Response]:\\n    \\\"\\\"\\\"\\n    Parse a transcript file into responses.\\n    \\n    Args:\\n        file_path: Path to transcript file\\n        veteran_name: Optional veteran name\\n        min_paragraph_length: Minimum paragraph length\\n        \\n    Returns:\\n        List of Response objects\\n    \\\"\\\"\\\"\\n    with open(file_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n        text = f.read()\\n    \\n    parser = TranscriptParser(min_paragraph_length=min_paragraph_length)\\n    parsed = parser.parse(text, veteran_name=veteran_name)\\n    \\n    return parser.create_responses(parsed)\\n\\n\\ndef extract_header_info(text: str) -> dict:\\n    \\\"\\\"\\\"\\n    Try to extract header information from transcript.\\n    \\n    Looks for patterns like:\\n    - \\\"Interview with Sergeant James Mitchell\\\"\\n    - \\\"6th Armored Division, Company B\\\"\\n    - \\\"Interviewed on March 15, 1995\\\"\\n    \\n    Args:\\n        text: Transcript text\\n        \\n    Returns:\\n        Dict with extracted info (name, unit, rank, date, location, interviewer)\\n    \\\"\\\"\\\"\\n    info = {}\\n    \\n    # Look at first few lines for header info\\n    lines = text.split(\\\"\\\\n\\\")[:20]\\n    header = \\\"\\\\n\\\".join(lines)\\n    \\n    # Name patterns\\n    name_patterns = [\\n        r\\\"Interview with (?:Sergeant|Sgt\\\\.|Captain|Capt\\\\.|Lieutenant|Lt\\\\.|Private|Pvt\\\\.|Corporal|Cpl\\\\.|Staff Sergeant)?\\\\s*([A-Z][a-z]+ (?:[A-Z]\\\\. )?[A-Z][a-z]+)\\\",\\n        r\\\"^([A-Z][a-z]+ [A-Z][a-z]+)\\\\s*$\\\",\\n    ]\\n    \\n    for pattern in name_patterns:\\n        match = re.search(pattern, header, re.MULTILINE)\\n        if match:\\n            info[\\\"name\\\"] = match.group(1).strip()\\n            break\\n    \\n    # Unit patterns\\n    unit_patterns = [\\n        r\\\"(\\\\d+(?:st|nd|rd|th)\\\\s+(?:Armored|Infantry|Airborne|Tank|Artillery)[^,\\\\n]+)\\\",\\n        r\\\"([A-Z][a-z]+ Company[^,\\\\n]+)\\\",\\n    ]\\n    \\n    for pattern in unit_patterns:\\n        match = re.search(pattern, header)\\n        if match:\\n            info[\\\"unit\\\"] = match.group(1).strip()\\n            break\\n    \\n    # Date patterns\\n    date_patterns = [\\n        r\\\"(?:Interviewed|Recorded)\\\\s+(?:on\\\\s+)?([A-Z][a-z]+ \\\\d{1,2},? \\\\d{4})\\\",\\n        r\\\"(\\\\d{4}-\\\\d{2}-\\\\d{2})\\\",\\n    ]\\n    \\n    for pattern in date_patterns:\\n        match = re.search(pattern, header)\\n        if match:\\n            info[\\\"date_recorded\\\"] = match.group(1).strip()\\n            break\\n    \\n    # Rank patterns\\n    rank_patterns = [\\n        r\\\"(Sergeant|Sgt\\\\.|Captain|Capt\\\\.|Lieutenant|Lt\\\\.|Private|Pvt\\\\.|Corporal|Cpl\\\\.|Staff Sergeant|Major|Colonel|General)\\\",\\n    ]\\n    \\n    for pattern in rank_patterns:\\n        match = re.search(pattern, header)\\n        if match:\\n            info[\\\"rank\\\"] = match.group(1).strip()\\n            break\\n    \\n    return info\\n\",\"file_size_bytes\":23114,\"content_length\":23114}"},"isError":false}} { metadata: undefined }
