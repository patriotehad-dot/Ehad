dding=(0, 1))\\n    actions_table.add_column(\\\"\\\", style=\\\"dim\\\")\\n    actions_table.add_row(f\\\"\\u2192 Assign chapter: oralhistory annotate {veteran_id} {response_id} --chapter N\\\")\\n    actions_table.add_row(f\\\"\\u2192 Add note: oralhistory annotate {veteran_id} {response_id} --note \\\\\\\"...\\\\\\\"\\\")\\n    actions_table.add_row(f\\\"\\u2192 Export veteran: oralhistory export veteran {veteran_id}\\\")\\n    \\n    console.print(\\\"[dim]Quick actions:[/dim]\\\")\\n    console.print(actions_table)\\n\\n\\n# ============================================================================\\n# Annotate Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.argument(\\\"response_id\\\", required=False)\\n@click.option(\\\"--note\\\", \\\"-n\\\", help=\\\"Add a note\\\")\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Assign to chapter\\\")\\n@click.option(\\\"--flag\\\", \\\"-f\\\", help=\\\"Add a flag\\\")\\n@click.option(\\\"--remove-flag\\\", help=\\\"Remove a flag\\\")\\n@click.option(\\\"--veteran-note\\\", help=\\\"Add note about veteran (not specific response)\\\")\\n@click.option(\\\"--todo\\\", help=\\\"Add research todo\\\")\\ndef annotate(\\n\",\n  \"file_size_bytes\": 85187,\n  \"content_length\": 1187\n}"},"isError":false}} { metadata: undefined }
2025-12-20T17:04:46.629Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"content":"#!/usr/bin/env python3\n\"\"\"Add context command to CLI.\"\"\"\n\ncontext_command = '''\n\n# ============================================================================\n# Context Command (Parent-Child Windowing)\n# ============================================================================\n\n@cli.command()\n@click.argument(\"veteran_id\")\n@click.argument(\"response_id\")\n@click.option(\"--before\", \"-b\", default=2, help=\"Number of responses before target\")\n@click.option(\"--after\", \"-a\", default=2, help=\"Number of responses after target\")\ndef context(veteran_id: str, response_id: str, before: int, after: int):\n    \"\"\"Show context window around a response (Parent-Child view).\n    \n    This is the \"Journalist\" query mode - when you find a quote, you need\n    to see what came before and after to understand the full story.\n    \n    Example: oralhistory context watson_levere 005 --before 3 --after 3\n    \"\"\"\n    try:\n        ctx = ProjectContext()\n    except ValueError:\n        console.print(\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\")\n        return\n    \n    storage = VeteranStorage(ctx)\n    v = storage.load(veteran_id)\n    \n    if not v:\n        console.print(f\"[red]Veteran not found: {veteran_id}[/red]\")\n        return\n    \n    # Find target response index\n    target_idx = None\n    for i, r in enumerate(v.responses):\n        if r.id == response_id:\n            target_idx = i\n            break\n    \n    if target_idx is None:\n        console.print(f\"[red]Response not found: {response_id}[/red]\")\n        console.print(f\"[dim]Available responses: {', '.join([r.id for r in v.responses[:10]])}{'...' if len(v.responses) > 10 else ''}[/dim]\")\n        return\n    \n    # Get context window\n    window, start_idx, end_idx = get_context_window(\n        v.responses, target_idx, before, after\n    )\n    \n    # Header\n    console.print(\"\")\n    console.print(Panel(\n        f\"[bold]CONTEXT WINDOW[/bold] — {v.name} [{response_id}]\\\\n\"\n        f\"[dim]Showing {before} before, {after} after (responses {start_idx+1}-{end_idx})[/dim]\",\n        box=box.DOUBLE,\n        border_style=\"cyan\"\n    ))\n    console.print(\"\")\n    \n    # Display each response in the window\n    for i, r in enumerate(window):\n        actual_idx = start_idx + i\n        is_target = (actual_idx == target_idx)\n        \n        # Determine panel style based on whether this is the target\n        if is_target:\n            border_style = \"yellow\"\n            title_prefix = \">>> TARGET >>> \"\n        else:\n            border_style = \"dim\"\n            title_prefix = \"\"\n        \n        # Build title with metadata\n        title_parts = [f\"{title_prefix}[{r.id}]\"]\n        if r.extracted:\n            if r.extracted.writing_potential == WritingPotential.HIGH:\n                title_parts.append(\"[yellow]★ HIGH[/yellow]\")\n            elif r.extracted.writing_potential == WritingPotential.MEDIUM:\n                title_parts.append(\"[dim]MEDIUM[/dim]\")\n        \n        title = \" \".join(title_parts)\n        \n        # Question panel\n        q_style = \"bold\" if is_target else \"dim\"\n        console.print(f\"[{q_style}]Q: {r.interviewer}[/{q_style}]\")\n        console.print(\"\")\n        \n        # Answer panel\n        answer_panel = Panel(\n            r.veteran,\n            title=title,\n            title_align=\"left\",\n            box=box.ROUNDED,\n            border_style=border_style,\n            padding=(0, 1)\n        )\n        console.print(answer_panel)\n        \n        # Add summary if available and this is the target\n        if is_target and r.extracted and r.extracted.summary:\n            console.print(f\"[dim italic]   Summary: {r.extracted.summary}[/dim italic]\")\n        \n        console.print(\"\")\n    \n    # Quick actions\n    console.print(\"[dim]Quick actions:[/dim]\")\n    console.print(f\"[dim]  → View single: oralhistory view {veteran_id} {response_id}[/dim]\")\n    console.print(f\"[dim]  → Wider context: oralhistory context {veteran_id} {response_id} --before 5 --after 5[/dim]\")\n    console.print(f\"[dim]  → Add note: oralhistory annotate {veteran_id} {response_id} --note \\\\\"...\\\\\"[/dim]\")\n\n\n'''\n\n# Read the file\nwith open(\"/Users/happyhawking/Documents/Projects/Current/writer/src/cli.py\", \"r\") as f:\n    content = f.read()\n\n# Find the insertion point (before Annotate Command section)\nmarker = '''# ============================================================================\n# Annotate Command\n# ============================================================================'''\n\nif marker in content:\n    content = content.replace(marker, context_command + marker)\n    with open(\"/Users/happyhawking/Documents/Projects/Current/writer/src/cli.py\", \"w\") as f:\n        f.write(content)\n    print(\"✓ Added context command to CLI\")\nelse:\n    print(\"ERROR: Could not find insertion marker\")\n","file_path":"/tmp/add_context_cmd.py"}},"jsonrpc":"2.0","id":30} { metadata: undefined }
