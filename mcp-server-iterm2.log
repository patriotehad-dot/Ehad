2025-12-20T16:45:30.087Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":31,"result":{"content":[{"type":"text","text":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/cli.py\",\"content\":\"\\\"\\\"\\\"\\nCLI for the Oral History Research System.\\n\\nA CLI tool for managing WWII oral history transcripts, designed for book research.\\nVeterans are first-class citizens - every search, every passage, every insight\\nstays connected to the person who lived it.\\n\\\"\\\"\\\"\\n\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Optional, List, Dict\\nfrom datetime import datetime\\nimport click\\nfrom rich.console import Console\\nfrom rich.table import Table\\nfrom rich.panel import Panel\\nfrom rich.progress import Progress, SpinnerColumn, TextColumn, BarColumn\\nfrom rich.markdown import Markdown\\nfrom rich import box\\n\\nfrom .config import (\\n    ProjectContext, find_project_root, ensure_project_structure,\\n    create_default_config, load_config\\n)\\nfrom .models import (\\n    Veteran, ServiceDates, SourceInfo, WritingPotential,\\n    TimelineEvent, Relationship, NotableStory, VerificationItem,\\n    Response, DatePrecision, Confidence, VeteranProfile, ThematicStrength\\n)\\nfrom .storage import VeteranStorage, AnnotationStorage, slugify\\nfrom .parser import parse_transcript_file, extract_header_info, TranscriptParser\\nfrom .search import SearchEngine\\nfrom .export import Exporter\\nfrom .llm import get_llm_client, ResponseExtractor, VeteranSynthesizer, NarrativeSynthesizer, DraftWriter\\n\\n\\nconsole = Console()\\n\\n\\n# ============================================================================\\n# Main CLI Group\\n# ============================================================================\\n\\n@click.group()\\n@click.version_option(version=\\\"1.0.0\\\")\\ndef cli():\\n    \\\"\\\"\\\"\\n    Oral History Research System\\n    \\n    A CLI tool for managing WWII oral history transcripts, designed for book research.\\n    Veterans are first-class citizens - every search, every passage, every insight\\n    stays connected to the person who lived it.\\n    \\\"\\\"\\\"\\n    pass\\n\\n\\n# ============================================================================\\n# Init Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--path\\\", type=click.Path(), default=\\\".\\\", help=\\\"Directory to initialize\\\")\\ndef init(path: str):\\n    \\\"\\\"\\\"Initialize a new oral history project.\\\"\\\"\\\"\\n    root = Path(path).resolve()\\n    \\n    if (root / \\\"config.yaml\\\").exists():\\n        console.print(f\\\"[yellow]Project already exists at {root}[/yellow]\\\")\\n        return\\n    \\n    console.print(f\\\"Initializing oral history project at [cyan]{root}[/cyan]\\\")\\n    \\n    # Create directory structure\\n    ensure_project_structure(root)\\n    \\n    # Create config file\\n    config_path = create_default_config(root)\\n    \\n    console.print(\\\"\\\")\\n    console.print(\\\"[green]\\u2713[/green] Created project structure:\\\")\\n    console.print(\\\"  \\u2022 veterans/      - Veteran transcripts\\\")\\n    console.print(\\\"  \\u2022 annotations/   - Your notes and chapter assignments\\\")\\n    console.print(\\\"  \\u2022 index/         - Search indexes\\\")\\n    console.print(\\\"  \\u2022 exports/       - Generated exports\\\")\\n    console.print(f\\\"  \\u2022 config.yaml    - Configuration\\\")\\n    console.print(\\\"\\\")\\n    console.print(\\\"[dim]Next steps:[/dim]\\\")\\n    console.print(\\\"  1. Set your API keys: export ANTHROPIC_API_KEY=... OPENAI_API_KEY=...\\\")\\n    console.print(\\\"  2. Initialize git: git init\\\")\\n    console.print(\\\"  3. Ingest a transcript: oralhistory ingest transcript.txt --veteran \\\\\\\"Name\\\\\\\"\\\")\\n\\n\\n# ============================================================================\\n# Ingest Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"transcript_file\\\", type=click.Path(exists=True))\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", required=True, help=\\\"Veteran's full name\\\")\\n@click.option(\\\"--unit\\\", \\\"-u\\\", help=\\\"Military unit\\\")\\n@click.option(\\\"--rank\\\", \\\"-r\\\", help=\\\"Military rank\\\")\\n@click.option(\\\"--source\\\", \\\"-s\\\", help=\\\"Source description\\\")\\n@click.option(\\\"--dry-run\\\", is_flag=True, help=\\\"Show what would be extracted without saving\\\")\\n@click.option(\\\"--no-embeddings\\\", is_flag=True, help=\\\"Skip generating embeddings (faster, no OpenAI needed)\\\")\\ndef ingest(\\n    transcript_file: str,\\n    veteran: str,\\n    unit: Optional[str],\\n    rank: Optional[str],\\n    source: Optional[str],\\n    dry_run: bool,\\n    no_embeddings: bool\\n):\\n    \\\"\\\"\\\"Ingest a new transcript.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    transcript_path = Path(transcript_file)\\n    veteran_id = slugify(veteran)\\n    \\n    console.print(f\\\"Ingesting transcript for [cyan]{veteran}[/cyan] ({veteran_id})\\\")\\n    console.print(\\\"\\\")\\n    \\n    # Check if veteran already exists\\n    storage = VeteranStorage(ctx)\\n    if storage.exists(veteran_id) and not dry_run:\\n        if not click.confirm(f\\\"Veteran {veteran_id} already exists. Overwrite?\\\"):\\n            return\\n    \\n    # Parse transcript\\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(\\\"Parsing transcript...\\\", total=None)\\n        \\n        # Read file and extract header info\\n        with open(transcript_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n            raw_text = f.read()\\n        \\n        header_info = extract_header_info(raw_text)\\n        responses = parse_transcript_file(transcript_path, veteran_name=veteran)\\n        \\n        progress.update(task, description=f\\\"Parsing transcript... {len(responses)} responses found\\\")\\n    \\n    console.print(f\\\"[green]\\u2713[/green] Parsed: {len(responses)} responses\\\")\\n    \\n    # Apply extracted header info\\n    if not unit and header_info.get(\\\"unit\\\"):\\n        unit = header_info[\\\"unit\\\"]\\n    if not rank and header_info.get(\\\"rank\\\"):\\n        rank = header_info[\\\"rank\\\"]\\n    \\n    # Create veteran object\\n    veteran_obj = Veteran(\\n        id=veteran_id,\\n        name=veteran,\\n        unit=unit,\\n        rank=rank,\\n        source=SourceInfo(\\n            file=transcript_path.name,\\n            date_recorded=header_info.get(\\\"date_recorded\\\"),\\n            location=source,\\n        ),\\n        responses=responses\\n    )\\n    \\n    # Extract metadata with LLM\\n    config = ctx.config\\n    try:\\n        llm_client = get_llm_client(\\n            provider=config.llm.provider,\\n            model=config.llm.model\\n        )\\n        extractor = ResponseExtractor(llm_client)\\n        synthesizer = VeteranSynthesizer(llm_client)\\n        \\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            BarColumn(),\\n            TextColumn(\\\"[progress.percentage]{task.percentage:>3.0f}%\\\"),\\n        ) as progress:\\n            task = progress.add_task(\\\"Extracting metadata...\\\", total=len(responses))\\n            \\n            def update_progress(current, total):\\n                progress.update(task, completed=current)\\n            \\n            extractor.extract_batch(responses, progress_callback=update_progress)\\n        \\n        console.print(f\\\"[green]\\u2713[/green] Extracted metadata for {len(responses)} responses\\\")\\n        \\n        # Synthesize profile\\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            transient=True,\\n        ) as progress:\\n            task = progress.add_task(\\\"Synthesizing veteran profile...\\\", total=None)\\n            veteran_obj = synthesizer.synthesize(veteran_obj)\\n        \\n        console.print(f\\\"[green]\\u2713[/green] Timeline: {len(veteran_obj.timeline)} events\\\")\\n        console.print(f\\\"[green]\\u2713[/green] Relationships: {len(veteran_obj.relationships)} people\\\")\\n        console.print(f\\\"[green]\\u2713[/green] Notable stories: {len(veteran_obj.notable_stories)}\\\")\\n        \\n    except Exception as e:\\n        console.print(f\\\"[yellow]Warning:[/yellow] LLM extraction failed: {e}\\\")\\n        console.print(\\\"  Continuing without metadata extraction...\\\")\\n    \\n    if dry_run:\\n        console.print(\\\"\\\")\\n        console.print(\\\"[yellow]DRY RUN - Not saving[/yellow]\\\")\\n        \\n        # Show sample extraction\\n        console.print(\\\"\\\")\\n        console.print(\\\"[bold]Sample extraction (first response):[/bold]\\\")\\n        if responses and responses[0].extracted:\\n            ext = responses[0].extracted\\n            console.print(f\\\"  Summary: {ext.summary}\\\")\\n            console.print(f\\\"  Topics: {', '.join(ext.topics)}\\\")\\n            console.print(f\\\"  Writing potential: {ext.writing_potential.value}\\\")\\n        \\n        return\\n    \\n    # Save veteran\\n    saved_path = storage.save(veteran_obj)\\n    console.print(f\\\"[green]\\u2713[/green] Saved: {saved_path}\\\")\\n    \\n    # Generate embeddings and index\\n    if not no_embeddings:\\n        try:\\n            with Progress(\\n                SpinnerColumn(),\\n                TextColumn(\\\"[progress.description]{task.description}\\\"),\\n                transient=True,\\n            ) as progress:\\n                task = progress.add_task(\\\"Generating embeddings...\\\", total=None)\\n                \\n                search_engine = SearchEngine(ctx)\\n                total_paragraphs = sum(len(r.paragraphs) for r in responses)\\n                progress.update(task, description=f\\\"Generating embeddings... {total_paragraphs} paragraphs\\\")\\n                \\n                search_engine.index.index_veteran(veteran_obj, generate_embeddings=True)\\n                search_engine.close()\\n            \\n            console.print(f\\\"[green]\\u2713[/green] Indexed: {len(responses)} responses, {total_paragraphs} paragraphs\\\")\\n        except Exception as e:\\n            console.print(f\\\"[yellow]Warning:[/yellow] Embedding generation failed: {e}\\\")\\n            console.print(\\\"  Run 'oralhistory reindex' later to generate embeddings\\\")\\n    \\n    # Show verification items\\n    if veteran_obj.verification_needed:\\n        console.print(\\\"\\\")\\n        console.print(\\\"[yellow]Verification needed:[/yellow]\\\")\\n        for item in veteran_obj.verification_needed:\\n            detail_text = f\\\": {item.detail}\\\" if item.detail else \\\"\\\"\\n            console.print(f\\\"  \\u2022 {item.issue}{detail_text}\\\")\\n            if item.response_ids:\\n                resp_refs = \\\", \\\".join([f\\\"[{r}]\\\" for r in item.response_ids])\\n                console.print(f\\\"    [dim]Responses: {resp_refs}[/dim]\\\")\\n    \\n    # Show notable stories\\n    if veteran_obj.notable_stories:\\n        console.print(\\\"\\\")\\n        console.print(\\\"[bold]Notable stories found:[/bold]\\\")\\n        for story in veteran_obj.notable_stories:\\n            potential = \\\"\\u2605 HIGH\\\" if story.writing_potential == WritingPotential.HIGH else story.writing_potential.value\\n            console.print(f\\\"  \\u2022 \\\\\\\"{story.title}\\\\\\\" ({potential})\\\")\\n\\n    # Prompt for immediate verification\\n    if not dry_run:\\n        console.print(\\\"\\\")\\n        if click.confirm(f\\\"Start interactive verification for [cyan]{veteran}[/cyan] now?\\\", default=True):\\n            run_interactive_verification(veteran_obj, storage, ctx)\\n        else:\\n            console.print(f\\\"\\\\n[bold yellow]>>> Run 'oralhistory verify {veteran_id}' later to audit this data.[/bold yellow]\\\")\\n\\n\\n# ============================================================================\\n# Search Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"query\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=20, help=\\\"Maximum results\\\")\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", help=\\\"Filter to specific veteran\\\")\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Filter to chapter\\\")\\n@click.option(\\\"--topic\\\", \\\"-t\\\", help=\\\"Filter by topic\\\")\\n@click.option(\\\"--potential\\\", \\\"-p\\\", type=click.Choice([\\\"low\\\", \\\"medium\\\", \\\"high\\\"]), help=\\\"Filter by writing potential\\\")\\n@click.option(\\\"--export\\\", \\\"export_name\\\", help=\\\"Export results to file\\\")\\ndef search(\\n    query: str,\\n    limit: int,\\n    veteran: Optional[str],\\n    chapter: Optional[int],\\n    topic: Optional[str],\\n    potential: Optional[str],\\n    export_name: Optional[str]\\n):\\n    \\\"\\\"\\\"Search across all veterans.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(\\\"Searching...\\\", total=None)\\n        \\n        results = search_engine.search(\\n            query=query,\\n            limit=limit,\\n            veteran_id=veteran,\\n            chapter=chapter,\\n            topic=topic,\\n            potential=potential\\n        )\\n    \\n    search_engine.close()\\n    \\n    if not results.hits:\\n        console.print(f\\\"[yellow]No results found for:[/yellow] {query}\\\")\\n        return\\n    \\n    # Display results\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        f\\\"[bold]SEARCH:[/bold] \\\\\\\"{query}\\\\\\\" ({results.veteran_count} veterans, {results.total_hits} responses)\\\",\\n        box=box.DOUBLE\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Group by veteran to avoid fragmented output\\n    from collections import defaultdict\\n    grouped_hits = defaultdict(list)\\n    for hit in results.hits:\\n        grouped_hits[hit.veteran_id].append(hit)\\n    \\n    # Get veteran names/info for sorting headers\\n    # We sort by the highest score in each group so the most relevant veteran stays at the top\\n    sorted_veterans = sorted(\\n        grouped_hits.items(), \\n        key=lambda x: max(h.score for h in x[1]), \\n        reverse=True\\n    )\\n    \\n    for _, hits in sorted_veterans:\\n        # Get first hit for veteran metadata\\n        first_hit = hits[0]\\n        \\n        header = f\\\"[bold cyan]{first_hit.veteran_name}[/bold cyan]\\\"\\n        if first_hit.unit or first_hit.rank:\\n            parts = []\\n            if first_hit.unit:\\n                parts.append(first_hit.unit)\\n            if first_hit.rank:\\n                parts.append(first_hit.rank)\\n            header += f\\\" [dim]({' | '.join(parts)})[/dim]\\\"\\n        \\n        console.print(\\\"\\\")\\n        console.print(Panel(header, box=box.ROUNDED, border_style=\\\"cyan\\\"))\\n        \\n        for hit in hits:\\n            # Response\\n            response = hit.response\\n            \\n            # Build metadata table for response header\\n            meta_table = Table(show_header=False, box=None, padding=(0, 1), expand=True)\\n            meta_table.add_column(\\\"ID\\\", style=\\\"cyan bold\\\", width=8)\\n            meta_table.add_column(\\\"Potential\\\", width=14)\\n            meta_table.add_column(\\\"Chapter\\\", width=12)\\n            meta_table.add_column(\\\"Topic\\\", style=\\\"dim\\\", min_width=40)\\n            \\n            # Format potential\\n            if response.extracted and response.extracted.writing_potential == WritingPotential.HIGH:\\n                potential_str = \\\"[yellow]\\u2605 HIGH[/yellow]\\\"\\n            elif response.extracted and response.extracted.writing_potential == WritingPotential.MEDIUM:\\n                potential_str = \\\"[dim]MEDIUM[/dim]\\\"\\n            else:\\n                potential_str = \\\"[dim]LOW[/dim]\\\"\\n            \\n            # Format chapter\\n            chapter_str = f\\\"Ch. {hit.chapter}\\\" if hit.chapter else \\\"[dim]\\u2014[/dim]\\\"\\n            \\n            # Format topic\\n            topic_str = response.extracted.summary[:50] + \\\"...\\\" if response.extracted and len(response.extracted.summary) > 50 else (response.extracted.summary if response.extracted else \\\"\\\")\\n            \\n            meta_table.add_row(f\\\"[{response.id}]\\\", potential_str, chapter_str, topic_str)\\n            console.print(meta_table)\\n            \\n            # LLM note and user notes\\n            if response.extracted and response.extracted.writing_note:\\n                console.print(f\\\"  [dim italic]LLM: \\\\\\\"{response.extracted.writing_note}\\\\\\\"[/dim italic]\\\")\\n            \\n            if hit.notes:\\n                for note in hit.notes:\\n                    console.print(f\\\"  [yellow]\\ud83d\\udcdd {note.text}[/yellow]\\\")\\n            \\n            # Question and Answer in a cleaner format\\n            console.print(\\\"\\\")\\n            q = response.interviewer[:200] + \\\"...\\\" if len(response.interviewer) > 200 else response.interviewer\\n            console.print(f\\\"  [bold dim]Q:[/bold dim] [italic]{q}[/italic]\\\")\\n            console.print(\\\"\\\")\\n            \\n            # Answer excerpt with better wrapping\\n            a = response.veteran[:500] + \\\"...\\\" if len(response.veteran) > 500 else response.veteran\\n            # Clean up multi-line for display\\n            a_clean = \\\" \\\".join(a.split())\\n            console.print(f\\\"  [bold dim]A:[/bold dim] \\\\\\\"{a_clean}\\\\\\\"\\\")\\n            \\n            console.print(\\\"\\\")\\n            console.print(f\\\"  [dim]\\u2500\\u2500\\u2500 oralhistory view {hit.veteran_id} {response.id} \\u2500\\u2500\\u2500[/dim]\\\")\\n            console.print(\\\"\\\")\\n    \\n    # Export if requested\\n    if export_name:\\n        exporter = Exporter(ctx)\\n        output_path = exporter.export_search_results(results, f\\\"{export_name}.md\\\")\\n        console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Veterans Command\\n# ============================================================================\\n\\n@cli.command()\\ndef veterans():\\n    \\\"\\\"\\\"List all veterans.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    veteran_ids = storage.list_veterans()\\n    \\n    if not veteran_ids:\\n        console.print(\\\"[yellow]No veterans found. Run 'oralhistory ingest' to add transcripts.[/yellow]\\\")\\n        return\\n    \\n    table = Table(title=f\\\"VETERANS ({len(veteran_ids)} total)\\\", box=box.ROUNDED)\\n    table.add_column(\\\"ID\\\", style=\\\"cyan\\\")\\n    table.add_column(\\\"Name\\\")\\n    table.add_column(\\\"Unit\\\")\\n    table.add_column(\\\"Responses\\\", justify=\\\"right\\\")\\n    \\n    for vid in sorted(veteran_ids):\\n        v = storage.load(vid)\\n        if v:\\n            table.add_row(\\n                vid,\\n                v.name,\\n                v.unit or \\\"-\\\",\\n                str(len(v.responses))\\n            )\\n    \\n    console.print(table)\\n\\n\\n# ============================================================================\\n# Verify Command (Interactive)\\n# ============================================================================\\n\\ndef run_interactive_verification(v: Veteran, storage: VeteranStorage, ctx: ProjectContext):\\n    \\\"\\\"\\\"Run the interactive verification loop for a veteran.\\\"\\\"\\\"\\n    console.print(Panel(f\\\"Interactive Verification: [bold]{v.name}[/bold]\\\", border_style=\\\"yellow\\\"))\\n    \\n    # 1. Identity Check\\n    console.print(\\\"\\\\n[bold]1. Identity Verification[/bold]\\\")\\n    \\n    # Name\\n    if not click.confirm(f\\\"Name: [cyan]{v.name}[/cyan]. Is this correct?\\\", default=True):\\n        v.name = click.prompt(\\\"Enter correct name\\\", default=v.name)\\n        \\n    # Rank\\n    if not click.confirm(f\\\"Rank: [cyan]{v.rank or 'None'}[/cyan]. Is this correct?\\\", default=True):\\n        v.rank = click.prompt(\\\"Enter correct rank\\\", default=v.rank or \\\"\\\")\\n        \\n    # Unit\\n    if not click.confirm(f\\\"Unit: [cyan]{v.unit or 'None'}[/cyan]. Is this correct?\\\", default=True):\\n        v.unit = click.prompt(\\\"Enter correct unit\\\", default=v.unit or \\\"\\\")\\n        \\n    # 2. Timeline Check (Low confidence items)\\n    if v.timeline:\\n        console.print(\\\"\\\\n[bold]2. Timeline Verification[/bold]\\\")\\n        for event in v.timeline:\\n            if event.confidence != Confidence.STATED or event.note:\\n                console.print(f\\\"\\\\nEvent: [cyan]{event.date}[/cyan] - {event.event}\\\")\\n                if event.note:\\n                    console.print(f\\\"[yellow]Note:[/yellow] {event.note}\\\")\\n                \\n                choice = click.prompt(\\n                    \\\"Action: [v]iew sources, [e]dit event, [c]onfirm, [s]kip\\\",\\n                    type=click.Choice(['v', 'e', 'c', 's']),\\n                    default='c'\\n                )\\n                \\n                if choice == 'v':\\n                    _display_verify_sources(v, event.response_ids)\\n                    # Prompt again after viewing\\n                    choice = click.prompt(\\n                        \\\"Action: [e]dit event, [c]onfirm, [s]kip\\\",\\n                        type=click.Choice(['e', 'c', 's']),\\n                        default='c'\\n                    )\\n                \\n                if choice == 'e':\\n                    event.date = click.prompt(\\\"Date\\\", default=event.date)\\n                    event.event = click.prompt(\\\"Event description\\\", default=event.event)\\n                    event.confidence = Confidence.STATED\\n                    event.note = None\\n                elif choice == 'c':\\n                    event.confidence = Confidence.STATED\\n                    event.note = None\\n\\n    # 3. LLM Flags (Verification Needed)\\n    if v.verification_needed:\\n        console.print(\\\"\\\\n[bold]3. Resolving LLM Flags[/bold]\\\")\\n        items_to_keep = []\\n        for item in v.verification_needed:\\n            console.print(f\\\"\\\\n[yellow]ISSUE:[/yellow] {item.issue}\\\")\\n            if item.detail:\\n                console.print(f\\\"[dim]{item.detail}[/dim]\\\")\\n            \\n            choice = click.prompt(\\n                \\\"Action: [v]iew sources, [r]esolve/remove, [k]eep flag, [s]kip\\\",\\n                type=click.Choice(['v', 'r', 'k', 's']),\\n                default='r'\\n            )\\n            \\n            if choice == 'v':\\n                _display_verify_sources(v, item.response_ids)\\n                choice = click.prompt(\\n                    \\\"Action: [r]esolve/remove, [k]eep flag, [s]kip\\\",\\n                    type=click.Choice(['r', 'k', 's']),\\n                    default='r'\\n                )\\n            \\n            if choice == 'k' or choice == 's':\\n                items_to_keep.append(item)\\n            elif choice == 'r':\\n                console.print(\\\"[green]Flag resolved.[/green]\\\")\\n                \\n        v.verification_needed = items_to_keep\\n\\n    # Save and Reindex\\n    v.verified = True\\n    storage.save(v)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        progress.add_task(\\\"Updating search index...\\\", total=None)\\n        search_engine = SearchEngine(ctx)\\n        search_engine.index.index_veteran(v)\\n        search_engine.close()\\n        \\n    console.print(f\\\"\\\\n[green]\\u2713[/green] Verification complete. Data saved and re-indexed.\\\")\\n\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\ndef verify(veteran_id: str):\\n    \\\"\\\"\\\"Interactive wizard to verify and correct veteran data.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    v = storage.load(veteran_id)\\n    \\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n        \\n    run_interactive_verification(v, storage, ctx)\\n\\n\\n# ============================================================================\\n# Rich Display Helper Functions\\n# ============================================================================\\n\\ndef _format_timeline_table(events: List[TimelineEvent]) -> Table:\\n    \\\"\\\"\\\"Format timeline events into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold cyan\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"Date\\\", style=\\\"bold\\\", width=20, no_wrap=True)\\n    table.add_column(\\\"Event\\\", style=\\\"\\\", min_width=40)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    table.add_column(\\\"\\\", width=3, justify=\\\"center\\\")  # Status indicator\\n    \\n    for event in events:\\n        # Format date with precision indicator\\n        date_str = event.date\\n        # Only add ~ if not already present and precision is approximate\\n        if event.date_precision == DatePrecision.APPROXIMATE and not date_str.startswith(\\\"~\\\"):\\n            date_str = f\\\"~{date_str}\\\"\\n        \\n        # Format response IDs\\n        if event.response_ids:\\n            resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in event.response_ids[:3]])\\n            if len(event.response_ids) > 3:\\n                resp_refs += f\\\" +{len(event.response_ids) - 3}\\\"\\n        else:\\n            resp_refs = \\\"[dim]\\u2014[/dim]\\\"\\n        \\n        # Format verification status\\n        if event.note:\\n            status = \\\"[yellow]\\u26a0[/yellow]\\\"\\n        elif event.confidence == Confidence.INFERRED:\\n            status = \\\"[dim]?[/dim]\\\"\\n        else:\\n            status = \\\"[green]\\u2713[/green]\\\"\\n        \\n        table.add_row(date_str, event.event, resp_refs, status)\\n    \\n    return table\\n\\n\\ndef _format_relationships_table(relationships: List[Relationship]) -> Table:\\n    \\\"\\\"\\\"Format relationships into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold cyan\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"Name\\\", style=\\\"bold\\\", width=18)\\n    table.add_column(\\\"Role\\\", style=\\\"dim\\\", width=15)\\n    table.add_column(\\\"Context\\\", style=\\\"\\\", min_width=30)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    \\n    for rel in relationships:\\n        resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in rel.response_ids]) if rel.response_ids else \\\"[dim]\\u2014[/dim]\\\"\\n        table.add_row(\\n            rel.canonical,\\n            rel.role or \\\"[dim]\\u2014[/dim]\\\",\\n            rel.context or \\\"[dim]\\u2014[/dim]\\\",\\n            resp_refs\\n        )\\n    \\n    return table\\n\\n\\ndef _format_stories_table(stories: List[NotableStory]) -> Table:\\n    \\\"\\\"\\\"Format notable stories into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold yellow\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"\\\", width=3)  # Star indicator\\n    table.add_column(\\\"Title\\\", style=\\\"bold\\\", min_width=25)\\n    table.add_column(\\\"Summary\\\", style=\\\"\\\", min_width=40)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    \\n    for story in stories:\\n        if story.writing_potential == WritingPotential.HIGH:\\n            star = \\\"[yellow]\\u2605[/yellow]\\\"\\n        elif story.writing_potential == WritingPotential.MEDIUM:\\n            star = \\\"[dim]\\u2606[/dim]\\\"\\n        else:\\n            star = \\\"[dim]\\u00b7[/dim]\\\"\\n        \\n        resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in story.response_ids]) if story.response_ids else \\\"[dim]\\u2014[/dim]\\\"\\n        \\n        # Truncate summary if too long\\n        summary = story.summary\\n        if len(summary) > 80:\\n            summary = summary[:77] + \\\"...\\\"\\n        \\n        table.add_row(star, story.title, summary, resp_refs)\\n    \\n    return table\\n\\n\\ndef _format_verification_table(items: List[VerificationItem]) -> Table:\\n    \\\"\\\"\\\"Format verification items into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold yellow\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"\\\", width=3)  # Warning icon\\n    table.add_column(\\\"Issue\\\", style=\\\"yellow\\\", width=22)\\n    table.add_column(\\\"Detail\\\", style=\\\"\\\", min_width=35)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    \\n    for item in items:\\n        resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in item.response_ids]) if item.response_ids else \\\"[dim]\\u2014[/dim]\\\"\\n        detail = item.detail if item.detail else \\\"[dim]No details[/dim]\\\"\\n        if len(detail) > 60:\\n            detail = detail[:57] + \\\"...\\\"\\n        \\n        table.add_row(\\\"[yellow]\\u26a0[/yellow]\\\", item.issue, detail, resp_refs)\\n    \\n    return table\\n\\n\\ndef _format_responses_table(responses: List[Response]) -> Table:\\n    \\\"\\\"\\\"Format responses list into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold cyan\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"ID\\\", style=\\\"cyan\\\", width=6)\\n    table.add_column(\\\"Potential\\\", width=10, justify=\\\"center\\\")\\n    table.add_column(\\\"Summary\\\", style=\\\"\\\", min_width=50)\\n    \\n    for r in responses:\\n        potential = \\\"[dim]\\u2014[/dim]\\\"\\n        if r.extracted:\\n            if r.extracted.writing_potential == WritingPotential.HIGH:\\n                potential = \\\"[yellow]\\u2605 HIGH[/yellow]\\\"\\n            elif r.extracted.writing_potential == WritingPotential.MEDIUM:\\n                potential = \\\"[dim]MEDIUM[/dim]\\\"\\n            else:\\n                potential = \\\"[dim]LOW[/dim]\\\"\\n        \\n        summary = r.extracted.summary if r.extracted else r.veteran[:80] + \\\"...\\\"\\n        if len(summary) > 80:\\n            summary = summary[:77] + \\\"...\\\"\\n        \\n        table.add_row(f\\\"[{r.id}]\\\", potential, summary)\\n    \\n    return table\\n\\n\\ndef _display_verify_sources(veteran: Veteran, response_ids: List[str]):\\n    \\\"\\\"\\\"Display full responses for verification.\\\"\\\"\\\"\\n    if not response_ids:\\n        console.print(\\\"[dim]No source responses linked.[/dim]\\\")\\n        return\\n        \\n    for rid in response_ids:\\n        # Find response\\n        response = next((r for r in veteran.responses if r.id == rid), None)\\n        if response:\\n            console.print(Panel(\\n                f\\\"[italic]Q: {response.interviewer}[/italic]\\\\n\\\\n{response.veteran}\\\",\\n                title=f\\\"Response [{rid}]\\\",\\n                border_style=\\\"cyan\\\",\\n                box=box.ROUNDED\\n            ))\\n        else:\\n            console.print(f\\\"[red]Response {rid} not found.[/red]\\\")\\n\\n\\n# ============================================================================\\n# Veteran Command (show single)\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.option(\\\"--timeline\\\", is_flag=True, help=\\\"Show timeline only\\\")\\n@click.option(\\\"--relationships\\\", is_flag=True, help=\\\"Show relationships only\\\")\\n@click.option(\\\"--responses\\\", is_flag=True, help=\\\"Show all responses\\\")\\n@click.option(\\\"--response\\\", \\\"response_id\\\", help=\\\"Show specific response\\\")\\ndef veteran(\\n    veteran_id: str,\\n    timeline: bool,\\n    relationships: bool,\\n    responses: bool,\\n    response_id: Optional[str]\\n):\\n    \\\"\\\"\\\"Show veteran profile.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    v = storage.load(veteran_id)\\n    \\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    # Header with name\\n    console.print(Panel(f\\\"[bold]{v.name}[/bold]\\\", box=box.DOUBLE, border_style=\\\"cyan\\\"))\\n    \\n    # Profile info table\\n    info_table = Table(show_header=False, box=None, padding=(0, 2), expand=True)\\n    info_table.add_column(\\\"Label\\\", style=\\\"bold\\\", width=10)\\n    info_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n    \\n    if v.unit:\\n        # Truncate long unit names\\n        unit_display = v.unit if len(v.unit) < 60 else v.unit[:57] + \\\"...\\\"\\n        info_table.add_row(\\\"Unit:\\\", unit_display)\\n    if v.rank:\\n        info_table.add_row(\\\"Rank:\\\", v.rank)\\n    if v.service_dates:\\n        dates = []\\n        if v.service_dates.start:\\n            dates.append(v.service_dates.start)\\n        if v.service_dates.end:\\n            dates.append(v.service_dates.end)\\n        if dates:\\n            info_table.add_row(\\\"Service:\\\", \\\" \\u2014 \\\".join(dates))\\n    if v.source:\\n        source_str = v.source.file\\n        if v.source.date_recorded:\\n            source_str += f\\\" [dim](Recorded: {v.source.date_recorded})[/dim]\\\"\\n        info_table.add_row(\\\"Source:\\\", source_str)\\n    \\n    # Add stats row\\n    stats_parts = []\\n    stats_parts.append(f\\\"{len(v.responses)} responses\\\")\\n    if v.timeline:\\n        stats_parts.append(f\\\"{len(v.timeline)} timeline events\\\")\\n    if v.relationships:\\n        stats_parts.append(f\\\"{len(v.relationships)} people\\\")\\n    if v.notable_stories:\\n        stats_parts.append(f\\\"{len(v.notable_stories)} notable stories\\\")\\n    info_table.add_row(\\\"Stats:\\\", \\\" | \\\".join(stats_parts))\\n    \\n    console.print(info_table)\\n    console.print(\\\"\\\")\\n    \\n    # Timeline\\n    if timeline or (not relationships and not responses and not response_id):\\n        if v.timeline:\\n            console.print(Panel(\\n                f\\\"[bold]TIMELINE[/bold] \\u2014 {len(v.timeline)} events\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"cyan\\\"\\n            ))\\n            \\n            timeline_table = _format_timeline_table(v.timeline)\\n            console.print(timeline_table)\\n            \\n            # Legend\\n            console.print(\\\"[dim]  ~ = approximate date  |  \\u2713 = verified  |  \\u26a0 = needs verification  |  ? = inferred[/dim]\\\")\\n            console.print(\\\"\\\")\\n    \\n    # Relationships\\n    if relationships or (not timeline and not responses and not response_id):\\n        if v.relationships:\\n            console.print(Panel(\\n                f\\\"[bold]RELATIONSHIPS[/bold] \\u2014 {len(v.relationships)} people\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"cyan\\\"\\n            ))\\n            \\n            relationships_table = _format_relationships_table(v.relationships)\\n            console.print(relationships_table)\\n            console.print(\\\"\\\")\\n    \\n    # Notable stories\\n    if not timeline and not relationships and not responses and not response_id:\\n        if v.notable_stories:\\n            console.print(Panel(\\n                f\\\"[bold]NOTABLE STORIES[/bold] \\u2014 {len(v.notable_stories)} stories\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"yellow\\\"\\n            ))\\n            \\n            stories_table = _format_stories_table(v.notable_stories)\\n            console.print(stories_table)\\n            \\n            # Legend\\n            console.print(\\\"[dim]  \\u2605 = HIGH potential  |  \\u2606 = MEDIUM potential  |  \\u00b7 = LOW potential[/dim]\\\")\\n            console.print(\\\"\\\")\\n        \\n        # Verification needed\\n        if v.verification_needed:\\n            console.print(Panel(\\n                f\\\"[bold]VERIFICATION NEEDED[/bold] \\u2014 {len(v.verification_needed)} items\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"yellow\\\"\\n            ))\\n            \\n            verification_table = _format_verification_table(v.verification_needed)\\n            console.print(verification_table)\\n            console.print(\\\"\\\")\\n    \\n    # Show specific response\\n    if response_id:\\n        for r in v.responses:\\n            if r.id == response_id:\\n                console.print(f\\\"[bold]RESPONSE [{r.id}][/bold]\\\")\\n                console.print(\\\"\\u2500\\\" * 60)\\n                console.print(\\\"\\\")\\n                console.print(f\\\"[italic]Q: {r.interviewer}[/italic]\\\")\\n                console.print(\\\"\\\")\\n                console.print(r.veteran)\\n                console.print(\\\"\\\")\\n                \\n                if r.extracted:\\n                    console.print(\\\"[bold]Extracted metadata:[/bold]\\\")\\n                    console.print(f\\\"  Summary: {r.extracted.summary}\\\")\\n                    console.print(f\\\"  Topics: {', '.join(r.extracted.topics)}\\\")\\n                    console.print(f\\\"  Potential: {r.extracted.writing_potential.value}\\\")\\n                    if r.extracted.writing_note:\\n                        console.print(f\\\"  Note: {r.extracted.writing_note}\\\")\\n                break\\n        else:\\n            console.print(f\\\"[red]Response not found: {response_id}[/red]\\\")\\n    \\n    # Show all responses\\n    if responses:\\n        console.print(Panel(\\n            f\\\"[bold]ALL RESPONSES[/bold] \\u2014 {len(v.responses)} responses\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        responses_table = _format_responses_table(v.responses)\\n        console.print(responses_table)\\n        \\n        # Hint for viewing full responses\\n        console.print(f\\\"[dim]  Use: oralhistory view {veteran_id} <ID> to see full text[/dim]\\\")\\n        console.print(\\\"\\\")\\n\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.option(\\\"--refresh\\\", is_flag=True, help=\\\"Re-generate the synthesis\\\")\\ndef profile(veteran_id: str, refresh: bool):\\n    \\\"\\\"\\\"Show high-level narrative synthesis for a veteran.\\n    \\n    Analyzes the entire interview to identify narrative themes, writing potential,\\n    and specific strengths for your book.\\n    \\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    v = storage.load(veteran_id)\\n    \\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    if not v.profile or refresh:\\n        llm_client = get_llm_client(\\n            provider=ctx.config.llm.provider,\\n            model=ctx.config.llm.model\\n        )\\n        synthesizer = NarrativeSynthesizer(llm_client)\\n        \\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            transient=True,\\n        ) as progress:\\n            task = progress.add_task(\\\"Generating narrative profile...\\\", total=None)\\n            v.profile = synthesizer.synthesize_profile(v)\\n            storage.save(v)\\n        \\n        console.print(f\\\"[green]\\u2713[/green] Narrative profile generated for [cyan]{v.name}[/cyan]\\\")\\n        console.print(\\\"\\\")\\n\\n    p = v.profile\\n    if not p:\\n        console.print(\\\"[red]Error: Could not load or generate profile.[/red]\\\")\\n        return\\n\\n    console.print(Panel(f\\\"[bold]{v.name}[/bold] \\u2014 Researcher's Brief\\\", box=box.DOUBLE, border_style=\\\"cyan\\\"))\\n    \\n    console.print(f\\\"[bold]Overview:[/bold]\\\\n{p.overview}\\\\n\\\")\\n    console.print(f\\\"[bold]Narrative Style:[/bold] {p.narrative_style}\\\\n\\\")\\n    \\n    # Thematic Strengths Table\\n    table = Table(title=\\\"THEMATIC STRENGTHS\\\", box=box.ROUNDED, expand=True)\\n    table.add_column(\\\"Theme\\\", style=\\\"bold cyan\\\", width=15)\\n    table.add_column(\\\"Potential\\\", width=10)\\n    table.add_column(\\\"Synthesis\\\", style=\\\"\\\", min_width=40)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim\\\", width=12)\\n    \\n    for ts in p.thematic_strengths:\\n        potential = \\\"[dim]\\u2014[/dim]\\\"\\n        if ts.strength == WritingPotential.HIGH:\\n            potential = \\\"[yellow]\\u2605 HIGH[/yellow]\\\"\\n        elif ts.strength == WritingPotential.MEDIUM:\\n            potential = \\\"[dim]MEDIUM[/dim]\\\"\\n        else:\\n            potential = \\\"[dim]LOW[/dim]\\\"\\n            \\n        sources = \\\" \\\".join([f\\\"[{r}]\\\" for r in ts.response_ids[:3]])\\n        if len(ts.response_ids) > 3:\\n            sources += f\\\" +{len(ts.response_ids)-3}\\\"\\n            \\n        table.add_row(ts.theme, potential, ts.summary, sources)\\n    \\n    console.print(table)\\n    console.print(\\\"\\\")\\n    \\n    # Key Entities\\n    if p.key_entities:\\n        console.print(f\\\"[bold]Key Entities:[/bold] {', '.join(p.key_entities)}\\\\n\\\")\\n        \\n    # Writing Advice\\n    console.print(Panel(p.writing_advice, title=\\\"[bold yellow]WRITING ADVICE[/bold yellow]\\\", box=box.ROUNDED))\\n    \\n    console.print(f\\\"\\\\n[dim]Last updated: {p.last_updated}[/dim]\\\")\\n\\n\\n@cli.command()\\n@click.argument(\\\"query\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=10, help=\\\"Number of accounts to synthesize\\\")\\ndef topic(query: str, limit: int):\\n    \\\"\\\"\\\"Synthesize a cross-veteran narrative on a specific topic.\\n    \\n    Searches across all veterans for the topic and uses an LLM to write\\n    a consolidated account with citations to specific response IDs.\\n    \\n    Example: oralhistory topic \\\"Battle of the Bulge Bastogne\\\"\\n    \\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    llm_client = get_llm_client(\\n        provider=ctx.config.llm.provider,\\n        model=ctx.config.llm.model\\n    )\\n    synthesizer = NarrativeSynthesizer(llm_client)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(f\\\"Searching for accounts of '{query}'...\\\", total=None)\\n        results = search_engine.search(query, limit=limit)\\n        \\n        if not results.hits:\\n            console.print(f\\\"[yellow]No accounts found for:[/yellow] {query}\\\")\\n            return\\n            \\n        progress.update(task, description=f\\\"Synthesizing {len(results.hits)} accounts into narrative...\\\")\\n        synthesis = synthesizer.synthesize_topic(query, results.hits)\\n    \\n    console.print(\\\"\\\")\\n    console.print(Markdown(synthesis))\\n    console.print(\\\"\\\")\\n    \\n    # Show source summary\\n    console.print(\\\"[dim]Sources used in this synthesis:[/dim]\\\")\\n    source_table = Table(show_header=False, box=None, padding=(0, 1))\\n    source_table.add_column(\\\"ID\\\", style=\\\"dim cyan\\\")\\n    source_table.add_column(\\\"Name\\\", style=\\\"dim\\\")\\n    \\n    unique_vets = {}\\n    for hit in results.hits:\\n        unique_vets[hit.veteran_id] = hit.veteran_name\\n        \\n    for vid, name in sorted(unique_vets.items()):\\n        source_table.add_row(vid, name)\\n        \\n    console.print(source_table)\\n    console.print(f\\\"\\\\n[dim]Total responses analyzed: {len(results.hits)}[/dim]\\\")\\n\\n\\n# ============================================================================\\n# View Command (Full Passage Preview)\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.argument(\\\"response_id\\\")\\ndef view(veteran_id: str, response_id: str):\\n    \\\"\\\"\\\"View full text of a specific response.\\n    \\n    Shows the complete, untruncated interviewer question and veteran answer,\\n    along with extracted metadata and any annotations.\\n    \\n    Example: oralhistory view mitchell_james 005\\n    \\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    veteran_storage = VeteranStorage(ctx)\\n    annotation_storage = AnnotationStorage(ctx)\\n    \\n    # Load veteran\\n    v = veteran_storage.load(veteran_id)\\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    # Find response\\n    response = None\\n    for r in v.responses:\\n        if r.id == response_id:\\n            response = r\\n            break\\n    \\n    if not response:\\n        console.print(f\\\"[red]Response not found: {response_id}[/red]\\\")\\n        console.print(f\\\"[dim]Available responses: {', '.join([r.id for r in v.responses[:10]])}{'...' if len(v.responses) > 10 else ''}[/dim]\\\")\\n        return\\n    \\n    # Load annotations\\n    annotations = annotation_storage.load(veteran_id)\\n    resp_annot = annotations.response_annotations.get(response_id)\\n    \\n    # Header\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        f\\\"[bold]{v.name}[/bold] \\u2014 Response [{response_id}]\\\",\\n        box=box.DOUBLE\\n    ))\\n    \\n    # Metadata info table\\n    info_table = Table(show_header=False, box=None, padding=(0, 2))\\n    info_table.add_column(\\\"Label\\\", style=\\\"bold\\\", width=10)\\n    info_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n    \\n    if v.unit:\\n        unit_display = v.unit if len(v.unit) < 50 else v.unit[:47] + \\\"...\\\"\\n        info_table.add_row(\\\"Unit:\\\", unit_display)\\n    if v.rank:\\n        info_table.add_row(\\\"Rank:\\\", v.rank)\\n    if resp_annot and resp_annot.chapter:\\n        info_table.add_row(\\\"Chapter:\\\", str(resp_annot.chapter))\\n    if response.extracted:\\n        potential = response.extracted.writing_potential.value.upper()\\n        if response.extracted.writing_potential == WritingPotential.HIGH:\\n            potential = f\\\"[yellow]\\u2605 {potential}[/yellow]\\\"\\n        info_table.add_row(\\\"Potential:\\\", potential)\\n    \\n    console.print(info_table)\\n    console.print(\\\"\\\")\\n    \\n    # Interviewer question in a panel\\n    console.print(Panel(\\n        f\\\"[italic]{response.interviewer}[/italic]\\\",\\n        title=\\\"[bold cyan]INTERVIEWER[/bold cyan]\\\",\\n        title_align=\\\"left\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"cyan\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Veteran response in a panel\\n    console.print(Panel(\\n        response.veteran,\\n        title=\\\"[bold green]VETERAN[/bold green]\\\",\\n        title_align=\\\"left\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"green\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Extracted metadata in a table\\n    if response.extracted:\\n        console.print(Panel(\\n            \\\"[bold]EXTRACTED METADATA[/bold]\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"dim\\\"\\n        ))\\n        \\n        meta_table = Table(show_header=False, box=box.SIMPLE, padding=(0, 1), expand=True)\\n        meta_table.add_column(\\\"Field\\\", style=\\\"bold\\\", width=12)\\n        meta_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n        \\n        meta_table.add_row(\\\"Summary:\\\", response.extracted.summary)\\n        \\n        if response.extracted.topics:\\n            meta_table.add_row(\\\"Topics:\\\", \\\", \\\".join(response.extracted.topics))\\n        \\n        if response.extracted.locations:\\n            meta_table.add_row(\\\"Locations:\\\", \\\", \\\".join(response.extracted.locations))\\n        \\n        if response.extracted.people:\\n            people_str = \\\", \\\".join([p.name for p in response.extracted.people])\\n            meta_table.add_row(\\\"People:\\\", people_str)\\n        \\n        if response.extracted.dates:\\n            dates_str = \\\"; \\\".join([f\\\"{d.value} ({d.context})\\\" for d in response.extracted.dates])\\n            meta_table.add_row(\\\"Dates:\\\", dates_str)\\n        \\n        if response.extracted.writing_note:\\n            meta_table.add_row(\\\"LLM Note:\\\", f\\\"[italic]{response.extracted.writing_note}[/italic]\\\")\\n        \\n        console.print(meta_table)\\n        console.print(\\\"\\\")\\n    \\n    # Annotations in a table\\n    if resp_annot:\\n        if resp_annot.notes or resp_annot.flags:\\n            console.print(Panel(\\n                \\\"[bold]YOUR ANNOTATIONS[/bold]\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"yellow\\\"\\n            ))\\n            \\n            annot_table = Table(show_header=False, box=box.SIMPLE, padding=(0, 1))\\n            annot_table.add_column(\\\"Field\\\", style=\\\"bold\\\", width=10)\\n            annot_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n            \\n            for note in resp_annot.notes:\\n                annot_table.add_row(f\\\"[{note.date}]\\\", note.text)\\n            \\n            if resp_annot.flags:\\n                annot_table.add_row(\\\"Flags:\\\", \\\"[yellow]\\\" + \\\", \\\".join(resp_annot.flags) + \\\"[/yellow]\\\")\\n            \\n            console.print(annot_table)\\n            console.print(\\\"\\\")\\n    \\n    # Quick actions in a subtle box\\n    actions_table = Table(show_header=False, box=None, padding=(0, 1))\\n    actions_table.add_column(\\\"\\\", style=\\\"dim\\\")\\n    actions_table.add_row(f\\\"\\u2192 Assign chapter: oralhistory annotate {veteran_id} {response_id} --chapter N\\\")\\n    actions_table.add_row(f\\\"\\u2192 Add note: oralhistory annotate {veteran_id} {response_id} --note \\\\\\\"...\\\\\\\"\\\")\\n    actions_table.add_row(f\\\"\\u2192 Export veteran: oralhistory export veteran {veteran_id}\\\")\\n    \\n    console.print(\\\"[dim]Quick actions:[/dim]\\\")\\n    console.print(actions_table)\\n\\n\\n# ============================================================================\\n# Annotate Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.argument(\\\"response_id\\\", required=False)\\n@click.option(\\\"--note\\\", \\\"-n\\\", help=\\\"Add a note\\\")\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Assign to chapter\\\")\\n@click.option(\\\"--flag\\\", \\\"-f\\\", help=\\\"Add a flag\\\")\\n@click.option(\\\"--remove-flag\\\", help=\\\"Remove a flag\\\")\\n@click.option(\\\"--veteran-note\\\", help=\\\"Add note about veteran (not specific response)\\\")\\n@click.option(\\\"--todo\\\", help=\\\"Add research todo\\\")\\ndef annotate(\\n    veteran_id: str,\\n    response_id: Optional[str],\\n    note: Optional[str],\\n    chapter: Optional[int],\\n    flag: Optional[str],\\n    remove_flag: Optional[str],\\n    veteran_note: Optional[str],\\n    todo: Optional[str]\\n):\\n    \\\"\\\"\\\"Add annotations to a response or veteran.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = AnnotationStorage(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    # Verify veteran exists\\n    if not veteran_storage.exists(veteran_id):\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    # Handle response-specific annotations\\n    if response_id:\\n        if note:\\n            storage.add_response_note(veteran_id, response_id, note)\\n            console.print(f\\\"[green]\\u2713[/green] Added note to {veteran_id}:{response_id}\\\")\\n        \\n        if chapter is not None:\\n            storage.set_chapter(veteran_id, response_id, chapter)\\n            console.print(f\\\"[green]\\u2713[/green] Assigned {veteran_id}:{response_id} to chapter {chapter}\\\")\\n        \\n        if flag:\\n            storage.add_flag(veteran_id, response_id, flag)\\n            console.print(f\\\"[green]\\u2713[/green] Added flag '{flag}' to {veteran_id}:{response_id}\\\")\\n        \\n        if remove_flag:\\n            storage.remove_flag(veteran_id, response_id, remove_flag)\\n            console.print(f\\\"[green]\\u2713[/green] Removed flag '{remove_flag}' from {veteran_id}:{response_id}\\\")\\n    \\n    # Handle veteran-level annotations\\n    if veteran_note:\\n        storage.add_veteran_note(veteran_id, veteran_note)\\n        console.print(f\\\"[green]\\u2713[/green] Added note to {veteran_id}\\\")\\n    \\n    if todo:\\n        storage.add_todo(veteran_id, todo)\\n        console.print(f\\\"[green]\\u2713[/green] Added research todo for {veteran_id}\\\")\\n\\n\\n# ============================================================================\\n# Annotations Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\", required=False)\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Show annotations for chapter\\\")\\n@click.option(\\\"--flags\\\", is_flag=True, help=\\\"Show all flagged responses\\\")\\ndef annotations(\\n    veteran_id: Optional[str],\\n    chapter: Optional[int],\\n    flags: bool\\n):\\n    \\\"\\\"\\\"View annotations.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = AnnotationStorage(ctx)\\n    \\n    if chapter is not None:\\n        # Show all responses in chapter\\n        chapter_responses = storage.get_chapter_responses(chapter)\\n        \\n        if not chapter_responses:\\n            console.print(f\\\"[yellow]No responses assigned to chapter {chapter}[/yellow]\\\")\\n            return\\n        \\n        total_responses = sum(len(rids) for rids in chapter_responses.values())\\n        console.print(Panel(\\n            f\\\"[bold]CHAPTER {chapter}[/bold] \\u2014 {total_responses} responses from {len(chapter_responses)} veterans\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        # Create table for chapter responses\\n        chapter_table = Table(show_header=True, header_style=\\\"bold cyan\\\", box=box.ROUNDED)\\n        chapter_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=25)\\n        chapter_table.add_column(\\\"Responses\\\", style=\\\"\\\", min_width=40)\\n        \\n        for vid, resp_ids in chapter_responses.items():\\n            chapter_table.add_row(vid, \\\" \\\".join([f\\\"[{r}]\\\" for r in resp_ids]))\\n        \\n        console.print(chapter_table)\\n        return\\n    \\n    if flags:\\n        # Show all flagged responses\\n        flagged = storage.get_flagged_responses()\\n        \\n        if not flagged:\\n            console.print(\\\"[yellow]No flagged responses[/yellow]\\\")\\n            return\\n        \\n        console.print(Panel(\\n            \\\"[bold]FLAGGED RESPONSES[/bold]\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"yellow\\\"\\n        ))\\n        \\n        # Create table for flagged responses\\n        flagged_table = Table(show_header=True, header_style=\\\"bold yellow\\\", box=box.ROUNDED)\\n        flagged_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=20)\\n        flagged_table.add_column(\\\"Response\\\", style=\\\"cyan\\\", width=10)\\n        flagged_table.add_column(\\\"Flags\\\", style=\\\"yellow\\\", min_width=30)\\n        \\n        for vid, resp_flags in flagged.items():\\n            for resp_id, flag_list in resp_flags.items():\\n                flagged_table.add_row(vid, f\\\"[{resp_id}]\\\", \\\", \\\".join(flag_list))\\n        \\n        console.print(flagged_table)\\n        return\\n    \\n    if veteran_id:\\n        # Show annotations for specific veteran\\n        annots = storage.load(veteran_id)\\n        \\n        console.print(Panel(\\n            f\\\"[bold]ANNOTATIONS[/bold] \\u2014 {veteran_id}\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        # Veteran notes\\n        if annots.veteran_notes:\\n            console.print(\\\"[bold cyan]Veteran Notes[/bold cyan]\\\")\\n            notes_table = Table(show_header=False, box=box.SIMPLE, padding=(0, 1))\\n            notes_table.add_column(\\\"Date\\\", style=\\\"dim\\\", width=12)\\n            notes_table.add_column(\\\"Note\\\", style=\\\"\\\")\\n            for note in annots.veteran_notes:\\n                notes_table.add_row(note.date, note.text)\\n            console.print(notes_table)\\n            console.print(\\\"\\\")\\n        \\n        # Research todos\\n        if annots.research_todos:\\n            console.print(\\\"[bold cyan]Research Todos[/bold cyan]\\\")\\n            for todo in annots.research_todos:\\n                console.print(f\\\"  [yellow]\\u2610[/yellow] {todo}\\\")\\n            console.print(\\\"\\\")\\n        \\n        # Response annotations\\n        if annots.response_annotations:\\n            console.print(\\\"[bold cyan]Response Annotations[/bold cyan]\\\")\\n            resp_table = Table(show_header=True, header_style=\\\"bold\\\", box=box.ROUNDED)\\n            resp_table.add_column(\\\"Response\\\", style=\\\"cyan\\\", width=10)\\n            resp_table.add_column(\\\"Chapter\\\", width=10, justify=\\\"center\\\")\\n            resp_table.add_column(\\\"Flags\\\", style=\\\"yellow\\\", width=25)\\n            resp_table.add_column(\\\"Notes\\\", style=\\\"\\\", min_width=30)\\n            \\n            for resp_id, ra in annots.response_annotations.items():\\n                chapter_str = f\\\"Ch. {ra.chapter}\\\" if ra.chapter else \\\"[dim]\\u2014[/dim]\\\"\\n                flags_str = \\\", \\\".join(ra.flags) if ra.flags else \\\"[dim]\\u2014[/dim]\\\"\\n                notes_str = \\\"; \\\".join([n.text for n in ra.notes[:2]]) if ra.notes else \\\"[dim]\\u2014[/dim]\\\"\\n                if len(ra.notes) > 2:\\n                    notes_str += f\\\" (+{len(ra.notes) - 2} more)\\\"\\n                resp_table.add_row(f\\\"[{resp_id}]\\\", chapter_str, flags_str, notes_str)\\n            \\n            console.print(resp_table)\\n    else:\\n        console.print(\\\"Usage: oralhistory annotations [VETERAN_ID] [--chapter N] [--flags]\\\")\\n\\n\\n# ============================================================================\\n# Chapter Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"chapter_num\\\", type=int)\\n@click.option(\\\"--export\\\", is_flag=True, help=\\\"Export chapter to file\\\")\\ndef chapter(chapter_num: int, export: bool):\\n    \\\"\\\"\\\"Show or export chapter material.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    annotation_storage = AnnotationStorage(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    chapter_responses = annotation_storage.get_chapter_responses(chapter_num)\\n    \\n    if not chapter_responses:\\n        console.print(f\\\"[yellow]No responses assigned to chapter {chapter_num}[/yellow]\\\")\\n        return\\n    \\n    total_responses = sum(len(rids) for rids in chapter_responses.values())\\n    \\n    console.print(Panel(\\n        f\\\"[bold]CHAPTER {chapter_num}[/bold] ({total_responses} responses from {len(chapter_responses)} veterans)\\\",\\n        box=box.DOUBLE\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    for veteran_id, resp_ids in chapter_responses.items():\\n        v = veteran_storage.load(veteran_id)\\n        if not v:\\n            continue\\n        \\n        annots = annotation_storage.load(veteran_id)\\n        \\n        # Veteran header panel\\n        console.print(Panel(\\n            f\\\"[bold]{v.name}[/bold] \\u2014 {len(resp_ids)} responses\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        # Create table for this veteran's responses\\n        vet_table = Table(show_header=True, header_style=\\\"bold\\\", box=box.SIMPLE, padding=(0, 1))\\n        vet_table.add_column(\\\"ID\\\", style=\\\"cyan\\\", width=6)\\n        vet_table.add_column(\\\"\\\", width=3)  # Potential indicator\\n        vet_table.add_column(\\\"Summary\\\", style=\\\"\\\", min_width=45)\\n        vet_table.add_column(\\\"Notes\\\", style=\\\"dim\\\", width=25)\\n        \\n        for resp_id in resp_ids:\\n            # Find response\\n            response = None\\n            for r in v.responses:\\n                if r.id == resp_id:\\n                    response = r\\n                    break\\n            \\n            if response:\\n                resp_annot = annots.response_annotations.get(resp_id)\\n                \\n                # Potential indicator\\n                if response.extracted and response.extracted.writing_potential == WritingPotential.HIGH:\\n                    potential = \\\"[yellow]\\u2605[/yellow]\\\"\\n                elif response.extracted and response.extracted.writing_potential == WritingPotential.MEDIUM:\\n                    potential = \\\"[dim]\\u2606[/dim]\\\"\\n                else:\\n                    potential = \\\"\\\"\\n                \\n                # Summary\\n                title = response.extracted.summary if response.extracted else response.veteran[:60] + \\\"...\\\"\\n                if len(title) > 50:\\n                    title = title[:47] + \\\"...\\\"\\n                \\n                # Notes\\n                notes_str = \\\"\\\"\\n                if resp_annot and resp_annot.notes:\\n                    notes_str = resp_annot.notes[0].text[:25]\\n                    if len(resp_annot.notes) > 1:\\n                        notes_str += f\\\" (+{len(resp_annot.notes) - 1})\\\"\\n                \\n                vet_table.add_row(f\\\"[{resp_id}]\\\", potential, title, notes_str if notes_str else \\\"[dim]\\u2014[/dim]\\\")\\n        \\n        console.print(vet_table)\\n        console.print(\\\"\\\")\\n    \\n    if export:\\n        exporter = Exporter(ctx)\\n        output_path = exporter.export_chapter(chapter_num)\\n        console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Export Command\\n# ============================================================================\\n\\n@cli.group()\\ndef export():\\n    \\\"\\\"\\\"Export commands.\\\"\\\"\\\"\\n    pass\\n\\n\\n@export.command(\\\"chapter\\\")\\n@click.argument(\\\"chapter_num\\\", type=int)\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_chapter(chapter_num: int, filename: Optional[str]):\\n    \\\"\\\"\\\"Export a chapter.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_chapter(chapter_num, filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n@export.command(\\\"veteran\\\")\\n@click.argument(\\\"veteran_id\\\")\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_veteran(veteran_id: str, filename: Optional[str]):\\n    \\\"\\\"\\\"Export a veteran's material.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_veteran(veteran_id, filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n@export.command(\\\"stories\\\")\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_stories(filename: Optional[str]):\\n    \\\"\\\"\\\"Export all notable stories.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_stories(filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n@export.command(\\\"timeline\\\")\\n@click.option(\\\"--start\\\", help=\\\"Start date (YYYY-MM)\\\")\\n@click.option(\\\"--end\\\", help=\\\"End date (YYYY-MM)\\\")\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_timeline(start: Optional[str], end: Optional[str], filename: Optional[str]):\\n    \\\"\\\"\\\"Export combined timeline.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_timeline(start, end, filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Reindex Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--no-embeddings\\\", is_flag=True, help=\\\"Skip embedding generation\\\")\\ndef reindex(no_embeddings: bool):\\n    \\\"\\\"\\\"Rebuild search indexes.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    veteran_ids = veteran_storage.list_veterans()\\n    \\n    if not veteran_ids:\\n        console.print(\\\"[yellow]No veterans to index[/yellow]\\\")\\n        return\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        BarColumn(),\\n        TextColumn(\\\"[progress.percentage]{task.percentage:>3.0f}%\\\"),\\n    ) as progress:\\n        task = progress.add_task(\\\"Reindexing...\\\", total=len(veteran_ids))\\n        \\n        for vid in veteran_ids:\\n            progress.update(task, description=f\\\"Indexing {vid}...\\\")\\n            \\n            veteran = veteran_storage.load(vid)\\n            if veteran:\\n                search_engine.index.index_veteran(\\n                    veteran, \\n                    generate_embeddings=not no_embeddings\\n                )\\n            \\n            progress.advance(task)\\n    \\n    search_engine.close()\\n    console.print(f\\\"[green]\\u2713[/green] Reindexed {len(veteran_ids)} veterans\\\")\\n\\n\\n# ============================================================================\\n# Stats Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--detailed\\\", is_flag=True, help=\\\"Show detailed statistics\\\")\\ndef stats(detailed: bool):\\n    \\\"\\\"\\\"Show project-wide statistics and coverage analysis.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    annotation_storage = AnnotationStorage(ctx)\\n    veteran_ids = storage.list_veterans()\\n    \\n    if not veteran_ids:\\n        console.print(\\\"[yellow]No veterans found. Run 'oralhistory ingest' to add transcripts.[/yellow]\\\")\\n        return\\n    \\n    # Collect statistics\\n    total_responses = 0\\n    total_paragraphs = 0\\n    verified_count = 0\\n    annotated_count = 0\\n    high_potential_count = 0\\n    medium_potential_count = 0\\n    low_potential_count = 0\\n    \\n    topic_counts: Dict[str, int] = {}\\n    location_counts: Dict[str, int] = {}\\n    year_counts: Dict[str, int] = {}\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(\\\"Gathering statistics...\\\", total=None)\\n        \\n        for vid in veteran_ids:\\n            v = storage.load(vid)\\n            if not v:\\n                continue\\n            \\n            if v.verified:\\n                verified_count += 1\\n            \\n            for r in v.responses:\\n                total_responses += 1\\n                total_paragraphs += len(r.paragraphs)\\n                \\n                if r.extracted:\\n                    # Count writing potential\\n                    if r.extracted.writing_potential == WritingPotential.HIGH:\\n                        high_potential_count += 1\\n                    elif r.extracted.writing_potential == WritingPotential.MEDIUM:\\n                        medium_potential_count += 1\\n                    else:\\n                        low_potential_count += 1\\n                    \\n                    # Count topics\\n                    for topic in r.extracted.topics:\\n                        topic_lower = topic.lower()\\n                        topic_counts[topic_lower] = topic_counts.get(topic_lower, 0) + 1\\n                    \\n                    # Count locations\\n                    for loc in r.extracted.locations:\\n                        location_counts[loc] = location_counts.get(loc, 0) + 1\\n                    \\n                    # Extract years from dates\\n                    for d in r.extracted.dates:\\n                        # Try to extract year (1942, 1943, etc.)\\n                        import re\\n                        year_match = re.search(r'\\\\b(19[3-4][0-9])\\\\b', d.value)\\n                        if year_match:\\n                            year = year_match.group(1)\\n                            year_counts[year] = year_counts.get(year, 0) + 1\\n            \\n            # Count annotations\\n            annots = annotation_storage.load(vid)\\n            if annots.response_annotations:\\n                annotated_count += len(annots.response_annotations)\\n    \\n    # Display header\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        \\\"[bold]PROJECT STATISTICS[/bold]\\\",\\n        box=box.DOUBLE,\\n        border_style=\\\"cyan\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Summary stats table\\n    summary_table = Table(show_header=False, box=None, padding=(0, 2), expand=True)\\n    summary_table.add_column(\\\"Label\\\", style=\\\"bold\\\", width=14)\\n    summary_table.add_column(\\\"Value\\\", style=\\\"cyan\\\", width=10, justify=\\\"right\\\")\\n    summary_table.add_column(\\\"Label2\\\", style=\\\"bold\\\", width=14)\\n    summary_table.add_column(\\\"Value2\\\", style=\\\"cyan\\\", width=10, justify=\\\"right\\\")\\n    summary_table.add_column(\\\"Label3\\\", style=\\\"bold\\\", width=14)\\n    summary_table.add_column(\\\"Value3\\\", style=\\\"cyan\\\", width=10, justify=\\\"right\\\")\\n    \\n    summary_table.add_row(\\n        \\\"Veterans:\\\", str(len(veteran_ids)),\\n        \\\"Responses:\\\", f\\\"{total_responses:,}\\\",\\n        \\\"Paragraphs:\\\", f\\\"{total_paragraphs:,}\\\"\\n    )\\n    summary_table.add_row(\\n        \\\"Verified:\\\", f\\\"{verified_count}/{len(veteran_ids)}\\\",\\n        \\\"Annotated:\\\", f\\\"{annotated_count:,}\\\",\\n        \\\"HIGH potential:\\\", f\\\"{high_potential_count:,}\\\"\\n    )\\n    \\n    console.print(summary_table)\\n    console.print(\\\"\\\")\\n    \\n    # Topic coverage bar chart\\n    if topic_counts:\\n        console.print(\\\"[bold]TOPIC COVERAGE[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        # Sort by count, take top 10\\n        sorted_topics = sorted(topic_counts.items(), key=lambda x: x[1], reverse=True)[:10]\\n        max_count = sorted_topics[0][1] if sorted_topics else 1\\n        bar_width = 30\\n        \\n        for topic, count in sorted_topics:\\n            bar_length = int((count / max_count) * bar_width)\\n            bar = \\\"\\u2588\\\" * bar_length\\n            # Truncate topic name if too long\\n            topic_display = topic[:14] if len(topic) > 14 else topic.ljust(14)\\n            console.print(f\\\" {topic_display} [cyan]{bar}[/cyan]  {count}\\\")\\n        \\n        console.print(\\\"\\\")\\n    \\n    # Time coverage bar chart\\n    if year_counts:\\n        console.print(\\\"[bold]TIME COVERAGE[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        # Sort by year\\n        sorted_years = sorted(year_counts.items(), key=lambda x: x[0])\\n        max_count = max(year_counts.values()) if year_counts else 1\\n        bar_width = 40\\n        \\n        for year, count in sorted_years:\\n            bar_length = int((count / max_count) * bar_width)\\n            bar = \\\"\\u2588\\\" * bar_length\\n            console.print(f\\\" {year} [green]{bar}[/green]  {count}\\\")\\n        \\n        console.print(\\\"\\\")\\n    \\n    # Top locations\\n    if location_counts:\\n        console.print(\\\"[bold]TOP LOCATIONS[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        # Sort by count, take top 10\\n        sorted_locs = sorted(location_counts.items(), key=lambda x: x[1], reverse=True)[:10]\\n        loc_strings = [f\\\"{loc} ({count})\\\" for loc, count in sorted_locs]\\n        console.print(f\\\" {', '.join(loc_strings)}\\\")\\n        console.print(\\\"\\\")\\n    \\n    # Writing potential distribution\\n    console.print(\\\"[bold]WRITING POTENTIAL[/bold]\\\")\\n    console.print(\\\"\\u2500\\\" * 63)\\n    \\n    total_extracted = high_potential_count + medium_potential_count + low_potential_count\\n    if total_extracted > 0:\\n        high_pct = (high_potential_count / total_extracted) * 100\\n        medium_pct = (medium_potential_count / total_extracted) * 100\\n        low_pct = (low_potential_count / total_extracted) * 100\\n        \\n        potential_table = Table(show_header=False, box=None, padding=(0, 1))\\n        potential_table.add_column(\\\"Level\\\", width=10)\\n        potential_table.add_column(\\\"Bar\\\", width=35)\\n        potential_table.add_column(\\\"Count\\\", width=15, justify=\\\"right\\\")\\n        \\n        high_bar = \\\"\\u2588\\\" * int(high_pct / 3)\\n        medium_bar = \\\"\\u2588\\\" * int(medium_pct / 3)\\n        low_bar = \\\"\\u2588\\\" * int(low_pct / 3)\\n        \\n        potential_table.add_row(\\\"\\u2605 HIGH\\\", f\\\"[yellow]{high_bar}[/yellow]\\\", f\\\"{high_potential_count:,} ({high_pct:.1f}%)\\\")\\n        potential_table.add_row(\\\"\\u2606 MEDIUM\\\", f\\\"[dim]{medium_bar}[/dim]\\\", f\\\"{medium_potential_count:,} ({medium_pct:.1f}%)\\\")\\n        potential_table.add_row(\\\"\\u00b7 LOW\\\", f\\\"[dim]{low_bar}[/dim]\\\", f\\\"{low_potential_count:,} ({low_pct:.1f}%)\\\")\\n        \\n        console.print(potential_table)\\n    \\n    console.print(\\\"\\\")\\n    \\n    # Detailed view\\n    if detailed:\\n        console.print(\\\"[bold]VETERAN DETAILS[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        detail_table = Table(\\n            show_header=True,\\n            header_style=\\\"bold cyan\\\",\\n            box=box.ROUNDED,\\n            expand=True\\n        )\\n        detail_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=25)\\n        detail_table.add_column(\\\"Responses\\\", justify=\\\"right\\\", width=10)\\n        detail_table.add_column(\\\"HIGH\\\", justify=\\\"right\\\", width=8)\\n        detail_table.add_column(\\\"Verified\\\", justify=\\\"center\\\", width=10)\\n        detail_table.add_column(\\\"Stories\\\", justify=\\\"right\\\", width=8)\\n        \\n        for vid in sorted(veteran_ids):\\n            v = storage.load(vid)\\n            if not v:\\n                continue\\n            \\n            high_count = sum(\\n                1 for r in v.responses \\n                if r.extracted and r.extracted.writing_potential == WritingPotential.HIGH\\n            )\\n            verified_str = \\\"[green]\\u2713[/green]\\\" if v.verified else \\\"[dim]\\u2014[/dim]\\\"\\n            story_count = len(v.notable_stories)\\n            \\n            detail_table.add_row(\\n                v.name[:24],\\n                str(len(v.responses)),\\n                str(high_count),\\n                verified_str,\\n                str(story_count)\\n            )\\n        \\n        console.print(detail_table)\\n\\n\\n# ============================================================================\\n# Compare Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran1_id\\\")\\n@click.argument(\\\"veteran2_id\\\")\\n@click.option(\\\"--topic\\\", \\\"-t\\\", required=True, help=\\\"Topic to compare on\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=5, help=\\\"Max passages per veteran\\\")\\n@click.option(\\\"--analyze\\\", is_flag=True, help=\\\"Use LLM to generate comparison analysis\\\")\\ndef compare(veteran1_id: str, veteran2_id: str, topic: str, limit: int, analyze: bool):\\n    \\\"\\\"\\\"Side-by-side comparison of two veterans' accounts on the same topic.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    search_engine = SearchEngine(ctx)\\n    \\n    # Verify both veterans exist\\n    v1 = storage.load(veteran1_id)\\n    v2 = storage.load(veteran2_id)\\n    \\n    if not v1:\\n        console.print(f\\\"[red]Veteran not found: {veteran1_id}[/red]\\\")\\n        return\\n    if not v2:\\n        console.print(f\\\"[red]Veteran not found: {veteran2_id}[/red]\\\")\\n        return\\n    \\n    # Search for topic in both veterans\\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(f\\\"Searching for '{topic}'...\\\", total=None)\\n        \\n        results1 = search_engine.search(query=topic, limit=limit, veteran_id=veteran1_id)\\n        results2 = search_engine.search(query=topic, limit=limit, veteran_id=veteran2_id)\\n    \\n    search_engine.close()\\n    \\n    # Header\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        f\\\"[bold]COMPARE:[/bold] \\\\\\\"{topic}\\\\\\\" \\u2014 2 Veterans\\\",\\n        box=box.DOUBLE,\\n        border_style=\\\"cyan\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Create side-by-side comparison using columns\\n    from rich.columns import Columns\\n    from rich.text import Text\\n    \\n    # Left panel (Veteran 1)\\n    left_lines = []\\n    left_lines.append(f\\\"[bold cyan]{v1.name}[/bold cyan]\\\")\\n    left_lines.append(f\\\"[dim]{v1.unit or 'No unit'}[/dim]\\\")\\n    left_lines.append(\\\"\\\")\\n    \\n    if results1.hits:\\n        for hit in results1.hits:\\n            r = hit.response\\n            potential = \\\"\\\"\\n            if r.extracted and r.extracted.writing_potential == WritingPotential.HIGH:\\n                potential = \\\" [yellow]\\u2605[/yellow]\\\"\\n            \\n            # Truncate text for display\\n            text = r.veteran[:200] + \\\"...\\\" if len(r.veteran) > 200 else r.veteran\\n            text = \\\" \\\".join(text.split())  # Clean whitespace\\n            \\n            left_lines.append(f\\\"[cyan][{r.id}][/cyan]{potential}\\\")\\n            left_lines.append(f\\\"[dim italic]Q: {r.interviewer[:80]}...[/dim italic]\\\" if len(r.interviewer) > 80 else f\\\"[dim italic]Q: {r.interviewer}[/dim italic]\\\")\\n            left_lines.append(f\\\"\\\\\\\"{text}\\\\\\\"\\\")\\n            left_lines.append(\\\"\\\")\\n    else:\\n        left_lines.append(\\\"[dim][no matches][/dim]\\\")\\n    \\n    # Right panel (Veteran 2)\\n    right_lines = []\\n    right_lines.append(f\\\"[bold cyan]{v2.name}[/bold cyan]\\\")\\n    right_lines.append(f\\\"[dim]{v2.unit or 'No unit'}[/dim]\\\")\\n    right_lines.append(\\\"\\\")\\n    \\n    if results2.hits:\\n        for hit in results2.hits:\\n            r = hit.response\\n            potential = \\\"\\\"\\n            if r.extracted and r.extracted.writing_potential == WritingPotential.HIGH:\\n                potential = \\\" [yellow]\\u2605[/yellow]\\\"\\n            \\n            # Truncate text for display\\n            text = r.veteran[:200] + \\\"...\\\" if len(r.veteran) > 200 else r.veteran\\n            text = \\\" \\\".join(text.split())  # Clean whitespace\\n            \\n            right_lines.append(f\\\"[cyan][{r.id}][/cyan]{potential}\\\")\\n            right_lines.append(f\\\"[dim italic]Q: {r.interviewer[:80]}...[/dim italic]\\\" if len(r.interviewer) > 80 else f\\\"[dim italic]Q: {r.interviewer}[/dim italic]\\\")\\n            right_lines.append(f\\\"\\\\\\\"{text}\\\\\\\"\\\")\\n            right_lines.append(\\\"\\\")\\n    else:\\n        right_lines.append(\\\"[dim][no matches][/dim]\\\")\\n    \\n    # Display in panels\\n    left_panel = Panel(\\n        \\\"\\\\n\\\".join(left_lines),\\n        title=f\\\"[bold]{veteran1_id}[/bold]\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"cyan\\\"\\n    )\\n    right_panel = Panel(\\n        \\\"\\\\n\\\".join(right_lines),\\n        title=f\\\"[bold]{veteran2_id}[/bold]\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"cyan\\\"\\n    )\\n    \\n    console.print(Columns([left_panel, right_panel], equal=True, expand=True))\\n    \\n    # LLM Analysis\\n    if analyze and (results1.hits or results2.hits):\\n        console.print(\\\"\\\")\\n        console.print(\\\"[bold yellow]ANALYSIS[/bold yellow]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        try:\\n            llm_client = get_llm_client(\\n                provider=ctx.config.llm.provider,\\n                model=ctx.config.llm.model\\n            )\\n            \\n            # Prepare accounts for comparison\\n            accounts = []\\n            for hit in results1.hits:\\n                accounts.append({\\n                    \\\"veteran_name\\\": v1.name,\\n                    \\\"veteran_id\\\": veteran1_id,\\n                    \\\"response_id\\\": hit.response_id,\\n                    \\\"text\\\": hit.response.veteran[:1000]\\n                })\\n            for hit in results2.hits:\\n                accounts.append({\\n                    \\\"veteran_name\\\": v2.name,\\n                    \\\"veteran_id\\\": veteran2_id,\\n                    \\\"response_id\\\": hit.response_id,\\n                    \\\"text\\\": hit.response.veteran[:1000]\\n                })\\n            \\n            import json\\n            comparison_prompt = f\\\"\\\"\\\"Compare these two veterans' accounts regarding \\\"{topic}\\\":\\n\\nAccounts:\\n{json.dumps(accounts, indent=2)}\\n\\nProvide a brief analysis (3-5 bullet points) highlighting:\\n- Areas of agreement or overlapping details\\n- Unique perspectives each veteran provides\\n- Any contradictions or different viewpoints\\n- Which veteran provides more detail on specific aspects\\n\\nFormat each bullet point starting with \\\"\\u2022 \\\"\\n\\\"\\\"\\\"\\n            \\n            with Progress(\\n                SpinnerColumn(),\\n                TextColumn(\\\"[progress.description]{task.description}\\\"),\\n                transient=True,\\n            ) as progress:\\n                task = progress.add_task(\\\"Generating analysis...\\\", total=None)\\n                analysis = llm_client.complete(\\n                    prompt=comparison_prompt,\\n                    system=\\\"You are comparing WWII oral history accounts. Be specific and cite response IDs.\\\",\\n                    max_tokens=1000\\n                )\\n            \\n            console.print(analysis)\\n            \\n        except Exception as e:\\n            console.print(f\\\"[yellow]Analysis failed: {e}[/yellow]\\\")\\n    \\n    console.print(\\\"\\\")\\n    console.print(\\\"[dim]Tip: Use --analyze for LLM-generated comparison analysis[/dim]\\\")\\n\\n\\n# ============================================================================\\n# Draft Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--topic\\\", \\\"-t\\\", help=\\\"Topic to draft about\\\")\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", \\\"veteran_id\\\", help=\\\"Filter to specific veteran\\\")\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Filter to chapter\\\")\\n@click.option(\\\"--query\\\", \\\"-q\\\", help=\\\"Search query to find passages\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=10, help=\\\"Maximum passages to use\\\")\\n@click.option(\\\"--style\\\", \\\"-s\\\", type=click.Choice([\\\"narrative\\\", \\\"documentary\\\", \\\"academic\\\"]), default=\\\"narrative\\\", help=\\\"Writing style\\\")\\n@click.option(\\\"--export\\\", \\\"export_path\\\", help=\\\"Export draft to file\\\")\\ndef draft(\\n    topic: Optional[str],\\n    veteran_id: Optional[str],\\n    chapter: Optional[int],\\n    query: Optional[str],\\n    limit: int,\\n    style: str,\\n    export_path: Optional[str]\\n):\\n    \\\"\\\"\\\"Generate first-draft narrative text from selected passages with inline citations.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    # Need at least one filter\\n    if not topic and not veteran_id and not chapter and not query:\\n        console.print(\\\"[red]Please specify at least one filter: --topic, --veteran, --chapter, or --query[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    annotation_storage = AnnotationStorage(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    # Build search query\\n    search_query = topic or query or \\\"\\\"\\n    \\n    # If chapter specified, get responses from that chapter\\n    passages = []\\n    \\n    if chapter:\\n        chapter_responses = annotation_storage.get_chapter_responses(chapter)\\n        for vid, resp_ids in chapter_responses.items():\\n            if veteran_id and vid != veteran_id:\\n                continue\\n            \\n            v = veteran_storage.load(vid)\\n            if not v:\\n                continue\\n            \\n            for rid in resp_ids:\\n                for r in v.responses:\\n                    if r.id == rid:\\n                        passages.append({\\n                            \\\"veteran_id\\\": vid,\\n                            \\\"veteran_name\\\": v.name,\\n                            \\\"response_id\\\": rid,\\n                            \\\"response\\\": r\\n                        })\\n                        break\\n    else:\\n        # Search for passages\\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            transient=True,\\n        ) as progress:\\n            task = progress.add_task(\\\"Searching for passages...\\\", total=None)\\n            \\n            results = search_engine.search(\\n                query=search_query,\\n                limit=limit,\\n                veteran_id=veteran_id,\\n                chapter=chapter\\n            )\\n        \\n        for hit in results.hits:\\n            passages.append({\\n                \\\"veteran_id\\\": hit.veteran_id,\\n                \\\"veteran_name\\\": hit.veteran_name,\\n                \\\"response_id\\\": hit.response_id,\\n                \\\"response\\\": hit.response\\n            })\\n    \\n    search_engine.close()\\n    \\n    if not passages:\\n        console.print(\\\"[yellow]No passages found matching your criteria.[/yellow]\\\")\\n        return\\n    \\n    # Limit passages\\n    passages = passages[:limit]\\n    \\n    console.print(f\\\"[green]\\u2713[/green] Found {len(passages)} passages to draft from\\\")\\n    console.print(\\\"\\\")\\n    \\n    llm_client = get_llm_client(\\n        provider=ctx.config.llm.provider,\\n        model=ctx.config.llm.model\\n    )\\n    \\n    draft_writer = DraftWriter(llm_client)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(f\\\"Generating {style} draft...\\\", total=None)\\n        \\n        draft_topic = topic or query or f\\\"Chapter {chapter}\\\" if chapter else \\\"selected passages\\\"\\n        draft_result = draft_writer.generate_draft(passages, style=style, topic=draft_topic)\\n    \\n    # Display header\\n    console.print(Panel(\\n        f\\\"[bold]DRAFT:[/bold] {draft_topic}\\\",\\n        box=box.DOUBLE,\\n        border_style=\\\"green\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Display draft\\n    console.print(Markdown(draft_result[\\\"draft\\\"]))\\n    console.print(\\\"\\\")\\n    \\n    # Display sources\\n    console.print(\\\"[bold]SOURCES USED[/bold]\\\")\\n    console.print(\\\"\\u2500\\\" * 63)\\n    \\n    sources_table = Table(show_header=True, header_style=\\\"bold\\\", box=box.SIMPLE)\\n    sources_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=25)\\n    sources_table.add_column(\\\"Response\\\", width=10)\\n    sources_table.add_column(\\\"Summary\\\", width=40)\\n    \\n    for p in passages:\\n        summary = p[\\\"response\\\"].extracted.summary if p[\\\"response\\\"].extracted else p[\\\"response\\\"].veteran[:50] + \\\"...\\\"\\n        if len(summary) > 40:\\n            summary = summary[:37] + \\\"...\\\"\\n        sources_table.add_row(p[\\\"veteran_name\\\"], f\\\"[{p['response_id']}]\\\", summary)\\n    \\n    console.print(sources_table)\\n    console.print(\\\"\\\")\\n    \\n    # Word count\\n    word_count = len(draft_result[\\\"draft\\\"].split())\\n    console.print(f\\\"[dim]Word count: {word_count:,}[/dim]\\\")\\n    \\n    # Export if requested\\n    if export_path:\\n        output_path = Path(export_path)\\n        if not output_path.suffix:\\n            output_path = output_path.with_suffix(\\\".md\\\")\\n        \\n        # Build full export content\\n        export_content = f\\\"# Draft: {draft_topic}\\\\n\\\\n\\\"\\n        export_content += f\\\"*Style: {style} | Sources: {len(passages)} passages | Generated: {datetime.now().strftime('%Y-%m-NaN %H:%M')}*\\\\n\\\\n\\\"\\n        export_content += \\\"---\\\\n\\\\n\\\"\\n        export_content += draft_result[\\\"draft\\\"]\\n        export_content += \\\"\\\\n\\\\n---\\\\n\\\\n\\\"\\n        export_content += \\\"## Sources\\\\n\\\\n\\\"\\n        for p in passages:\\n            summary = p[\\\"response\\\"].extracted.summary if p[\\\"response\\\"].extracted else \\\"\\\"\\n            export_content += f\\\"- **{p['veteran_name']}** [{p['response_id']}]: {summary}\\\\n\\\"\\n        \\n        output_path.write_text(export_content)\\n        console.print(f\\\"[green]\\u2713[/green] Exported draft to: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Entry Point\\n# ============================================================================\\n\\ndef main():\\n    \\\"\\\"\\\"Main entry point.\\\"\\\"\\\"\\n    cli()\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"file_size_bytes\":84403,\"content_length\":84191}"}],"structuredContent":{"result":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/cli.py\",\"content\":\"\\\"\\\"\\\"\\nCLI for the Oral History Research System.\\n\\nA CLI tool for managing WWII oral history transcripts, designed for book research.\\nVeterans are first-class citizens - every search, every passage, every insight\\nstays connected to the person who lived it.\\n\\\"\\\"\\\"\\n\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Optional, List, Dict\\nfrom datetime import datetime\\nimport click\\nfrom rich.console import Console\\nfrom rich.table import Table\\nfrom rich.panel import Panel\\nfrom rich.progress import Progress, SpinnerColumn, TextColumn, BarColumn\\nfrom rich.markdown import Markdown\\nfrom rich import box\\n\\nfrom .config import (\\n    ProjectContext, find_project_root, ensure_project_structure,\\n    create_default_config, load_config\\n)\\nfrom .models import (\\n    Veteran, ServiceDates, SourceInfo, WritingPotential,\\n    TimelineEvent, Relationship, NotableStory, VerificationItem,\\n    Response, DatePrecision, Confidence, VeteranProfile, ThematicStrength\\n)\\nfrom .storage import VeteranStorage, AnnotationStorage, slugify\\nfrom .parser import parse_transcript_file, extract_header_info, TranscriptParser\\nfrom .search import SearchEngine\\nfrom .export import Exporter\\nfrom .llm import get_llm_client, ResponseExtractor, VeteranSynthesizer, NarrativeSynthesizer, DraftWriter\\n\\n\\nconsole = Console()\\n\\n\\n# ============================================================================\\n# Main CLI Group\\n# ============================================================================\\n\\n@click.group()\\n@click.version_option(version=\\\"1.0.0\\\")\\ndef cli():\\n    \\\"\\\"\\\"\\n    Oral History Research System\\n    \\n    A CLI tool for managing WWII oral history transcripts, designed for book research.\\n    Veterans are first-class citizens - every search, every passage, every insight\\n    stays connected to the person who lived it.\\n    \\\"\\\"\\\"\\n    pass\\n\\n\\n# ============================================================================\\n# Init Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--path\\\", type=click.Path(), default=\\\".\\\", help=\\\"Directory to initialize\\\")\\ndef init(path: str):\\n    \\\"\\\"\\\"Initialize a new oral history project.\\\"\\\"\\\"\\n    root = Path(path).resolve()\\n    \\n    if (root / \\\"config.yaml\\\").exists():\\n        console.print(f\\\"[yellow]Project already exists at {root}[/yellow]\\\")\\n        return\\n    \\n    console.print(f\\\"Initializing oral history project at [cyan]{root}[/cyan]\\\")\\n    \\n    # Create directory structure\\n    ensure_project_structure(root)\\n    \\n    # Create config file\\n    config_path = create_default_config(root)\\n    \\n    console.print(\\\"\\\")\\n    console.print(\\\"[green]\\u2713[/green] Created project structure:\\\")\\n    console.print(\\\"  \\u2022 veterans/      - Veteran transcripts\\\")\\n    console.print(\\\"  \\u2022 annotations/   - Your notes and chapter assignments\\\")\\n    console.print(\\\"  \\u2022 index/         - Search indexes\\\")\\n    console.print(\\\"  \\u2022 exports/       - Generated exports\\\")\\n    console.print(f\\\"  \\u2022 config.yaml    - Configuration\\\")\\n    console.print(\\\"\\\")\\n    console.print(\\\"[dim]Next steps:[/dim]\\\")\\n    console.print(\\\"  1. Set your API keys: export ANTHROPIC_API_KEY=... OPENAI_API_KEY=...\\\")\\n    console.print(\\\"  2. Initialize git: git init\\\")\\n    console.print(\\\"  3. Ingest a transcript: oralhistory ingest transcript.txt --veteran \\\\\\\"Name\\\\\\\"\\\")\\n\\n\\n# ============================================================================\\n# Ingest Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"transcript_file\\\", type=click.Path(exists=True))\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", required=True, help=\\\"Veteran's full name\\\")\\n@click.option(\\\"--unit\\\", \\\"-u\\\", help=\\\"Military unit\\\")\\n@click.option(\\\"--rank\\\", \\\"-r\\\", help=\\\"Military rank\\\")\\n@click.option(\\\"--source\\\", \\\"-s\\\", help=\\\"Source description\\\")\\n@click.option(\\\"--dry-run\\\", is_flag=True, help=\\\"Show what would be extracted without saving\\\")\\n@click.option(\\\"--no-embeddings\\\", is_flag=True, help=\\\"Skip generating embeddings (faster, no OpenAI needed)\\\")\\ndef ingest(\\n    transcript_file: str,\\n    veteran: str,\\n    unit: Optional[str],\\n    rank: Optional[str],\\n    source: Optional[str],\\n    dry_run: bool,\\n    no_embeddings: bool\\n):\\n    \\\"\\\"\\\"Ingest a new transcript.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    transcript_path = Path(transcript_file)\\n    veteran_id = slugify(veteran)\\n    \\n    console.print(f\\\"Ingesting transcript for [cyan]{veteran}[/cyan] ({veteran_id})\\\")\\n    console.print(\\\"\\\")\\n    \\n    # Check if veteran already exists\\n    storage = VeteranStorage(ctx)\\n    if storage.exists(veteran_id) and not dry_run:\\n        if not click.confirm(f\\\"Veteran {veteran_id} already exists. Overwrite?\\\"):\\n            return\\n    \\n    # Parse transcript\\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(\\\"Parsing transcript...\\\", total=None)\\n        \\n        # Read file and extract header info\\n        with open(transcript_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n            raw_text = f.read()\\n        \\n        header_info = extract_header_info(raw_text)\\n        responses = parse_transcript_file(transcript_path, veteran_name=veteran)\\n        \\n        progress.update(task, description=f\\\"Parsing transcript... {len(responses)} responses found\\\")\\n    \\n    console.print(f\\\"[green]\\u2713[/green] Parsed: {len(responses)} responses\\\")\\n    \\n    # Apply extracted header info\\n    if not unit and header_info.get(\\\"unit\\\"):\\n        unit = header_info[\\\"unit\\\"]\\n    if not rank and header_info.get(\\\"rank\\\"):\\n        rank = header_info[\\\"rank\\\"]\\n    \\n    # Create veteran object\\n    veteran_obj = Veteran(\\n        id=veteran_id,\\n        name=veteran,\\n        unit=unit,\\n        rank=rank,\\n        source=SourceInfo(\\n            file=transcript_path.name,\\n            date_recorded=header_info.get(\\\"date_recorded\\\"),\\n            location=source,\\n        ),\\n        responses=responses\\n    )\\n    \\n    # Extract metadata with LLM\\n    config = ctx.config\\n    try:\\n        llm_client = get_llm_client(\\n            provider=config.llm.provider,\\n            model=config.llm.model\\n        )\\n        extractor = ResponseExtractor(llm_client)\\n        synthesizer = VeteranSynthesizer(llm_client)\\n        \\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            BarColumn(),\\n            TextColumn(\\\"[progress.percentage]{task.percentage:>3.0f}%\\\"),\\n        ) as progress:\\n            task = progress.add_task(\\\"Extracting metadata...\\\", total=len(responses))\\n            \\n            def update_progress(current, total):\\n                progress.update(task, completed=current)\\n            \\n            extractor.extract_batch(responses, progress_callback=update_progress)\\n        \\n        console.print(f\\\"[green]\\u2713[/green] Extracted metadata for {len(responses)} responses\\\")\\n        \\n        # Synthesize profile\\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            transient=True,\\n        ) as progress:\\n            task = progress.add_task(\\\"Synthesizing veteran profile...\\\", total=None)\\n            veteran_obj = synthesizer.synthesize(veteran_obj)\\n        \\n        console.print(f\\\"[green]\\u2713[/green] Timeline: {len(veteran_obj.timeline)} events\\\")\\n        console.print(f\\\"[green]\\u2713[/green] Relationships: {len(veteran_obj.relationships)} people\\\")\\n        console.print(f\\\"[green]\\u2713[/green] Notable stories: {len(veteran_obj.notable_stories)}\\\")\\n        \\n    except Exception as e:\\n        console.print(f\\\"[yellow]Warning:[/yellow] LLM extraction failed: {e}\\\")\\n        console.print(\\\"  Continuing without metadata extraction...\\\")\\n    \\n    if dry_run:\\n        console.print(\\\"\\\")\\n        console.print(\\\"[yellow]DRY RUN - Not saving[/yellow]\\\")\\n        \\n        # Show sample extraction\\n        console.print(\\\"\\\")\\n        console.print(\\\"[bold]Sample extraction (first response):[/bold]\\\")\\n        if responses and responses[0].extracted:\\n            ext = responses[0].extracted\\n            console.print(f\\\"  Summary: {ext.summary}\\\")\\n            console.print(f\\\"  Topics: {', '.join(ext.topics)}\\\")\\n            console.print(f\\\"  Writing potential: {ext.writing_potential.value}\\\")\\n        \\n        return\\n    \\n    # Save veteran\\n    saved_path = storage.save(veteran_obj)\\n    console.print(f\\\"[green]\\u2713[/green] Saved: {saved_path}\\\")\\n    \\n    # Generate embeddings and index\\n    if not no_embeddings:\\n        try:\\n            with Progress(\\n                SpinnerColumn(),\\n                TextColumn(\\\"[progress.description]{task.description}\\\"),\\n                transient=True,\\n            ) as progress:\\n                task = progress.add_task(\\\"Generating embeddings...\\\", total=None)\\n                \\n                search_engine = SearchEngine(ctx)\\n                total_paragraphs = sum(len(r.paragraphs) for r in responses)\\n                progress.update(task, description=f\\\"Generating embeddings... {total_paragraphs} paragraphs\\\")\\n                \\n                search_engine.index.index_veteran(veteran_obj, generate_embeddings=True)\\n                search_engine.close()\\n            \\n            console.print(f\\\"[green]\\u2713[/green] Indexed: {len(responses)} responses, {total_paragraphs} paragraphs\\\")\\n        except Exception as e:\\n            console.print(f\\\"[yellow]Warning:[/yellow] Embedding generation failed: {e}\\\")\\n            console.print(\\\"  Run 'oralhistory reindex' later to generate embeddings\\\")\\n    \\n    # Show verification items\\n    if veteran_obj.verification_needed:\\n        console.print(\\\"\\\")\\n        console.print(\\\"[yellow]Verification needed:[/yellow]\\\")\\n        for item in veteran_obj.verification_needed:\\n            detail_text = f\\\": {item.detail}\\\" if item.detail else \\\"\\\"\\n            console.print(f\\\"  \\u2022 {item.issue}{detail_text}\\\")\\n            if item.response_ids:\\n                resp_refs = \\\", \\\".join([f\\\"[{r}]\\\" for r in item.response_ids])\\n                console.print(f\\\"    [dim]Responses: {resp_refs}[/dim]\\\")\\n    \\n    # Show notable stories\\n    if veteran_obj.notable_stories:\\n        console.print(\\\"\\\")\\n        console.print(\\\"[bold]Notable stories found:[/bold]\\\")\\n        for story in veteran_obj.notable_stories:\\n            potential = \\\"\\u2605 HIGH\\\" if story.writing_potential == WritingPotential.HIGH else story.writing_potential.value\\n            console.print(f\\\"  \\u2022 \\\\\\\"{story.title}\\\\\\\" ({potential})\\\")\\n\\n    # Prompt for immediate verification\\n    if not dry_run:\\n        console.print(\\\"\\\")\\n        if click.confirm(f\\\"Start interactive verification for [cyan]{veteran}[/cyan] now?\\\", default=True):\\n            run_interactive_verification(veteran_obj, storage, ctx)\\n        else:\\n            console.print(f\\\"\\\\n[bold yellow]>>> Run 'oralhistory verify {veteran_id}' later to audit this data.[/bold yellow]\\\")\\n\\n\\n# ============================================================================\\n# Search Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"query\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=20, help=\\\"Maximum results\\\")\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", help=\\\"Filter to specific veteran\\\")\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Filter to chapter\\\")\\n@click.option(\\\"--topic\\\", \\\"-t\\\", help=\\\"Filter by topic\\\")\\n@click.option(\\\"--potential\\\", \\\"-p\\\", type=click.Choice([\\\"low\\\", \\\"medium\\\", \\\"high\\\"]), help=\\\"Filter by writing potential\\\")\\n@click.option(\\\"--export\\\", \\\"export_name\\\", help=\\\"Export results to file\\\")\\ndef search(\\n    query: str,\\n    limit: int,\\n    veteran: Optional[str],\\n    chapter: Optional[int],\\n    topic: Optional[str],\\n    potential: Optional[str],\\n    export_name: Optional[str]\\n):\\n    \\\"\\\"\\\"Search across all veterans.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(\\\"Searching...\\\", total=None)\\n        \\n        results = search_engine.search(\\n            query=query,\\n            limit=limit,\\n            veteran_id=veteran,\\n            chapter=chapter,\\n            topic=topic,\\n            potential=potential\\n        )\\n    \\n    search_engine.close()\\n    \\n    if not results.hits:\\n        console.print(f\\\"[yellow]No results found for:[/yellow] {query}\\\")\\n        return\\n    \\n    # Display results\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        f\\\"[bold]SEARCH:[/bold] \\\\\\\"{query}\\\\\\\" ({results.veteran_count} veterans, {results.total_hits} responses)\\\",\\n        box=box.DOUBLE\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Group by veteran to avoid fragmented output\\n    from collections import defaultdict\\n    grouped_hits = defaultdict(list)\\n    for hit in results.hits:\\n        grouped_hits[hit.veteran_id].append(hit)\\n    \\n    # Get veteran names/info for sorting headers\\n    # We sort by the highest score in each group so the most relevant veteran stays at the top\\n    sorted_veterans = sorted(\\n        grouped_hits.items(), \\n        key=lambda x: max(h.score for h in x[1]), \\n        reverse=True\\n    )\\n    \\n    for _, hits in sorted_veterans:\\n        # Get first hit for veteran metadata\\n        first_hit = hits[0]\\n        \\n        header = f\\\"[bold cyan]{first_hit.veteran_name}[/bold cyan]\\\"\\n        if first_hit.unit or first_hit.rank:\\n            parts = []\\n            if first_hit.unit:\\n                parts.append(first_hit.unit)\\n            if first_hit.rank:\\n                parts.append(first_hit.rank)\\n            header += f\\\" [dim]({' | '.join(parts)})[/dim]\\\"\\n        \\n        console.print(\\\"\\\")\\n        console.print(Panel(header, box=box.ROUNDED, border_style=\\\"cyan\\\"))\\n        \\n        for hit in hits:\\n            # Response\\n            response = hit.response\\n            \\n            # Build metadata table for response header\\n            meta_table = Table(show_header=False, box=None, padding=(0, 1), expand=True)\\n            meta_table.add_column(\\\"ID\\\", style=\\\"cyan bold\\\", width=8)\\n            meta_table.add_column(\\\"Potential\\\", width=14)\\n            meta_table.add_column(\\\"Chapter\\\", width=12)\\n            meta_table.add_column(\\\"Topic\\\", style=\\\"dim\\\", min_width=40)\\n            \\n            # Format potential\\n            if response.extracted and response.extracted.writing_potential == WritingPotential.HIGH:\\n                potential_str = \\\"[yellow]\\u2605 HIGH[/yellow]\\\"\\n            elif response.extracted and response.extracted.writing_potential == WritingPotential.MEDIUM:\\n                potential_str = \\\"[dim]MEDIUM[/dim]\\\"\\n            else:\\n                potential_str = \\\"[dim]LOW[/dim]\\\"\\n            \\n            # Format chapter\\n            chapter_str = f\\\"Ch. {hit.chapter}\\\" if hit.chapter else \\\"[dim]\\u2014[/dim]\\\"\\n            \\n            # Format topic\\n            topic_str = response.extracted.summary[:50] + \\\"...\\\" if response.extracted and len(response.extracted.summary) > 50 else (response.extracted.summary if response.extracted else \\\"\\\")\\n            \\n            meta_table.add_row(f\\\"[{response.id}]\\\", potential_str, chapter_str, topic_str)\\n            console.print(meta_table)\\n            \\n            # LLM note and user notes\\n            if response.extracted and response.extracted.writing_note:\\n                console.print(f\\\"  [dim italic]LLM: \\\\\\\"{response.extracted.writing_note}\\\\\\\"[/dim italic]\\\")\\n            \\n            if hit.notes:\\n                for note in hit.notes:\\n                    console.print(f\\\"  [yellow]\\ud83d\\udcdd {note.text}[/yellow]\\\")\\n            \\n            # Question and Answer in a cleaner format\\n            console.print(\\\"\\\")\\n            q = response.interviewer[:200] + \\\"...\\\" if len(response.interviewer) > 200 else response.interviewer\\n            console.print(f\\\"  [bold dim]Q:[/bold dim] [italic]{q}[/italic]\\\")\\n            console.print(\\\"\\\")\\n            \\n            # Answer excerpt with better wrapping\\n            a = response.veteran[:500] + \\\"...\\\" if len(response.veteran) > 500 else response.veteran\\n            # Clean up multi-line for display\\n            a_clean = \\\" \\\".join(a.split())\\n            console.print(f\\\"  [bold dim]A:[/bold dim] \\\\\\\"{a_clean}\\\\\\\"\\\")\\n            \\n            console.print(\\\"\\\")\\n            console.print(f\\\"  [dim]\\u2500\\u2500\\u2500 oralhistory view {hit.veteran_id} {response.id} \\u2500\\u2500\\u2500[/dim]\\\")\\n            console.print(\\\"\\\")\\n    \\n    # Export if requested\\n    if export_name:\\n        exporter = Exporter(ctx)\\n        output_path = exporter.export_search_results(results, f\\\"{export_name}.md\\\")\\n        console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Veterans Command\\n# ============================================================================\\n\\n@cli.command()\\ndef veterans():\\n    \\\"\\\"\\\"List all veterans.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    veteran_ids = storage.list_veterans()\\n    \\n    if not veteran_ids:\\n        console.print(\\\"[yellow]No veterans found. Run 'oralhistory ingest' to add transcripts.[/yellow]\\\")\\n        return\\n    \\n    table = Table(title=f\\\"VETERANS ({len(veteran_ids)} total)\\\", box=box.ROUNDED)\\n    table.add_column(\\\"ID\\\", style=\\\"cyan\\\")\\n    table.add_column(\\\"Name\\\")\\n    table.add_column(\\\"Unit\\\")\\n    table.add_column(\\\"Responses\\\", justify=\\\"right\\\")\\n    \\n    for vid in sorted(veteran_ids):\\n        v = storage.load(vid)\\n        if v:\\n            table.add_row(\\n                vid,\\n                v.name,\\n                v.unit or \\\"-\\\",\\n                str(len(v.responses))\\n            )\\n    \\n    console.print(table)\\n\\n\\n# ============================================================================\\n# Verify Command (Interactive)\\n# ============================================================================\\n\\ndef run_interactive_verification(v: Veteran, storage: VeteranStorage, ctx: ProjectContext):\\n    \\\"\\\"\\\"Run the interactive verification loop for a veteran.\\\"\\\"\\\"\\n    console.print(Panel(f\\\"Interactive Verification: [bold]{v.name}[/bold]\\\", border_style=\\\"yellow\\\"))\\n    \\n    # 1. Identity Check\\n    console.print(\\\"\\\\n[bold]1. Identity Verification[/bold]\\\")\\n    \\n    # Name\\n    if not click.confirm(f\\\"Name: [cyan]{v.name}[/cyan]. Is this correct?\\\", default=True):\\n        v.name = click.prompt(\\\"Enter correct name\\\", default=v.name)\\n        \\n    # Rank\\n    if not click.confirm(f\\\"Rank: [cyan]{v.rank or 'None'}[/cyan]. Is this correct?\\\", default=True):\\n        v.rank = click.prompt(\\\"Enter correct rank\\\", default=v.rank or \\\"\\\")\\n        \\n    # Unit\\n    if not click.confirm(f\\\"Unit: [cyan]{v.unit or 'None'}[/cyan]. Is this correct?\\\", default=True):\\n        v.unit = click.prompt(\\\"Enter correct unit\\\", default=v.unit or \\\"\\\")\\n        \\n    # 2. Timeline Check (Low confidence items)\\n    if v.timeline:\\n        console.print(\\\"\\\\n[bold]2. Timeline Verification[/bold]\\\")\\n        for event in v.timeline:\\n            if event.confidence != Confidence.STATED or event.note:\\n                console.print(f\\\"\\\\nEvent: [cyan]{event.date}[/cyan] - {event.event}\\\")\\n                if event.note:\\n                    console.print(f\\\"[yellow]Note:[/yellow] {event.note}\\\")\\n                \\n                choice = click.prompt(\\n                    \\\"Action: [v]iew sources, [e]dit event, [c]onfirm, [s]kip\\\",\\n                    type=click.Choice(['v', 'e', 'c', 's']),\\n                    default='c'\\n                )\\n                \\n                if choice == 'v':\\n                    _display_verify_sources(v, event.response_ids)\\n                    # Prompt again after viewing\\n                    choice = click.prompt(\\n                        \\\"Action: [e]dit event, [c]onfirm, [s]kip\\\",\\n                        type=click.Choice(['e', 'c', 's']),\\n                        default='c'\\n                    )\\n                \\n                if choice == 'e':\\n                    event.date = click.prompt(\\\"Date\\\", default=event.date)\\n                    event.event = click.prompt(\\\"Event description\\\", default=event.event)\\n                    event.confidence = Confidence.STATED\\n                    event.note = None\\n                elif choice == 'c':\\n                    event.confidence = Confidence.STATED\\n                    event.note = None\\n\\n    # 3. LLM Flags (Verification Needed)\\n    if v.verification_needed:\\n        console.print(\\\"\\\\n[bold]3. Resolving LLM Flags[/bold]\\\")\\n        items_to_keep = []\\n        for item in v.verification_needed:\\n            console.print(f\\\"\\\\n[yellow]ISSUE:[/yellow] {item.issue}\\\")\\n            if item.detail:\\n                console.print(f\\\"[dim]{item.detail}[/dim]\\\")\\n            \\n            choice = click.prompt(\\n                \\\"Action: [v]iew sources, [r]esolve/remove, [k]eep flag, [s]kip\\\",\\n                type=click.Choice(['v', 'r', 'k', 's']),\\n                default='r'\\n            )\\n            \\n            if choice == 'v':\\n                _display_verify_sources(v, item.response_ids)\\n                choice = click.prompt(\\n                    \\\"Action: [r]esolve/remove, [k]eep flag, [s]kip\\\",\\n                    type=click.Choice(['r', 'k', 's']),\\n                    default='r'\\n                )\\n            \\n            if choice == 'k' or choice == 's':\\n                items_to_keep.append(item)\\n            elif choice == 'r':\\n                console.print(\\\"[green]Flag resolved.[/green]\\\")\\n                \\n        v.verification_needed = items_to_keep\\n\\n    # Save and Reindex\\n    v.verified = True\\n    storage.save(v)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        progress.add_task(\\\"Updating search index...\\\", total=None)\\n        search_engine = SearchEngine(ctx)\\n        search_engine.index.index_veteran(v)\\n        search_engine.close()\\n        \\n    console.print(f\\\"\\\\n[green]\\u2713[/green] Verification complete. Data saved and re-indexed.\\\")\\n\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\ndef verify(veteran_id: str):\\n    \\\"\\\"\\\"Interactive wizard to verify and correct veteran data.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    v = storage.load(veteran_id)\\n    \\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n        \\n    run_interactive_verification(v, storage, ctx)\\n\\n\\n# ============================================================================\\n# Rich Display Helper Functions\\n# ============================================================================\\n\\ndef _format_timeline_table(events: List[TimelineEvent]) -> Table:\\n    \\\"\\\"\\\"Format timeline events into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold cyan\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"Date\\\", style=\\\"bold\\\", width=20, no_wrap=True)\\n    table.add_column(\\\"Event\\\", style=\\\"\\\", min_width=40)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    table.add_column(\\\"\\\", width=3, justify=\\\"center\\\")  # Status indicator\\n    \\n    for event in events:\\n        # Format date with precision indicator\\n        date_str = event.date\\n        # Only add ~ if not already present and precision is approximate\\n        if event.date_precision == DatePrecision.APPROXIMATE and not date_str.startswith(\\\"~\\\"):\\n            date_str = f\\\"~{date_str}\\\"\\n        \\n        # Format response IDs\\n        if event.response_ids:\\n            resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in event.response_ids[:3]])\\n            if len(event.response_ids) > 3:\\n                resp_refs += f\\\" +{len(event.response_ids) - 3}\\\"\\n        else:\\n            resp_refs = \\\"[dim]\\u2014[/dim]\\\"\\n        \\n        # Format verification status\\n        if event.note:\\n            status = \\\"[yellow]\\u26a0[/yellow]\\\"\\n        elif event.confidence == Confidence.INFERRED:\\n            status = \\\"[dim]?[/dim]\\\"\\n        else:\\n            status = \\\"[green]\\u2713[/green]\\\"\\n        \\n        table.add_row(date_str, event.event, resp_refs, status)\\n    \\n    return table\\n\\n\\ndef _format_relationships_table(relationships: List[Relationship]) -> Table:\\n    \\\"\\\"\\\"Format relationships into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold cyan\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"Name\\\", style=\\\"bold\\\", width=18)\\n    table.add_column(\\\"Role\\\", style=\\\"dim\\\", width=15)\\n    table.add_column(\\\"Context\\\", style=\\\"\\\", min_width=30)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    \\n    for rel in relationships:\\n        resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in rel.response_ids]) if rel.response_ids else \\\"[dim]\\u2014[/dim]\\\"\\n        table.add_row(\\n            rel.canonical,\\n            rel.role or \\\"[dim]\\u2014[/dim]\\\",\\n            rel.context or \\\"[dim]\\u2014[/dim]\\\",\\n            resp_refs\\n        )\\n    \\n    return table\\n\\n\\ndef _format_stories_table(stories: List[NotableStory]) -> Table:\\n    \\\"\\\"\\\"Format notable stories into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold yellow\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"\\\", width=3)  # Star indicator\\n    table.add_column(\\\"Title\\\", style=\\\"bold\\\", min_width=25)\\n    table.add_column(\\\"Summary\\\", style=\\\"\\\", min_width=40)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    \\n    for story in stories:\\n        if story.writing_potential == WritingPotential.HIGH:\\n            star = \\\"[yellow]\\u2605[/yellow]\\\"\\n        elif story.writing_potential == WritingPotential.MEDIUM:\\n            star = \\\"[dim]\\u2606[/dim]\\\"\\n        else:\\n            star = \\\"[dim]\\u00b7[/dim]\\\"\\n        \\n        resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in story.response_ids]) if story.response_ids else \\\"[dim]\\u2014[/dim]\\\"\\n        \\n        # Truncate summary if too long\\n        summary = story.summary\\n        if len(summary) > 80:\\n            summary = summary[:77] + \\\"...\\\"\\n        \\n        table.add_row(star, story.title, summary, resp_refs)\\n    \\n    return table\\n\\n\\ndef _format_verification_table(items: List[VerificationItem]) -> Table:\\n    \\\"\\\"\\\"Format verification items into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold yellow\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"\\\", width=3)  # Warning icon\\n    table.add_column(\\\"Issue\\\", style=\\\"yellow\\\", width=22)\\n    table.add_column(\\\"Detail\\\", style=\\\"\\\", min_width=35)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim cyan\\\", width=14, justify=\\\"right\\\")\\n    \\n    for item in items:\\n        resp_refs = \\\" \\\".join([f\\\"[{r}]\\\" for r in item.response_ids]) if item.response_ids else \\\"[dim]\\u2014[/dim]\\\"\\n        detail = item.detail if item.detail else \\\"[dim]No details[/dim]\\\"\\n        if len(detail) > 60:\\n            detail = detail[:57] + \\\"...\\\"\\n        \\n        table.add_row(\\\"[yellow]\\u26a0[/yellow]\\\", item.issue, detail, resp_refs)\\n    \\n    return table\\n\\n\\ndef _format_responses_table(responses: List[Response]) -> Table:\\n    \\\"\\\"\\\"Format responses list into a Rich table.\\\"\\\"\\\"\\n    table = Table(\\n        show_header=True,\\n        header_style=\\\"bold cyan\\\",\\n        box=box.ROUNDED,\\n        padding=(0, 1),\\n        expand=True\\n    )\\n    \\n    table.add_column(\\\"ID\\\", style=\\\"cyan\\\", width=6)\\n    table.add_column(\\\"Potential\\\", width=10, justify=\\\"center\\\")\\n    table.add_column(\\\"Summary\\\", style=\\\"\\\", min_width=50)\\n    \\n    for r in responses:\\n        potential = \\\"[dim]\\u2014[/dim]\\\"\\n        if r.extracted:\\n            if r.extracted.writing_potential == WritingPotential.HIGH:\\n                potential = \\\"[yellow]\\u2605 HIGH[/yellow]\\\"\\n            elif r.extracted.writing_potential == WritingPotential.MEDIUM:\\n                potential = \\\"[dim]MEDIUM[/dim]\\\"\\n            else:\\n                potential = \\\"[dim]LOW[/dim]\\\"\\n        \\n        summary = r.extracted.summary if r.extracted else r.veteran[:80] + \\\"...\\\"\\n        if len(summary) > 80:\\n            summary = summary[:77] + \\\"...\\\"\\n        \\n        table.add_row(f\\\"[{r.id}]\\\", potential, summary)\\n    \\n    return table\\n\\n\\ndef _display_verify_sources(veteran: Veteran, response_ids: List[str]):\\n    \\\"\\\"\\\"Display full responses for verification.\\\"\\\"\\\"\\n    if not response_ids:\\n        console.print(\\\"[dim]No source responses linked.[/dim]\\\")\\n        return\\n        \\n    for rid in response_ids:\\n        # Find response\\n        response = next((r for r in veteran.responses if r.id == rid), None)\\n        if response:\\n            console.print(Panel(\\n                f\\\"[italic]Q: {response.interviewer}[/italic]\\\\n\\\\n{response.veteran}\\\",\\n                title=f\\\"Response [{rid}]\\\",\\n                border_style=\\\"cyan\\\",\\n                box=box.ROUNDED\\n            ))\\n        else:\\n            console.print(f\\\"[red]Response {rid} not found.[/red]\\\")\\n\\n\\n# ============================================================================\\n# Veteran Command (show single)\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.option(\\\"--timeline\\\", is_flag=True, help=\\\"Show timeline only\\\")\\n@click.option(\\\"--relationships\\\", is_flag=True, help=\\\"Show relationships only\\\")\\n@click.option(\\\"--responses\\\", is_flag=True, help=\\\"Show all responses\\\")\\n@click.option(\\\"--response\\\", \\\"response_id\\\", help=\\\"Show specific response\\\")\\ndef veteran(\\n    veteran_id: str,\\n    timeline: bool,\\n    relationships: bool,\\n    responses: bool,\\n    response_id: Optional[str]\\n):\\n    \\\"\\\"\\\"Show veteran profile.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    v = storage.load(veteran_id)\\n    \\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    # Header with name\\n    console.print(Panel(f\\\"[bold]{v.name}[/bold]\\\", box=box.DOUBLE, border_style=\\\"cyan\\\"))\\n    \\n    # Profile info table\\n    info_table = Table(show_header=False, box=None, padding=(0, 2), expand=True)\\n    info_table.add_column(\\\"Label\\\", style=\\\"bold\\\", width=10)\\n    info_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n    \\n    if v.unit:\\n        # Truncate long unit names\\n        unit_display = v.unit if len(v.unit) < 60 else v.unit[:57] + \\\"...\\\"\\n        info_table.add_row(\\\"Unit:\\\", unit_display)\\n    if v.rank:\\n        info_table.add_row(\\\"Rank:\\\", v.rank)\\n    if v.service_dates:\\n        dates = []\\n        if v.service_dates.start:\\n            dates.append(v.service_dates.start)\\n        if v.service_dates.end:\\n            dates.append(v.service_dates.end)\\n        if dates:\\n            info_table.add_row(\\\"Service:\\\", \\\" \\u2014 \\\".join(dates))\\n    if v.source:\\n        source_str = v.source.file\\n        if v.source.date_recorded:\\n            source_str += f\\\" [dim](Recorded: {v.source.date_recorded})[/dim]\\\"\\n        info_table.add_row(\\\"Source:\\\", source_str)\\n    \\n    # Add stats row\\n    stats_parts = []\\n    stats_parts.append(f\\\"{len(v.responses)} responses\\\")\\n    if v.timeline:\\n        stats_parts.append(f\\\"{len(v.timeline)} timeline events\\\")\\n    if v.relationships:\\n        stats_parts.append(f\\\"{len(v.relationships)} people\\\")\\n    if v.notable_stories:\\n        stats_parts.append(f\\\"{len(v.notable_stories)} notable stories\\\")\\n    info_table.add_row(\\\"Stats:\\\", \\\" | \\\".join(stats_parts))\\n    \\n    console.print(info_table)\\n    console.print(\\\"\\\")\\n    \\n    # Timeline\\n    if timeline or (not relationships and not responses and not response_id):\\n        if v.timeline:\\n            console.print(Panel(\\n                f\\\"[bold]TIMELINE[/bold] \\u2014 {len(v.timeline)} events\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"cyan\\\"\\n            ))\\n            \\n            timeline_table = _format_timeline_table(v.timeline)\\n            console.print(timeline_table)\\n            \\n            # Legend\\n            console.print(\\\"[dim]  ~ = approximate date  |  \\u2713 = verified  |  \\u26a0 = needs verification  |  ? = inferred[/dim]\\\")\\n            console.print(\\\"\\\")\\n    \\n    # Relationships\\n    if relationships or (not timeline and not responses and not response_id):\\n        if v.relationships:\\n            console.print(Panel(\\n                f\\\"[bold]RELATIONSHIPS[/bold] \\u2014 {len(v.relationships)} people\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"cyan\\\"\\n            ))\\n            \\n            relationships_table = _format_relationships_table(v.relationships)\\n            console.print(relationships_table)\\n            console.print(\\\"\\\")\\n    \\n    # Notable stories\\n    if not timeline and not relationships and not responses and not response_id:\\n        if v.notable_stories:\\n            console.print(Panel(\\n                f\\\"[bold]NOTABLE STORIES[/bold] \\u2014 {len(v.notable_stories)} stories\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"yellow\\\"\\n            ))\\n            \\n            stories_table = _format_stories_table(v.notable_stories)\\n            console.print(stories_table)\\n            \\n            # Legend\\n            console.print(\\\"[dim]  \\u2605 = HIGH potential  |  \\u2606 = MEDIUM potential  |  \\u00b7 = LOW potential[/dim]\\\")\\n            console.print(\\\"\\\")\\n        \\n        # Verification needed\\n        if v.verification_needed:\\n            console.print(Panel(\\n                f\\\"[bold]VERIFICATION NEEDED[/bold] \\u2014 {len(v.verification_needed)} items\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"yellow\\\"\\n            ))\\n            \\n            verification_table = _format_verification_table(v.verification_needed)\\n            console.print(verification_table)\\n            console.print(\\\"\\\")\\n    \\n    # Show specific response\\n    if response_id:\\n        for r in v.responses:\\n            if r.id == response_id:\\n                console.print(f\\\"[bold]RESPONSE [{r.id}][/bold]\\\")\\n                console.print(\\\"\\u2500\\\" * 60)\\n                console.print(\\\"\\\")\\n                console.print(f\\\"[italic]Q: {r.interviewer}[/italic]\\\")\\n                console.print(\\\"\\\")\\n                console.print(r.veteran)\\n                console.print(\\\"\\\")\\n                \\n                if r.extracted:\\n                    console.print(\\\"[bold]Extracted metadata:[/bold]\\\")\\n                    console.print(f\\\"  Summary: {r.extracted.summary}\\\")\\n                    console.print(f\\\"  Topics: {', '.join(r.extracted.topics)}\\\")\\n                    console.print(f\\\"  Potential: {r.extracted.writing_potential.value}\\\")\\n                    if r.extracted.writing_note:\\n                        console.print(f\\\"  Note: {r.extracted.writing_note}\\\")\\n                break\\n        else:\\n            console.print(f\\\"[red]Response not found: {response_id}[/red]\\\")\\n    \\n    # Show all responses\\n    if responses:\\n        console.print(Panel(\\n            f\\\"[bold]ALL RESPONSES[/bold] \\u2014 {len(v.responses)} responses\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        responses_table = _format_responses_table(v.responses)\\n        console.print(responses_table)\\n        \\n        # Hint for viewing full responses\\n        console.print(f\\\"[dim]  Use: oralhistory view {veteran_id} <ID> to see full text[/dim]\\\")\\n        console.print(\\\"\\\")\\n\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.option(\\\"--refresh\\\", is_flag=True, help=\\\"Re-generate the synthesis\\\")\\ndef profile(veteran_id: str, refresh: bool):\\n    \\\"\\\"\\\"Show high-level narrative synthesis for a veteran.\\n    \\n    Analyzes the entire interview to identify narrative themes, writing potential,\\n    and specific strengths for your book.\\n    \\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    v = storage.load(veteran_id)\\n    \\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    if not v.profile or refresh:\\n        llm_client = get_llm_client(\\n            provider=ctx.config.llm.provider,\\n            model=ctx.config.llm.model\\n        )\\n        synthesizer = NarrativeSynthesizer(llm_client)\\n        \\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            transient=True,\\n        ) as progress:\\n            task = progress.add_task(\\\"Generating narrative profile...\\\", total=None)\\n            v.profile = synthesizer.synthesize_profile(v)\\n            storage.save(v)\\n        \\n        console.print(f\\\"[green]\\u2713[/green] Narrative profile generated for [cyan]{v.name}[/cyan]\\\")\\n        console.print(\\\"\\\")\\n\\n    p = v.profile\\n    if not p:\\n        console.print(\\\"[red]Error: Could not load or generate profile.[/red]\\\")\\n        return\\n\\n    console.print(Panel(f\\\"[bold]{v.name}[/bold] \\u2014 Researcher's Brief\\\", box=box.DOUBLE, border_style=\\\"cyan\\\"))\\n    \\n    console.print(f\\\"[bold]Overview:[/bold]\\\\n{p.overview}\\\\n\\\")\\n    console.print(f\\\"[bold]Narrative Style:[/bold] {p.narrative_style}\\\\n\\\")\\n    \\n    # Thematic Strengths Table\\n    table = Table(title=\\\"THEMATIC STRENGTHS\\\", box=box.ROUNDED, expand=True)\\n    table.add_column(\\\"Theme\\\", style=\\\"bold cyan\\\", width=15)\\n    table.add_column(\\\"Potential\\\", width=10)\\n    table.add_column(\\\"Synthesis\\\", style=\\\"\\\", min_width=40)\\n    table.add_column(\\\"Sources\\\", style=\\\"dim\\\", width=12)\\n    \\n    for ts in p.thematic_strengths:\\n        potential = \\\"[dim]\\u2014[/dim]\\\"\\n        if ts.strength == WritingPotential.HIGH:\\n            potential = \\\"[yellow]\\u2605 HIGH[/yellow]\\\"\\n        elif ts.strength == WritingPotential.MEDIUM:\\n            potential = \\\"[dim]MEDIUM[/dim]\\\"\\n        else:\\n            potential = \\\"[dim]LOW[/dim]\\\"\\n            \\n        sources = \\\" \\\".join([f\\\"[{r}]\\\" for r in ts.response_ids[:3]])\\n        if len(ts.response_ids) > 3:\\n            sources += f\\\" +{len(ts.response_ids)-3}\\\"\\n            \\n        table.add_row(ts.theme, potential, ts.summary, sources)\\n    \\n    console.print(table)\\n    console.print(\\\"\\\")\\n    \\n    # Key Entities\\n    if p.key_entities:\\n        console.print(f\\\"[bold]Key Entities:[/bold] {', '.join(p.key_entities)}\\\\n\\\")\\n        \\n    # Writing Advice\\n    console.print(Panel(p.writing_advice, title=\\\"[bold yellow]WRITING ADVICE[/bold yellow]\\\", box=box.ROUNDED))\\n    \\n    console.print(f\\\"\\\\n[dim]Last updated: {p.last_updated}[/dim]\\\")\\n\\n\\n@cli.command()\\n@click.argument(\\\"query\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=10, help=\\\"Number of accounts to synthesize\\\")\\ndef topic(query: str, limit: int):\\n    \\\"\\\"\\\"Synthesize a cross-veteran narrative on a specific topic.\\n    \\n    Searches across all veterans for the topic and uses an LLM to write\\n    a consolidated account with citations to specific response IDs.\\n    \\n    Example: oralhistory topic \\\"Battle of the Bulge Bastogne\\\"\\n    \\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    llm_client = get_llm_client(\\n        provider=ctx.config.llm.provider,\\n        model=ctx.config.llm.model\\n    )\\n    synthesizer = NarrativeSynthesizer(llm_client)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(f\\\"Searching for accounts of '{query}'...\\\", total=None)\\n        results = search_engine.search(query, limit=limit)\\n        \\n        if not results.hits:\\n            console.print(f\\\"[yellow]No accounts found for:[/yellow] {query}\\\")\\n            return\\n            \\n        progress.update(task, description=f\\\"Synthesizing {len(results.hits)} accounts into narrative...\\\")\\n        synthesis = synthesizer.synthesize_topic(query, results.hits)\\n    \\n    console.print(\\\"\\\")\\n    console.print(Markdown(synthesis))\\n    console.print(\\\"\\\")\\n    \\n    # Show source summary\\n    console.print(\\\"[dim]Sources used in this synthesis:[/dim]\\\")\\n    source_table = Table(show_header=False, box=None, padding=(0, 1))\\n    source_table.add_column(\\\"ID\\\", style=\\\"dim cyan\\\")\\n    source_table.add_column(\\\"Name\\\", style=\\\"dim\\\")\\n    \\n    unique_vets = {}\\n    for hit in results.hits:\\n        unique_vets[hit.veteran_id] = hit.veteran_name\\n        \\n    for vid, name in sorted(unique_vets.items()):\\n        source_table.add_row(vid, name)\\n        \\n    console.print(source_table)\\n    console.print(f\\\"\\\\n[dim]Total responses analyzed: {len(results.hits)}[/dim]\\\")\\n\\n\\n# ============================================================================\\n# View Command (Full Passage Preview)\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.argument(\\\"response_id\\\")\\ndef view(veteran_id: str, response_id: str):\\n    \\\"\\\"\\\"View full text of a specific response.\\n    \\n    Shows the complete, untruncated interviewer question and veteran answer,\\n    along with extracted metadata and any annotations.\\n    \\n    Example: oralhistory view mitchell_james 005\\n    \\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    veteran_storage = VeteranStorage(ctx)\\n    annotation_storage = AnnotationStorage(ctx)\\n    \\n    # Load veteran\\n    v = veteran_storage.load(veteran_id)\\n    if not v:\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    # Find response\\n    response = None\\n    for r in v.responses:\\n        if r.id == response_id:\\n            response = r\\n            break\\n    \\n    if not response:\\n        console.print(f\\\"[red]Response not found: {response_id}[/red]\\\")\\n        console.print(f\\\"[dim]Available responses: {', '.join([r.id for r in v.responses[:10]])}{'...' if len(v.responses) > 10 else ''}[/dim]\\\")\\n        return\\n    \\n    # Load annotations\\n    annotations = annotation_storage.load(veteran_id)\\n    resp_annot = annotations.response_annotations.get(response_id)\\n    \\n    # Header\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        f\\\"[bold]{v.name}[/bold] \\u2014 Response [{response_id}]\\\",\\n        box=box.DOUBLE\\n    ))\\n    \\n    # Metadata info table\\n    info_table = Table(show_header=False, box=None, padding=(0, 2))\\n    info_table.add_column(\\\"Label\\\", style=\\\"bold\\\", width=10)\\n    info_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n    \\n    if v.unit:\\n        unit_display = v.unit if len(v.unit) < 50 else v.unit[:47] + \\\"...\\\"\\n        info_table.add_row(\\\"Unit:\\\", unit_display)\\n    if v.rank:\\n        info_table.add_row(\\\"Rank:\\\", v.rank)\\n    if resp_annot and resp_annot.chapter:\\n        info_table.add_row(\\\"Chapter:\\\", str(resp_annot.chapter))\\n    if response.extracted:\\n        potential = response.extracted.writing_potential.value.upper()\\n        if response.extracted.writing_potential == WritingPotential.HIGH:\\n            potential = f\\\"[yellow]\\u2605 {potential}[/yellow]\\\"\\n        info_table.add_row(\\\"Potential:\\\", potential)\\n    \\n    console.print(info_table)\\n    console.print(\\\"\\\")\\n    \\n    # Interviewer question in a panel\\n    console.print(Panel(\\n        f\\\"[italic]{response.interviewer}[/italic]\\\",\\n        title=\\\"[bold cyan]INTERVIEWER[/bold cyan]\\\",\\n        title_align=\\\"left\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"cyan\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Veteran response in a panel\\n    console.print(Panel(\\n        response.veteran,\\n        title=\\\"[bold green]VETERAN[/bold green]\\\",\\n        title_align=\\\"left\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"green\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Extracted metadata in a table\\n    if response.extracted:\\n        console.print(Panel(\\n            \\\"[bold]EXTRACTED METADATA[/bold]\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"dim\\\"\\n        ))\\n        \\n        meta_table = Table(show_header=False, box=box.SIMPLE, padding=(0, 1), expand=True)\\n        meta_table.add_column(\\\"Field\\\", style=\\\"bold\\\", width=12)\\n        meta_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n        \\n        meta_table.add_row(\\\"Summary:\\\", response.extracted.summary)\\n        \\n        if response.extracted.topics:\\n            meta_table.add_row(\\\"Topics:\\\", \\\", \\\".join(response.extracted.topics))\\n        \\n        if response.extracted.locations:\\n            meta_table.add_row(\\\"Locations:\\\", \\\", \\\".join(response.extracted.locations))\\n        \\n        if response.extracted.people:\\n            people_str = \\\", \\\".join([p.name for p in response.extracted.people])\\n            meta_table.add_row(\\\"People:\\\", people_str)\\n        \\n        if response.extracted.dates:\\n            dates_str = \\\"; \\\".join([f\\\"{d.value} ({d.context})\\\" for d in response.extracted.dates])\\n            meta_table.add_row(\\\"Dates:\\\", dates_str)\\n        \\n        if response.extracted.writing_note:\\n            meta_table.add_row(\\\"LLM Note:\\\", f\\\"[italic]{response.extracted.writing_note}[/italic]\\\")\\n        \\n        console.print(meta_table)\\n        console.print(\\\"\\\")\\n    \\n    # Annotations in a table\\n    if resp_annot:\\n        if resp_annot.notes or resp_annot.flags:\\n            console.print(Panel(\\n                \\\"[bold]YOUR ANNOTATIONS[/bold]\\\",\\n                box=box.ROUNDED,\\n                border_style=\\\"yellow\\\"\\n            ))\\n            \\n            annot_table = Table(show_header=False, box=box.SIMPLE, padding=(0, 1))\\n            annot_table.add_column(\\\"Field\\\", style=\\\"bold\\\", width=10)\\n            annot_table.add_column(\\\"Value\\\", style=\\\"\\\")\\n            \\n            for note in resp_annot.notes:\\n                annot_table.add_row(f\\\"[{note.date}]\\\", note.text)\\n            \\n            if resp_annot.flags:\\n                annot_table.add_row(\\\"Flags:\\\", \\\"[yellow]\\\" + \\\", \\\".join(resp_annot.flags) + \\\"[/yellow]\\\")\\n            \\n            console.print(annot_table)\\n            console.print(\\\"\\\")\\n    \\n    # Quick actions in a subtle box\\n    actions_table = Table(show_header=False, box=None, padding=(0, 1))\\n    actions_table.add_column(\\\"\\\", style=\\\"dim\\\")\\n    actions_table.add_row(f\\\"\\u2192 Assign chapter: oralhistory annotate {veteran_id} {response_id} --chapter N\\\")\\n    actions_table.add_row(f\\\"\\u2192 Add note: oralhistory annotate {veteran_id} {response_id} --note \\\\\\\"...\\\\\\\"\\\")\\n    actions_table.add_row(f\\\"\\u2192 Export veteran: oralhistory export veteran {veteran_id}\\\")\\n    \\n    console.print(\\\"[dim]Quick actions:[/dim]\\\")\\n    console.print(actions_table)\\n\\n\\n# ============================================================================\\n# Annotate Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\")\\n@click.argument(\\\"response_id\\\", required=False)\\n@click.option(\\\"--note\\\", \\\"-n\\\", help=\\\"Add a note\\\")\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Assign to chapter\\\")\\n@click.option(\\\"--flag\\\", \\\"-f\\\", help=\\\"Add a flag\\\")\\n@click.option(\\\"--remove-flag\\\", help=\\\"Remove a flag\\\")\\n@click.option(\\\"--veteran-note\\\", help=\\\"Add note about veteran (not specific response)\\\")\\n@click.option(\\\"--todo\\\", help=\\\"Add research todo\\\")\\ndef annotate(\\n    veteran_id: str,\\n    response_id: Optional[str],\\n    note: Optional[str],\\n    chapter: Optional[int],\\n    flag: Optional[str],\\n    remove_flag: Optional[str],\\n    veteran_note: Optional[str],\\n    todo: Optional[str]\\n):\\n    \\\"\\\"\\\"Add annotations to a response or veteran.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = AnnotationStorage(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    # Verify veteran exists\\n    if not veteran_storage.exists(veteran_id):\\n        console.print(f\\\"[red]Veteran not found: {veteran_id}[/red]\\\")\\n        return\\n    \\n    # Handle response-specific annotations\\n    if response_id:\\n        if note:\\n            storage.add_response_note(veteran_id, response_id, note)\\n            console.print(f\\\"[green]\\u2713[/green] Added note to {veteran_id}:{response_id}\\\")\\n        \\n        if chapter is not None:\\n            storage.set_chapter(veteran_id, response_id, chapter)\\n            console.print(f\\\"[green]\\u2713[/green] Assigned {veteran_id}:{response_id} to chapter {chapter}\\\")\\n        \\n        if flag:\\n            storage.add_flag(veteran_id, response_id, flag)\\n            console.print(f\\\"[green]\\u2713[/green] Added flag '{flag}' to {veteran_id}:{response_id}\\\")\\n        \\n        if remove_flag:\\n            storage.remove_flag(veteran_id, response_id, remove_flag)\\n            console.print(f\\\"[green]\\u2713[/green] Removed flag '{remove_flag}' from {veteran_id}:{response_id}\\\")\\n    \\n    # Handle veteran-level annotations\\n    if veteran_note:\\n        storage.add_veteran_note(veteran_id, veteran_note)\\n        console.print(f\\\"[green]\\u2713[/green] Added note to {veteran_id}\\\")\\n    \\n    if todo:\\n        storage.add_todo(veteran_id, todo)\\n        console.print(f\\\"[green]\\u2713[/green] Added research todo for {veteran_id}\\\")\\n\\n\\n# ============================================================================\\n# Annotations Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran_id\\\", required=False)\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Show annotations for chapter\\\")\\n@click.option(\\\"--flags\\\", is_flag=True, help=\\\"Show all flagged responses\\\")\\ndef annotations(\\n    veteran_id: Optional[str],\\n    chapter: Optional[int],\\n    flags: bool\\n):\\n    \\\"\\\"\\\"View annotations.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = AnnotationStorage(ctx)\\n    \\n    if chapter is not None:\\n        # Show all responses in chapter\\n        chapter_responses = storage.get_chapter_responses(chapter)\\n        \\n        if not chapter_responses:\\n            console.print(f\\\"[yellow]No responses assigned to chapter {chapter}[/yellow]\\\")\\n            return\\n        \\n        total_responses = sum(len(rids) for rids in chapter_responses.values())\\n        console.print(Panel(\\n            f\\\"[bold]CHAPTER {chapter}[/bold] \\u2014 {total_responses} responses from {len(chapter_responses)} veterans\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        # Create table for chapter responses\\n        chapter_table = Table(show_header=True, header_style=\\\"bold cyan\\\", box=box.ROUNDED)\\n        chapter_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=25)\\n        chapter_table.add_column(\\\"Responses\\\", style=\\\"\\\", min_width=40)\\n        \\n        for vid, resp_ids in chapter_responses.items():\\n            chapter_table.add_row(vid, \\\" \\\".join([f\\\"[{r}]\\\" for r in resp_ids]))\\n        \\n        console.print(chapter_table)\\n        return\\n    \\n    if flags:\\n        # Show all flagged responses\\n        flagged = storage.get_flagged_responses()\\n        \\n        if not flagged:\\n            console.print(\\\"[yellow]No flagged responses[/yellow]\\\")\\n            return\\n        \\n        console.print(Panel(\\n            \\\"[bold]FLAGGED RESPONSES[/bold]\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"yellow\\\"\\n        ))\\n        \\n        # Create table for flagged responses\\n        flagged_table = Table(show_header=True, header_style=\\\"bold yellow\\\", box=box.ROUNDED)\\n        flagged_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=20)\\n        flagged_table.add_column(\\\"Response\\\", style=\\\"cyan\\\", width=10)\\n        flagged_table.add_column(\\\"Flags\\\", style=\\\"yellow\\\", min_width=30)\\n        \\n        for vid, resp_flags in flagged.items():\\n            for resp_id, flag_list in resp_flags.items():\\n                flagged_table.add_row(vid, f\\\"[{resp_id}]\\\", \\\", \\\".join(flag_list))\\n        \\n        console.print(flagged_table)\\n        return\\n    \\n    if veteran_id:\\n        # Show annotations for specific veteran\\n        annots = storage.load(veteran_id)\\n        \\n        console.print(Panel(\\n            f\\\"[bold]ANNOTATIONS[/bold] \\u2014 {veteran_id}\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        # Veteran notes\\n        if annots.veteran_notes:\\n            console.print(\\\"[bold cyan]Veteran Notes[/bold cyan]\\\")\\n            notes_table = Table(show_header=False, box=box.SIMPLE, padding=(0, 1))\\n            notes_table.add_column(\\\"Date\\\", style=\\\"dim\\\", width=12)\\n            notes_table.add_column(\\\"Note\\\", style=\\\"\\\")\\n            for note in annots.veteran_notes:\\n                notes_table.add_row(note.date, note.text)\\n            console.print(notes_table)\\n            console.print(\\\"\\\")\\n        \\n        # Research todos\\n        if annots.research_todos:\\n            console.print(\\\"[bold cyan]Research Todos[/bold cyan]\\\")\\n            for todo in annots.research_todos:\\n                console.print(f\\\"  [yellow]\\u2610[/yellow] {todo}\\\")\\n            console.print(\\\"\\\")\\n        \\n        # Response annotations\\n        if annots.response_annotations:\\n            console.print(\\\"[bold cyan]Response Annotations[/bold cyan]\\\")\\n            resp_table = Table(show_header=True, header_style=\\\"bold\\\", box=box.ROUNDED)\\n            resp_table.add_column(\\\"Response\\\", style=\\\"cyan\\\", width=10)\\n            resp_table.add_column(\\\"Chapter\\\", width=10, justify=\\\"center\\\")\\n            resp_table.add_column(\\\"Flags\\\", style=\\\"yellow\\\", width=25)\\n            resp_table.add_column(\\\"Notes\\\", style=\\\"\\\", min_width=30)\\n            \\n            for resp_id, ra in annots.response_annotations.items():\\n                chapter_str = f\\\"Ch. {ra.chapter}\\\" if ra.chapter else \\\"[dim]\\u2014[/dim]\\\"\\n                flags_str = \\\", \\\".join(ra.flags) if ra.flags else \\\"[dim]\\u2014[/dim]\\\"\\n                notes_str = \\\"; \\\".join([n.text for n in ra.notes[:2]]) if ra.notes else \\\"[dim]\\u2014[/dim]\\\"\\n                if len(ra.notes) > 2:\\n                    notes_str += f\\\" (+{len(ra.notes) - 2} more)\\\"\\n                resp_table.add_row(f\\\"[{resp_id}]\\\", chapter_str, flags_str, notes_str)\\n            \\n            console.print(resp_table)\\n    else:\\n        console.print(\\\"Usage: oralhistory annotations [VETERAN_ID] [--chapter N] [--flags]\\\")\\n\\n\\n# ============================================================================\\n# Chapter Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"chapter_num\\\", type=int)\\n@click.option(\\\"--export\\\", is_flag=True, help=\\\"Export chapter to file\\\")\\ndef chapter(chapter_num: int, export: bool):\\n    \\\"\\\"\\\"Show or export chapter material.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    annotation_storage = AnnotationStorage(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    chapter_responses = annotation_storage.get_chapter_responses(chapter_num)\\n    \\n    if not chapter_responses:\\n        console.print(f\\\"[yellow]No responses assigned to chapter {chapter_num}[/yellow]\\\")\\n        return\\n    \\n    total_responses = sum(len(rids) for rids in chapter_responses.values())\\n    \\n    console.print(Panel(\\n        f\\\"[bold]CHAPTER {chapter_num}[/bold] ({total_responses} responses from {len(chapter_responses)} veterans)\\\",\\n        box=box.DOUBLE\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    for veteran_id, resp_ids in chapter_responses.items():\\n        v = veteran_storage.load(veteran_id)\\n        if not v:\\n            continue\\n        \\n        annots = annotation_storage.load(veteran_id)\\n        \\n        # Veteran header panel\\n        console.print(Panel(\\n            f\\\"[bold]{v.name}[/bold] \\u2014 {len(resp_ids)} responses\\\",\\n            box=box.ROUNDED,\\n            border_style=\\\"cyan\\\"\\n        ))\\n        \\n        # Create table for this veteran's responses\\n        vet_table = Table(show_header=True, header_style=\\\"bold\\\", box=box.SIMPLE, padding=(0, 1))\\n        vet_table.add_column(\\\"ID\\\", style=\\\"cyan\\\", width=6)\\n        vet_table.add_column(\\\"\\\", width=3)  # Potential indicator\\n        vet_table.add_column(\\\"Summary\\\", style=\\\"\\\", min_width=45)\\n        vet_table.add_column(\\\"Notes\\\", style=\\\"dim\\\", width=25)\\n        \\n        for resp_id in resp_ids:\\n            # Find response\\n            response = None\\n            for r in v.responses:\\n                if r.id == resp_id:\\n                    response = r\\n                    break\\n            \\n            if response:\\n                resp_annot = annots.response_annotations.get(resp_id)\\n                \\n                # Potential indicator\\n                if response.extracted and response.extracted.writing_potential == WritingPotential.HIGH:\\n                    potential = \\\"[yellow]\\u2605[/yellow]\\\"\\n                elif response.extracted and response.extracted.writing_potential == WritingPotential.MEDIUM:\\n                    potential = \\\"[dim]\\u2606[/dim]\\\"\\n                else:\\n                    potential = \\\"\\\"\\n                \\n                # Summary\\n                title = response.extracted.summary if response.extracted else response.veteran[:60] + \\\"...\\\"\\n                if len(title) > 50:\\n                    title = title[:47] + \\\"...\\\"\\n                \\n                # Notes\\n                notes_str = \\\"\\\"\\n                if resp_annot and resp_annot.notes:\\n                    notes_str = resp_annot.notes[0].text[:25]\\n                    if len(resp_annot.notes) > 1:\\n                        notes_str += f\\\" (+{len(resp_annot.notes) - 1})\\\"\\n                \\n                vet_table.add_row(f\\\"[{resp_id}]\\\", potential, title, notes_str if notes_str else \\\"[dim]\\u2014[/dim]\\\")\\n        \\n        console.print(vet_table)\\n        console.print(\\\"\\\")\\n    \\n    if export:\\n        exporter = Exporter(ctx)\\n        output_path = exporter.export_chapter(chapter_num)\\n        console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Export Command\\n# ============================================================================\\n\\n@cli.group()\\ndef export():\\n    \\\"\\\"\\\"Export commands.\\\"\\\"\\\"\\n    pass\\n\\n\\n@export.command(\\\"chapter\\\")\\n@click.argument(\\\"chapter_num\\\", type=int)\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_chapter(chapter_num: int, filename: Optional[str]):\\n    \\\"\\\"\\\"Export a chapter.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_chapter(chapter_num, filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n@export.command(\\\"veteran\\\")\\n@click.argument(\\\"veteran_id\\\")\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_veteran(veteran_id: str, filename: Optional[str]):\\n    \\\"\\\"\\\"Export a veteran's material.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_veteran(veteran_id, filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n@export.command(\\\"stories\\\")\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_stories(filename: Optional[str]):\\n    \\\"\\\"\\\"Export all notable stories.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_stories(filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n@export.command(\\\"timeline\\\")\\n@click.option(\\\"--start\\\", help=\\\"Start date (YYYY-MM)\\\")\\n@click.option(\\\"--end\\\", help=\\\"End date (YYYY-MM)\\\")\\n@click.option(\\\"--filename\\\", \\\"-f\\\", help=\\\"Output filename\\\")\\ndef export_timeline(start: Optional[str], end: Optional[str], filename: Optional[str]):\\n    \\\"\\\"\\\"Export combined timeline.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    exporter = Exporter(ctx)\\n    output_path = exporter.export_timeline(start, end, filename)\\n    console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Reindex Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--no-embeddings\\\", is_flag=True, help=\\\"Skip embedding generation\\\")\\ndef reindex(no_embeddings: bool):\\n    \\\"\\\"\\\"Rebuild search indexes.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    veteran_ids = veteran_storage.list_veterans()\\n    \\n    if not veteran_ids:\\n        console.print(\\\"[yellow]No veterans to index[/yellow]\\\")\\n        return\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        BarColumn(),\\n        TextColumn(\\\"[progress.percentage]{task.percentage:>3.0f}%\\\"),\\n    ) as progress:\\n        task = progress.add_task(\\\"Reindexing...\\\", total=len(veteran_ids))\\n        \\n        for vid in veteran_ids:\\n            progress.update(task, description=f\\\"Indexing {vid}...\\\")\\n            \\n            veteran = veteran_storage.load(vid)\\n            if veteran:\\n                search_engine.index.index_veteran(\\n                    veteran, \\n                    generate_embeddings=not no_embeddings\\n                )\\n            \\n            progress.advance(task)\\n    \\n    search_engine.close()\\n    console.print(f\\\"[green]\\u2713[/green] Reindexed {len(veteran_ids)} veterans\\\")\\n\\n\\n# ============================================================================\\n# Stats Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--detailed\\\", is_flag=True, help=\\\"Show detailed statistics\\\")\\ndef stats(detailed: bool):\\n    \\\"\\\"\\\"Show project-wide statistics and coverage analysis.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    annotation_storage = AnnotationStorage(ctx)\\n    veteran_ids = storage.list_veterans()\\n    \\n    if not veteran_ids:\\n        console.print(\\\"[yellow]No veterans found. Run 'oralhistory ingest' to add transcripts.[/yellow]\\\")\\n        return\\n    \\n    # Collect statistics\\n    total_responses = 0\\n    total_paragraphs = 0\\n    verified_count = 0\\n    annotated_count = 0\\n    high_potential_count = 0\\n    medium_potential_count = 0\\n    low_potential_count = 0\\n    \\n    topic_counts: Dict[str, int] = {}\\n    location_counts: Dict[str, int] = {}\\n    year_counts: Dict[str, int] = {}\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(\\\"Gathering statistics...\\\", total=None)\\n        \\n        for vid in veteran_ids:\\n            v = storage.load(vid)\\n            if not v:\\n                continue\\n            \\n            if v.verified:\\n                verified_count += 1\\n            \\n            for r in v.responses:\\n                total_responses += 1\\n                total_paragraphs += len(r.paragraphs)\\n                \\n                if r.extracted:\\n                    # Count writing potential\\n                    if r.extracted.writing_potential == WritingPotential.HIGH:\\n                        high_potential_count += 1\\n                    elif r.extracted.writing_potential == WritingPotential.MEDIUM:\\n                        medium_potential_count += 1\\n                    else:\\n                        low_potential_count += 1\\n                    \\n                    # Count topics\\n                    for topic in r.extracted.topics:\\n                        topic_lower = topic.lower()\\n                        topic_counts[topic_lower] = topic_counts.get(topic_lower, 0) + 1\\n                    \\n                    # Count locations\\n                    for loc in r.extracted.locations:\\n                        location_counts[loc] = location_counts.get(loc, 0) + 1\\n                    \\n                    # Extract years from dates\\n                    for d in r.extracted.dates:\\n                        # Try to extract year (1942, 1943, etc.)\\n                        import re\\n                        year_match = re.search(r'\\\\b(19[3-4][0-9])\\\\b', d.value)\\n                        if year_match:\\n                            year = year_match.group(1)\\n                            year_counts[year] = year_counts.get(year, 0) + 1\\n            \\n            # Count annotations\\n            annots = annotation_storage.load(vid)\\n            if annots.response_annotations:\\n                annotated_count += len(annots.response_annotations)\\n    \\n    # Display header\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        \\\"[bold]PROJECT STATISTICS[/bold]\\\",\\n        box=box.DOUBLE,\\n        border_style=\\\"cyan\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Summary stats table\\n    summary_table = Table(show_header=False, box=None, padding=(0, 2), expand=True)\\n    summary_table.add_column(\\\"Label\\\", style=\\\"bold\\\", width=14)\\n    summary_table.add_column(\\\"Value\\\", style=\\\"cyan\\\", width=10, justify=\\\"right\\\")\\n    summary_table.add_column(\\\"Label2\\\", style=\\\"bold\\\", width=14)\\n    summary_table.add_column(\\\"Value2\\\", style=\\\"cyan\\\", width=10, justify=\\\"right\\\")\\n    summary_table.add_column(\\\"Label3\\\", style=\\\"bold\\\", width=14)\\n    summary_table.add_column(\\\"Value3\\\", style=\\\"cyan\\\", width=10, justify=\\\"right\\\")\\n    \\n    summary_table.add_row(\\n        \\\"Veterans:\\\", str(len(veteran_ids)),\\n        \\\"Responses:\\\", f\\\"{total_responses:,}\\\",\\n        \\\"Paragraphs:\\\", f\\\"{total_paragraphs:,}\\\"\\n    )\\n    summary_table.add_row(\\n        \\\"Verified:\\\", f\\\"{verified_count}/{len(veteran_ids)}\\\",\\n        \\\"Annotated:\\\", f\\\"{annotated_count:,}\\\",\\n        \\\"HIGH potential:\\\", f\\\"{high_potential_count:,}\\\"\\n    )\\n    \\n    console.print(summary_table)\\n    console.print(\\\"\\\")\\n    \\n    # Topic coverage bar chart\\n    if topic_counts:\\n        console.print(\\\"[bold]TOPIC COVERAGE[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        # Sort by count, take top 10\\n        sorted_topics = sorted(topic_counts.items(), key=lambda x: x[1], reverse=True)[:10]\\n        max_count = sorted_topics[0][1] if sorted_topics else 1\\n        bar_width = 30\\n        \\n        for topic, count in sorted_topics:\\n            bar_length = int((count / max_count) * bar_width)\\n            bar = \\\"\\u2588\\\" * bar_length\\n            # Truncate topic name if too long\\n            topic_display = topic[:14] if len(topic) > 14 else topic.ljust(14)\\n            console.print(f\\\" {topic_display} [cyan]{bar}[/cyan]  {count}\\\")\\n        \\n        console.print(\\\"\\\")\\n    \\n    # Time coverage bar chart\\n    if year_counts:\\n        console.print(\\\"[bold]TIME COVERAGE[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        # Sort by year\\n        sorted_years = sorted(year_counts.items(), key=lambda x: x[0])\\n        max_count = max(year_counts.values()) if year_counts else 1\\n        bar_width = 40\\n        \\n        for year, count in sorted_years:\\n            bar_length = int((count / max_count) * bar_width)\\n            bar = \\\"\\u2588\\\" * bar_length\\n            console.print(f\\\" {year} [green]{bar}[/green]  {count}\\\")\\n        \\n        console.print(\\\"\\\")\\n    \\n    # Top locations\\n    if location_counts:\\n        console.print(\\\"[bold]TOP LOCATIONS[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        # Sort by count, take top 10\\n        sorted_locs = sorted(location_counts.items(), key=lambda x: x[1], reverse=True)[:10]\\n        loc_strings = [f\\\"{loc} ({count})\\\" for loc, count in sorted_locs]\\n        console.print(f\\\" {', '.join(loc_strings)}\\\")\\n        console.print(\\\"\\\")\\n    \\n    # Writing potential distribution\\n    console.print(\\\"[bold]WRITING POTENTIAL[/bold]\\\")\\n    console.print(\\\"\\u2500\\\" * 63)\\n    \\n    total_extracted = high_potential_count + medium_potential_count + low_potential_count\\n    if total_extracted > 0:\\n        high_pct = (high_potential_count / total_extracted) * 100\\n        medium_pct = (medium_potential_count / total_extracted) * 100\\n        low_pct = (low_potential_count / total_extracted) * 100\\n        \\n        potential_table = Table(show_header=False, box=None, padding=(0, 1))\\n        potential_table.add_column(\\\"Level\\\", width=10)\\n        potential_table.add_column(\\\"Bar\\\", width=35)\\n        potential_table.add_column(\\\"Count\\\", width=15, justify=\\\"right\\\")\\n        \\n        high_bar = \\\"\\u2588\\\" * int(high_pct / 3)\\n        medium_bar = \\\"\\u2588\\\" * int(medium_pct / 3)\\n        low_bar = \\\"\\u2588\\\" * int(low_pct / 3)\\n        \\n        potential_table.add_row(\\\"\\u2605 HIGH\\\", f\\\"[yellow]{high_bar}[/yellow]\\\", f\\\"{high_potential_count:,} ({high_pct:.1f}%)\\\")\\n        potential_table.add_row(\\\"\\u2606 MEDIUM\\\", f\\\"[dim]{medium_bar}[/dim]\\\", f\\\"{medium_potential_count:,} ({medium_pct:.1f}%)\\\")\\n        potential_table.add_row(\\\"\\u00b7 LOW\\\", f\\\"[dim]{low_bar}[/dim]\\\", f\\\"{low_potential_count:,} ({low_pct:.1f}%)\\\")\\n        \\n        console.print(potential_table)\\n    \\n    console.print(\\\"\\\")\\n    \\n    # Detailed view\\n    if detailed:\\n        console.print(\\\"[bold]VETERAN DETAILS[/bold]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        detail_table = Table(\\n            show_header=True,\\n            header_style=\\\"bold cyan\\\",\\n            box=box.ROUNDED,\\n            expand=True\\n        )\\n        detail_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=25)\\n        detail_table.add_column(\\\"Responses\\\", justify=\\\"right\\\", width=10)\\n        detail_table.add_column(\\\"HIGH\\\", justify=\\\"right\\\", width=8)\\n        detail_table.add_column(\\\"Verified\\\", justify=\\\"center\\\", width=10)\\n        detail_table.add_column(\\\"Stories\\\", justify=\\\"right\\\", width=8)\\n        \\n        for vid in sorted(veteran_ids):\\n            v = storage.load(vid)\\n            if not v:\\n                continue\\n            \\n            high_count = sum(\\n                1 for r in v.responses \\n                if r.extracted and r.extracted.writing_potential == WritingPotential.HIGH\\n            )\\n            verified_str = \\\"[green]\\u2713[/green]\\\" if v.verified else \\\"[dim]\\u2014[/dim]\\\"\\n            story_count = len(v.notable_stories)\\n            \\n            detail_table.add_row(\\n                v.name[:24],\\n                str(len(v.responses)),\\n                str(high_count),\\n                verified_str,\\n                str(story_count)\\n            )\\n        \\n        console.print(detail_table)\\n\\n\\n# ============================================================================\\n# Compare Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"veteran1_id\\\")\\n@click.argument(\\\"veteran2_id\\\")\\n@click.option(\\\"--topic\\\", \\\"-t\\\", required=True, help=\\\"Topic to compare on\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=5, help=\\\"Max passages per veteran\\\")\\n@click.option(\\\"--analyze\\\", is_flag=True, help=\\\"Use LLM to generate comparison analysis\\\")\\ndef compare(veteran1_id: str, veteran2_id: str, topic: str, limit: int, analyze: bool):\\n    \\\"\\\"\\\"Side-by-side comparison of two veterans' accounts on the same topic.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    storage = VeteranStorage(ctx)\\n    search_engine = SearchEngine(ctx)\\n    \\n    # Verify both veterans exist\\n    v1 = storage.load(veteran1_id)\\n    v2 = storage.load(veteran2_id)\\n    \\n    if not v1:\\n        console.print(f\\\"[red]Veteran not found: {veteran1_id}[/red]\\\")\\n        return\\n    if not v2:\\n        console.print(f\\\"[red]Veteran not found: {veteran2_id}[/red]\\\")\\n        return\\n    \\n    # Search for topic in both veterans\\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(f\\\"Searching for '{topic}'...\\\", total=None)\\n        \\n        results1 = search_engine.search(query=topic, limit=limit, veteran_id=veteran1_id)\\n        results2 = search_engine.search(query=topic, limit=limit, veteran_id=veteran2_id)\\n    \\n    search_engine.close()\\n    \\n    # Header\\n    console.print(\\\"\\\")\\n    console.print(Panel(\\n        f\\\"[bold]COMPARE:[/bold] \\\\\\\"{topic}\\\\\\\" \\u2014 2 Veterans\\\",\\n        box=box.DOUBLE,\\n        border_style=\\\"cyan\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Create side-by-side comparison using columns\\n    from rich.columns import Columns\\n    from rich.text import Text\\n    \\n    # Left panel (Veteran 1)\\n    left_lines = []\\n    left_lines.append(f\\\"[bold cyan]{v1.name}[/bold cyan]\\\")\\n    left_lines.append(f\\\"[dim]{v1.unit or 'No unit'}[/dim]\\\")\\n    left_lines.append(\\\"\\\")\\n    \\n    if results1.hits:\\n        for hit in results1.hits:\\n            r = hit.response\\n            potential = \\\"\\\"\\n            if r.extracted and r.extracted.writing_potential == WritingPotential.HIGH:\\n                potential = \\\" [yellow]\\u2605[/yellow]\\\"\\n            \\n            # Truncate text for display\\n            text = r.veteran[:200] + \\\"...\\\" if len(r.veteran) > 200 else r.veteran\\n            text = \\\" \\\".join(text.split())  # Clean whitespace\\n            \\n            left_lines.append(f\\\"[cyan][{r.id}][/cyan]{potential}\\\")\\n            left_lines.append(f\\\"[dim italic]Q: {r.interviewer[:80]}...[/dim italic]\\\" if len(r.interviewer) > 80 else f\\\"[dim italic]Q: {r.interviewer}[/dim italic]\\\")\\n            left_lines.append(f\\\"\\\\\\\"{text}\\\\\\\"\\\")\\n            left_lines.append(\\\"\\\")\\n    else:\\n        left_lines.append(\\\"[dim][no matches][/dim]\\\")\\n    \\n    # Right panel (Veteran 2)\\n    right_lines = []\\n    right_lines.append(f\\\"[bold cyan]{v2.name}[/bold cyan]\\\")\\n    right_lines.append(f\\\"[dim]{v2.unit or 'No unit'}[/dim]\\\")\\n    right_lines.append(\\\"\\\")\\n    \\n    if results2.hits:\\n        for hit in results2.hits:\\n            r = hit.response\\n            potential = \\\"\\\"\\n            if r.extracted and r.extracted.writing_potential == WritingPotential.HIGH:\\n                potential = \\\" [yellow]\\u2605[/yellow]\\\"\\n            \\n            # Truncate text for display\\n            text = r.veteran[:200] + \\\"...\\\" if len(r.veteran) > 200 else r.veteran\\n            text = \\\" \\\".join(text.split())  # Clean whitespace\\n            \\n            right_lines.append(f\\\"[cyan][{r.id}][/cyan]{potential}\\\")\\n            right_lines.append(f\\\"[dim italic]Q: {r.interviewer[:80]}...[/dim italic]\\\" if len(r.interviewer) > 80 else f\\\"[dim italic]Q: {r.interviewer}[/dim italic]\\\")\\n            right_lines.append(f\\\"\\\\\\\"{text}\\\\\\\"\\\")\\n            right_lines.append(\\\"\\\")\\n    else:\\n        right_lines.append(\\\"[dim][no matches][/dim]\\\")\\n    \\n    # Display in panels\\n    left_panel = Panel(\\n        \\\"\\\\n\\\".join(left_lines),\\n        title=f\\\"[bold]{veteran1_id}[/bold]\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"cyan\\\"\\n    )\\n    right_panel = Panel(\\n        \\\"\\\\n\\\".join(right_lines),\\n        title=f\\\"[bold]{veteran2_id}[/bold]\\\",\\n        box=box.ROUNDED,\\n        border_style=\\\"cyan\\\"\\n    )\\n    \\n    console.print(Columns([left_panel, right_panel], equal=True, expand=True))\\n    \\n    # LLM Analysis\\n    if analyze and (results1.hits or results2.hits):\\n        console.print(\\\"\\\")\\n        console.print(\\\"[bold yellow]ANALYSIS[/bold yellow]\\\")\\n        console.print(\\\"\\u2500\\\" * 63)\\n        \\n        try:\\n            llm_client = get_llm_client(\\n                provider=ctx.config.llm.provider,\\n                model=ctx.config.llm.model\\n            )\\n            \\n            # Prepare accounts for comparison\\n            accounts = []\\n            for hit in results1.hits:\\n                accounts.append({\\n                    \\\"veteran_name\\\": v1.name,\\n                    \\\"veteran_id\\\": veteran1_id,\\n                    \\\"response_id\\\": hit.response_id,\\n                    \\\"text\\\": hit.response.veteran[:1000]\\n                })\\n            for hit in results2.hits:\\n                accounts.append({\\n                    \\\"veteran_name\\\": v2.name,\\n                    \\\"veteran_id\\\": veteran2_id,\\n                    \\\"response_id\\\": hit.response_id,\\n                    \\\"text\\\": hit.response.veteran[:1000]\\n                })\\n            \\n            import json\\n            comparison_prompt = f\\\"\\\"\\\"Compare these two veterans' accounts regarding \\\"{topic}\\\":\\n\\nAccounts:\\n{json.dumps(accounts, indent=2)}\\n\\nProvide a brief analysis (3-5 bullet points) highlighting:\\n- Areas of agreement or overlapping details\\n- Unique perspectives each veteran provides\\n- Any contradictions or different viewpoints\\n- Which veteran provides more detail on specific aspects\\n\\nFormat each bullet point starting with \\\"\\u2022 \\\"\\n\\\"\\\"\\\"\\n            \\n            with Progress(\\n                SpinnerColumn(),\\n                TextColumn(\\\"[progress.description]{task.description}\\\"),\\n                transient=True,\\n            ) as progress:\\n                task = progress.add_task(\\\"Generating analysis...\\\", total=None)\\n                analysis = llm_client.complete(\\n                    prompt=comparison_prompt,\\n                    system=\\\"You are comparing WWII oral history accounts. Be specific and cite response IDs.\\\",\\n                    max_tokens=1000\\n                )\\n            \\n            console.print(analysis)\\n            \\n        except Exception as e:\\n            console.print(f\\\"[yellow]Analysis failed: {e}[/yellow]\\\")\\n    \\n    console.print(\\\"\\\")\\n    console.print(\\\"[dim]Tip: Use --analyze for LLM-generated comparison analysis[/dim]\\\")\\n\\n\\n# ============================================================================\\n# Draft Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.option(\\\"--topic\\\", \\\"-t\\\", help=\\\"Topic to draft about\\\")\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", \\\"veteran_id\\\", help=\\\"Filter to specific veteran\\\")\\n@click.option(\\\"--chapter\\\", \\\"-c\\\", type=int, help=\\\"Filter to chapter\\\")\\n@click.option(\\\"--query\\\", \\\"-q\\\", help=\\\"Search query to find passages\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=10, help=\\\"Maximum passages to use\\\")\\n@click.option(\\\"--style\\\", \\\"-s\\\", type=click.Choice([\\\"narrative\\\", \\\"documentary\\\", \\\"academic\\\"]), default=\\\"narrative\\\", help=\\\"Writing style\\\")\\n@click.option(\\\"--export\\\", \\\"export_path\\\", help=\\\"Export draft to file\\\")\\ndef draft(\\n    topic: Optional[str],\\n    veteran_id: Optional[str],\\n    chapter: Optional[int],\\n    query: Optional[str],\\n    limit: int,\\n    style: str,\\n    export_path: Optional[str]\\n):\\n    \\\"\\\"\\\"Generate first-draft narrative text from selected passages with inline citations.\\\"\\\"\\\"\\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    # Need at least one filter\\n    if not topic and not veteran_id and not chapter and not query:\\n        console.print(\\\"[red]Please specify at least one filter: --topic, --veteran, --chapter, or --query[/red]\\\")\\n        return\\n    \\n    search_engine = SearchEngine(ctx)\\n    annotation_storage = AnnotationStorage(ctx)\\n    veteran_storage = VeteranStorage(ctx)\\n    \\n    # Build search query\\n    search_query = topic or query or \\\"\\\"\\n    \\n    # If chapter specified, get responses from that chapter\\n    passages = []\\n    \\n    if chapter:\\n        chapter_responses = annotation_storage.get_chapter_responses(chapter)\\n        for vid, resp_ids in chapter_responses.items():\\n            if veteran_id and vid != veteran_id:\\n                continue\\n            \\n            v = veteran_storage.load(vid)\\n            if not v:\\n                continue\\n            \\n            for rid in resp_ids:\\n                for r in v.responses:\\n                    if r.id == rid:\\n                        passages.append({\\n                            \\\"veteran_id\\\": vid,\\n                            \\\"veteran_name\\\": v.name,\\n                            \\\"response_id\\\": rid,\\n                            \\\"response\\\": r\\n                        })\\n                        break\\n    else:\\n        # Search for passages\\n        with Progress(\\n            SpinnerColumn(),\\n            TextColumn(\\\"[progress.description]{task.description}\\\"),\\n            transient=True,\\n        ) as progress:\\n            task = progress.add_task(\\\"Searching for passages...\\\", total=None)\\n            \\n            results = search_engine.search(\\n                query=search_query,\\n                limit=limit,\\n                veteran_id=veteran_id,\\n                chapter=chapter\\n            )\\n        \\n        for hit in results.hits:\\n            passages.append({\\n                \\\"veteran_id\\\": hit.veteran_id,\\n                \\\"veteran_name\\\": hit.veteran_name,\\n                \\\"response_id\\\": hit.response_id,\\n                \\\"response\\\": hit.response\\n            })\\n    \\n    search_engine.close()\\n    \\n    if not passages:\\n        console.print(\\\"[yellow]No passages found matching your criteria.[/yellow]\\\")\\n        return\\n    \\n    # Limit passages\\n    passages = passages[:limit]\\n    \\n    console.print(f\\\"[green]\\u2713[/green] Found {len(passages)} passages to draft from\\\")\\n    console.print(\\\"\\\")\\n    \\n    llm_client = get_llm_client(\\n        provider=ctx.config.llm.provider,\\n        model=ctx.config.llm.model\\n    )\\n    \\n    draft_writer = DraftWriter(llm_client)\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        task = progress.add_task(f\\\"Generating {style} draft...\\\", total=None)\\n        \\n        draft_topic = topic or query or f\\\"Chapter {chapter}\\\" if chapter else \\\"selected passages\\\"\\n        draft_result = draft_writer.generate_draft(passages, style=style, topic=draft_topic)\\n    \\n    # Display header\\n    console.print(Panel(\\n        f\\\"[bold]DRAFT:[/bold] {draft_topic}\\\",\\n        box=box.DOUBLE,\\n        border_style=\\\"green\\\"\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Display draft\\n    console.print(Markdown(draft_result[\\\"draft\\\"]))\\n    console.print(\\\"\\\")\\n    \\n    # Display sources\\n    console.print(\\\"[bold]SOURCES USED[/bold]\\\")\\n    console.print(\\\"\\u2500\\\" * 63)\\n    \\n    sources_table = Table(show_header=True, header_style=\\\"bold\\\", box=box.SIMPLE)\\n    sources_table.add_column(\\\"Veteran\\\", style=\\\"cyan\\\", width=25)\\n    sources_table.add_column(\\\"Response\\\", width=10)\\n    sources_table.add_column(\\\"Summary\\\", width=40)\\n    \\n    for p in passages:\\n        summary = p[\\\"response\\\"].extracted.summary if p[\\\"response\\\"].extracted else p[\\\"response\\\"].veteran[:50] + \\\"...\\\"\\n        if len(summary) > 40:\\n            summary = summary[:37] + \\\"...\\\"\\n        sources_table.add_row(p[\\\"veteran_name\\\"], f\\\"[{p['response_id']}]\\\", summary)\\n    \\n    console.print(sources_table)\\n    console.print(\\\"\\\")\\n    \\n    # Word count\\n    word_count = len(draft_result[\\\"draft\\\"].split())\\n    console.print(f\\\"[dim]Word count: {word_count:,}[/dim]\\\")\\n    \\n    # Export if requested\\n    if export_path:\\n        output_path = Path(export_path)\\n        if not output_path.suffix:\\n            output_path = output_path.with_suffix(\\\".md\\\")\\n        \\n        # Build full export content\\n        export_content = f\\\"# Draft: {draft_topic}\\\\n\\\\n\\\"\\n        export_content += f\\\"*Style: {style} | Sources: {len(passages)} passages | Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}*\\\\n\\\\n\\\"\\n        export_content += \\\"---\\\\n\\\\n\\\"\\n        export_content += draft_result[\\\"draft\\\"]\\n        export_content += \\\"\\\\n\\\\n---\\\\n\\\\n\\\"\\n        export_content += \\\"## Sources\\\\n\\\\n\\\"\\n        for p in passages:\\n            summary = p[\\\"response\\\"].extracted.summary if p[\\\"response\\\"].extracted else \\\"\\\"\\n            export_content += f\\\"- **{p['veteran_name']}** [{p['response_id']}]: {summary}\\\\n\\\"\\n        \\n        output_path.write_text(export_content)\\n        console.print(f\\\"[green]\\u2713[/green] Exported draft to: {output_path}\\\")\\n\\n\\n# ============================================================================\\n# Entry Point\\n# ============================================================================\\n\\ndef main():\\n    \\\"\\\"\\\"Main entry point.\\\"\\\"\\\"\\n    cli()\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"file_size_bytes\":84403,\"content_length\":84191}"},"isError":false}} %o
