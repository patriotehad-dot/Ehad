2025-12-21T16:37:53.485Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"file_path":"/Users/happyhawking/Documents/Projects/Current/writer/src/rag_pipeline.py","content":"\"\"\"\nAdvanced RAG Pipeline for Oral History Research System.\n\nImplements multiple retrieval enhancement strategies:\n1. Query Expansion - Generate multiple search variants\n2. Re-ranking - Cross-encoder for precise relevance scoring  \n3. Self-Reflection - Grade results and retry if poor\n4. Contextual Embedding - Rich context prepended to chunks\n\nBased on research from Anthropic and industry best practices.\n\"\"\"\n\nimport os\nimport json\nfrom typing import List, Optional, Dict, Any, Tuple\nfrom dataclasses import dataclass\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\n\nfrom .models import SearchHit, SearchResults, Response, Veteran\nfrom .config import ProjectContext, get_api_key\n\n\n# ============================================================================\n# Data Classes\n# ============================================================================\n\n@dataclass\nclass ExpandedQueries:\n    \"\"\"Result of query expansion.\"\"\"\n    original: str\n    variants: List[str]\n    \n@dataclass \nclass ReflectionResult:\n    \"\"\"Result of search quality reflection.\"\"\"\n    score: int  # 1-5\n    reasoning: str\n    refined_query: Optional[str] = None\n\n\n# ============================================================================\n# Cross-Encoder Re-ranker\n# ============================================================================\n\n_reranker_model = None\n\ndef get_reranker():\n    \"\"\"Get or initialize cross-encoder reranker model.\"\"\"\n    global _reranker_model\n    \n    if _reranker_model is not None:\n        return _reranker_model\n    \n    try:\n        from sentence_transformers import CrossEncoder\n    except ImportError:\n        raise ImportError(\n            \"sentence-transformers package not installed. \"\n            \"Run: pip install sentence-transformers\"\n        )\n    \n    # ms-marco model is optimized for passage retrieval/reranking\n    # Small, fast, and effective\n    _reranker_model = CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')\n    return _reranker_model\n\n\ndef rerank_results(\n    query: str, \n    hits: List[SearchHit], \n    top_k: int = 15\n) -> List[SearchHit]:\n    \"\"\"\n    Re-rank search results using cross-encoder.\n    \n    The cross-encoder sees query and document together, giving much\n    more accurate relevance scores than bi-encoder similarity.\n    \n    Args:\n        query: Original search query\n        hits: List of SearchHit objects from initial retrieval\n        top_k: Number of top results to return\n        \n    Returns:\n        Re-ranked list of SearchHit objects with updated scores\n    \"\"\"\n    if not hits:\n        return []\n    \n    if len(hits) <= top_k:\n        # Not enough to rerank, but still score them\n        pass\n    \n    reranker = get_reranker()\n    \n    # Build query-document pairs\n    pairs = []\n    for hit in hits:\n        # Use full Q&A text for reranking\n        doc_text = f\"Q: {hit.response.interviewer}\\nA: {hit.response.veteran}\"\n        # Truncate if too long (cross-encoder has limits)\n        if len(doc_text) > 2000:\n            doc_text = doc_text[:2000]\n        pairs.append((query, doc_text))\n    \n    # Get cross-encoder scores\n    scores = reranker.predict(pairs)\n    \n    # Update hits with new scores and sort\n    scored_hits = list(zip(hits, scores))\n    scored_hits.sort(key=lambda x: x[1], reverse=True)\n    \n    # Return top_k with updated scores\n    result = []\n    for hit, new_score in scored_hits[:top_k]:\n        # Normalize score to 0-1 range (cross-encoder outputs ~-10 to +10)\n        normalized = (float(new_score) + 10) / 20\n        normalized = max(0.0, min(1.0, normalized))\n        \n        # Create new hit with updated score\n        hit.score = normalized\n        result.append(hit)\n    \n    return result\n\n\n# ============================================================================\n# Query Expansion\n# ============================================================================\n\ndef expand_query(\n    query: str,\n    llm_client,\n    num_variants: int = 3\n) -> ExpandedQueries:\n    \"\"\"\n    Expand query into multiple search variants.\n    \n    Generates synonyms, related terms, and alternative phrasings\n    to capture different ways the same information might be expressed.\n    \n    Args:\n        query: Original user query\n        llm_client: LLM client for generation\n        num_variants: Number of variants to generate\n        \n    Returns:\n        ExpandedQueries with original and variants\n    \"\"\"\n    prompt = f\"\"\"Generate {num_variants} alternative search queries for finding oral history content.\n\nOriginal query: \"{query}\"\n\nRequirements:\n- Each variant should capture the same intent but use different words\n- Include synonyms, related military terms, period-appropriate language\n- Include both specific and broader phrasings\n- WWII veterans may use different terminology than modern speakers\n\nReturn ONLY a JSON array of strings, no other text:\n[\"variant 1\", \"variant 2\", \"variant 3\"]\"\"\"\n\n    try:\n        response = llm_client.chat.completions.create(\n            model=os.getenv(\"PORTKEY_VIRTUAL_KEY_ANTHROPIC_SONNET\", \"claude-sonnet-4-20250514\"),\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n            max_tokens=300,\n            temperature=0.7\n        )\n        \n        content = response.choices[0].message.content.strip()\n        \n        # Parse JSON response\n        # Handle potential markdown code blocks\n        if content.startswith(\"```\"):\n            content = content.split(\"```\")[1]\n            if content.startswith(\"json\"):\n                content = content[4:]\n        content = content.strip()\n        \n        variants = json.loads(content)\n        \n        if not isinstance(variants, list):\n            variants = [query]\n        \n        return ExpandedQueries(\n            original=query,\n            variants=variants[:num_variants]\n        )\n        \n    except Exception as e:\n        # Fallback: return original only\n        print(f\"Query expansion failed: {e}\")\n        return ExpandedQueries(original=query, variants=[])\n\n\n# ============================================================================\n# Self-Reflective Search\n# ============================================================================\n\ndef reflect_on_results(\n    query: str,\n    hits: List[SearchHit],\n    llm_client,\n    sample_size: int = 5\n) -> ReflectionResult:\n    \"\"\"\n    Grade search results and suggest refinements if needed.\n    \n    Uses LLM to evaluate whether results actually answer the query,\n    and suggests refined search if results are poor.\n    \n    Args:\n        query: Original search query\n        hits: Search results to evaluate\n        llm_client: LLM client for evaluation\n        sample_size: Number of results to show LLM\n        \n    Returns:\n        ReflectionResult with score and optional refined query\n    \"\"\"\n    if not hits:\n        return ReflectionResult(\n            score=1,\n            reasoning=\"No results found\",\n            refined_query=query  # Retry with same query might help after reindex\n        )\n    \n    # Build sample of results for LLM to evaluate\n    samples = []\n    for hit in hits[:sample_size]:\n        summary = hit.response.extracted.summary if hit.response.extracted else hit.response.veteran[:200]\n        samples.append(f\"- [{hit.veteran_name}] {summary}\")\n    \n    results_text = \"\\n\".join(samples)\n    \n    prompt = f\"\"\"Evaluate these oral history search results.\n\nQuery: \"{query}\"\n\nTop Results:\n{results_text}\n\nRate how well these results answer the query on a 1-5 scale:\n5 = Excellent, directly answers the query\n4 = Good, relevant content found\n3 = Okay, somewhat relevant\n2 = Poor, mostly irrelevant\n1 = Very poor, completely off-topic\n\nIf score < 3, suggest a refined search query that might work better.\nConsider: synonyms, related terms, broader/narrower scope.\n\nReturn ONLY JSON:\n{{\"score\": N, \"reasoning\": \"brief explanation\", \"refined_query\": \"new query or null\"}}\"\"\"\n\n    try:\n        response = llm_client.chat.completions.create(\n            model=os.getenv(\"PORTKEY_VIRTUAL_KEY_ANTHROPIC_SONNET\", \"claude-sonnet-4-20250514\"),\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n            max_tokens=200,\n            temperature=0.3\n        )\n        \n        content = response.choices[0].message.content.strip()\n        \n        # Parse JSON\n        if content.startswith(\"```\"):\n            content = content.split(\"```\")[1]\n            if content.startswith(\"json\"):\n                content = content[4:]\n        content = content.strip()\n        \n        result = json.loads(content)\n        \n        return ReflectionResult(\n            score=result.get(\"score\", 3),\n            reasoning=result.get(\"reasoning\", \"\"),\n            refined_query=result.get(\"refined_query\")\n        )\n        \n    except Exception as e:\n        print(f\"Reflection failed: {e}\")\n        return ReflectionResult(score=3, reasoning=\"Evaluation failed\")\n\n\n# ============================================================================\n# Contextual Embedding Builder\n# ============================================================================\n\ndef build_contextual_text(\n    response: Response,\n    veteran: Veteran,\n    segment_topic: Optional[str] = None\n) -> str:\n    \"\"\"\n    Build context-enriched text for embedding.\n    \n    Prepends veteran and topic context so embeddings capture\n    not just content but also who/what/when.\n    \n    Args:\n        response: The response to embed\n        veteran: The veteran who gave the response\n        segment_topic: Optional topic from segment detection\n        \n    Returns:\n        Context-enriched text for embedding\n    \"\"\"\n    # Build context prefix\n    context_parts = []\n    \n    # Veteran identity\n    if veteran.name:\n        context_parts.append(veteran.name)\n    if veteran.unit:\n        context_parts.append(veteran.unit)\n    if veteran.rank:\n        context_parts.append(veteran.rank)\n    \n    # Topic if known\n    if segment_topic:\n        context_parts.append(f\"Topic: {segment_topic}\")\n    elif response.extracted and response.extracted.topics:\n        context_parts.append(f\"Topics: {', '.join(response.extracted.topics[:3])}\")\n    \n    # Time period if known\n    if response.extracted and response.extracted.dates:\n        context_parts.append(f\"Period: {', '.join(response.extracted.dates[:2])}\")\n    \n    context = f\"[{', '.join(context_parts)}]\" if context_parts else \"\"\n    \n    # Build full text\n    qa_text = f\"Q: {response.interviewer}\\nA: {response.veteran}\"\n    \n    if context:\n        return f\"{context}\\n\\n{qa_text}\"\n    return qa_text\n\n\n# ============================================================================\n# Advanced Search Pipeline\n# ============================================================================\n\nclass AdvancedSearchPipeline:\n    \"\"\"\n    Advanced RAG pipeline combining multiple retrieval strategies.\n    \n    Pipeline stages:\n    1. Query Expansion (optional) - Generate search variants\n    2. Multi-query Search - Search all variants in parallel\n    3. Re-ranking - Cross-encoder scores combined results\n    4. Self-Reflection (optional) - Grade and retry if poor\n    \"\"\"\n    \n    def __init__(\n        self,\n        search_engine,  # SearchEngine instance\n        llm_client = None,\n        enable_expansion: bool = True,\n        enable_reranking: bool = True,\n        enable_reflection: bool = True,\n        expansion_variants: int = 3,\n        reflection_threshold: int = 3,\n        max_retries: int = 1\n    ):\n        \"\"\"\n        Initialize advanced search pipeline.\n        \n        Args:\n            search_engine: SearchEngine instance for base search\n            llm_client: LLM client for expansion/reflection (optional)\n            enable_expansion: Whether to expand queries\n            enable_reranking: Whether to rerank results\n            enable_reflection: Whether to reflect and retry\n            expansion_variants: Number of query variants\n            reflection_threshold: Min score before retry (1-5)\n            max_retries: Maximum reflection retries\n        \"\"\"\n        self.search_engine = search_engine\n        self.llm_client = llm_client\n        self.enable_expansion = enable_expansion and llm_client is not None\n        self.enable_reranking = enable_reranking\n        self.enable_reflection = enable_reflection and llm_client is not None\n        self.expansion_variants = expansion_variants\n        self.reflection_threshold = reflection_threshold\n        self.max_retries = max_retries\n    \n    def search(\n        self,\n        query: str,\n        limit: int = 15,\n        veteran_id: Optional[str] = None,\n        **kwargs\n    ) -> SearchResults:\n        \"\"\"\n        Execute advanced search pipeline.\n        \n        Args:\n            query: Search query\n            limit: Maximum results to return\n            veteran_id: Optional filter to specific veteran\n            **kwargs: Additional filters passed to base search\n            \n        Returns:\n            SearchResults with enhanced results\n        \"\"\"\n        # Track pipeline stages for debugging\n        pipeline_info = {\n            \"original_query\": query,\n            \"expanded_queries\": [],\n            \"candidates_before_rerank\": 0,\n            \"reflection_score\": None,\n            \"retries\": 0\n        }\n        \n        # Stage 1: Query Expansion\n        queries_to_search = [query]\n        if self.enable_expansion:\n            expanded = expand_query(\n                query, \n                self.llm_client,\n                num_variants=self.expansion_variants\n            )\n            queries_to_search.extend(expanded.variants)\n            pipeline_info[\"expanded_queries\"] = expanded.variants\n        \n        # Stage 2: Multi-query Search (parallel)\n        all_hits = self._multi_query_search(\n            queries_to_search, \n            limit=limit * 3,  # Get more for reranking\n            veteran_id=veteran_id,\n            **kwargs\n        )\n        pipeline_info[\"candidates_before_rerank\"] = len(all_hits)\n        \n        # Stage 3: Re-ranking\n        if self.enable_reranking and len(all_hits) > 0:\n            all_hits = rerank_results(query, all_hits, top_k=limit * 2)\n        \n        # Stage 4: Self-Reflection (with retry)\n        final_hits = all_hits[:limit]\n        \n        if self.enable_reflection and len(final_hits) > 0:\n            retries = 0\n            while retries < self.max_retries:\n                reflection = reflect_on_results(\n                    query, final_hits, self.llm_client\n                )\n                pipeline_info[\"reflection_score\"] = reflection.score\n                \n                if reflection.score >= self.reflection_threshold:\n                    break  # Results are good enough\n                \n                if reflection.refined_query and reflection.refined_query != query:\n                    # Retry with refined query\n                    retries += 1\n                    pipeline_info[\"retries\"] = retries\n                    \n                    # Search with refined query\n                    refined_hits = self._multi_query_search(\n                        [reflection.refined_query],\n                        limit=limit * 2,\n                        veteran_id=veteran_id,\n                        **kwargs\n                    )\n                    \n                    if self.enable_reranking and refined_hits:\n                        refined_hits = rerank_results(\n                            reflection.refined_query, \n                            refined_hits, \n                            top_k=limit\n                        )\n                    \n                    # Merge refined results with original (refined first)\n                    seen_ids = set()\n                    merged = []\n                    for hit in refined_hits + final_hits:\n                        key = (hit.veteran_id, hit.response_id)\n                        if key not in seen_ids:\n                            seen_ids.add(key)\n                            merged.append(hit)\n                    \n                    final_hits = merged[:limit]\n                else:\n                    break  # No refined query suggested\n        \n        # Build results\n        veteran_ids = set(h.veteran_id for h in final_hits)\n        \n        results = SearchResults(\n            query=query,\n            total_hits=len(final_hits),\n            veteran_count=len(veteran_ids),\n            hits=final_hits\n        )\n        \n        # Attach pipeline info for debugging (optional)\n        results._pipeline_info = pipeline_info\n        \n        return results\n    \n    def _multi_query_search(\n        self,\n        queries: List[str],\n        limit: int,\n        veteran_id: Optional[str] = None,\n        **kwargs\n    ) -> List[SearchHit]:\n        \"\"\"\n        Search multiple queries and merge results.\n        \n        Args:\n            queries: List of query strings\n            limit: Max results per query\n            veteran_id: Optional veteran filter\n            **kwargs: Additional filters\n            \n        Returns:\n            Merged, deduplicated list of hits\n        \"\"\"\n        all_hits = []\n        seen = set()\n        \n        # Search each query (could parallelize, but LLM calls are the bottleneck)\n        for q in queries:\n            try:\n                results = self.search_engine.search(\n                    query=q,\n                    limit=limit,\n                    veteran_id=veteran_id,\n                    use_segments=True,\n                    **kwargs\n                )\n                \n                for hit in results.hits:\n                    key = (hit.veteran_id, hit.response_id)\n                    if key not in seen:\n                        seen.add(key)\n                        all_hits.append(hit)\n                        \n            except Exception as e:\n                print(f\"Search failed for query '{q}': {e}\")\n                continue\n        \n        # Sort by score descending\n        all_hits.sort(key=lambda h: h.score, reverse=True)\n        \n        return all_hits\n\n\n# ============================================================================\n# Factory Function\n# ============================================================================\n\ndef create_advanced_pipeline(\n    ctx: ProjectContext,\n    llm_client = None,\n    preset: str = \"balanced\"\n) -> AdvancedSearchPipeline:\n    \"\"\"\n    Create an advanced search pipeline with preset configuration.\n    \n    Args:\n        ctx: Project context\n        llm_client: Optional LLM client (required for expansion/reflection)\n        preset: Configuration preset\n            - \"fast\": Reranking only, no LLM calls\n            - \"balanced\": Reranking + expansion (recommended)\n            - \"thorough\": All features including reflection\n            \n    Returns:\n        Configured AdvancedSearchPipeline\n    \"\"\"\n    from .search import SearchEngine\n    \n    search_engine = SearchEngine(ctx)\n    \n    presets = {\n        \"fast\": {\n            \"enable_expansion\": False,\n            \"enable_reranking\": True,\n            \"enable_reflection\": False,\n        },\n        \"balanced\": {\n            \"enable_expansion\": True,\n            \"enable_reranking\": True,\n            \"enable_reflection\": False,\n            \"expansion_variants\": 3,\n        },\n        \"thorough\": {\n            \"enable_expansion\": True,\n            \"enable_reranking\": True,\n            \"enable_reflection\": True,\n            \"expansion_variants\": 4,\n            \"reflection_threshold\": 3,\n            \"max_retries\": 1,\n        }\n    }\n    \n    config = presets.get(preset, presets[\"balanced\"])\n    \n    return AdvancedSearchPipeline(\n        search_engine=search_engine,\n        llm_client=llm_client,\n        **config\n    )\n"}},"jsonrpc":"2.0","id":9} { metadata: undefined }
