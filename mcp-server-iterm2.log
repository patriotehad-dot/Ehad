nnotation.notes:\n                lines.append(f\"- {note.text}\")\n        if annotation.flags:\n            lines.append(f\"**Flags:** {', '.join(annotation.flags)}\")\n    \n    if lines[-1] != \"\":\n        lines.append(\"\")\n    \n    # Question\n    lines.append(f\"**Q:** {response.interviewer}\")\n    lines.append(\"\")\n    \n    # Answer (as blockquote)\n    veteran_lines = response.veteran.split(\"\\n\")\n    for vline in veteran_lines:\n        lines.append(f\"> {vline}\")\n    lines.append(\"\")\n    \n    # Extracted metadata\n    if response.extracted and include_extraction:\n        extracted = response.extracted\n        meta_parts = []\n        \n        if extracted.topics:\n            meta_parts.append(f\"Topics: {', '.join(extracted.topics)}\")\n        if extracted.dates:\n            date_strs = [f\"{d.value} ({d.context})\" for d in extracted.dates]\n            meta_parts.append(f\"Dates: {'; '.join(date_strs)}\")\n        if extracted.locations:\n            meta_parts.append(f\"Locations: {', '.join(extracted.locations)}\")\n        if extracted.units:\n            meta_parts.append(f\"Units: {', '.join(extracted.units)}\")\n        \n        if meta_parts:\n            lines.append(\"**Extracted:**\")\n            for part in meta_parts:\n                lines.append(f\"- {part}\")\n            lines.append(\"\")\n    \n    lines.append(\"---\")\n    lines.append(\"\")\n    \n    return \"\\n\".join(lines)\n\n\ndef format_veteran_header_md(veteran: Veteran) -> str:\n    \"\"\"Format veteran header as markdown.\"\"\"\n    lines = []\n    \n    lines.append(f\"## {veteran.name}\")\n    \n    parts = []\n    if veteran.unit:\n        parts.append(veteran.unit)\n    if veteran.rank:\n        parts.append(veteran.rank)\n    \n    if parts:\n        lines.append(f\"**{' | '.join(parts)}**\")\n    \n    lines.append(\"\")\n    \n    return \"\\n\".join(lines)\n\n\nclass ExportGenerator:\n    \"\"\"Generates markdown exports.\"\"\"\n    \n    def __init__(self, ctx: ProjectContext):\n        \"\"\"\n        Initialize exporter.\n        \n        Args:\n            ctx: Project context\n        \"\"\"\n        self.ctx = ctx\n        self.veteran_storage = VeteranStorage(ctx)\n        self.annotation_storage = AnnotationStorage(ctx)\n    \n    def export_chapter(\n        self, \n        chapter: int,\n        output_path: Optional[Path] = None\n    ) -> Path:\n        \"\"\"\n        Export all responses assigned to a chapter.\n        \n        Args:\n            chapter: Chapter number\n            output_path: Optional custom output path\n            \n        Returns:\n            Path to exported file\n        \"\"\"\n        if output_path is None:\n            output_path = self.ctx.exports_dir / f\"chapter_{str(chapter).zfill(2)}.md\"\n        \n        output_path.parent.mkdir(parents=True, exist_ok=True)\n        \n        # Get chapter responses\n        chapter_data = self.annotation_storage.get_chapter_responses(chapter)\n        \n        lines = []\n        lines.append(f\"# Chapter {chapter} - Research Material\")\n        lines.append(\"\")\n        lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-NaN')}\")\n        \n        # Count totals\n        total_responses = sum(len(resp_ids) for resp_ids in chapter_data.values())\n        total_veterans = len(chapter_data)\n        lines.append(f\"> Responses: {total_responses} from {total_veterans} veterans\")\n        lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n        \n        # Process each veteran\n        for veteran_id, response_ids in chapter_data.items():\n            veteran = self.veteran_storage.load(veteran_id)\n            if not veteran:\n                continue\n            \n            annotations = self.annotation_storage.load(veteran_id)\n            \n            lines.append(format_veteran_header_md(veteran))\n            \n            # Find and format each response\n      