x_tokens=200)\\n            \\n            # Parse JSON\\n            response = response.strip()\\n            if response.startswith(\\\"```\\\"):\\n                response = response.split(\\\"```\\\")[1]\\n                if response.startswith(\\\"json\\\"):\\n                    response = response[4:]\\n            \\n            data = json.loads(response)\\n            \\n            return RetrievalGrade(\\n                score=int(data.get(\\\"score\\\", 3)),\\n                reasoning=data.get(\\\"reasoning\\\", \\\"\\\"),\\n                refined_query=data.get(\\\"refined_query\\\")\\n            )\\n            \\n        except Exception as e:\\n            # Default to passing grade on error\\n            return RetrievalGrade(score=3, reasoning=f\\\"Grading failed: {e}\\\", refined_query=None)\\n\\n\\nclass AdvancedRetriever:\\n    \\\"\\\"\\\"\\n    Combines all retrieval strategies into a configurable pipeline.\\n    \\n    Pipeline stages:\\n    1. Query Expansion (optional)\\n    2. Multi-query search (parallel)\\n    3. Result merging and deduplication\\n    4. Re-ranking\\n    5. Self-reflection with retry (optional)\\n    \\\"\\\"\\\"\\n    \\n    def __init__(\\n        self,\\n        llm_client: LLMClient,\\n        search_fn,  # Function that takes (query, limit, veteran_id) -> results\\n        get_text_fn,  # Function that takes (vet_id, resp_id) -> text\\n        enable_expansion: bool = True,\\n        enable_reranking: bool = True,\\n        enable_reflection: bool = True,\\n        max_retries: int = 1\\n    ):\\n        \\\"\\\"\\\"\\n        Initialize advanced retriever.\\n        \\n        Args:\\n            llm_client: LLM client for expansion/reflection\\n            search_fn: Base search function\\n            get_text_fn: Function to get text for a result\\n            enable_expansion: Whether to expand queries\\n            enable_reranking: Whether to re-rank results\\n            enable_reflection: Whether to do self-reflection\\n            max_retries: Maximum retries on poor results\\n        \\\"\\\"\\\"\\n        self.search_fn = search_fn\\n        self.get_text_fn = get_text_fn\\n        \\n        self.expander = QueryExpander(llm_client) if enable_expansion else None\\n        self.reranker = ResultReranker(llm_client) if enable_reranking else None\\n        self.reflector = RetrievalReflector(llm_client) if enable_reflection else None\\n        \\n        self.enable_expansion = enable_expansion\\n        self.enable_reranking = enable_reranking\\n        self.enable_reflection = enable_reflection\\n        self.max_retries = max_retries\\n    \\n    def search(\\n        self,\\n        query: str,\\n        limit: int = 15,\\n        veteran_id: Optional[str] = None,\\n        _retry_count: int = 0\\n    ) -> Tuple[List[Tuple[str, str, float, Any]], Dict[str, Any]]:\\n        \\\"\\\"\\\"\\n        Execute advanced search pipeline.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results to return\\n            veteran_id: Optional filter to specific veteran\\n            \\n        Returns:\\n            Tuple of (results, metadata)\\n            - results: List of (vet_id, resp_id, score, segment_topic)\\n            - metadata: Dict with pipeline info (queries_used, reranked, reflection, etc.)\\n        \\\"\\\"\\\"\\n        metadata = {\\n            \\\"original_query\\\": query,\\n            \\\"queries_used\\\": [query],\\n            \\\"expanded\\\": False,\\n            \\\"reranked\\\": False,\\n\",\"file_size_bytes\":16229,\"content_length\":5022}"},"isError":false}} { metadata: undefined }
