2025-12-21T17:08:15.485Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"run_command","arguments":{"command":"cat >> ~/Documents/Projects/Current/writer/src/search.py << 'ADVANCED'\n\n\n# ============================================================================\n# Advanced Search with Retrieval Strategies\n# ============================================================================\n\nclass AdvancedSearchEngine(SearchEngine):\n    \"\"\"\n    Extended search engine with advanced retrieval strategies:\n    - Query expansion (multiple query variants)\n    - Re-ranking (cross-encoder or LLM scoring)\n    - Self-reflection (quality grading with retry)\n    \n    Use this for research queries where precision matters.\n    Falls back to standard search if LLM unavailable.\n    \"\"\"\n    \n    def __init__(self, ctx: ProjectContext):\n        super().__init__(ctx)\n        self._advanced_retriever = None\n        self._llm_client = None\n    \n    def _get_llm_client(self):\n        \"\"\"Lazy-load LLM client.\"\"\"\n        if self._llm_client is None:\n            try:\n                from .llm import get_llm_client\n                config = self.ctx.config\n                self._llm_client = get_llm_client(\n                    provider=config.llm.provider,\n                    model=config.llm.model\n                )\n            except Exception:\n                self._llm_client = False  # Mark as unavailable\n        return self._llm_client\n    \n    def _get_retriever(self, enable_expansion=True, enable_reranking=True, enable_reflection=True):\n        \"\"\"Get or create advanced retriever.\"\"\"\n        llm = self._get_llm_client()\n        if not llm or llm is False:\n            return None\n        \n        from .llm import AdvancedRetriever\n        \n        # Create search function that returns raw results\n        def search_fn(query, limit, veteran_id=None):\n            hybrid_weight = self.ctx.config.search.hybrid_weight\n            return self.index.search_hybrid_with_segments(\n                query,\n                limit=limit,\n                hybrid_weight=hybrid_weight,\n                veteran_id=veteran_id\n            )\n        \n        # Create text getter\n        def get_text_fn(vet_id, resp_id):\n            veteran = self.veteran_storage.load(vet_id)\n            if veteran:\n                for r in veteran.responses:\n                    if r.id == resp_id:\n                        return f\"Q: {r.interviewer}\\nA: {r.veteran}\"\n            return \"\"\n        \n        return AdvancedRetriever(\n            llm_client=llm,\n            search_fn=search_fn,\n            get_text_fn=get_text_fn,\n            enable_expansion=enable_expansion,\n            enable_reranking=enable_reranking,\n            enable_reflection=enable_reflection\n        )\n    \n    def search_advanced(\n        self,\n        query: str,\n        limit: int = 15,\n        veteran_id: Optional[str] = None,\n        chapter: Optional[int] = None,\n        topic: Optional[str] = None,\n        potential: Optional[str] = None,\n        enable_expansion: bool = True,\n        enable_reranking: bool = True,\n        enable_reflection: bool = True\n    ) -> Tuple[SearchResults, Dict[str, Any]]:\n        \"\"\"\n        Execute advanced search with all retrieval strategies.\n        \n        Args:\n            query: Search query\n            limit: Maximum results\n            veteran_id: Filter to specific veteran\n            chapter: Filter to responses in chapter\n            topic: Filter by topic\n            potential: Filter by writing potential\n            enable_expansion: Use query expansion\n            enable_reranking: Use cross-encoder reranking\n            enable_reflection: Use self-reflection with retry\n            \n        Returns:\n            Tuple of (SearchResults, metadata dict with pipeline info)\n        \"\"\"\n        retriever = self._get_retriever(\n            enable_expansion=enable_expansion,\n            enable_reranking=enable_reranking,\n            enable_reflection=enable_reflection\n        )\n        \n        if not retriever:\n            # Fallback to standard search\n            results = self.search(\n                query, limit=limit, veteran_id=veteran_id,\n                chapter=chapter, topic=topic, potential=potential\n            )\n            return results, {\"fallback\": True, \"reason\": \"LLM unavailable\"}\n        \n        # Execute advanced pipeline\n        raw_results, metadata = retriever.search(query, limit=limit * 2, veteran_id=veteran_id)\n        \n        # Convert raw results to SearchHits (same logic as standard search)\n        MIN_SCORE = 0.2  # Lower threshold since results are reranked\n        hits = []\n        seen_veterans = set()\n        \n        for vet_id, resp_id, score, segment_topic in raw_results:\n            if score < MIN_SCORE:\n                continue\n            \n            veteran = self.veteran_storage.load(vet_id)\n            if not veteran:\n                continue\n            \n            response = None\n            for r in veteran.responses:\n                if r.id == resp_id:\n                    response = r\n                    break\n            \n            if not response:\n                continue\n            \n            # Apply filters\n            if potential and response.extracted:\n                if response.extracted.writing_potential.value != potential:\n                    continue\n            \n            if topic and response.extracted:\n                if topic not in response.extracted.topics:\n                    continue\n            \n            annotations = self.annotation_storage.load(vet_id)\n            resp_annot = annotations.response_annotations.get(resp_id)\n            \n            if chapter is not None:\n                if resp_annot is None or resp_annot.chapter != chapter:\n                    continue\n            \n            seen_veterans.add(vet_id)\n            \n            hit = SearchHit(\n                veteran_id=vet_id,\n                veteran_name=veteran.name,\n                unit=veteran.unit,\n                rank=veteran.rank,\n                response_id=resp_id,\n                response=response,\n                score=score,\n                chapter=resp_annot.chapter if resp_annot else None,\n                notes=resp_annot.notes if resp_annot else [],\n                flags=resp_annot.flags if resp_annot else []\n            )\n            \n            if segment_topic:\n                hit.matched_paragraph_id = f\"[{segment_topic}]\"\n            \n            hits.append(hit)\n            \n            if len(hits) >= limit:\n                break\n        \n        search_results = SearchResults(\n            query=query,\n            total_hits=len(hits),\n            veteran_count=len(seen_veterans),\n            hits=hits\n        )\n        \n        return search_results, metadata\nADVANCED\necho \"Added AdvancedSearchEngine\"","timeout":15}},"jsonrpc":"2.0","id":15} { metadata: undefined }
