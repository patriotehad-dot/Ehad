 results.hits:\\n        console.print(f\\\"[yellow]No results found for:[/yellow] {query}\\\")\\n        return\\n    \\n    # Debug info\\n    if debug and hasattr(results, '_pipeline_info'):\\n        info = results._pipeline_info\\n        console.print(\\\"\\\")\\n        console.print(Panel(\\n            f\\\"[dim]Original: {info['original_query']}\\\\n\\\"\\n            f\\\"Variants: {info.get('expanded_queries', [])}\\\\n\\\"\\n            f\\\"Candidates before rerank: {info.get('candidates_before_rerank', '?')}\\\\n\\\"\\n            f\\\"Reflection score: {info.get('reflection_score', 'N/A')}\\\\n\\\"\\n            f\\\"Retries: {info.get('retries', 0)}[/dim]\\\",\\n            title=\\\"[cyan]Pipeline Debug[/cyan]\\\",\\n            box=box.ROUNDED\\n        ))\\n    \\n    # Display results - same format as regular search\\n    console.print(\\\"\\\")\\n    mode_label = {\\\"fast\\\": \\\"\\u26a1 Fast\\\", \\\"balanced\\\": \\\"\\u2696\\ufe0f Balanced\\\", \\\"thorough\\\": \\\"\\ud83d\\udd0d Thorough\\\"}[mode]\\n    console.print(Panel(\\n        f\\\"[bold]SEARCH+[/bold] \\\\\\\"{query}\\\\\\\" ({results.veteran_count} veterans, {results.total_hits} responses) [{mode_label}]\\\",\\n        box=box.DOUBLE\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Group by veteran\\n    from collections import defaultdict\\n    grouped_hits = defaultdict(list)\\n    for hit in results.hits:\\n        grouped_hits[hit.veteran_id].append(hit)\\n    \\n    sorted_veterans = sorted(\\n        grouped_hits.items(), \\n        key=lambda x: max(h.score for h in x[1]), \\n        reverse=True\\n    )\\n    \\n    for _, hits in sorted_veterans:\\n        first_hit = hits[0]\\n        \\n        header = f\\\"[bold cyan]{first_hit.veteran_name}[/bold cyan]\\\"\\n        if first_hit.unit or first_hit.rank:\\n            parts = []\\n            if first_hit.unit:\\n                parts.append(first_hit.unit)\\n            if first_hit.rank:\\n                parts.append(first_hit.rank)\\n            header += f\\\" [dim]({' | '.join(parts)})[/dim]\\\"\\n        \\n        console.print(\\\"\\\")\\n        console.print(Panel(header, box=box.ROUNDED, border_style=\\\"cyan\\\"))\\n        \\n        for hit in hits:\\n            response = hit.response\\n            \\n            # Score and ID\\n            score_bar = \\\"\\u2588\\\" * int(hit.score * 10) + \\\"\\u2591\\\" * (10 - int(hit.score * 10))\\n            console.print(f\\\"  [cyan][{response.id}][/cyan] [dim]{score_bar}[/dim] {hit.score:.2f}\\\")\\n            \\n            # Summary\\n            if response.extracted and response.extracted.summary:\\n                summary = response.extracted.summary[:80] + \\\"...\\\" if len(response.extracted.summary) > 80 else response.extracted.summary\\n                console.print(f\\\"  [dim]{summary}[/dim]\\\")\\n            \\n            # Answer excerpt\\n            a = response.veteran[:400] + \\\"...\\\" if len(response.veteran) > 400 else response.veteran\\n            a_clean = \\\" \\\".join(a.split())\\n            console.print(f\\\"  \\\\\\\"{a_clean}\\\\\\\"\\\")\\n            console.print(\\\"\\\")\\n    \\n    # Export if requested\\n    if export_name:\\n        exporter = Exporter(ctx)\\n        output_path = exporter.export_search_results(results, f\\\"{export_name}.md\\\")\\n        console.print(f\\\"[green]\\u2713[/green] Exported: {output_path}\\\")\\n\\nADVANCED_SEARCH\\necho \\\"Advanced search command added\\\"\"}"}],"structuredContent":{"result":"{\"success\":true,\"command\":\"cd ~/Documents/Projects/Current/writer/src && head -465 cli.py > cli_new.py && cat >> cli_new.py << 'ADVANCED_SEARCH'\\n\\n\\n# ============================================================================\\n# Advanced Search Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"query\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", def