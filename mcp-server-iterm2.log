2025-12-20T16:55:11.337Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"file_path":"/Users/happyhawking/Documents/Projects/Current/writer/src/parser_json.py","content":"\"\"\"\nJSON Transcript Parser for Oral History Research System.\n\nParses turn-based JSON transcripts into Q&A Response pairs.\nHandles the format: [{\"speaker\": \"...\", \"text\": \"...\"}, ...]\n\nThe key insight: a Question + Answer(s) = one atomic unit of history.\n\"\"\"\n\nimport json\nimport re\nfrom pathlib import Path\nfrom typing import List, Tuple, Optional, Dict, Any\nfrom dataclasses import dataclass\n\nfrom .models import Response, Paragraph\n\n\n@dataclass\nclass Turn:\n    \"\"\"A single turn in the conversation.\"\"\"\n    speaker: str\n    text: str\n    index: int  # Position in original transcript\n\n\n@dataclass\nclass QAPair:\n    \"\"\"A Question-Answer pair: one interviewer question + veteran's response(s).\"\"\"\n    question: str\n    answer: str\n    question_turn_index: int\n    answer_turn_indices: List[int]\n\n\nclass JSONTranscriptParser:\n    \"\"\"\n    Parses JSON transcripts with turn-based speaker attribution.\n    \n    Expected format:\n    [\n        {\"speaker\": \"Interviewer 2\", \"text\": \"Where were you born?\"},\n        {\"speaker\": \"Levere Watson\", \"text\": \"I was born in Foreston...\"},\n        ...\n    ]\n    \"\"\"\n    \n    # Common interviewer identifiers (case-insensitive matching)\n    INTERVIEWER_PATTERNS = [\n        r'^interviewer',\n        r'^int\\b',\n        r'^q\\b',\n        r'^narrator',\n        r'^host',\n        r'^moderator',\n    ]\n    \n    def __init__(self, min_paragraph_length: int = 50):\n        \"\"\"\n        Initialize parser.\n        \n        Args:\n            min_paragraph_length: Minimum characters for a paragraph chunk\n        \"\"\"\n        self.min_paragraph_length = min_paragraph_length\n        self._interviewer_re = [\n            re.compile(p, re.IGNORECASE) for p in self.INTERVIEWER_PATTERNS\n        ]\n    \n    def load_json(self, file_path: Path) -> List[Dict[str, Any]]:\n        \"\"\"Load and validate JSON transcript file.\"\"\"\n        with open(file_path, 'r', encoding='utf-8') as f:\n            data = json.load(f)\n        \n        if not isinstance(data, list):\n            raise ValueError(f\"Expected JSON array, got {type(data).__name__}\")\n        \n        # Validate structure\n        for i, turn in enumerate(data):\n            if not isinstance(turn, dict):\n                raise ValueError(f\"Turn {i} is not an object\")\n            if 'text' not in turn:\n                raise ValueError(f\"Turn {i} missing 'text' field\")\n            if 'speaker' not in turn:\n                raise ValueError(f\"Turn {i} missing 'speaker' field\")\n        \n        return data\n    \n    def _is_interviewer(self, speaker: str) -> bool:\n        \"\"\"Check if speaker is an interviewer based on common patterns.\"\"\"\n        for pattern in self._interviewer_re:\n            if pattern.search(speaker):\n                return True\n        return False\n    \n    def _detect_speakers(self, turns: List[Dict[str, Any]]) -> Tuple[str, str]:\n        \"\"\"\n        Detect interviewer and veteran names from the transcript.\n        \n        Returns:\n            Tuple of (interviewer_name, veteran_name)\n        \"\"\"\n        speaker_counts: Dict[str, int] = {}\n        speaker_total_length: Dict[str, int] = {}\n        \n        for turn in turns:\n            speaker = turn['speaker']\n            text_length = len(turn.get('text', ''))\n            \n            speaker_counts[speaker] = speaker_counts.get(speaker, 0) + 1\n            speaker_total_length[speaker] = speaker_total_length.get(speaker, 0) + text_length\n        \n        # Find interviewer by pattern matching first\n        interviewer = None\n        for speaker in speaker_counts:\n            if self._is_interviewer(speaker):\n                interviewer = speaker\n                break\n        \n        # If no pattern match, assume the one with shorter total text is interviewer\n        # (interviewers ask short questions, veterans give long answers)\n        if not interviewer and len(speaker_counts) >= 2:\n            sorted_by_length = sorted(\n                speaker_total_length.items(), \n                key=lambda x: x[1]\n            )\n            interviewer = sorted_by_length[0][0]\n        \n        # Veteran is whoever isn't the interviewer\n        veteran = None\n        for speaker in speaker_counts:\n            if speaker != interviewer:\n                if veteran is None or speaker_total_length[speaker] > speaker_total_length.get(veteran, 0):\n                    veteran = speaker\n        \n        return interviewer or \"Unknown Interviewer\", veteran or \"Unknown Veteran\"\n    \n    def parse_turns(self, data: List[Dict[str, Any]]) -> Tuple[List[Turn], str, str]:\n        \"\"\"\n        Parse raw JSON into Turn objects and detect speakers.\n        \n        Returns:\n            Tuple of (turns, interviewer_name, veteran_name)\n        \"\"\"\n        interviewer, veteran = self._detect_speakers(data)\n        \n        turns = []\n        for i, item in enumerate(data):\n            turns.append(Turn(\n                speaker=item['speaker'],\n                text=item.get('text', '').strip(),\n                index=i\n            ))\n        \n        return turns, interviewer, veteran\n    \n    def group_into_qa_pairs(\n        self, \n        turns: List[Turn], \n        interviewer: str, \n        veteran: str\n    ) -> List[QAPair]:\n        \"\"\"\n        Group consecutive turns into Q&A pairs.\n        \n        Logic:\n        - Interviewer turn(s) = Question\n        - Following Veteran turn(s) = Answer\n        - Multiple consecutive veteran turns are combined into one answer\n        \"\"\"\n        qa_pairs = []\n        \n        current_question = None\n        current_question_index = None\n        current_answer_parts = []\n        current_answer_indices = []\n        \n        def flush_qa():\n            \"\"\"Save current Q&A pair if complete.\"\"\"\n            nonlocal current_question, current_question_index\n            nonlocal current_answer_parts, current_answer_indices\n            \n            if current_question and current_answer_parts:\n                qa_pairs.append(QAPair(\n                    question=current_question,\n                    answer=\" \".join(current_answer_parts),\n                    question_turn_index=current_question_index,\n                    answer_turn_indices=current_answer_indices.copy()\n                ))\n            \n            current_question = None\n            current_question_index = None\n            current_answer_parts = []\n            current_answer_indices = []\n        \n        for turn in turns:\n            is_interviewer = (turn.speaker == interviewer or \n                            self._is_interviewer(turn.speaker))\n            \n            if is_interviewer:\n                # New question - flush previous Q&A if exists\n                flush_qa()\n                \n                # Start new question (combine consecutive interviewer turns)\n                if current_question is None:\n                    current_question = turn.text\n                    current_question_index = turn.index\n                else:\n                    current_question += \" \" + turn.text\n            else:\n                # Veteran response - add to current answer\n                if turn.text:  # Skip empty responses\n                    current_answer_parts.append(turn.text)\n                    current_answer_indices.append(turn.index)\n        \n        # Don't forget the last Q&A pair\n        flush_qa()\n        \n        return qa_pairs\n    \n    def split_paragraphs(self, text: str) -> List[str]:\n        \"\"\"\n        Split text into paragraphs for embedding.\n        \n        For oral history, we split on:\n        - Double newlines\n        - Long pauses (if marked)\n        - Topic shifts (harder to detect)\n        \n        Args:\n            text: Text to split\n            \n        Returns:\n            List of paragraph texts\n        \"\"\"\n        # First try double newlines\n        parts = re.split(r'\\n\\s*\\n', text)\n        \n        if len(parts) == 1:\n            # No double newlines - split on sentence boundaries for long texts\n            # Keep chunks around 500-1000 chars for good embedding\n            if len(text) > 1000:\n                parts = self._split_long_text(text)\n            else:\n                parts = [text]\n        \n        # Merge short paragraphs\n        paragraphs = []\n        current = \"\"\n        \n        for part in parts:\n            part = part.strip()\n            if not part:\n                continue\n            \n            if len(part) < self.min_paragraph_length and current:\n                current += \" \" + part\n            elif len(current) < self.min_paragraph_length and current:\n                current += \" \" + part\n            else:\n                if current:\n                    paragraphs.append(current)\n                current = part\n        \n        if current:\n            paragraphs.append(current)\n        \n        # If we ended up with nothing, return the whole text\n        if not paragraphs and text.strip():\n            paragraphs = [text.strip()]\n        \n        return paragraphs\n    \n    def _split_long_text(self, text: str, target_length: int = 800) -> List[str]:\n        \"\"\"Split long text into chunks at sentence boundaries.\"\"\"\n        sentences = re.split(r'(?<=[.!?])\\s+', text)\n        \n        chunks = []\n        current_chunk = \"\"\n        \n        for sentence in sentences:\n            if len(current_chunk) + len(sentence) > target_length and current_chunk:\n                chunks.append(current_chunk.strip())\n                current_chunk = sentence\n            else:\n                current_chunk += \" \" + sentence if current_chunk else sentence\n        \n        if current_chunk:\n            chunks.append(current_chunk.strip())\n        \n        return chunks\n    \n    def create_responses(\n        self, \n        qa_pairs: List[QAPair], \n        veteran_name: str,\n        id_prefix: str = \"\"\n    ) -> List[Response]:\n        \"\"\"\n        Convert Q&A pairs to Response objects with paragraphs.\n        \n        Args:\n            qa_pairs: List of Q&A pairs\n            veteran_name: Name of the veteran (for speaker attribution)\n            id_prefix: Optional prefix for response IDs\n            \n        Returns:\n            List of Response objects\n        \"\"\"\n        responses = []\n        \n        for i, qa in enumerate(qa_pairs):\n            response_id = f\"{id_prefix}{str(i + 1).zfill(3)}\"\n            \n            # Split veteran's answer into paragraphs\n            paragraph_texts = self.split_paragraphs(qa.answer)\n            paragraphs = []\n            \n            for j, para_text in enumerate(paragraph_texts):\n                para_id = f\"{response_id}_p{j + 1}\"\n                paragraphs.append(Paragraph(id=para_id, text=para_text))\n            \n            responses.append(Response(\n                id=response_id,\n                interviewer=qa.question,\n                veteran=qa.answer,\n                paragraphs=paragraphs\n            ))\n        \n        return responses\n    \n    def parse(self, file_path: Path) -> Tuple[List[Response], str, str]:\n        \"\"\"\n        Parse a JSON transcript file into Response objects.\n        \n        Args:\n            file_path: Path to JSON transcript\n            \n        Returns:\n            Tuple of (responses, interviewer_name, veteran_name)\n        \"\"\"\n        # Load JSON\n        data = self.load_json(file_path)\n        \n        # Parse into turns\n        turns, interviewer, veteran = self.parse_turns(data)\n        \n        # Group into Q&A pairs\n        qa_pairs = self.group_into_qa_pairs(turns, interviewer, veteran)\n        \n        # Create Response objects\n        responses = self.create_responses(qa_pairs, veteran)\n        \n        return responses, interviewer, veteran\n    \n    def get_context_window(\n        self, \n        file_path: Path,\n        response_index: int,\n        window_size: int = 2\n    ) -> List[Response]:\n        \"\"\"\n        Get a window of responses around a specific response.\n        \n        This is the \"Parent-Child\" windowing - when you find a quote,\n        you want to see what came before and after.\n        \n        Args:\n            file_path: Path to JSON transcript\n            response_index: Index of the target response (0-based)\n            window_size: Number of responses before/after to include\n            \n        Returns:\n            List of Response objects in the window\n        \"\"\"\n        responses, _, _ = self.parse(file_path)\n        \n        start = max(0, response_index - window_size)\n        end = min(len(responses), response_index + window_size + 1)\n        \n        return responses[start:end]\n\n\ndef parse_json_transcript(\n    file_path: Path,\n    min_paragraph_length: int = 50\n) -> Tuple[List[Response], str, str]:\n    \"\"\"\n    Parse a JSON transcript file.\n    \n    Convenience function for the parser.\n    \n    Args:\n        file_path: Path to transcript file\n        min_paragraph_length: Minimum paragraph length\n        \n    Returns:\n        Tuple of (responses, interviewer_name, veteran_name)\n    \"\"\"\n    parser = JSONTranscriptParser(min_paragraph_length=min_paragraph_length)\n    return parser.parse(file_path)\n\n\ndef extract_veteran_name_from_filename(filename: str) -> str:\n    \"\"\"\n    Extract veteran name from filename.\n    \n    Handles patterns like:\n    - \"Lavere-E-Watson-69th.json\" -> \"Lavere E Watson\"\n    - \"john_doe_interview.json\" -> \"John Doe\"\n    \n    Args:\n        filename: The filename (with or without path)\n        \n    Returns:\n        Extracted and cleaned veteran name\n    \"\"\"\n    # Remove extension\n    name = Path(filename).stem\n    \n    # Remove common suffixes\n    suffixes_to_remove = [\n        r'-?\\d+(?:st|nd|rd|th)?$',  # Unit numbers like \"69th\"\n        r'_?interview$',\n        r'_?transcript$',\n        r'_?oral[_-]?history$',\n    ]\n    \n    for pattern in suffixes_to_remove:\n        name = re.sub(pattern, '', name, flags=re.IGNORECASE)\n    \n    # Replace separators with spaces\n    name = re.sub(r'[-_]+', ' ', name)\n    \n    # Title case\n    name = ' '.join(word.capitalize() for word in name.split())\n    \n    return name.strip()\n"}},"jsonrpc":"2.0","id":7} { metadata: undefined }
