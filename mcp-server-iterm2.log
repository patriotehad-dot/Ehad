2025-12-20T16:46:42.325Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":32,"result":{"content":[{"type":"text","text":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/storage.py\",\"content\":\"\\\"\\\"\\\"\\nStorage layer for the Oral History Research System.\\n\\nHandles reading and writing YAML files for veterans and annotations.\\nAll file I/O is centralized here for consistency.\\n\\\"\\\"\\\"\\n\\nimport re\\nfrom pathlib import Path\\nfrom typing import List, Optional, Dict, Any\\nfrom datetime import datetime\\nimport yaml\\n\\nfrom .models import (\\n    Veteran, VeteranAnnotations, ResponseAnnotation, \\n    AnnotationNote, Response, Paragraph\\n)\\nfrom .config import ProjectContext\\n\\n\\ndef slugify(name: str) -> str:\\n    \\\"\\\"\\\"\\n    Convert a name to a slug suitable for filenames.\\n    \\n    Args:\\n        name: Name to convert (e.g., \\\"Hugo Girusi\\\")\\n        \\n    Returns:\\n        Slug (e.g., \\\"girusi_hugo\\\")\\n    \\\"\\\"\\\"\\n    # Convert to lowercase\\n    slug = name.lower()\\n    \\n    # Split into parts\\n    parts = slug.split()\\n    \\n    # Reverse order (last name first) if there are multiple parts\\n    if len(parts) > 1:\\n        parts = [parts[-1]] + parts[:-1]\\n    \\n    # Join with underscore\\n    slug = \\\"_\\\".join(parts)\\n    \\n    # Remove non-alphanumeric characters except underscore\\n    slug = re.sub(r\\\"[^a-z0-9_]\\\", \\\"\\\", slug)\\n    \\n    return slug\\n\\n\\nclass VeteranStorage:\\n    \\\"\\\"\\\"Handles storage operations for veterans.\\\"\\\"\\\"\\n    \\n    def __init__(self, ctx: ProjectContext):\\n        \\\"\\\"\\\"\\n        Initialize storage with project context.\\n        \\n        Args:\\n            ctx: Project context\\n        \\\"\\\"\\\"\\n        self.ctx = ctx\\n    \\n    def list_veterans(self) -> List[str]:\\n        \\\"\\\"\\\"\\n        List all veteran IDs in the project.\\n        \\n        Returns:\\n            List of veteran IDs\\n        \\\"\\\"\\\"\\n        veterans_dir = self.ctx.veterans_dir\\n        if not veterans_dir.exists():\\n            return []\\n        \\n        return [\\n            f.stem for f in veterans_dir.glob(\\\"*.yaml\\\")\\n            if f.is_file()\\n        ]\\n    \\n    def load(self, veteran_id: str) -> Optional[Veteran]:\\n        \\\"\\\"\\\"\\n        Load a veteran by ID.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            \\n        Returns:\\n            Veteran object or None if not found\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.veteran_file(veteran_id)\\n        \\n        if not file_path.exists():\\n            return None\\n        \\n        with open(file_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n            data = yaml.safe_load(f)\\n        \\n        if data is None:\\n            return None\\n        \\n        return Veteran(**data)\\n    \\n    def save(self, veteran: Veteran) -> Path:\\n        \\\"\\\"\\\"\\n        Save a veteran to YAML.\\n        \\n        Args:\\n            veteran: Veteran object to save\\n            \\n        Returns:\\n            Path to saved file\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.veteran_file(veteran.id)\\n        \\n        # Ensure directory exists\\n        file_path.parent.mkdir(parents=True, exist_ok=True)\\n        \\n        # Convert to dict for YAML serialization\\n        data = veteran.model_dump(mode=\\\"json\\\", exclude_none=True)\\n        \\n        # Custom YAML formatting for readability\\n        with open(file_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n            yaml.dump(\\n                data, \\n                f, \\n                default_flow_style=False, \\n                sort_keys=False,\\n                allow_unicode=True,\\n                width=120\\n            )\\n        \\n        return file_path\\n    \\n    def exists(self, veteran_id: str) -> bool:\\n        \\\"\\\"\\\"Check if a veteran exists.\\\"\\\"\\\"\\n        return self.ctx.veteran_file(veteran_id).exists()\\n    \\n    def delete(self, veteran_id: str) -> bool:\\n        \\\"\\\"\\\"\\n        Delete a veteran file.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            \\n        Returns:\\n            True if deleted, False if not found\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.veteran_file(veteran_id)\\n        if file_path.exists():\\n            file_path.unlink()\\n            return True\\n        return False\\n    \\n    def get_all(self) -> List[Veteran]:\\n        \\\"\\\"\\\"\\n        Load all veterans.\\n        \\n        Returns:\\n            List of all veteran objects\\n        \\\"\\\"\\\"\\n        veterans = []\\n        for veteran_id in self.list_veterans():\\n            veteran = self.load(veteran_id)\\n            if veteran:\\n                veterans.append(veteran)\\n        return veterans\\n\\n\\nclass AnnotationStorage:\\n    \\\"\\\"\\\"Handles storage operations for annotations.\\\"\\\"\\\"\\n    \\n    def __init__(self, ctx: ProjectContext):\\n        \\\"\\\"\\\"\\n        Initialize storage with project context.\\n        \\n        Args:\\n            ctx: Project context\\n        \\\"\\\"\\\"\\n        self.ctx = ctx\\n    \\n    def load(self, veteran_id: str) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Load annotations for a veteran.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            \\n        Returns:\\n            VeteranAnnotations object (empty if none exist)\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.annotations_file(veteran_id)\\n        \\n        if not file_path.exists():\\n            return VeteranAnnotations(veteran_id=veteran_id)\\n        \\n        with open(file_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n            data = yaml.safe_load(f)\\n        \\n        if data is None:\\n            return VeteranAnnotations(veteran_id=veteran_id)\\n        \\n        return VeteranAnnotations(**data)\\n    \\n    def save(self, annotations: VeteranAnnotations) -> Path:\\n        \\\"\\\"\\\"\\n        Save annotations for a veteran.\\n        \\n        Args:\\n            annotations: Annotations to save\\n            \\n        Returns:\\n            Path to saved file\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.annotations_file(annotations.veteran_id)\\n        \\n        # Ensure directory exists\\n        file_path.parent.mkdir(parents=True, exist_ok=True)\\n        \\n        # Convert to dict for YAML serialization\\n        data = annotations.model_dump(mode=\\\"json\\\", exclude_none=True)\\n        \\n        with open(file_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n            yaml.dump(\\n                data, \\n                f, \\n                default_flow_style=False, \\n                sort_keys=False,\\n                allow_unicode=True\\n            )\\n        \\n        return file_path\\n    \\n    def add_response_note(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        note_text: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a note to a response.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            note_text: Note text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id not in annotations.response_annotations:\\n            annotations.response_annotations[response_id] = ResponseAnnotation()\\n        \\n        note = AnnotationNote(\\n            date=datetime.now().strftime(\\\"%Y-%m-NaN\\\"),\\n            text=note_text\\n        )\\n        annotations.response_annotations[response_id].notes.append(note)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def set_chapter(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        chapter: int\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Assign a response to a chapter.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            chapter: Chapter number\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id not in annotations.response_annotations:\\n            annotations.response_annotations[response_id] = ResponseAnnotation()\\n        \\n        annotations.response_annotations[response_id].chapter = chapter\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def add_flag(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        flag: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a flag to a response.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            flag: Flag text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id not in annotations.response_annotations:\\n            annotations.response_annotations[response_id] = ResponseAnnotation()\\n        \\n        if flag not in annotations.response_annotations[response_id].flags:\\n            annotations.response_annotations[response_id].flags.append(flag)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def remove_flag(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        flag: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Remove a flag from a response.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            flag: Flag to remove\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id in annotations.response_annotations:\\n            flags = annotations.response_annotations[response_id].flags\\n            if flag in flags:\\n                flags.remove(flag)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def add_veteran_note(\\n        self, \\n        veteran_id: str, \\n        note_text: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a note about the veteran (not specific to a response).\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            note_text: Note text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        note = AnnotationNote(\\n            date=datetime.now().strftime(\\\"%Y-%m-%d\\\"),\\n            text=note_text\\n        )\\n        annotations.veteran_notes.append(note)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def add_todo(\\n        self, \\n        veteran_id: str, \\n        todo_text: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a research todo.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            todo_text: Todo text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        annotations.research_todos.append(todo_text)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def get_chapter_responses(\\n        self, \\n        chapter: int\\n    ) -> Dict[str, List[str]]:\\n        \\\"\\\"\\\"\\n        Get all responses assigned to a chapter.\\n        \\n        Args:\\n            chapter: Chapter number\\n            \\n        Returns:\\n            Dict mapping veteran_id to list of response_ids\\n        \\\"\\\"\\\"\\n        result = {}\\n        \\n        annotations_dir = self.ctx.annotations_dir\\n        if not annotations_dir.exists():\\n            return result\\n        \\n        for file_path in annotations_dir.glob(\\\"*.yaml\\\"):\\n            veteran_id = file_path.stem\\n            annotations = self.load(veteran_id)\\n            \\n            response_ids = []\\n            for resp_id, annot in annotations.response_annotations.items():\\n                if annot.chapter == chapter:\\n                    response_ids.append(resp_id)\\n            \\n            if response_ids:\\n                result[veteran_id] = response_ids\\n        \\n        return result\\n    \\n    def get_flagged_responses(\\n        self, \\n        flag: Optional[str] = None\\n    ) -> Dict[str, Dict[str, List[str]]]:\\n        \\\"\\\"\\\"\\n        Get all flagged responses.\\n        \\n        Args:\\n            flag: Specific flag to filter by (None for all)\\n            \\n        Returns:\\n            Dict mapping veteran_id to {response_id: [flags]}\\n        \\\"\\\"\\\"\\n        result = {}\\n        \\n        annotations_dir = self.ctx.annotations_dir\\n        if not annotations_dir.exists():\\n            return result\\n        \\n        for file_path in annotations_dir.glob(\\\"*.yaml\\\"):\\n            veteran_id = file_path.stem\\n            annotations = self.load(veteran_id)\\n            \\n            veteran_flags = {}\\n            for resp_id, annot in annotations.response_annotations.items():\\n                if annot.flags:\\n                    if flag is None or flag in annot.flags:\\n                        veteran_flags[resp_id] = annot.flags\\n            \\n            if veteran_flags:\\n                result[veteran_id] = veteran_flags\\n        \\n        return result\\n\",\"file_size_bytes\":12394,\"content_length\":12394}"}],"structuredContent":{"result":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/storage.py\",\"content\":\"\\\"\\\"\\\"\\nStorage layer for the Oral History Research System.\\n\\nHandles reading and writing YAML files for veterans and annotations.\\nAll file I/O is centralized here for consistency.\\n\\\"\\\"\\\"\\n\\nimport re\\nfrom pathlib import Path\\nfrom typing import List, Optional, Dict, Any\\nfrom datetime import datetime\\nimport yaml\\n\\nfrom .models import (\\n    Veteran, VeteranAnnotations, ResponseAnnotation, \\n    AnnotationNote, Response, Paragraph\\n)\\nfrom .config import ProjectContext\\n\\n\\ndef slugify(name: str) -> str:\\n    \\\"\\\"\\\"\\n    Convert a name to a slug suitable for filenames.\\n    \\n    Args:\\n        name: Name to convert (e.g., \\\"Hugo Girusi\\\")\\n        \\n    Returns:\\n        Slug (e.g., \\\"girusi_hugo\\\")\\n    \\\"\\\"\\\"\\n    # Convert to lowercase\\n    slug = name.lower()\\n    \\n    # Split into parts\\n    parts = slug.split()\\n    \\n    # Reverse order (last name first) if there are multiple parts\\n    if len(parts) > 1:\\n        parts = [parts[-1]] + parts[:-1]\\n    \\n    # Join with underscore\\n    slug = \\\"_\\\".join(parts)\\n    \\n    # Remove non-alphanumeric characters except underscore\\n    slug = re.sub(r\\\"[^a-z0-9_]\\\", \\\"\\\", slug)\\n    \\n    return slug\\n\\n\\nclass VeteranStorage:\\n    \\\"\\\"\\\"Handles storage operations for veterans.\\\"\\\"\\\"\\n    \\n    def __init__(self, ctx: ProjectContext):\\n        \\\"\\\"\\\"\\n        Initialize storage with project context.\\n        \\n        Args:\\n            ctx: Project context\\n        \\\"\\\"\\\"\\n        self.ctx = ctx\\n    \\n    def list_veterans(self) -> List[str]:\\n        \\\"\\\"\\\"\\n        List all veteran IDs in the project.\\n        \\n        Returns:\\n            List of veteran IDs\\n        \\\"\\\"\\\"\\n        veterans_dir = self.ctx.veterans_dir\\n        if not veterans_dir.exists():\\n            return []\\n        \\n        return [\\n            f.stem for f in veterans_dir.glob(\\\"*.yaml\\\")\\n            if f.is_file()\\n        ]\\n    \\n    def load(self, veteran_id: str) -> Optional[Veteran]:\\n        \\\"\\\"\\\"\\n        Load a veteran by ID.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            \\n        Returns:\\n            Veteran object or None if not found\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.veteran_file(veteran_id)\\n        \\n        if not file_path.exists():\\n            return None\\n        \\n        with open(file_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n            data = yaml.safe_load(f)\\n        \\n        if data is None:\\n            return None\\n        \\n        return Veteran(**data)\\n    \\n    def save(self, veteran: Veteran) -> Path:\\n        \\\"\\\"\\\"\\n        Save a veteran to YAML.\\n        \\n        Args:\\n            veteran: Veteran object to save\\n            \\n        Returns:\\n            Path to saved file\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.veteran_file(veteran.id)\\n        \\n        # Ensure directory exists\\n        file_path.parent.mkdir(parents=True, exist_ok=True)\\n        \\n        # Convert to dict for YAML serialization\\n        data = veteran.model_dump(mode=\\\"json\\\", exclude_none=True)\\n        \\n        # Custom YAML formatting for readability\\n        with open(file_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n            yaml.dump(\\n                data, \\n                f, \\n                default_flow_style=False, \\n                sort_keys=False,\\n                allow_unicode=True,\\n                width=120\\n            )\\n        \\n        return file_path\\n    \\n    def exists(self, veteran_id: str) -> bool:\\n        \\\"\\\"\\\"Check if a veteran exists.\\\"\\\"\\\"\\n        return self.ctx.veteran_file(veteran_id).exists()\\n    \\n    def delete(self, veteran_id: str) -> bool:\\n        \\\"\\\"\\\"\\n        Delete a veteran file.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            \\n        Returns:\\n            True if deleted, False if not found\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.veteran_file(veteran_id)\\n        if file_path.exists():\\n            file_path.unlink()\\n            return True\\n        return False\\n    \\n    def get_all(self) -> List[Veteran]:\\n        \\\"\\\"\\\"\\n        Load all veterans.\\n        \\n        Returns:\\n            List of all veteran objects\\n        \\\"\\\"\\\"\\n        veterans = []\\n        for veteran_id in self.list_veterans():\\n            veteran = self.load(veteran_id)\\n            if veteran:\\n                veterans.append(veteran)\\n        return veterans\\n\\n\\nclass AnnotationStorage:\\n    \\\"\\\"\\\"Handles storage operations for annotations.\\\"\\\"\\\"\\n    \\n    def __init__(self, ctx: ProjectContext):\\n        \\\"\\\"\\\"\\n        Initialize storage with project context.\\n        \\n        Args:\\n            ctx: Project context\\n        \\\"\\\"\\\"\\n        self.ctx = ctx\\n    \\n    def load(self, veteran_id: str) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Load annotations for a veteran.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            \\n        Returns:\\n            VeteranAnnotations object (empty if none exist)\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.annotations_file(veteran_id)\\n        \\n        if not file_path.exists():\\n            return VeteranAnnotations(veteran_id=veteran_id)\\n        \\n        with open(file_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n            data = yaml.safe_load(f)\\n        \\n        if data is None:\\n            return VeteranAnnotations(veteran_id=veteran_id)\\n        \\n        return VeteranAnnotations(**data)\\n    \\n    def save(self, annotations: VeteranAnnotations) -> Path:\\n        \\\"\\\"\\\"\\n        Save annotations for a veteran.\\n        \\n        Args:\\n            annotations: Annotations to save\\n            \\n        Returns:\\n            Path to saved file\\n        \\\"\\\"\\\"\\n        file_path = self.ctx.annotations_file(annotations.veteran_id)\\n        \\n        # Ensure directory exists\\n        file_path.parent.mkdir(parents=True, exist_ok=True)\\n        \\n        # Convert to dict for YAML serialization\\n        data = annotations.model_dump(mode=\\\"json\\\", exclude_none=True)\\n        \\n        with open(file_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n            yaml.dump(\\n                data, \\n                f, \\n                default_flow_style=False, \\n                sort_keys=False,\\n                allow_unicode=True\\n            )\\n        \\n        return file_path\\n    \\n    def add_response_note(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        note_text: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a note to a response.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            note_text: Note text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id not in annotations.response_annotations:\\n            annotations.response_annotations[response_id] = ResponseAnnotation()\\n        \\n        note = AnnotationNote(\\n            date=datetime.now().strftime(\\\"%Y-%m-%d\\\"),\\n            text=note_text\\n        )\\n        annotations.response_annotations[response_id].notes.append(note)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def set_chapter(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        chapter: int\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Assign a response to a chapter.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            chapter: Chapter number\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id not in annotations.response_annotations:\\n            annotations.response_annotations[response_id] = ResponseAnnotation()\\n        \\n        annotations.response_annotations[response_id].chapter = chapter\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def add_flag(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        flag: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a flag to a response.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            flag: Flag text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id not in annotations.response_annotations:\\n            annotations.response_annotations[response_id] = ResponseAnnotation()\\n        \\n        if flag not in annotations.response_annotations[response_id].flags:\\n            annotations.response_annotations[response_id].flags.append(flag)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def remove_flag(\\n        self, \\n        veteran_id: str, \\n        response_id: str, \\n        flag: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Remove a flag from a response.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            response_id: Response identifier\\n            flag: Flag to remove\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        if response_id in annotations.response_annotations:\\n            flags = annotations.response_annotations[response_id].flags\\n            if flag in flags:\\n                flags.remove(flag)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def add_veteran_note(\\n        self, \\n        veteran_id: str, \\n        note_text: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a note about the veteran (not specific to a response).\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            note_text: Note text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        \\n        note = AnnotationNote(\\n            date=datetime.now().strftime(\\\"%Y-%m-%d\\\"),\\n            text=note_text\\n        )\\n        annotations.veteran_notes.append(note)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def add_todo(\\n        self, \\n        veteran_id: str, \\n        todo_text: str\\n    ) -> VeteranAnnotations:\\n        \\\"\\\"\\\"\\n        Add a research todo.\\n        \\n        Args:\\n            veteran_id: Veteran identifier\\n            todo_text: Todo text\\n            \\n        Returns:\\n            Updated annotations\\n        \\\"\\\"\\\"\\n        annotations = self.load(veteran_id)\\n        annotations.research_todos.append(todo_text)\\n        \\n        self.save(annotations)\\n        return annotations\\n    \\n    def get_chapter_responses(\\n        self, \\n        chapter: int\\n    ) -> Dict[str, List[str]]:\\n        \\\"\\\"\\\"\\n        Get all responses assigned to a chapter.\\n        \\n        Args:\\n            chapter: Chapter number\\n            \\n        Returns:\\n            Dict mapping veteran_id to list of response_ids\\n        \\\"\\\"\\\"\\n        result = {}\\n        \\n        annotations_dir = self.ctx.annotations_dir\\n        if not annotations_dir.exists():\\n            return result\\n        \\n        for file_path in annotations_dir.glob(\\\"*.yaml\\\"):\\n            veteran_id = file_path.stem\\n            annotations = self.load(veteran_id)\\n            \\n            response_ids = []\\n            for resp_id, annot in annotations.response_annotations.items():\\n                if annot.chapter == chapter:\\n                    response_ids.append(resp_id)\\n            \\n            if response_ids:\\n                result[veteran_id] = response_ids\\n        \\n        return result\\n    \\n    def get_flagged_responses(\\n        self, \\n        flag: Optional[str] = None\\n    ) -> Dict[str, Dict[str, List[str]]]:\\n        \\\"\\\"\\\"\\n        Get all flagged responses.\\n        \\n        Args:\\n            flag: Specific flag to filter by (None for all)\\n            \\n        Returns:\\n            Dict mapping veteran_id to {response_id: [flags]}\\n        \\\"\\\"\\\"\\n        result = {}\\n        \\n        annotations_dir = self.ctx.annotations_dir\\n        if not annotations_dir.exists():\\n            return result\\n        \\n        for file_path in annotations_dir.glob(\\\"*.yaml\\\"):\\n            veteran_id = file_path.stem\\n            annotations = self.load(veteran_id)\\n            \\n            veteran_flags = {}\\n            for resp_id, annot in annotations.response_annotations.items():\\n                if annot.flags:\\n                    if flag is None or flag in annot.flags:\\n                        veteran_flags[resp_id] = annot.flags\\n            \\n            if veteran_flags:\\n                result[veteran_id] = veteran_flags\\n        \\n        return result\\n\",\"file_size_bytes\":12394,\"content_length\":12394}"},"isError":false}} %o
