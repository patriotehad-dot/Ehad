2025-12-21T17:05:29.651Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":8,"result":{"content":[{"type":"text","text":"{\n  \"success\": true,\n  \"file_path\": \"/Users/happyhawking/Documents/Projects/Current/writer/src/llm/__init__.py\",\n  \"content\": \"\\\"\\\"\\\"\\nLLM module for the Oral History Research System.\\n\\nProvides LLM client abstraction, response extraction, veteran synthesis,\\nand topic segmentation.\\n\\\"\\\"\\\"\\n\\nfrom .client import LLMClient, get_llm_client\\nfrom .extractor import ResponseExtractor\\nfrom .synthesizer import VeteranSynthesizer, NarrativeSynthesizer, DraftWriter\\nfrom .segmenter import TopicSegmenter\\n\\n__all__ = [\\n    \\\"LLMClient\\\",\\n    \\\"get_llm_client\\\",\\n    \\\"ResponseExtractor\\\",\\n    \\\"VeteranSynthesizer\\\",\\n    \\\"NarrativeSynthesizer\\\",\\n    \\\"DraftWriter\\\",\\n    \\\"TopicSegmenter\\\",\\n]\\n\",\n  \"file_size_bytes\": 534,\n  \"content_length\": 534\n}"}],"structuredContent":{"result":"{\n  \"success\": true,\n  \"file_path\": \"/Users/happyhawking/Documents/Projects/Current/writer/src/llm/__init__.py\",\n  \"content\": \"\\\"\\\"\\\"\\nLLM module for the Oral History Research System.\\n\\nProvides LLM client abstraction, response extraction, veteran synthesis,\\nand topic segmentation.\\n\\\"\\\"\\\"\\n\\nfrom .client import LLMClient, get_llm_client\\nfrom .extractor import ResponseExtractor\\nfrom .synthesizer import VeteranSynthesizer, NarrativeSynthesizer, DraftWriter\\nfrom .segmenter import TopicSegmenter\\n\\n__all__ = [\\n    \\\"LLMClient\\\",\\n    \\\"get_llm_client\\\",\\n    \\\"ResponseExtractor\\\",\\n    \\\"VeteranSynthesizer\\\",\\n    \\\"NarrativeSynthesizer\\\",\\n    \\\"DraftWriter\\\",\\n    \\\"TopicSegmenter\\\",\\n]\\n\",\n  \"file_size_bytes\": 534,\n  \"content_length\": 534\n}"},"isError":false}} { metadata: undefined }
2025-12-21T17:06:31.004Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"file_path":"/Users/happyhawking/Documents/Projects/Current/writer/src/llm/retrieval.py","content":"\"\"\"\nAdvanced Retrieval Strategies for the Oral History Research System.\n\nImplements:\n1. Query Expansion - Generate multiple query variants for broader coverage\n2. Re-ranking - Cross-encoder scoring for precision\n3. Self-Reflection - Quality grading with automatic retry\n\nThese strategies can be combined in a pipeline for optimal retrieval.\n\"\"\"\n\nimport json\nfrom typing import List, Optional, Dict, Any, Tuple\nfrom dataclasses import dataclass\n\nfrom .client import LLMClient\n\n\n@dataclass\nclass QueryExpansion:\n    \"\"\"Result of query expansion.\"\"\"\n    original: str\n    variants: List[str]\n    \n\n@dataclass \nclass RetrievalGrade:\n    \"\"\"Result of self-reflection grading.\"\"\"\n    score: int  # 1-5\n    reasoning: str\n    refined_query: Optional[str]  # Suggested refinement if score < 3\n\n\nclass QueryExpander:\n    \"\"\"\n    Expands a single query into multiple variants for broader coverage.\n    \n    Example:\n        \"Bastogne cold\" -> [\n            \"Bastogne cold\",\n            \"Bastogne freezing winter December 1944\",\n            \"Battle of Bulge weather conditions frozen\",\n            \"siege frozen soldiers foxholes snow\"\n        ]\n    \"\"\"\n    \n    EXPANSION_PROMPT = \"\"\"You are helping search a WWII oral history archive of veteran interviews.\n\nGiven this search query, generate 3-4 alternative search queries that would help find relevant content.\n\nConsider:\n- Synonyms and related terms\n- Specific historical details (dates, places, unit names)\n- Different phrasings of the same concept\n- Both broad and narrow variants\n\nOriginal query: \"{query}\"\n\nReturn a JSON object with a \"variants\" array of strings. Include the original query as the first variant.\n\nExample output:\n{{\"variants\": [\"Bastogne cold\", \"Bastogne freezing winter 1944\", \"Battle of Bulge weather\", \"frozen foxholes snow\"]}}\n\nJSON output:\"\"\"\n\n    def __init__(self, llm_client: LLMClient):\n        self.llm = llm_client\n    \n    def expand(self, query: str) -> QueryExpansion:\n        \"\"\"\n        Expand a query into multiple variants.\n        \n        Args:\n            query: Original search query\n            \n        Returns:\n            QueryExpansion with original and variant queries\n        \"\"\"\n        prompt = self.EXPANSION_PROMPT.format(query=query)\n        \n        try:\n            response = self.llm.complete(prompt, max_tokens=300)\n            \n            # Parse JSON response\n            response = response.strip()\n            if response.startswith(\"```\"):\n                response = response.split(\"```\")[1]\n                if response.startswith(\"json\"):\n                    response = response[4:]\n            \n            data = json.loads(response)\n            variants = data.get(\"variants\", [query])\n            \n            # Ensure original is included\n            if query not in variants:\n                variants.insert(0, query)\n            \n            return QueryExpansion(original=query, variants=variants[:5])  # Max 5 variants\n            \n        except Exception as e:\n            # Fallback: return just the original query\n            return QueryExpansion(original=query, variants=[query])\n\n\nclass ResultReranker:\n    \"\"\"\n    Re-ranks search results using cross-encoder or LLM scoring.\n    \n    Takes initial retrieval results and re-scores them based on\n    actual relevance to the query, not just embedding similarity.\n    \"\"\"\n    \n    RERANK_PROMPT = \"\"\"You are evaluating search results for relevance to a query about WWII veteran oral histories.\n\nQuery: \"{query}\"\n\nFor each result below, rate its relevance from 0.0 to 1.0:\n- 1.0 = Directly answers or highly relevant to the query\n- 0.7-0.9 = Related and useful context\n- 0.4-0.6 = Tangentially related\n- 0.1-0.3 = Marginally relevant  \n- 0.0 = Not relevant at all\n\nResults to evaluate:\n{results}\n\nReturn a JSON object with \"scores\" array containing relevance scores in the same order as the results.\nOnly return the JSON, no explanation.\n\nExample: {{\"scores\": [0.95, 0.72, 0.45, 0.23, 0.88]}}\n\nJSON output:\"\"\"\n\n    def __init__(self, llm_client: LLMClient):\n        self.llm = llm_client\n        self._cross_encoder = None\n    \n    def _get_cross_encoder(self):\n        \"\"\"Lazy-load cross-encoder model.\"\"\"\n        if self._cross_encoder is None:\n            try:\n                from sentence_transformers import CrossEncoder\n                self._cross_encoder = CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')\n            except ImportError:\n                self._cross_encoder = False  # Mark as unavailable\n        return self._cross_encoder\n    \n    def rerank(\n        self, \n        query: str, \n        results: List[Tuple[str, str, float, Any]],  # (vet_id, resp_id, score, segment_topic)\n        texts: List[str],  # The actual text content for each result\n        top_k: int = 15,\n        use_cross_encoder: bool = True\n    ) -> List[Tuple[str, str, float, Any]]:\n        \"\"\"\n        Re-rank results by relevance to query.\n        \n        Args:\n            query: Search query\n            results: Original search results (vet_id, resp_id, score, segment_topic)\n            texts: Text content corresponding to each result\n            top_k: Number of results to return\n            use_cross_encoder: Try to use cross-encoder first (faster, cheaper)\n            \n        Returns:\n            Re-ranked results with updated scores\n        \"\"\"\n        if not results:\n            return []\n        \n        # Try cross-encoder first (faster, no API cost)\n        if use_cross_encoder:\n            encoder = self._get_cross_encoder()\n            if encoder and encoder is not False:\n                return self._rerank_with_cross_encoder(query, results, texts, top_k, encoder)\n        \n        # Fall back to LLM-based reranking\n        return self._rerank_with_llm(query, results, texts, top_k)\n    \n    def _rerank_with_cross_encoder(\n        self,\n        query: str,\n        results: List[Tuple[str, str, float, Any]],\n        texts: List[str],\n        top_k: int,\n        encoder\n    ) -> List[Tuple[str, str, float, Any]]:\n        \"\"\"Re-rank using cross-encoder model.\"\"\"\n        # Create query-document pairs\n        pairs = [(query, text[:1000]) for text in texts]  # Truncate for efficiency\n        \n        # Score all pairs\n        scores = encoder.predict(pairs)\n        \n        # Combine with results and sort\n        scored = list(zip(results, scores))\n        scored.sort(key=lambda x: x[1], reverse=True)\n        \n        # Return top_k with updated scores\n        return [\n            (r[0], r[1], float(score), r[3])  # Replace original score with rerank score\n            for r, score in scored[:top_k]\n        ]\n    \n    def _rerank_with_llm(\n        self,\n        query: str,\n        results: List[Tuple[str, str, float, Any]],\n        texts: List[str],\n        top_k: int\n    ) -> List[Tuple[str, str, float, Any]]:\n        \"\"\"Re-rank using LLM scoring.\"\"\"\n        # Format results for prompt\n        results_text = \"\\n\\n\".join([\n            f\"[{i+1}] {text[:500]}...\" if len(text) > 500 else f\"[{i+1}] {text}\"\n            for i, text in enumerate(texts)\n        ])\n        \n        prompt = self.RERANK_PROMPT.format(query=query, results=results_text)\n        \n        try:\n            response = self.llm.complete(prompt, max_tokens=200)\n            \n            # Parse JSON\n            response = response.strip()\n            if response.startswith(\"```\"):\n                response = response.split(\"```\")[1]\n                if response.startswith(\"json\"):\n                    response = response[4:]\n            \n            data = json.loads(response)\n            scores = data.get(\"scores\", [])\n            \n            # Combine with results\n            if len(scores) == len(results):\n                scored = list(zip(results, scores))\n                scored.sort(key=lambda x: x[1], reverse=True)\n                return [\n                    (r[0], r[1], float(score), r[3])\n                    for r, score in scored[:top_k]\n                ]\n        except Exception:\n            pass\n        \n        # Fallback: return original order\n        return results[:top_k]\n\n\nclass RetrievalReflector:\n    \"\"\"\n    Self-reflection for search quality.\n    \n    Grades search results and suggests refinements if quality is poor.\n    \"\"\"\n    \n    REFLECTION_PROMPT = \"\"\"You are evaluating whether search results adequately answer a query about WWII veteran oral histories.\n\nQuery: \"{query}\"\n\nTop search results (summaries):\n{results}\n\nEvaluate:\n1. Do these results directly address the query?\n2. Is there sufficient relevant information?\n3. Are there obvious gaps or missing perspectives?\n\nRate the results 1-5:\n- 5: Excellent - directly answers the query with rich detail\n- 4: Good - relevant results that address the query\n- 3: Adequate - some relevant results but incomplete\n- 2: Poor - mostly irrelevant or tangential\n- 1: Failed - results don't address the query at all\n\nIf score < 3, suggest a refined search query that might work better.\n\nReturn JSON:\n{{\"score\": N, \"reasoning\": \"brief explanation\", \"refined_query\": \"new query or null\"}}\n\nJSON output:\"\"\"\n\n    def __init__(self, llm_client: LLMClient):\n        self.llm = llm_client\n    \n    def grade(\n        self, \n        query: str, \n        result_summaries: List[str]\n    ) -> RetrievalGrade:\n        \"\"\"\n        Grade search results and suggest refinements.\n        \n        Args:\n            query: Original search query\n            result_summaries: Brief summaries of top results\n            \n        Returns:\n            RetrievalGrade with score and optional refined query\n        \"\"\"\n        results_text = \"\\n\".join([\n            f\"- {summary[:200]}\" for summary in result_summaries[:5]\n        ])\n        \n        prompt = self.REFLECTION_PROMPT.format(query=query, results=results_text)\n        \n        try:\n            response = self.llm.complete(prompt, max_tokens=200)\n            \n            # Parse JSON\n            response = response.strip()\n            if response.startswith(\"```\"):\n                response = response.split(\"```\")[1]\n                if response.startswith(\"json\"):\n                    response = response[4:]\n            \n            data = json.loads(response)\n            \n            return RetrievalGrade(\n                score=int(data.get(\"score\", 3)),\n                reasoning=data.get(\"reasoning\", \"\"),\n                refined_query=data.get(\"refined_query\")\n            )\n            \n        except Exception as e:\n            # Default to passing grade on error\n            return RetrievalGrade(score=3, reasoning=f\"Grading failed: {e}\", refined_query=None)\n\n\nclass AdvancedRetriever:\n    \"\"\"\n    Combines all retrieval strategies into a configurable pipeline.\n    \n    Pipeline stages:\n    1. Query Expansion (optional)\n    2. Multi-query search (parallel)\n    3. Result merging and deduplication\n    4. Re-ranking\n    5. Self-reflection with retry (optional)\n    \"\"\"\n    \n    def __init__(\n        self,\n        llm_client: LLMClient,\n        search_fn,  # Function that takes (query, limit, veteran_id) -> results\n        get_text_fn,  # Function that takes (vet_id, resp_id) -> text\n        enable_expansion: bool = True,\n        enable_reranking: bool = True,\n        enable_reflection: bool = True,\n        max_retries: int = 1\n    ):\n        \"\"\"\n        Initialize advanced retriever.\n        \n        Args:\n            llm_client: LLM client for expansion/reflection\n            search_fn: Base search function\n            get_text_fn: Function to get text for a result\n            enable_expansion: Whether to expand queries\n            enable_reranking: Whether to re-rank results\n            enable_reflection: Whether to do self-reflection\n            max_retries: Maximum retries on poor results\n        \"\"\"\n        self.search_fn = search_fn\n        self.get_text_fn = get_text_fn\n        \n        self.expander = QueryExpander(llm_client) if enable_expansion else None\n        self.reranker = ResultReranker(llm_client) if enable_reranking else None\n        self.reflector = RetrievalReflector(llm_client) if enable_reflection else None\n        \n        self.enable_expansion = enable_expansion\n        self.enable_reranking = enable_reranking\n        self.enable_reflection = enable_reflection\n        self.max_retries = max_retries\n    \n    def search(\n        self,\n        query: str,\n        limit: int = 15,\n        veteran_id: Optional[str] = None,\n        _retry_count: int = 0\n    ) -> Tuple[List[Tuple[str, str, float, Any]], Dict[str, Any]]:\n        \"\"\"\n        Execute advanced search pipeline.\n        \n        Args:\n            query: Search query\n            limit: Maximum results to return\n            veteran_id: Optional filter to specific veteran\n            \n        Returns:\n            Tuple of (results, metadata)\n            - results: List of (vet_id, resp_id, score, segment_topic)\n            - metadata: Dict with pipeline info (queries_used, reranked, reflection, etc.)\n        \"\"\"\n        metadata = {\n            \"original_query\": query,\n            \"queries_used\": [query],\n            \"expanded\": False,\n            \"reranked\": False,\n            \"reflection_score\": None,\n            \"retried\": False,\n            \"retry_query\": None\n        }\n        \n        # Step 1: Query Expansion\n        queries = [query]\n        if self.enable_expansion and self.expander:\n            expansion = self.expander.expand(query)\n            queries = expansion.variants\n            metadata[\"queries_used\"] = queries\n            metadata[\"expanded\"] = len(queries) > 1\n        \n        # Step 2: Multi-query search\n        all_results = []\n        seen = set()\n        \n        for q in queries:\n            results = self.search_fn(q, limit=limit * 2, veteran_id=veteran_id)\n            for r in results:\n                key = (r[0], r[1])  # (vet_id, resp_id)\n                if key not in seen:\n                    seen.add(key)\n                    all_results.append(r)\n        \n        # Step 3: Re-ranking\n        if self.enable_reranking and self.reranker and all_results:\n            # Get texts for reranking\n            texts = []\n            for vet_id, resp_id, score, seg_topic in all_results:\n                text = self.get_text_fn(vet_id, resp_id)\n                texts.append(text)\n            \n            all_results = self.reranker.rerank(\n                query, \n                all_results, \n                texts, \n                top_k=limit * 2  # Keep extra for potential retry\n            )\n            metadata[\"reranked\"] = True\n        \n        # Step 4: Self-reflection\n        if self.enable_reflection and self.reflector and all_results:\n            # Get summaries for grading\n            summaries = []\n            for vet_id, resp_id, score, seg_topic in all_results[:5]:\n                text = self.get_text_fn(vet_id, resp_id)\n                summaries.append(text[:200])\n            \n            grade = self.reflector.grade(query, summaries)\n            metadata[\"reflection_score\"] = grade.score\n            metadata[\"reflection_reasoning\"] = grade.reasoning\n            \n            # Retry if poor quality and we haven't exhausted retries\n            if grade.score < 3 and grade.refined_query and _retry_count < self.max_retries:\n                metadata[\"retried\"] = True\n                metadata[\"retry_query\"] = grade.refined_query\n                \n                # Recursive call with refined query\n                retry_results, retry_meta = self.search(\n                    grade.refined_query,\n                    limit=limit,\n                    veteran_id=veteran_id,\n                    _retry_count=_retry_count + 1\n                )\n                \n                # Merge retry metadata\n                metadata[\"retry_metadata\"] = retry_meta\n                \n                # Combine results, preferring retry results\n                combined = []\n                seen = set()\n                for r in retry_results + all_results:\n                    key = (r[0], r[1])\n                    if key not in seen:\n                        seen.add(key)\n                        combined.append(r)\n                \n                all_results = combined\n        \n        return all_results[:limit], metadata\n"}},"jsonrpc":"2.0","id":9} { metadata: undefined }
