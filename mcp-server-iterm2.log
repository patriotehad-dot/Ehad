2025-12-20T17:14:31.872Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"file_path":"/Users/happyhawking/Documents/Projects/Current/writer/src/entity_command.py","content":"\"\"\"\nEntity Command for CLI - Cross-Reference Search\n\nAdd this to cli.py after the compare command.\n\"\"\"\n\n# ============================================================================\n# Entity Command (Cross-Reference Search)\n# ============================================================================\n\n@cli.command()\n@click.argument(\"query\")\n@click.option(\"--type\", \"-t\", \"entity_type\", \n              type=click.Choice([\"all\", \"person\", \"location\", \"unit\"]), \n              default=\"all\", help=\"Filter by entity type\")\n@click.option(\"--limit\", \"-l\", default=20, help=\"Maximum responses to show\")\ndef entity(query: str, entity_type: str, limit: int):\n    \"\"\"Cross-reference search: find an entity across all veterans.\n    \n    This is the \"Cross-Reference\" query mode - finding the same person,\n    place, or unit mentioned by different veterans.\n    \n    Examples:\n        oralhistory entity \"General Patton\"\n        oralhistory entity \"Bastogne\" --type location\n        oralhistory entity \"69th Tank Battalion\" --type unit\n    \"\"\"\n    try:\n        ctx = ProjectContext()\n    except ValueError:\n        console.print(\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\")\n        return\n    \n    storage = VeteranStorage(ctx)\n    veteran_ids = storage.list_veterans()\n    \n    if not veteran_ids:\n        console.print(\"[yellow]No veterans found. Run 'oralhistory ingest' to add transcripts.[/yellow]\")\n        return\n    \n    query_lower = query.lower()\n    \n    # Results structure: {veteran_id: {response_id: [{type, context, match, response}]}}\n    from collections import defaultdict\n    matches = defaultdict(lambda: defaultdict(list))\n    veteran_names = {}\n    veteran_units = {}\n    \n    # Also track relationship-level matches (synthesized across responses)\n    relationship_matches = defaultdict(list)  # {veteran_id: [Relationship, ...]}\n    \n    with Progress(\n        SpinnerColumn(),\n        TextColumn(\"[progress.description]{task.description}\"),\n        transient=True,\n    ) as progress:\n        task = progress.add_task(f\"Searching for '{query}'...\", total=len(veteran_ids))\n        \n        for vid in veteran_ids:\n            v = storage.load(vid)\n            if not v:\n                progress.advance(task)\n                continue\n            \n            veteran_names[vid] = v.name\n            veteran_units[vid] = v.unit\n            \n            # Check veteran-level relationships\n            for rel in v.relationships:\n                # Check all name variants\n                for name in rel.names + [rel.canonical]:\n                    if query_lower in name.lower():\n                        relationship_matches[vid].append(rel)\n                        break\n            \n            # Check each response's extracted entities\n            for r in v.responses:\n                if not r.extracted:\n                    continue\n                \n                ext = r.extracted\n                \n                # Check people\n                if entity_type in [\"all\", \"person\"]:\n                    for person in ext.people:\n                        if query_lower in person.name.lower():\n                            matches[vid][r.id].append({\n                                \"type\": \"person\",\n                                \"match\": person.name,\n                                \"context\": person.context or person.role or \"\",\n                                \"response\": r\n                            })\n                \n                # Check locations\n                if entity_type in [\"all\", \"location\"]:\n                    for loc in ext.locations:\n                        if query_lower in loc.lower():\n                            matches[vid][r.id].append({\n                                \"type\": \"location\",\n                                \"match\": loc,\n                                \"context\": ext.summary[:100] if ext.summary else \"\",\n                                \"response\": r\n                            })\n                \n                # Check units\n                if entity_type in [\"all\", \"unit\"]:\n                    for unit in ext.units:\n                        if query_lower in unit.lower():\n                            matches[vid][r.id].append({\n                                \"type\": \"unit\",\n                                \"match\": unit,\n                                \"context\": ext.summary[:100] if ext.summary else \"\",\n                                \"response\": r\n                            })\n                \n                # Also search in raw text for partial matches not caught by extraction\n                if entity_type == \"all\" and query_lower in r.veteran.lower():\n                    # Only add if we haven't already matched this response\n                    if not matches[vid][r.id]:\n                        matches[vid][r.id].append({\n                            \"type\": \"text\",\n                            \"match\": query,\n                            \"context\": ext.summary[:100] if ext.summary else r.veteran[:100],\n                            \"response\": r\n                        })\n            \n            progress.advance(task)\n    \n    # Count totals\n    total_veterans = len(matches) + len([v for v in relationship_matches if v not in matches])\n    total_responses = sum(len(resps) for resps in matches.values())\n    \n    if total_veterans == 0 and not relationship_matches:\n        console.print(f\"[yellow]No matches found for:[/yellow] {query}\")\n        console.print(f\"[dim]Try a different spelling or use --type to filter[/dim]\")\n        return\n    \n    # Display header\n    console.print(\"\")\n    console.print(Panel(\n        f\"[bold]ENTITY SEARCH:[/bold] \\\"{query}\\\" ({total_veterans} veterans, {total_responses} responses)\",\n        box=box.DOUBLE,\n        border_style=\"cyan\"\n    ))\n    console.print(\"\")\n    \n    # Display relationship-level matches first (these are synthesized/canonical)\n    if relationship_matches:\n        console.print(\"[bold cyan]RELATIONSHIPS (Synthesized)[/bold cyan]\")\n        console.print(\"\")\n        \n        rel_table = Table(show_header=True, header_style=\"bold\", box=box.ROUNDED)\n        rel_table.add_column(\"Veteran\", style=\"cyan\", width=20)\n        rel_table.add_column(\"Match\", style=\"yellow\", width=20)\n        rel_table.add_column(\"Role\", width=15)\n        rel_table.add_column(\"Context\", width=35)\n        rel_table.add_column(\"Sources\", style=\"dim\", width=12)\n        \n        for vid, rels in relationship_matches.items():\n            for rel in rels:\n                sources = \" \".join([f\"[{r}]\" for r in rel.response_ids[:3]])\n                if len(rel.response_ids) > 3:\n                    sources += f\" +{len(rel.response_ids) - 3}\"\n                \n                rel_table.add_row(\n                    veteran_names.get(vid, vid),\n                    rel.canonical,\n                    rel.role or \"[dim]—[/dim]\",\n                    rel.context[:35] + \"...\" if rel.context and len(rel.context) > 35 else (rel.context or \"[dim]—[/dim]\"),\n                    sources\n                )\n        \n        console.print(rel_table)\n        console.print(\"\")\n    \n    # Display response-level matches\n    if matches:\n        console.print(\"[bold cyan]RESPONSE MATCHES[/bold cyan]\")\n        console.print(\"\")\n        \n        responses_shown = 0\n        \n        for vid in sorted(matches.keys(), key=lambda x: len(matches[x]), reverse=True):\n            if responses_shown >= limit:\n                remaining = total_responses - responses_shown\n                console.print(f\"[dim]... and {remaining} more responses. Use --limit to see more.[/dim]\")\n                break\n            \n            # Veteran header\n            vet_name = veteran_names.get(vid, vid)\n            vet_unit = veteran_units.get(vid)\n            header = f\"[bold]{vet_name}[/bold]\"\n            if vet_unit:\n                header += f\" [dim]({vet_unit})[/dim]\"\n            \n            console.print(Panel(header, box=box.ROUNDED, border_style=\"cyan\"))\n            \n            for resp_id, match_list in matches[vid].items():\n                if responses_shown >= limit:\n                    break\n                \n                for match in match_list:\n                    response = match[\"response\"]\n                    \n                    # Type badge\n                    type_badge = {\n                        \"person\": \"[magenta]PERSON[/magenta]\",\n                        \"location\": \"[green]LOCATION[/green]\",\n                        \"unit\": \"[blue]UNIT[/blue]\",\n                        \"text\": \"[dim]TEXT[/dim]\"\n                    }.get(match[\"type\"], \"[dim]?[/dim]\")\n                    \n                    # Potential indicator\n                    potential = \"\"\n                    if response.extracted and response.extracted.writing_potential == WritingPotential.HIGH:\n                        potential = \" [yellow]★[/yellow]\"\n                    \n                    console.print(f\"  [{resp_id}] {type_badge} [yellow]{match['match']}[/yellow]{potential}\")\n                    \n                    if match[\"context\"]:\n                        console.print(f\"      [dim]{match['context']}[/dim]\")\n                    \n                    # Show snippet of the response\n                    snippet = response.veteran[:150].replace(\"\\n\", \" \")\n                    if len(response.veteran) > 150:\n                        snippet += \"...\"\n                    console.print(f\"      \\\"{snippet}\\\"\")\n                    console.print(\"\")\n                \n                responses_shown += 1\n            \n            console.print(\"\")\n    \n    # Quick actions\n    console.print(\"[dim]Quick actions:[/dim]\")\n    if matches:\n        first_vid = list(matches.keys())[0]\n        first_resp = list(matches[first_vid].keys())[0]\n        console.print(f\"[dim]  → View response: oralhistory view {first_vid} {first_resp}[/dim]\")\n        console.print(f\"[dim]  → See context: oralhistory context {first_vid} {first_resp}[/dim]\")\n    console.print(f\"[dim]  → Search semantically: oralhistory search \\\"{query}\\\"[/dim]\")\n"}},"jsonrpc":"2.0","id":51} { metadata: undefined }
