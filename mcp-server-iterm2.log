th = exporter.export_notable_stories()\n    console.print(f\"[green]Exported:[/green] {path}\")\n\n\n@export.command(name=\"timeline\")\n@click.option(\"--start\", help=\"Start date (e.g., 1944-06)\")\n@click.option(\"--end\", help=\"End date (e.g., 1944-09)\")\ndef export_timeline(start: Optional[str], end: Optional[str]):\n    \"\"\"Export timeline across all veterans.\"\"\"\n    ctx = get_context()\n    exporter = ExportGenerator(ctx)\n    path = exporter.export_timeline(start_date=start, end_date=end)\n    console.print(f\"[green]Exported:[/green] {path}\")\n\n\n# ============================================================================\n# Connections Command\n# ============================================================================\n\n@cli.command()\n@click.option(\"--search\", \"-s\", \"search_name\", help=\"Search for specific person\")\ndef connections(search_name: Optional[str]):\n    \"\"\"Find potential connections across veterans.\"\"\"\n    ctx = get_context()\n    storage = VeteranStorage(ctx)\n    \n    if search_name:\n        # Search for a specific person\n        console.print(f\"[bold]Searching for:[/bold] {search_name}\")\n        console.print(\"─\" * 40)\n        \n        search_lower = search_name.lower()\n        \n        for vet_id in storage.list_veterans():\n            vet = storage.load(vet_id)\n            if not vet:\n                continue\n            \n            for rel in vet.relationships:\n                for name in rel.names:\n                    if search_lower in name.lower():\n                        refs = \", \".join(f\"[{r}]\" for r in rel.response_ids)\n                        role = f\" ({rel.role})\" if rel.role else \"\"\n                        console.print(f\"[cyan]{vet.name}[/cyan]: {rel.canonical}{role} {refs}\")\n                        break\n        return\n    \n    # Find all potential connections\n    console.print(\"[bold]POTENTIAL CONNECTIONS[/bold]\")\n    console.print(\"─\" * 40)\n    \n