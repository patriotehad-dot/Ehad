, {para_count} paragraphs\")\n            except Exception as e:\n                progress.remove_task(task)\n                console.print(f\"[yellow]Warning:[/yellow] Embedding generation failed: {e}\")\n        \n    # Summary\n    console.print()\n    \n    if vet.verification_needed:\n        console.print(\"[bold yellow]Verification needed:[/bold yellow]\")\n        for item in vet.verification_needed:\n            console.print(f\"  - {item.issue}: {item.detail}\")\n        console.print()\n    \n    if vet.notable_stories:\n        console.print(\"[bold]Notable stories found:[/bold]\")\n        for story in vet.notable_stories[:5]:\n            potential = \"HIGH\" if story.writing_potential == WritingPotential.HIGH else story.writing_potential.value\n            console.print(f\"  - \\\"{story.title}\\\" ({potential})\")\n        console.print()\n    \n    console.print(f\"[bold green]Done![/bold green] Run [bold]oralhistory veteran {veteran_id}[/bold] to view profile.\")\n\n\n# ============================================================================\n# Search Command\n# ============================================================================\n\n@cli.command()\n@click.argument(\"query\")\n@click.option(\"--limit\", \"-l\", default=20, help=\"Max results\")\n@click.option(\"--veteran\", \"-v\", help=\"Filter to specific veteran\")\n@click.option(\"--chapter\", \"-c\", type=int, help=\"Filter to chapter\")\n@click.option(\"--topic\", \"-t\", help=\"Filter by topic\")\n@click.option(\"--potential\", \"-p\", type=click.Choice([\"low\", \"medium\", \"high\"]), help=\"Filter by writing potential\")\n@click.option(\"--export\", \"-e\", \"export_name\", help=\"Export results to file\")\ndef search(\n    query: str,\n    limit: int,\n    veteran: Optional[str],\n    chapter: Optional[int],\n    topic: Optional[str],\n    potential: Optional[str],\n    export_name: Optional[str]\n):\n    \"\"\"Search across all veteran testimonies.\n    \n    Performs hybrid semantic + keyword search.\n    \"\"\"\n    ctx = get_context()\n    \n    with Progress(\n        SpinnerColumn(),\n        TextColumn(\"[progress.description]{task.description}\"),\n        console=console,\n        transient=True\n    ) as progress:\n        task = progress.add_task(\"Searching...\", total=None)\n        \n        engine = SearchEngine(ctx)\n        results = engine.search(\n            query=query,\n            limit=limit,\n            veteran_id=veteran,\n            chapter=chapter,\n            topic=topic,\n            potential=potential\n        )\n        engine.close()\n    \n    # Display results\n    console.print()\n    console.print(Panel(\n        f\"[bold]SEARCH:[/bold] \\\"{query}\\\" ({results.veteran_count} veterans, {results.total_hits} responses)\",\n        box=box.DOUBLE\n    ))\n    console.print()\n    \n    if not results.hits:\n        console.print(\"[yellow]No results found.[/yellow]\")\n        return\n    \n    # Group by veteran\n    by_veteran = {}\n    for hit in results.hits:\n        if hit.veteran_id not in by_veteran:\n            by_veteran[hit.veteran_id] = {\n                \"name\": hit.veteran_name,\n                \"unit\": hit.unit,\n                \"rank\": hit.rank,\n                \"hits\": []\n            }\n        by_veteran[hit.veteran_id][\"hits\"].append(hit)\n    \n    for vet_id, data in by_veteran.items():\n        # Veteran header\n        header = f\"[bold]{data['name']}[/bold]\"\n        if data[\"unit\"] or data[\"rank\"]:\n            parts = [p for p in [data[\"unit\"], data[\"rank\"]] if p]\n            header += f\"\\n{' | '.join(parts)}\"\n        \n        console.print(Panel(header, box=box.ROUNDED))\n        \n        for hit in data[\"hits\"]:\n            response = hit.response\n            \n            # Response header\n            resp_header = f\"[bold][{response.id}][/bold]\"\n            if response.extracted:\n                if response.extracted.writing_potential == WritingPotential.HIGH:\n                    resp_header += \" [yellow]★ HIGH POTENTIAL[/yellow]\"\n                if response.extracted.summary:\n                    resp_header += f\"\\n{response.extracted.summary}\"\n            \n            if hit.chapter:\n                resp_header += f\"\\n[dim]Chapter: {hit.chapter}[/dim]\"\n            \n            console.print(resp_header)\n            console.print()\n            \n            # Question (truncated)\n            q = response.interviewer[:200] + \"...\" if len(response.interviewer) > 200 else response.interviewer\n            console.print(f\"[dim]Q: {q}[/dim]\")\n            console.print()\n            \n            # Answer (truncated)\n            a = response.veteran[:500] + \"...\" if len(response.veteran) > 500 else response.veteran\n            console.print(f\"[italic]\\\"{a}\\\"[/italic]\")\n            console.print()\n            console.print(\"─\" * 60)\n            console.print()\n    \n    # Export if requested\n    if export_name:\n        exporter = ExportGenerator(ctx)\n        path = exporter.export_search_results(results, export_name)\n        console.print(f\"[green]Exported:[/green] {path}\")\n\n\n# ============================================================================\n# Veterans Command\n# ============================================================================\n\n@cli.command()\ndef veterans():\n    \"\"\"List all veterans in the project.\"\"\"\n    ctx = get_context()\n    storage = VeteranStorage(ctx)\n    \n    veteran_ids = storage.list_veterans()\n    \n    if not veteran_ids:\n        console.print(\"[yellow]No veterans found.[/yellow]\")\n        console.print(\"Run [bold]oralhistory ingest[/bold] to add transcripts.\")\n        return\n    \n    table = Table(title=\"VETERANS\", box=box.ROUNDED)\n    table.add_column(\"ID\", style=\"cyan\")\n    table.add_column(\"Name\", style=\"bold\")\n    table.add_column(\"Unit\")\n    table.add_column(\"Responses\", justify=\"right\")\n    \n    for vet_id in veteran_ids:\n        vet = storage.load(vet_id)\n        if vet:\n            table.add_row(\n                vet_id,\n                vet.name,\n                vet.unit or \"\",\n                str(len(vet.responses))\n            )\n    \n    console.print(table)\n\n\n# ============================================================================\n# Veteran Command\n# ============================================================================\n\n@cli.command()\n@click.argument(\"veteran_id\")\n@click.option(\"--timeline\", is_flag=True, help=\"Show timeline only\")\n@click.option(\"--relationships\", is_flag=True, help=\"Show relationships only\")\n@click.option(\"--responses\", is_flag=True, help=\"Show all responses\")\n@click.option(\"--response\", \"-r\", help=\"Show specific response\")\ndef veteran(\n    veteran_id: str,\n    timeline: bool,\n    relationships: bool,\n    responses: bool,\n    response: Optional[str]\n):\n    \"\"\"Show veteran profile and transcript.\"\"\"\n    ctx = get_context()\n    storage = VeteranStorage(ctx)\n    \n    vet = storage.load(veteran_id)\n    if not vet:\n        console.print(f\"[red]Veteran not found:[/red] {veteran_id}\")\n        return\n    \n    # Show specific response\n    if response:\n        for r in vet.responses:\n            if r.id == response:\n                console.print(Panel(f\"[bold][{r.id}][/bold]\", box=box.DOUBLE))\n                console.print(f\"[bold]Q:[/bold] {r.interviewer}\")\n                console.print()\n                console.print(r.veteran)\n                \n                if r.extracted:\n                    console.print()\n                    console.print(\"[dim]Extracted metadata:[/dim]\")\n                    console.print(f\"  Summary: {r.extracted.summary}\")\n                    console.print(f\"  Topics: {', '.join(r.extracted.topics)}\")\n                    console.print(f\"  Potential: {r.extracted.writing_potential.value}\")\n                return\n        \n        console.print(f\"[red]Response not found:[/red] {response}\")\n        return\n    \n    # Header\n    console.print(Panel(f\"[bold]{vet.name}[/bold]\", box=box.DOUBLE))\n    \n    info_lines = []\n    if vet.unit:\n        info_lines.append(f\"[bold]Unit:[/bold] {vet.unit}\")\n    if vet.rank:\n        info_lines.append(f\"[bold]Rank:[/bold] {vet.rank}\")\n    if vet.service_dates and (vet.service_dates.start or vet.service_dates.end):\n        info_lines.append(f\"[bold]Service:[/bold] {vet.service_dates.start or '?'} - {vet.service_dates.end or '?'}\")\n    if vet.source:\n        info_lines.append(f\"[bold]Source:[/bold] {vet.source.file}\")\n    \n    for line in info_lines:\n        console.print(line)\n    console.print()\n    \n    # Timeline\n    if timeline or not (relationships or responses):\n        if vet.timeline:\n            console.print(\"[bold]TIMELINE[/bold]\")\n            console.print(\"─\" * 40)\n            for event in vet.timeline:\n                marker = \"~\" if event.confidence.value == \"approximate\" else \"\"\n                refs = \", \".join(f\"[{r}]\" for r in event.response_ids)\n                console.print(f\"{event.date}{marker}  {event.event} {refs}\")\n                if event.note:\n                    console.print(f\"          [yellow]⚠ {event.note}[/yellow]\")\n            console.print()\n    \n    # Relationships\n    if relationships or not (timeline or responses):\n        if vet.relationships:\n            console.print(\"[bold]RELATIONSHIPS[/bold]\")\n            console.print(\"─\" * 40)\n            for rel in vet.relationships:\n                role = f\" ({rel.role})\" if rel.role else \"\"\n                refs = \", \".join(f\"[{r}]\" for r in rel.response_ids)\n                console.print(f\"{rel.canonical}{role} - {refs}\")\n            console.print()\n    \n    # Notable Stories\n    if not (timeline or relationships or responses):\n        if vet.notable_stories:\n            console.print(\"[bold]NOTABLE STORIES[/bold]\")\n            console.print(\"─\" * 40)\n            for story in vet.notable_stories:\n                refs = \", \".join(f\"[{r}]\" for r in story.response_ids)\n                console.print(f\"★ {story.title} {refs}\")\n            console.print()\n        \n        if vet.verification_needed:\n            console.print(\"[bold yellow]VERIFICATION NEEDED[/bold yellow]\")\n            console.print(\"─\" * 40)\n            for item in vet.verification_needed:\n                refs = \", \".join(f\"[{r}]\" for r in item.response_ids)\n                console.print(f\"⚠ {item.issue}: {item.detail} {refs}\")\n            console.print()\n    \n    # All responses\n    if responses:\n        console.print(\"[bold]ALL RESPONSES[/bold]\")\n        console.print(\"─\" * 40)\n        for r in vet.responses:\n            summary = r.extracted.summary if r.extracted else \"\"\n            potential = \"\"\n            if r.extracted and r.extracted.writing_potential == WritingPotential.HIGH:\n                potential = \" ★\"\n            console.print(f\"[{r.id}]{potential} {summary[:60]}...\")\n        console.print()\n\n\n# ============================================================================\n# Annotate Command\n# ============================================================================\n\n@cli.command()\n@click.argument(\"veteran_id\")\n@click.argument(\"response_id\", required=False)\n@click.option(\"--note\", \"-n\", help=\"Add note to response\")\n@click.option(\"--chapter\", \"-c\", type=int, help=\"Assign to chapter\")\n@click.option(\"--flag\", \"-f\", help=\"Add flag\")\n@click.option(\"--remove-flag\", help=\"Remove flag\")\n@click.option(\"--veteran-note\", help=\"Add note about veteran (not specific response)\")\n@click.option(\"--todo\", help=\"Add research todo\")\ndef annotate(\n    veteran_id: str,\n    response_id: Optional[str],\n    note: Optional[str],\n    chapter: Optional[int],\n    flag: Optional[str],\n    remove_flag: Optional[str],\n    veteran_note: Optional[str],\n    todo: Optional[str]\n):\n    \"\"\"Add annotations to a veteran or response.\"\"\"\n    ctx = get_context()\n    storage = AnnotationStorage(ctx)\n    vet_storage = VeteranStorage(ctx)\n    \n    # Check veteran exists\n    if not vet_storage.exists(veteran_id):\n        console.print(f\"[red]Veteran not found:[/red] {veteran_id}\")\n        return\n    \n    if veteran_note:\n        storage.add_veteran_note(veteran_id, veteran_note)\n        console.print(f\"[green]Added veteran note[/green]\")\n    \n    if todo:\n        storage.add_todo(veteran_id, todo)\n        console.print(f\"[green]Added todo[/green]\")\n    \n    if response_id:\n        if note:\n            storage.add_response_note(veteran_id, response_id, note)\n            console.print(f\"[green]Added note to [{response_id}][/green]\")\n        \n        if chapter is not None:\n            storage.set_chapter(veteran_id, response_id, chapter)\n            console.print(f\"[green]Assigned [{response_id}] to chapter {chapter}[/green]\")\n        \n        if flag:\n            storage.add_flag(veteran_id, response_id, flag)\n            console.print(f\"[green]Added flag '{flag}' to [{response_id}][/green]\")\n        \n        if remove_flag:\n            storage.remove_flag(veteran_id, response_id, remove_flag)\n            console.print(f\"[green]Removed flag '{remove_flag}' from [{response_id}][/green]\")\n\n\n# ============================================================================\n# Annotations Command\n# ============================================================================\n\n@cli.command()\n@click.argument(\"veteran_id\", required=False)\n@click.option(\"--chapter\", \"-c\", type=int, help=\"Show annotations for chapter\")\n@click.option(\"--flags\", is_flag=True, help=\"Show all flagged responses\")\ndef annotations(\n    veteran_id: Optional[str],\n    chapter: Optional[int],\n    flags: bool\n):\n    \"\"\"View annotations.\"\"\"\n    ctx = get_context()\n    storage = AnnotationStorage(ctx)\n    \n    if chapter is not None:\n        # Show chapter annotations\n        chapter_data = storage.get_chapter_responses(chapter)\n        \n        if not chapter_data:\n            console.print(f\"[yellow]No responses assigned to chapter {chapter}[/yellow]\")\n            return\n        \n        console.print(f\"[bold]Chapter {chapter} Responses[/bold]\")\n        console.print(\"─\" * 40)\n        \n        for vet_id, resp_ids in chapter_data.items():\n            console.print(f\"[cyan]{vet_id}[/cyan]: {', '.join(resp_ids)}\")\n        return\n    \n    if flags:\n        # Show flagged responses\n        flagged = storage.get_flagged_responses()\n        \n        if not flagged:\n            console.print(\"[yellow]No flagged responses[/yellow]\")\n            return\n        \n        console.print(\"[bold]Flagged Responses[/bold]\")\n        console.print(\"─\" * 40)\n        \n        for vet_id, resp_flags in flagged.items():\n            console.print(f\"[cyan]{vet_id}[/cyan]:\")\n            for resp_id, flag_list in resp_flags.items():\n                console.print(f\"  [{resp_id}]: {', '.join(flag_list)}\")\n        return\n    \n    if veteran_id:\n        # Show veteran annotations\n        annot = storage.load(veteran_id)\n        \n        console.print(f\"[bold]Annotations for {veteran_id}[/bold]\")\n        console.print(\"─\" * 40)\n        \n        if annot.veteran_notes:\n            console.print(\"[bold]Veteran Notes:[/bold]\")\n            for note in annot.veteran_notes:\n                console.print(f\"  {note.date}: {note.text}\")\n            console.print()\n        \n        if annot.research_todos:\n            console.print(\"[bold]Research Todos:[/bold]\")\n            for todo_item in annot.research_todos:\n                console.print(f\"  - {todo_item}\")\n            console.print()\n        \n        if annot.response_annotations:\n            console.print(\"[bold]Response Annotations:[/bold]\")\n            for resp_id, resp_annot in annot.response_annotations.items():\n                parts = []\n                if resp_annot.chapter:\n                    parts.append(f\"Chapter {resp_annot.chapter}\")\n                if resp_annot.flags:\n                    parts.append(f\"Flags: {', '.join(resp_annot.flags)}\")\n                console.print(f\"  [{resp_id}]: {'; '.join(parts)}\")\n                for note in resp_annot.notes:\n                    console.print(f\"    {note.date}: {note.text}\")\n\n\n# ============================================================================\n# Chapter Command\n# ============================================================================\n\n@cli.command()\n@click.argument(\"number\", type=int)\n@click.option(\"--export\", \"-e\", is_flag=True, help=\"Export chapter material\")\ndef chapter(number: int, export: bool):\n    \"\"\"View or export chapter material.\"\"\"\n    ctx = get_context()\n    \n    if export:\n        exporter = ExportGenerator(ctx)\n        path = exporter.export_chapter(number)\n        console.print(f\"[green]Exported:[/green] {path}\")\n        return\n    \n    # View chapter\n    annot_storage = AnnotationStorage(ctx)\n    vet_storage = VeteranStorage(ctx)\n    \n    chapter_data = annot_storage.get_chapter_responses(number)\n    \n    if not chapter_data:\n        console.print(f\"[yellow]No responses assigned to chapter {number}[/yellow]\")\n        return\n    \n    total_responses = sum(len(r) for r in chapter_data.values())\n    \n    console.print(Panel(\n        f\"[bold]CHAPTER {number}[/bold] ({total_responses} responses from {len(chapter_data)} veterans)\",\n        box=box.DOUBLE\n    ))\n    console.print()\n    \n    for vet_id, resp_ids in chapter_data.items():\n        vet = vet_storage.load(vet_id)\n        if not vet:\n            continue\n        \n        