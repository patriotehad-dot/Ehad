t_topic)\\n        texts: List[str],  # The actual text content for each result\\n        top_k: int = 15,\\n        use_cross_encoder: bool = True\\n    ) -> List[Tuple[str, str, float, Any]]:\\n        \\\"\\\"\\\"\\n        Re-rank results by relevance to query.\\n        \\n        Args:\\n            query: Search query\\n            results: Original search results (vet_id, resp_id, score, segment_topic)\\n            texts: Text content corresponding to each result\\n            top_k: Number of results to return\\n            use_cross_encoder: Try to use cross-encoder first (faster, cheaper)\\n            \\n        Returns:\\n            Re-ranked results with updated scores\\n        \\\"\\\"\\\"\\n        if not results:\\n            return []\\n        \\n        # Try cross-encoder first (faster, no API cost)\\n        if use_cross_encoder:\\n            encoder = self._get_cross_encoder()\\n            if encoder and encoder is not False:\\n                return self._rerank_with_cross_encoder(query, results, texts, top_k, encoder)\\n        \\n        # Fall back to LLM-based reranking\\n        return self._rerank_with_llm(query, results, texts, top_k)\\n    \\n    def _rerank_with_cross_encoder(\\n        self,\\n        query: str,\\n        results: List[Tuple[str, str, float, Any]],\\n        texts: List[str],\\n        top_k: int,\\n        encoder\\n    ) -> List[Tuple[str, str, float, Any]]:\\n        \\\"\\\"\\\"Re-rank using cross-encoder model.\\\"\\\"\\\"\\n        # Create query-document pairs\\n        pairs = [(query, text[:1000]) for text in texts]  # Truncate for efficiency\\n        \\n        # Score all pairs\\n        scores = encoder.predict(pairs)\\n        \\n        # Combine with results and sort\\n        scored = list(zip(results, scores))\\n        scored.sort(key=lambda x: x[1], reverse=True)\\n        \\n        # Return top_k with updated scores\\n        return [\\n            (r[0], r[1], float(score), r[3])  # Replace original score with rerank score\\n            for r, score in scored[:top_k]\\n        ]\\n    \\n    def _rerank_with_llm(\\n        self,\\n        query: str,\\n        results: List[Tuple[str, str, float, Any]],\\n        texts: List[str],\\n        top_k: int\\n    ) -> List[Tuple[str, str, float, Any]]:\\n        \\\"\\\"\\\"Re-rank using LLM scoring.\\\"\\\"\\\"\\n        # Format results for prompt\\n        results_text = \\\"\\\\n\\\\n\\\".join([\\n            f\\\"[{i+1}] {text[:500]}...\\\" if len(text) > 500 else f\\\"[{i+1}] {text}\\\"\\n            for i, text in enumerate(texts)\\n        ])\\n        \\n        prompt = self.RERANK_PROMPT.format(query=query, results=results_text)\\n        \\n        try:\\n            response = self.llm.complete(prompt, max_tokens=200)\\n            \\n            # Parse JSON\\n            response = response.strip()\\n            if response.startswith(\\\"```\\\"):\\n                response = response.split(\\\"```\\\")[1]\\n                if response.startswith(\\\"json\\\"):\\n                    response = response[4:]\\n            \\n            data = json.loads(response)\\n            scores = data.get(\\\"scores\\\", [])\\n            \\n            # Combine with results\\n            if len(scores) == len(results):\\n                scored = list(zip(results, scores))\\n                scored.sort(key=lambda x: x[1], reverse=True)\\n                return [\\n                    (r[0], r[1], float(score), r[3])\\n                    for r, score in scored[:top_k]\\n                ]\\n        except Exception:\\n            pass\\n        \\n        # Fallback: return original order\\n        return results[:top_k]\\n\\n\\nclass RetrievalReflector:\\n\",\"file_size_bytes\":16229,\"content_length\":5166}"},"isError":false}} { metadata: undefined }
