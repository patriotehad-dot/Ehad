2025-12-20T17:27:52.809Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":70,"result":{"content":[{"type":"text","text":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/search.py\",\"content\":\"\\\"\\\"\\\"\\nSearch functionality for the Oral History Research System.\\n\\nProvides semantic and hybrid search across veteran testimonies.\\nUses SQLite with optimized vector search.\\n\\\"\\\"\\\"\\n\\nimport os\\nimport sqlite3\\nimport random\\nfrom typing import List, Optional, Dict, Any, Tuple\\nfrom pathlib import Path\\nimport json\\n\\nimport numpy as np\\n\\nfrom .models import (\\n    Veteran, Response, SearchHit, SearchResults,\\n    WritingPotential, VeteranAnnotations\\n)\\nfrom .config import ProjectContext, get_api_key\\nfrom .storage import VeteranStorage, AnnotationStorage\\n\\n\\n# Cached Portkey client for embeddings\\n_embeddings_client = None\\n\\n\\ndef get_embeddings_client():\\n    \\\"\\\"\\\"Get Portkey client for embeddings.\\\"\\\"\\\"\\n    global _embeddings_client\\n    \\n    if _embeddings_client is not None:\\n        return _embeddings_client\\n    \\n    try:\\n        from portkey_ai import Portkey\\n    except ImportError:\\n        raise ImportError(\\\"portkey-ai package not installed. Run: pip install portkey-ai\\\")\\n    \\n    api_key = get_api_key(\\\"portkey\\\")\\n    if not api_key:\\n        raise ValueError(\\\"PORTKEY_API_KEY not set\\\")\\n    \\n    _embeddings_client = Portkey(api_key=api_key)\\n    return _embeddings_client\\n\\n\\ndef generate_embedding(text: str, model: Optional[str] = None) -> List[float]:\\n    \\\"\\\"\\\"\\n    Generate embedding for text using Portkey.\\n    \\n    Args:\\n        text: Text to embed\\n        model: Embedding model name (uses PORTKEY_EMBEDDING_MODEL if not provided)\\n        \\n    Returns:\\n        Embedding vector\\n    \\\"\\\"\\\"\\n    client = get_embeddings_client()\\n    \\n    # Get model from env if not provided\\n    model = model or os.getenv(\\\"PORTKEY_EMBEDDING_MODEL\\\")\\n    if not model:\\n        raise ValueError(\\\"PORTKEY_EMBEDDING_MODEL not set. Please set the environment variable or provide a model.\\\")\\n    \\n    # Truncate if too long (max ~8000 tokens for embedding models)\\n    if len(text) > 30000:\\n        text = text[:30000]\\n    \\n    # Portkey requires input as a list\\n    response = client.embeddings.create(\\n        input=[text],\\n        model=model\\n    )\\n    \\n    # Extract embedding from response\\n    if response and hasattr(response, 'data') and len(response.data) > 0:\\n        return response.data[0].embedding\\n    \\n    raise ValueError(\\\"Invalid embedding response structure from Portkey\\\")\\n\\n\\nclass SearchIndex:\\n    \\\"\\\"\\\"\\n    Search index using SQLite with sqlite-vss.\\n    \\n    Stores embeddings for paragraphs and full responses.\\n    Supports hybrid search (semantic + keyword).\\n    \\\"\\\"\\\"\\n    \\n    def __init__(self, db_path: Path, embedding_dim: int = 1536):\\n        \\\"\\\"\\\"\\n        Initialize search index.\\n        \\n        Args:\\n            db_path: Path to SQLite database\\n            embedding_dim: Dimension of embedding vectors\\n        \\\"\\\"\\\"\\n        self.db_path = db_path\\n        self.embedding_dim = embedding_dim\\n        self._conn = None\\n        self._vss_available = False\\n    \\n    def _get_conn(self) -> sqlite3.Connection:\\n        \\\"\\\"\\\"Get database connection, creating tables if needed.\\\"\\\"\\\"\\n        if self._conn is None:\\n            self.db_path.parent.mkdir(parents=True, exist_ok=True)\\n            self._conn = sqlite3.connect(str(self.db_path))\\n            self._conn.row_factory = sqlite3.Row\\n            self._init_tables()\\n        return self._conn\\n    \\n    def _init_tables(self):\\n        \\\"\\\"\\\"Initialize database tables.\\\"\\\"\\\"\\n        conn = self._conn\\n        \\n        # Check if sqlite-vss is available\\n        try:\\n            conn.enable_load_extension(True)\\n            # Try to load vss extension\\n            try:\\n                conn.load_extension(\\\"vss0\\\")\\n                self._vss_available = True\\n            except Exception:\\n                # VSS not available, fall back to basic FTS\\n                self._vss_available = False\\n        except Exception:\\n            self._vss_available = False\\n        \\n        # Core tables\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TABLE IF NOT EXISTS paragraphs (\\n                id TEXT PRIMARY KEY,\\n                veteran_id TEXT NOT NULL,\\n                response_id TEXT NOT NULL,\\n                text TEXT NOT NULL,\\n                embedding BLOB\\n            )\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TABLE IF NOT EXISTS responses (\\n                id TEXT PRIMARY KEY,\\n                veteran_id TEXT NOT NULL,\\n                full_text TEXT NOT NULL,\\n                embedding BLOB\\n            )\\n        \\\"\\\"\\\")\\n        \\n        # FTS for keyword search (always available)\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE VIRTUAL TABLE IF NOT EXISTS paragraphs_fts USING fts5(\\n                id, veteran_id, response_id, text,\\n                content=paragraphs,\\n                content_rowid=rowid\\n            )\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE VIRTUAL TABLE IF NOT EXISTS responses_fts USING fts5(\\n                id, veteran_id, full_text,\\n                content=responses,\\n                content_rowid=rowid\\n            )\\n        \\\"\\\"\\\")\\n        \\n        # Triggers to keep FTS in sync\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS paragraphs_ai AFTER INSERT ON paragraphs BEGIN\\n                INSERT INTO paragraphs_fts(rowid, id, veteran_id, response_id, text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.response_id, new.text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS paragraphs_ad AFTER DELETE ON paragraphs BEGIN\\n                INSERT INTO paragraphs_fts(paragraphs_fts, rowid, id, veteran_id, response_id, text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.response_id, old.text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS paragraphs_au AFTER UPDATE ON paragraphs BEGIN\\n                INSERT INTO paragraphs_fts(paragraphs_fts, rowid, id, veteran_id, response_id, text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.response_id, old.text);\\n                INSERT INTO paragraphs_fts(rowid, id, veteran_id, response_id, text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.response_id, new.text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS responses_ai AFTER INSERT ON responses BEGIN\\n                INSERT INTO responses_fts(rowid, id, veteran_id, full_text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.full_text);\\n            END\\n        \\\"\\\"\\\")\\n\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS responses_ad AFTER DELETE ON responses BEGIN\\n                INSERT INTO responses_fts(responses_fts, rowid, id, veteran_id, full_text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.full_text);\\n            END\\n        \\\"\\\"\\\")\\n\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS responses_au AFTER UPDATE ON responses BEGIN\\n                INSERT INTO responses_fts(responses_fts, rowid, id, veteran_id, full_text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.full_text);\\n                INSERT INTO responses_fts(rowid, id, veteran_id, full_text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.full_text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        # Repair existing indexes if out of sync\\n        try:\\n            conn.execute(\\\"INSERT INTO paragraphs_fts(paragraphs_fts) VALUES('rebuild')\\\")\\n            conn.execute(\\\"INSERT INTO responses_fts(responses_fts) VALUES('rebuild')\\\")\\n        except sqlite3.Error:\\n            pass # Ignore if rebuild fails (e.g. extension not supporting it)\\n        \\n        # Indexes for faster filtering by veteran_id\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE INDEX IF NOT EXISTS idx_paragraphs_veteran_id \\n            ON paragraphs(veteran_id)\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE INDEX IF NOT EXISTS idx_responses_veteran_id \\n            ON responses(veteran_id)\\n        \\\"\\\"\\\")\\n        \\n        conn.commit()\\n    \\n    def index_veteran(self, veteran: Veteran, generate_embeddings: bool = True):\\n        \\\"\\\"\\\"\\n        Index a veteran's responses and paragraphs.\\n        \\n        Args:\\n            veteran: Veteran to index\\n            generate_embeddings: Whether to generate embeddings (requires API)\\n        \\\"\\\"\\\"\\n        conn = self._get_conn()\\n        \\n        # Delete existing entries for this veteran\\n        conn.execute(\\\"DELETE FROM paragraphs WHERE veteran_id = ?\\\", (veteran.id,))\\n        conn.execute(\\\"DELETE FROM responses WHERE veteran_id = ?\\\", (veteran.id,))\\n        \\n        for response in veteran.responses:\\n            # Index full response\\n            full_text = f\\\"Q: {response.interviewer}\\\\nA: {response.veteran}\\\"\\n            \\n            embedding = None\\n            if generate_embeddings:\\n                try:\\n                    embedding = generate_embedding(full_text)\\n                    embedding = self._serialize_embedding(embedding)\\n                except Exception:\\n                    pass  # Skip embedding on error\\n            \\n            conn.execute(\\\"\\\"\\\"\\n                INSERT INTO responses (id, veteran_id, full_text, embedding)\\n                VALUES (?, ?, ?, ?)\\n            \\\"\\\"\\\", (\\n                f\\\"{veteran.id}:{response.id}\\\",\\n                veteran.id,\\n                full_text,\\n                embedding\\n            ))\\n            \\n            # Index paragraphs\\n            for para in response.paragraphs:\\n                para_embedding = None\\n                if generate_embeddings:\\n                    try:\\n                        para_embedding = generate_embedding(para.text)\\n                        para_embedding = self._serialize_embedding(para_embedding)\\n                    except Exception:\\n                        pass\\n                \\n                conn.execute(\\\"\\\"\\\"\\n                    INSERT INTO paragraphs (id, veteran_id, response_id, text, embedding)\\n                    VALUES (?, ?, ?, ?, ?)\\n                \\\"\\\"\\\", (\\n                    f\\\"{veteran.id}:{para.id}\\\",\\n                    veteran.id,\\n                    response.id,\\n                    para.text,\\n                    para_embedding\\n                ))\\n        \\n        conn.commit()\\n    \\n    def _serialize_embedding(self, embedding: List[float]) -> bytes:\\n        \\\"\\\"\\\"Serialize embedding to bytes using numpy for efficiency.\\\"\\\"\\\"\\n        return np.array(embedding, dtype=np.float32).tobytes()\\n    \\n    def _deserialize_embedding(self, data: bytes) -> np.ndarray:\\n        \\\"\\\"\\\"Deserialize embedding from bytes to numpy array.\\\"\\\"\\\"\\n        return np.frombuffer(data, dtype=np.float32)\\n    \\n    def _cosine_similarity(self, a: np.ndarray, b: np.ndarray) -> float:\\n        \\\"\\\"\\\"Calculate cosine similarity between two vectors using numpy.\\\"\\\"\\\"\\n        # Ensure numpy arrays\\n        if not isinstance(a, np.ndarray):\\n            a = np.array(a, dtype=np.float32)\\n        if not isinstance(b, np.ndarray):\\n            b = np.array(b, dtype=np.float32)\\n        \\n        dot = np.dot(a, b)\\n        norm_a = np.linalg.norm(a)\\n        norm_b = np.linalg.norm(b)\\n        \\n        if norm_a == 0 or norm_b == 0:\\n            return 0.0\\n        return float(dot / (norm_a * norm_b))\\n    \\n    def _batch_cosine_similarity(self, query: np.ndarray, embeddings: np.ndarray) -> np.ndarray:\\n        \\\"\\\"\\\"\\n        Calculate cosine similarity between a query and multiple embeddings.\\n        Uses vectorized numpy operations for speed.\\n        \\n        Args:\\n            query: Query embedding (1D array)\\n            embeddings: Matrix of embeddings (2D array, one per row)\\n            \\n        Returns:\\n            Array of similarity scores\\n        \\\"\\\"\\\"\\n        # Normalize query\\n        query_norm = np.linalg.norm(query)\\n        if query_norm == 0:\\n            return np.zeros(len(embeddings))\\n        query_normalized = query / query_norm\\n        \\n        # Normalize embeddings\\n        norms = np.linalg.norm(embeddings, axis=1, keepdims=True)\\n        norms[norms == 0] = 1  # Avoid division by zero\\n        embeddings_normalized = embeddings / norms\\n        \\n        # Compute all similarities at once\\n        return embeddings_normalized @ query_normalized\\n    \\n    def _get_paragraph_count(self, veteran_id: Optional[str] = None) -> int:\\n        \\\"\\\"\\\"Get count of paragraphs with embeddings.\\\"\\\"\\\"\\n        conn = self._get_conn()\\n        if veteran_id:\\n            result = conn.execute(\\n                \\\"SELECT COUNT(*) FROM paragraphs WHERE embedding IS NOT NULL AND veteran_id = ?\\\",\\n                (veteran_id,)\\n            ).fetchone()\\n        else:\\n            result = conn.execute(\\n                \\\"SELECT COUNT(*) FROM paragraphs WHERE embedding IS NOT NULL\\\"\\n            ).fetchone()\\n        return result[0] if result else 0\\n    \\n    def search_semantic(\\n        self, \\n        query: str, \\n        limit: int = 20,\\n        veteran_id: Optional[str] = None,\\n        approximate: bool = True,\\n        sample_ratio: float = 0.2\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Search by semantic similarity with optimizations.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            veteran_id: Optional filter to specific veteran\\n            approximate: Use approximate search for large datasets (>5000 paragraphs)\\n            sample_ratio: Sampling ratio for approximate search (default 20%)\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        conn = self._get_conn()\\n        \\n        # Generate query embedding\\n        query_embedding = np.array(generate_embedding(query), dtype=np.float32)\\n        \\n        # Check if we should use approximate search\\n        paragraph_count = self._get_paragraph_count(veteran_id)\\n        use_approximate = approximate and paragraph_count > 5000\\n        \\n        # Get paragraphs with embeddings\\n        if veteran_id:\\n            base_query = \\\"\\\"\\\"\\n                SELECT id, veteran_id, response_id, embedding\\n                FROM paragraphs\\n                WHERE embedding IS NOT NULL AND veteran_id = ?\\n            \\\"\\\"\\\"\\n            params = (veteran_id,)\\n        else:\\n            base_query = \\\"\\\"\\\"\\n                SELECT id, veteran_id, response_id, embedding\\n                FROM paragraphs\\n                WHERE embedding IS NOT NULL\\n            \\\"\\\"\\\"\\n            params = ()\\n        \\n        # For approximate search, randomly sample a subset\\n        if use_approximate:\\n            # First pass: sample subset for initial ranking\\n            rows = conn.execute(base_query, params).fetchall()\\n            sample_size = max(int(len(rows) * sample_ratio), limit * 10)\\n            sampled_rows = random.sample(rows, min(sample_size, len(rows)))\\n            \\n            # Calculate similarities for sampled subset\\n            initial_results = self._calculate_similarities_batch(\\n                query_embedding, sampled_rows\\n            )\\n            \\n            # Get top candidates from sample\\n            initial_results.sort(key=lambda x: x[2], reverse=True)\\n            top_response_ids = set()\\n            for _, resp_id, _ in initial_results[:limit * 3]:\\n                top_response_ids.add(resp_id)\\n            \\n            # Second pass: refine with full search on candidate responses\\n            candidate_rows = [r for r in rows if r[\\\"response_id\\\"] in top_response_ids]\\n            results = self._calculate_similarities_batch(query_embedding, candidate_rows)\\n        else:\\n            # Full search for smaller datasets\\n            rows = conn.execute(base_query, params).fetchall()\\n            results = self._calculate_similarities_batch(query_embedding, rows)\\n        \\n        # Sort by score and dedupe by response\\n        results.sort(key=lambda x: x[2], reverse=True)\\n        \\n        seen_responses = set()\\n        deduped = []\\n        for vet_id, resp_id, score in results:\\n            key = f\\\"{vet_id}:{resp_id}\\\"\\n            if key not in seen_responses:\\n                seen_responses.add(key)\\n                deduped.append((vet_id, resp_id, score))\\n                if len(deduped) >= limit:\\n                    break\\n        \\n        return deduped\\n    \\n    def _calculate_similarities_batch(\\n        self, \\n        query_embedding: np.ndarray, \\n        rows: List[sqlite3.Row]\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Calculate similarities for a batch of rows using vectorized operations.\\n        \\n        Args:\\n            query_embedding: Query embedding as numpy array\\n            rows: Database rows with embeddings\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        if not rows:\\n            return []\\n        \\n        # Batch deserialize embeddings\\n        embeddings = []\\n        metadata = []\\n        \\n        for row in rows:\\n            if row[\\\"embedding\\\"]:\\n                emb = self._deserialize_embedding(row[\\\"embedding\\\"])\\n                embeddings.append(emb)\\n                metadata.append((row[\\\"veteran_id\\\"], row[\\\"response_id\\\"]))\\n        \\n        if not embeddings:\\n            return []\\n        \\n        # Stack into matrix and compute all similarities at once\\n        embeddings_matrix = np.vstack(embeddings)\\n        scores = self._batch_cosine_similarity(query_embedding, embeddings_matrix)\\n        \\n        # Build results\\n        results = [\\n            (meta[0], meta[1], float(score))\\n            for meta, score in zip(metadata, scores)\\n        ]\\n        \\n        return results\\n    \\n    def search_keyword(\\n        self, \\n        query: str, \\n        limit: int = 20,\\n        veteran_id: Optional[str] = None\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Search by keyword/FTS.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            veteran_id: Optional filter to specific veteran\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        conn = self._get_conn()\\n        \\n        # Escape special FTS5 characters\\n        safe_query = query.replace('\\\"', '\\\"\\\"')\\n        \\n        if veteran_id:\\n            rows = conn.execute(\\\"\\\"\\\"\\n                SELECT veteran_id, response_id, rank\\n                FROM paragraphs_fts\\n                WHERE paragraphs_fts MATCH ?\\n                AND veteran_id = ?\\n                ORDER BY rank\\n                LIMIT ?\\n            \\\"\\\"\\\", (safe_query, veteran_id, limit * 2)).fetchall()\\n        else:\\n            rows = conn.execute(\\\"\\\"\\\"\\n                SELECT veteran_id, response_id, rank\\n                FROM paragraphs_fts\\n                WHERE paragraphs_fts MATCH ?\\n                ORDER BY rank\\n                LIMIT ?\\n            \\\"\\\"\\\", (safe_query, limit * 2)).fetchall()\\n        \\n        # Dedupe by response\\n        seen_responses = set()\\n        results = []\\n        for row in rows:\\n            key = f\\\"{row['veteran_id']}:{row['response_id']}\\\"\\n            if key not in seen_responses:\\n                seen_responses.add(key)\\n                # Convert FTS rank to similarity-like score (higher is better)\\n                score = 1.0 / (1.0 + abs(row[\\\"rank\\\"]))\\n                results.append((row[\\\"veteran_id\\\"], row[\\\"response_id\\\"], score))\\n                if len(results) >= limit:\\n                    break\\n        \\n        return results\\n    \\n    def search_hybrid(\\n        self, \\n        query: str, \\n        limit: int = 20,\\n        hybrid_weight: float = 0.7,\\n        veteran_id: Optional[str] = None\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Hybrid search combining semantic and keyword.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            hybrid_weight: Weight for semantic (0=keyword only, 1=semantic only)\\n            veteran_id: Optional filter to specific veteran\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        # Get both result sets\\n        try:\\n            semantic_results = self.search_semantic(query, limit=limit*2, veteran_id=veteran_id)\\n        except Exception:\\n            semantic_results = []\\n        \\n        keyword_results = self.search_keyword(query, limit=limit*2, veteran_id=veteran_id)\\n        \\n        # Combine scores\\n        scores = {}\\n        \\n        # Semantic scores\\n        for vet_id, resp_id, score in semantic_results:\\n            key = f\\\"{vet_id}:{resp_id}\\\"\\n            scores[key] = scores.get(key, 0) + score * hybrid_weight\\n        \\n        # Keyword scores\\n        for vet_id, resp_id, score in keyword_results:\\n            key = f\\\"{vet_id}:{resp_id}\\\"\\n            scores[key] = scores.get(key, 0) + score * (1 - hybrid_weight)\\n        \\n        # Sort and return\\n        results = []\\n        for key, score in sorted(scores.items(), key=lambda x: x[1], reverse=True)[:limit]:\\n            vet_id, resp_id = key.split(\\\":\\\", 1)\\n            results.append((vet_id, resp_id, score))\\n        \\n        return results\\n    \\n    def close(self):\\n        \\\"\\\"\\\"Close database connection.\\\"\\\"\\\"\\n        if self._conn:\\n            self._conn.close()\\n            self._conn = None\\n\\n\\nclass SearchEngine:\\n    \\\"\\\"\\\"\\n    High-level search engine that combines index, storage, and annotations.\\n    \\\"\\\"\\\"\\n    \\n    def __init__(self, ctx: ProjectContext):\\n        \\\"\\\"\\\"\\n        Initialize search engine.\\n        \\n        Args:\\n            ctx: Project context\\n        \\\"\\\"\\\"\\n        self.ctx = ctx\\n        self.index = SearchIndex(ctx.embeddings_db)\\n        self.veteran_storage = VeteranStorage(ctx)\\n        self.annotation_storage = AnnotationStorage(ctx)\\n    \\n    def search(\\n        self,\\n        query: str,\\n        limit: int = 20,\\n        veteran_id: Optional[str] = None,\\n        chapter: Optional[int] = None,\\n        topic: Optional[str] = None,\\n        potential: Optional[str] = None\\n    ) -> SearchResults:\\n        \\\"\\\"\\\"\\n        Search across all veterans.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            veteran_id: Filter to specific veteran\\n            chapter: Filter to responses in chapter\\n            topic: Filter by topic\\n            potential: Filter by writing potential (low/medium/high)\\n            \\n        Returns:\\n            SearchResults object\\n        \\\"\\\"\\\"\\n        # Get raw search results\\n        hybrid_weight = self.ctx.config.search.hybrid_weight\\n        raw_results = self.index.search_hybrid(\\n            query, \\n            limit=limit * 3,  # Get extra to allow for filtering\\n            hybrid_weight=hybrid_weight,\\n            veteran_id=veteran_id\\n        )\\n        \\n        # Minimum relevance score threshold - filter out weak matches\\n        MIN_SCORE = 0.25\\n        \\n        # Build search hits\\n        hits = []\\n        seen_veterans = set()\\n        \\n        # Lowercase query for text presence check\\n        query_lower = query.lower()\\n        query_terms = [t.strip() for t in query_lower.split() if len(t.strip()) > 2]\\n        \\n        for vet_id, resp_id, score in raw_results:\\n            # Skip results below minimum score threshold\\n            if score < MIN_SCORE:\\n                continue\\n            # Load veteran\\n            veteran = self.veteran_storage.load(vet_id)\\n            if not veteran:\\n                continue\\n            \\n            # Find response\\n            response = None\\n            for r in veteran.responses:\\n                if r.id == resp_id:\\n                    response = r\\n                    break\\n            \\n            if not response:\\n                continue\\n            \\n            # For mid-range scores, require at least one query term in the text\\n            # This filters out \\\"thematically similar but actually irrelevant\\\" results\\n            if score < 0.5:\\n                combined_text = (response.interviewer + \\\" \\\" + response.veteran).lower()\\n                has_query_term = any(term in combined_text for term in query_terms)\\n                if not has_query_term:\\n                    continue\\n            \\n            # Apply filters\\n            if potential:\\n                if response.extracted:\\n                    if response.extracted.writing_potential.value != potential:\\n                        continue\\n            \\n            if topic:\\n                if response.extracted:\\n                    if topic not in response.extracted.topics:\\n                        continue\\n            \\n            # Get annotations\\n            annotations = self.annotation_storage.load(vet_id)\\n            resp_annot = annotations.response_annotations.get(resp_id)\\n            \\n            if chapter is not None:\\n                if resp_annot is None or resp_annot.chapter != chapter:\\n                    continue\\n            \\n            seen_veterans.add(vet_id)\\n            \\n            hit = SearchHit(\\n                veteran_id=vet_id,\\n                veteran_name=veteran.name,\\n                unit=veteran.unit,\\n                rank=veteran.rank,\\n                response_id=resp_id,\\n                response=response,\\n                score=score,\\n                chapter=resp_annot.chapter if resp_annot else None,\\n                notes=resp_annot.notes if resp_annot else [],\\n                flags=resp_annot.flags if resp_annot else []\\n            )\\n            \\n            hits.append(hit)\\n            \\n            if len(hits) >= limit:\\n                break\\n        \\n        return SearchResults(\\n            query=query,\\n            total_hits=len(hits),\\n            veteran_count=len(seen_veterans),\\n            hits=hits\\n        )\\n    \\n    def get_thematic_matches(self, theme: str, limit: int = 50) -> List[SearchHit]:\\n        \\\"\\\"\\\"\\n        Find responses matching a specific theme across all veterans.\\n        \\n        Args:\\n            theme: The theme to search for\\n            limit: Maximum matches\\n            \\n        Returns:\\n            List of SearchHit objects\\n        \\\"\\\"\\\"\\n        results = self.search(theme, limit=limit)\\n        return results.hits\\n    \\n    def reindex_all(self, generate_embeddings: bool = True):\\n        \\\"\\\"\\\"\\n        Reindex all veterans.\\n        \\n        Args:\\n            generate_embeddings: Whether to generate embeddings\\n        \\\"\\\"\\\"\\n        for veteran_id in self.veteran_storage.list_veterans():\\n            veteran = self.veteran_storage.load(veteran_id)\\n            if veteran:\\n                self.index.index_veteran(veteran, generate_embeddings=generate_embeddings)\\n    \\n    def close(self):\\n        \\\"\\\"\\\"Close connections.\\\"\\\"\\\"\\n        self.index.close()\\n\",\"file_size_bytes\":26406,\"content_length\":26406}"}],"structuredContent":{"result":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/search.py\",\"content\":\"\\\"\\\"\\\"\\nSearch functionality for the Oral History Research System.\\n\\nProvides semantic and hybrid search across veteran testimonies.\\nUses SQLite with optimized vector search.\\n\\\"\\\"\\\"\\n\\nimport os\\nimport sqlite3\\nimport random\\nfrom typing import List, Optional, Dict, Any, Tuple\\nfrom pathlib import Path\\nimport json\\n\\nimport numpy as np\\n\\nfrom .models import (\\n    Veteran, Response, SearchHit, SearchResults,\\n    WritingPotential, VeteranAnnotations\\n)\\nfrom .config import ProjectContext, get_api_key\\nfrom .storage import VeteranStorage, AnnotationStorage\\n\\n\\n# Cached Portkey client for embeddings\\n_embeddings_client = None\\n\\n\\ndef get_embeddings_client():\\n    \\\"\\\"\\\"Get Portkey client for embeddings.\\\"\\\"\\\"\\n    global _embeddings_client\\n    \\n    if _embeddings_client is not None:\\n        return _embeddings_client\\n    \\n    try:\\n        from portkey_ai import Portkey\\n    except ImportError:\\n        raise ImportError(\\\"portkey-ai package not installed. Run: pip install portkey-ai\\\")\\n    \\n    api_key = get_api_key(\\\"portkey\\\")\\n    if not api_key:\\n        raise ValueError(\\\"PORTKEY_API_KEY not set\\\")\\n    \\n    _embeddings_client = Portkey(api_key=api_key)\\n    return _embeddings_client\\n\\n\\ndef generate_embedding(text: str, model: Optional[str] = None) -> List[float]:\\n    \\\"\\\"\\\"\\n    Generate embedding for text using Portkey.\\n    \\n    Args:\\n        text: Text to embed\\n        model: Embedding model name (uses PORTKEY_EMBEDDING_MODEL if not provided)\\n        \\n    Returns:\\n        Embedding vector\\n    \\\"\\\"\\\"\\n    client = get_embeddings_client()\\n    \\n    # Get model from env if not provided\\n    model = model or os.getenv(\\\"PORTKEY_EMBEDDING_MODEL\\\")\\n    if not model:\\n        raise ValueError(\\\"PORTKEY_EMBEDDING_MODEL not set. Please set the environment variable or provide a model.\\\")\\n    \\n    # Truncate if too long (max ~8000 tokens for embedding models)\\n    if len(text) > 30000:\\n        text = text[:30000]\\n    \\n    # Portkey requires input as a list\\n    response = client.embeddings.create(\\n        input=[text],\\n        model=model\\n    )\\n    \\n    # Extract embedding from response\\n    if response and hasattr(response, 'data') and len(response.data) > 0:\\n        return response.data[0].embedding\\n    \\n    raise ValueError(\\\"Invalid embedding response structure from Portkey\\\")\\n\\n\\nclass SearchIndex:\\n    \\\"\\\"\\\"\\n    Search index using SQLite with sqlite-vss.\\n    \\n    Stores embeddings for paragraphs and full responses.\\n    Supports hybrid search (semantic + keyword).\\n    \\\"\\\"\\\"\\n    \\n    def __init__(self, db_path: Path, embedding_dim: int = 1536):\\n        \\\"\\\"\\\"\\n        Initialize search index.\\n        \\n        Args:\\n            db_path: Path to SQLite database\\n            embedding_dim: Dimension of embedding vectors\\n        \\\"\\\"\\\"\\n        self.db_path = db_path\\n        self.embedding_dim = embedding_dim\\n        self._conn = None\\n        self._vss_available = False\\n    \\n    def _get_conn(self) -> sqlite3.Connection:\\n        \\\"\\\"\\\"Get database connection, creating tables if needed.\\\"\\\"\\\"\\n        if self._conn is None:\\n            self.db_path.parent.mkdir(parents=True, exist_ok=True)\\n            self._conn = sqlite3.connect(str(self.db_path))\\n            self._conn.row_factory = sqlite3.Row\\n            self._init_tables()\\n        return self._conn\\n    \\n    def _init_tables(self):\\n        \\\"\\\"\\\"Initialize database tables.\\\"\\\"\\\"\\n        conn = self._conn\\n        \\n        # Check if sqlite-vss is available\\n        try:\\n            conn.enable_load_extension(True)\\n            # Try to load vss extension\\n            try:\\n                conn.load_extension(\\\"vss0\\\")\\n                self._vss_available = True\\n            except Exception:\\n                # VSS not available, fall back to basic FTS\\n                self._vss_available = False\\n        except Exception:\\n            self._vss_available = False\\n        \\n        # Core tables\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TABLE IF NOT EXISTS paragraphs (\\n                id TEXT PRIMARY KEY,\\n                veteran_id TEXT NOT NULL,\\n                response_id TEXT NOT NULL,\\n                text TEXT NOT NULL,\\n                embedding BLOB\\n            )\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TABLE IF NOT EXISTS responses (\\n                id TEXT PRIMARY KEY,\\n                veteran_id TEXT NOT NULL,\\n                full_text TEXT NOT NULL,\\n                embedding BLOB\\n            )\\n        \\\"\\\"\\\")\\n        \\n        # FTS for keyword search (always available)\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE VIRTUAL TABLE IF NOT EXISTS paragraphs_fts USING fts5(\\n                id, veteran_id, response_id, text,\\n                content=paragraphs,\\n                content_rowid=rowid\\n            )\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE VIRTUAL TABLE IF NOT EXISTS responses_fts USING fts5(\\n                id, veteran_id, full_text,\\n                content=responses,\\n                content_rowid=rowid\\n            )\\n        \\\"\\\"\\\")\\n        \\n        # Triggers to keep FTS in sync\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS paragraphs_ai AFTER INSERT ON paragraphs BEGIN\\n                INSERT INTO paragraphs_fts(rowid, id, veteran_id, response_id, text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.response_id, new.text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS paragraphs_ad AFTER DELETE ON paragraphs BEGIN\\n                INSERT INTO paragraphs_fts(paragraphs_fts, rowid, id, veteran_id, response_id, text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.response_id, old.text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS paragraphs_au AFTER UPDATE ON paragraphs BEGIN\\n                INSERT INTO paragraphs_fts(paragraphs_fts, rowid, id, veteran_id, response_id, text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.response_id, old.text);\\n                INSERT INTO paragraphs_fts(rowid, id, veteran_id, response_id, text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.response_id, new.text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS responses_ai AFTER INSERT ON responses BEGIN\\n                INSERT INTO responses_fts(rowid, id, veteran_id, full_text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.full_text);\\n            END\\n        \\\"\\\"\\\")\\n\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS responses_ad AFTER DELETE ON responses BEGIN\\n                INSERT INTO responses_fts(responses_fts, rowid, id, veteran_id, full_text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.full_text);\\n            END\\n        \\\"\\\"\\\")\\n\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE TRIGGER IF NOT EXISTS responses_au AFTER UPDATE ON responses BEGIN\\n                INSERT INTO responses_fts(responses_fts, rowid, id, veteran_id, full_text)\\n                VALUES ('delete', old.rowid, old.id, old.veteran_id, old.full_text);\\n                INSERT INTO responses_fts(rowid, id, veteran_id, full_text)\\n                VALUES (new.rowid, new.id, new.veteran_id, new.full_text);\\n            END\\n        \\\"\\\"\\\")\\n        \\n        # Repair existing indexes if out of sync\\n        try:\\n            conn.execute(\\\"INSERT INTO paragraphs_fts(paragraphs_fts) VALUES('rebuild')\\\")\\n            conn.execute(\\\"INSERT INTO responses_fts(responses_fts) VALUES('rebuild')\\\")\\n        except sqlite3.Error:\\n            pass # Ignore if rebuild fails (e.g. extension not supporting it)\\n        \\n        # Indexes for faster filtering by veteran_id\\n        conn.execute(\\\"\\\"\\\"\\n            CREATE INDEX IF NOT EXISTS idx_paragraphs_veteran_id \\n            ON paragraphs(veteran_id)\\n        \\\"\\\"\\\")\\n        \\n        conn.execute(\\\"\\\"\\\"\\n            CREATE INDEX IF NOT EXISTS idx_responses_veteran_id \\n            ON responses(veteran_id)\\n        \\\"\\\"\\\")\\n        \\n        conn.commit()\\n    \\n    def index_veteran(self, veteran: Veteran, generate_embeddings: bool = True):\\n        \\\"\\\"\\\"\\n        Index a veteran's responses and paragraphs.\\n        \\n        Args:\\n            veteran: Veteran to index\\n            generate_embeddings: Whether to generate embeddings (requires API)\\n        \\\"\\\"\\\"\\n        conn = self._get_conn()\\n        \\n        # Delete existing entries for this veteran\\n        conn.execute(\\\"DELETE FROM paragraphs WHERE veteran_id = ?\\\", (veteran.id,))\\n        conn.execute(\\\"DELETE FROM responses WHERE veteran_id = ?\\\", (veteran.id,))\\n        \\n        for response in veteran.responses:\\n            # Index full response\\n            full_text = f\\\"Q: {response.interviewer}\\\\nA: {response.veteran}\\\"\\n            \\n            embedding = None\\n            if generate_embeddings:\\n                try:\\n                    embedding = generate_embedding(full_text)\\n                    embedding = self._serialize_embedding(embedding)\\n                except Exception:\\n                    pass  # Skip embedding on error\\n            \\n            conn.execute(\\\"\\\"\\\"\\n                INSERT INTO responses (id, veteran_id, full_text, embedding)\\n                VALUES (?, ?, ?, ?)\\n            \\\"\\\"\\\", (\\n                f\\\"{veteran.id}:{response.id}\\\",\\n                veteran.id,\\n                full_text,\\n                embedding\\n            ))\\n            \\n            # Index paragraphs\\n            for para in response.paragraphs:\\n                para_embedding = None\\n                if generate_embeddings:\\n                    try:\\n                        para_embedding = generate_embedding(para.text)\\n                        para_embedding = self._serialize_embedding(para_embedding)\\n                    except Exception:\\n                        pass\\n                \\n                conn.execute(\\\"\\\"\\\"\\n                    INSERT INTO paragraphs (id, veteran_id, response_id, text, embedding)\\n                    VALUES (?, ?, ?, ?, ?)\\n                \\\"\\\"\\\", (\\n                    f\\\"{veteran.id}:{para.id}\\\",\\n                    veteran.id,\\n                    response.id,\\n                    para.text,\\n                    para_embedding\\n                ))\\n        \\n        conn.commit()\\n    \\n    def _serialize_embedding(self, embedding: List[float]) -> bytes:\\n        \\\"\\\"\\\"Serialize embedding to bytes using numpy for efficiency.\\\"\\\"\\\"\\n        return np.array(embedding, dtype=np.float32).tobytes()\\n    \\n    def _deserialize_embedding(self, data: bytes) -> np.ndarray:\\n        \\\"\\\"\\\"Deserialize embedding from bytes to numpy array.\\\"\\\"\\\"\\n        return np.frombuffer(data, dtype=np.float32)\\n    \\n    def _cosine_similarity(self, a: np.ndarray, b: np.ndarray) -> float:\\n        \\\"\\\"\\\"Calculate cosine similarity between two vectors using numpy.\\\"\\\"\\\"\\n        # Ensure numpy arrays\\n        if not isinstance(a, np.ndarray):\\n            a = np.array(a, dtype=np.float32)\\n        if not isinstance(b, np.ndarray):\\n            b = np.array(b, dtype=np.float32)\\n        \\n        dot = np.dot(a, b)\\n        norm_a = np.linalg.norm(a)\\n        norm_b = np.linalg.norm(b)\\n        \\n        if norm_a == 0 or norm_b == 0:\\n            return 0.0\\n        return float(dot / (norm_a * norm_b))\\n    \\n    def _batch_cosine_similarity(self, query: np.ndarray, embeddings: np.ndarray) -> np.ndarray:\\n        \\\"\\\"\\\"\\n        Calculate cosine similarity between a query and multiple embeddings.\\n        Uses vectorized numpy operations for speed.\\n        \\n        Args:\\n            query: Query embedding (1D array)\\n            embeddings: Matrix of embeddings (2D array, one per row)\\n            \\n        Returns:\\n            Array of similarity scores\\n        \\\"\\\"\\\"\\n        # Normalize query\\n        query_norm = np.linalg.norm(query)\\n        if query_norm == 0:\\n            return np.zeros(len(embeddings))\\n        query_normalized = query / query_norm\\n        \\n        # Normalize embeddings\\n        norms = np.linalg.norm(embeddings, axis=1, keepdims=True)\\n        norms[norms == 0] = 1  # Avoid division by zero\\n        embeddings_normalized = embeddings / norms\\n        \\n        # Compute all similarities at once\\n        return embeddings_normalized @ query_normalized\\n    \\n    def _get_paragraph_count(self, veteran_id: Optional[str] = None) -> int:\\n        \\\"\\\"\\\"Get count of paragraphs with embeddings.\\\"\\\"\\\"\\n        conn = self._get_conn()\\n        if veteran_id:\\n            result = conn.execute(\\n                \\\"SELECT COUNT(*) FROM paragraphs WHERE embedding IS NOT NULL AND veteran_id = ?\\\",\\n                (veteran_id,)\\n            ).fetchone()\\n        else:\\n            result = conn.execute(\\n                \\\"SELECT COUNT(*) FROM paragraphs WHERE embedding IS NOT NULL\\\"\\n            ).fetchone()\\n        return result[0] if result else 0\\n    \\n    def search_semantic(\\n        self, \\n        query: str, \\n        limit: int = 20,\\n        veteran_id: Optional[str] = None,\\n        approximate: bool = True,\\n        sample_ratio: float = 0.2\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Search by semantic similarity with optimizations.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            veteran_id: Optional filter to specific veteran\\n            approximate: Use approximate search for large datasets (>5000 paragraphs)\\n            sample_ratio: Sampling ratio for approximate search (default 20%)\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        conn = self._get_conn()\\n        \\n        # Generate query embedding\\n        query_embedding = np.array(generate_embedding(query), dtype=np.float32)\\n        \\n        # Check if we should use approximate search\\n        paragraph_count = self._get_paragraph_count(veteran_id)\\n        use_approximate = approximate and paragraph_count > 5000\\n        \\n        # Get paragraphs with embeddings\\n        if veteran_id:\\n            base_query = \\\"\\\"\\\"\\n                SELECT id, veteran_id, response_id, embedding\\n                FROM paragraphs\\n                WHERE embedding IS NOT NULL AND veteran_id = ?\\n            \\\"\\\"\\\"\\n            params = (veteran_id,)\\n        else:\\n            base_query = \\\"\\\"\\\"\\n                SELECT id, veteran_id, response_id, embedding\\n                FROM paragraphs\\n                WHERE embedding IS NOT NULL\\n            \\\"\\\"\\\"\\n            params = ()\\n        \\n        # For approximate search, randomly sample a subset\\n        if use_approximate:\\n            # First pass: sample subset for initial ranking\\n            rows = conn.execute(base_query, params).fetchall()\\n            sample_size = max(int(len(rows) * sample_ratio), limit * 10)\\n            sampled_rows = random.sample(rows, min(sample_size, len(rows)))\\n            \\n            # Calculate similarities for sampled subset\\n            initial_results = self._calculate_similarities_batch(\\n                query_embedding, sampled_rows\\n            )\\n            \\n            # Get top candidates from sample\\n            initial_results.sort(key=lambda x: x[2], reverse=True)\\n            top_response_ids = set()\\n            for _, resp_id, _ in initial_results[:limit * 3]:\\n                top_response_ids.add(resp_id)\\n            \\n            # Second pass: refine with full search on candidate responses\\n            candidate_rows = [r for r in rows if r[\\\"response_id\\\"] in top_response_ids]\\n            results = self._calculate_similarities_batch(query_embedding, candidate_rows)\\n        else:\\n            # Full search for smaller datasets\\n            rows = conn.execute(base_query, params).fetchall()\\n            results = self._calculate_similarities_batch(query_embedding, rows)\\n        \\n        # Sort by score and dedupe by response\\n        results.sort(key=lambda x: x[2], reverse=True)\\n        \\n        seen_responses = set()\\n        deduped = []\\n        for vet_id, resp_id, score in results:\\n            key = f\\\"{vet_id}:{resp_id}\\\"\\n            if key not in seen_responses:\\n                seen_responses.add(key)\\n                deduped.append((vet_id, resp_id, score))\\n                if len(deduped) >= limit:\\n                    break\\n        \\n        return deduped\\n    \\n    def _calculate_similarities_batch(\\n        self, \\n        query_embedding: np.ndarray, \\n        rows: List[sqlite3.Row]\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Calculate similarities for a batch of rows using vectorized operations.\\n        \\n        Args:\\n            query_embedding: Query embedding as numpy array\\n            rows: Database rows with embeddings\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        if not rows:\\n            return []\\n        \\n        # Batch deserialize embeddings\\n        embeddings = []\\n        metadata = []\\n        \\n        for row in rows:\\n            if row[\\\"embedding\\\"]:\\n                emb = self._deserialize_embedding(row[\\\"embedding\\\"])\\n                embeddings.append(emb)\\n                metadata.append((row[\\\"veteran_id\\\"], row[\\\"response_id\\\"]))\\n        \\n        if not embeddings:\\n            return []\\n        \\n        # Stack into matrix and compute all similarities at once\\n        embeddings_matrix = np.vstack(embeddings)\\n        scores = self._batch_cosine_similarity(query_embedding, embeddings_matrix)\\n        \\n        # Build results\\n        results = [\\n            (meta[0], meta[1], float(score))\\n            for meta, score in zip(metadata, scores)\\n        ]\\n        \\n        return results\\n    \\n    def search_keyword(\\n        self, \\n        query: str, \\n        limit: int = 20,\\n        veteran_id: Optional[str] = None\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Search by keyword/FTS.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            veteran_id: Optional filter to specific veteran\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        conn = self._get_conn()\\n        \\n        # Escape special FTS5 characters\\n        safe_query = query.replace('\\\"', '\\\"\\\"')\\n        \\n        if veteran_id:\\n            rows = conn.execute(\\\"\\\"\\\"\\n                SELECT veteran_id, response_id, rank\\n                FROM paragraphs_fts\\n                WHERE paragraphs_fts MATCH ?\\n                AND veteran_id = ?\\n                ORDER BY rank\\n                LIMIT ?\\n            \\\"\\\"\\\", (safe_query, veteran_id, limit * 2)).fetchall()\\n        else:\\n            rows = conn.execute(\\\"\\\"\\\"\\n                SELECT veteran_id, response_id, rank\\n                FROM paragraphs_fts\\n                WHERE paragraphs_fts MATCH ?\\n                ORDER BY rank\\n                LIMIT ?\\n            \\\"\\\"\\\", (safe_query, limit * 2)).fetchall()\\n        \\n        # Dedupe by response\\n        seen_responses = set()\\n        results = []\\n        for row in rows:\\n            key = f\\\"{row['veteran_id']}:{row['response_id']}\\\"\\n            if key not in seen_responses:\\n                seen_responses.add(key)\\n                # Convert FTS rank to similarity-like score (higher is better)\\n                score = 1.0 / (1.0 + abs(row[\\\"rank\\\"]))\\n                results.append((row[\\\"veteran_id\\\"], row[\\\"response_id\\\"], score))\\n                if len(results) >= limit:\\n                    break\\n        \\n        return results\\n    \\n    def search_hybrid(\\n        self, \\n        query: str, \\n        limit: int = 20,\\n        hybrid_weight: float = 0.7,\\n        veteran_id: Optional[str] = None\\n    ) -> List[Tuple[str, str, float]]:\\n        \\\"\\\"\\\"\\n        Hybrid search combining semantic and keyword.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            hybrid_weight: Weight for semantic (0=keyword only, 1=semantic only)\\n            veteran_id: Optional filter to specific veteran\\n            \\n        Returns:\\n            List of (veteran_id, response_id, score) tuples\\n        \\\"\\\"\\\"\\n        # Get both result sets\\n        try:\\n            semantic_results = self.search_semantic(query, limit=limit*2, veteran_id=veteran_id)\\n        except Exception:\\n            semantic_results = []\\n        \\n        keyword_results = self.search_keyword(query, limit=limit*2, veteran_id=veteran_id)\\n        \\n        # Combine scores\\n        scores = {}\\n        \\n        # Semantic scores\\n        for vet_id, resp_id, score in semantic_results:\\n            key = f\\\"{vet_id}:{resp_id}\\\"\\n            scores[key] = scores.get(key, 0) + score * hybrid_weight\\n        \\n        # Keyword scores\\n        for vet_id, resp_id, score in keyword_results:\\n            key = f\\\"{vet_id}:{resp_id}\\\"\\n            scores[key] = scores.get(key, 0) + score * (1 - hybrid_weight)\\n        \\n        # Sort and return\\n        results = []\\n        for key, score in sorted(scores.items(), key=lambda x: x[1], reverse=True)[:limit]:\\n            vet_id, resp_id = key.split(\\\":\\\", 1)\\n            results.append((vet_id, resp_id, score))\\n        \\n        return results\\n    \\n    def close(self):\\n        \\\"\\\"\\\"Close database connection.\\\"\\\"\\\"\\n        if self._conn:\\n            self._conn.close()\\n            self._conn = None\\n\\n\\nclass SearchEngine:\\n    \\\"\\\"\\\"\\n    High-level search engine that combines index, storage, and annotations.\\n    \\\"\\\"\\\"\\n    \\n    def __init__(self, ctx: ProjectContext):\\n        \\\"\\\"\\\"\\n        Initialize search engine.\\n        \\n        Args:\\n            ctx: Project context\\n        \\\"\\\"\\\"\\n        self.ctx = ctx\\n        self.index = SearchIndex(ctx.embeddings_db)\\n        self.veteran_storage = VeteranStorage(ctx)\\n        self.annotation_storage = AnnotationStorage(ctx)\\n    \\n    def search(\\n        self,\\n        query: str,\\n        limit: int = 20,\\n        veteran_id: Optional[str] = None,\\n        chapter: Optional[int] = None,\\n        topic: Optional[str] = None,\\n        potential: Optional[str] = None\\n    ) -> SearchResults:\\n        \\\"\\\"\\\"\\n        Search across all veterans.\\n        \\n        Args:\\n            query: Search query\\n            limit: Maximum results\\n            veteran_id: Filter to specific veteran\\n            chapter: Filter to responses in chapter\\n            topic: Filter by topic\\n            potential: Filter by writing potential (low/medium/high)\\n            \\n        Returns:\\n            SearchResults object\\n        \\\"\\\"\\\"\\n        # Get raw search results\\n        hybrid_weight = self.ctx.config.search.hybrid_weight\\n        raw_results = self.index.search_hybrid(\\n            query, \\n            limit=limit * 3,  # Get extra to allow for filtering\\n            hybrid_weight=hybrid_weight,\\n            veteran_id=veteran_id\\n        )\\n        \\n        # Minimum relevance score threshold - filter out weak matches\\n        MIN_SCORE = 0.25\\n        \\n        # Build search hits\\n        hits = []\\n        seen_veterans = set()\\n        \\n        # Lowercase query for text presence check\\n        query_lower = query.lower()\\n        query_terms = [t.strip() for t in query_lower.split() if len(t.strip()) > 2]\\n        \\n        for vet_id, resp_id, score in raw_results:\\n            # Skip results below minimum score threshold\\n            if score < MIN_SCORE:\\n                continue\\n            # Load veteran\\n            veteran = self.veteran_storage.load(vet_id)\\n            if not veteran:\\n                continue\\n            \\n            # Find response\\n            response = None\\n            for r in veteran.responses:\\n                if r.id == resp_id:\\n                    response = r\\n                    break\\n            \\n            if not response:\\n                continue\\n            \\n            # For mid-range scores, require at least one query term in the text\\n            # This filters out \\\"thematically similar but actually irrelevant\\\" results\\n            if score < 0.5:\\n                combined_text = (response.interviewer + \\\" \\\" + response.veteran).lower()\\n                has_query_term = any(term in combined_text for term in query_terms)\\n                if not has_query_term:\\n                    continue\\n            \\n            # Apply filters\\n            if potential:\\n                if response.extracted:\\n                    if response.extracted.writing_potential.value != potential:\\n                        continue\\n            \\n            if topic:\\n                if response.extracted:\\n                    if topic not in response.extracted.topics:\\n                        continue\\n            \\n            # Get annotations\\n            annotations = self.annotation_storage.load(vet_id)\\n            resp_annot = annotations.response_annotations.get(resp_id)\\n            \\n            if chapter is not None:\\n                if resp_annot is None or resp_annot.chapter != chapter:\\n                    continue\\n            \\n            seen_veterans.add(vet_id)\\n            \\n            hit = SearchHit(\\n                veteran_id=vet_id,\\n                veteran_name=veteran.name,\\n                unit=veteran.unit,\\n                rank=veteran.rank,\\n                response_id=resp_id,\\n                response=response,\\n                score=score,\\n                chapter=resp_annot.chapter if resp_annot else None,\\n                notes=resp_annot.notes if resp_annot else [],\\n                flags=resp_annot.flags if resp_annot else []\\n            )\\n            \\n            hits.append(hit)\\n            \\n            if len(hits) >= limit:\\n                break\\n        \\n        return SearchResults(\\n            query=query,\\n            total_hits=len(hits),\\n            veteran_count=len(seen_veterans),\\n            hits=hits\\n        )\\n    \\n    def get_thematic_matches(self, theme: str, limit: int = 50) -> List[SearchHit]:\\n        \\\"\\\"\\\"\\n        Find responses matching a specific theme across all veterans.\\n        \\n        Args:\\n            theme: The theme to search for\\n            limit: Maximum matches\\n            \\n        Returns:\\n            List of SearchHit objects\\n        \\\"\\\"\\\"\\n        results = self.search(theme, limit=limit)\\n        return results.hits\\n    \\n    def reindex_all(self, generate_embeddings: bool = True):\\n        \\\"\\\"\\\"\\n        Reindex all veterans.\\n        \\n        Args:\\n            generate_embeddings: Whether to generate embeddings\\n        \\\"\\\"\\\"\\n        for veteran_id in self.veteran_storage.list_veterans():\\n            veteran = self.veteran_storage.load(veteran_id)\\n            if veteran:\\n                self.index.index_veteran(veteran, generate_embeddings=generate_embeddings)\\n    \\n    def close(self):\\n        \\\"\\\"\\\"Close connections.\\\"\\\"\\\"\\n        self.index.close()\\n\",\"file_size_bytes\":26406,\"content_length\":26406}"},"isError":false}} { metadata: undefined }
