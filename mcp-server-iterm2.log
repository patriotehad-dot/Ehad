 lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n        \n        # Profile\n        lines.append(\"## Profile\")\n        lines.append(\"\")\n        if veteran.unit:\n            lines.append(f\"- **Unit:** {veteran.unit}\")\n        if veteran.rank:\n            lines.append(f\"- **Rank:** {veteran.rank}\")\n        if veteran.service_dates:\n            dates = veteran.service_dates\n            if dates.start or dates.end:\n                lines.append(f\"- **Service:** {dates.start or '?'} - {dates.end or '?'}\")\n        lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n        \n        # Timeline\n        if veteran.timeline:\n            lines.append(\"## Timeline\")\n            lines.append(\"\")\n            lines.append(\"| Date | Event | Confidence | Response |\")\n            lines.append(\"|------|-------|------------|----------|\")\n            \n            for event in veteran.timeline:\n                confidence_marker = \"\"\n                if event.confidence.value == \"approximate\":\n                    confidence_marker = \" ~\"\n                resp_refs = \", \".join(f\"[{r}]\" for r in event.response_ids)\n                note = f\" *{event.note}*\" if event.note else \"\"\n                lines.append(f\"| {event.date}{confidence_marker} | {event.event}{note} | {event.confidence.value} | {resp_refs} |\")\n            \n            lines.append(\"\")\n            lines.append(\"---\")\n            lines.append(\"\")\n        \n        # Relationships\n        if veteran.relationships:\n            lines.append(\"## Relationships\")\n            lines.append(\"\")\n            \n            for rel in veteran.relationships:\n                lines.append(f\"### {rel.canonical}\")\n                if rel.role:\n                    lines.append(f\"- **Role:** {rel.role}\")\n                if len(rel.names) > 1:\n                    lines.append(f\"- **Also known as:** {', '.join(n for n in rel.names if n != rel.canonical)}\")\n                if rel.context:\n                    lines.append(f\"- **Context:** {rel.context}\")\n                resp_refs = \", \".join(f\"[{r}]\" for r in rel.response_ids)\n                lines.append(f\"- **Responses:** {resp_refs}\")\n                lines.append(\"\")\n            \n            lines.append(\"---\")\n            lines.append(\"\")\n        \n        # Notable Stories\n        if veteran.notable_stories:\n            lines.append(\"## Notable Stories\")\n            lines.append(\"\")\n            \n            for story in veteran.notable_stories:\n                lines.append(f\"### {story.title}\")\n                resp_refs = \", \".join(f\"[{r}]\" for r in story.response_ids)\n                lines.append(f\"**Responses:** {resp_refs}\")\n                if story.writing_note:\n                    lines.append(f\"**Writing note:** {story.writing_note}\")\n                lines.append(\"\")\n                lines.append(f\"> {story.summary}\")\n                lines.append(\"\")\n            \n            lines.append(\"---\")\n            lines.append(\"\")\n        \n        # Verification Needed\n        if veteran.verification_needed:\n            lines.append(\"## Verification Needed\")\n            lines.append(\"\")\n            \n            for item in veteran.verification_needed:\n                resp_refs = \", \".join(f\"[{r}]\" for r in item.response_ids)\n                lines.append(f\"- **{item.issue}**: {item.detail} ({resp_refs})\")\n            \n            lines.append(\"\")\n            lines.append(\"---\")\n            lines.append(\"\")\n        \n        # All Responses\n        lines.append(\"## All Responses\")\n        lines.append(\"\")\n        \n        for response in veteran.responses:\n            resp_annot = annotations.response_annotations.get(response.id)\n            lines.append(format_response_md(response, resp_annot))\n        \n        # Write file\n        with open(output_path, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"\\n\".join(lines))\n        \n        return output_path\n    \n    def export_search_results(\n        self, \n        results: SearchResults,\n        name: str,\n        output_path: Optional[Path] = None\n    ) -> Path:\n        \"\"\"\n        Export search results.\n        \n        Args:\n            results: Search results to export\n            name: Export name\n            output_path: Optional custom output path\n            \n        Returns:\n            Path to exported file\n        \"\"\"\n        if output_path is None:\n            safe_name = \"\".join(c if c.isalnum() or c in \"._-\" else \"_\" for c in name)\n            output_path = self.ctx.exports_dir / f\"{safe_name}.md\"\n        \n        output_path.parent.mkdir(parents=True, exist_ok=True)\n        \n        lines = []\n        lines.append(f\"# Search Results: {results.query}\")\n        lines.append(\"\")\n        lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-%d')}\")\n        lines.append(f\"> Results: {results.total_hits} from {results.veteran_count} veterans\")\n        lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n        \n        # Group by veteran\n        by_veteran: Dict[str, List] = {}\n        for hit in results.hits:\n            if hit.veteran_id not in by_veteran:\n                by_veteran[hit.veteran_id] = []\n            by_veteran[hit.veteran_id].append(hit)\n        \n        for veteran_id, hits in by_veteran.items():\n            first_hit = hits[0]\n            \n            # Veteran header\n            lines.append(f\"## {first_hit.veteran_name}\")\n            parts = []\n            if first_hit.unit:\n                parts.append(first_hit.unit)\n            if first_hit.rank:\n                parts.append(first_hit.rank)\n            if parts:\n                lines.append(f\"**{' | '.join(parts)}**\")\n            lines.append(\"\")\n            \n            # Responses\n            for hit in hits:\n                resp_annot = ResponseAnnotation(\n                    chapter=hit.chapter,\n                    notes=hit.notes,\n                    flags=hit.flags\n                )\n                lines.append(format_response_md(hit.response, resp_annot))\n        \n        # Write file\n        with open(output_path, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"\\n\".join(lines))\n        \n        return output_path\n    \n    def export_notable_stories(\n        self,\n        output_path: Optional[Path] = None\n    ) -> Path:\n        \"\"\"\n        Export all notable stories across veterans.\n        \n        Args:\n            output_path: Optional custom output path\n            \n        Returns:\n            Path to exported file\n        \"\"\"\n        if output_path is None:\n            output_path = self.ctx.exports_dir / \"notable_stories.md\"\n        \n        output_path.parent.mkdir(parents=True, exist_ok=True)\n        \n        lines = []\n        lines.append(\"# Notable Stories - All Veterans\")\n        lines.append(\"\")\n        lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-%d')}\")\n        lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n        \n        for veteran_id in self.veteran_storage.list_veterans():\n            veteran = self.veteran_storage.load(veteran_id)\n            if not veteran or not veteran.notable_stories:\n                continue\n            \n            lines.append(format_veteran_header_md(veteran))\n            \n            for story in veteran.notable_stories:\n                lines.append(f\"### {story.title}\")\n                resp_refs = \", \".join(f\"[{r}]\" for r in story.response_ids)\n                lines.append(f\"**Responses:** {resp_refs}\")\n                if story.writing_note:\n                    lines.append(f\"**Writing note:** {story.writing_note}\")\n                lines.append(\"\")\n                lines.append(f\"> {story.summary}\")\n                lines.append(\"\")\n            \n            lines.append(\"---\")\n            lines.append(\"\")\n        \n        with open(output_path, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"\\n\".join(lines))\n        \n        return output_path\n    \n    def export_timeline(\n        self,\n        start_date: Optional[str] = None,\n        end_date: Optional[str] = None,\n        output_path: Optional[Path] = None\n    ) -> Path:\n        \"\"\"\n        Export timeline across all veterans.\n        \n        Args:\n            start_date: Optional start date filter\n            end_date: Optional end date filter\n            output_path: Optional custom output path\n            \n        Returns:\n            Path to exported file\n        \"\"\"\n        if output_path is None:\n            name = \"timeline\"\n            if start_date:\n                name += f\"_from_{start_date}\"\n            if end_date:\n                name += f\"_to_{end_date}\"\n            output_path = self.ctx.exports_dir / f\"{name}.md\"\n        \n        output_path.parent.mkdir(parents=True, exist_ok=True)\n        \n        # Collect all events\n        all_events = []\n        \n        for veteran_id in self.veteran_storage.list_veterans():\n            veteran = self.veteran_storage.load(veteran_id)\n            if not veteran:\n                continue\n            \n            for event in veteran.timeline:\n                # Simple date filtering (could be improved)\n                include = True\n                if start_date and event.date < start_date:\n                    include = False\n                if end_date and event.date > end_date:\n                    include = False\n                \n                if include:\n                    all_events.append({\n                        \"date\": event.date,\n                        \"event\": event.event,\n                        \"veteran_id\": veteran_id,\n                        \"veteran_name\": veteran.name,\n                        \"response_ids\": event.response_ids,\n                        \"note\": event.note\n                    })\n        \n        # Sort by date\n        all_events.sort(key=lambda x: x[\"date\"])\n        \n        lines = []\n        lines.append(\"# Timeline - All Veterans\")\n        lines.append(\"\")\n        lines.append(f\"> Generated: {datetime.now().strftime('%Y-%m-%d')}\")\n        if start_date or end_date:\n            lines.append(f\"> Date range: {start_date or 'beginning'} to {end_date or 'end'}\")\n        lines.append(f\"> Events: {len(all_events)}\")\n        lines.append(\"\")\n        lines.append(\"---\")\n        lines.append(\"\")\n        \n        lines.append(\"| Date | Veteran | Event | References |\")\n        lines.append(\"|------|---------|-------|------------|\")\n        \n        for e in all_events:\n            resp_refs = \", \".join(f\"[{r}]\" for r in e[\"response_ids\"])\n            note = f\" *({e['note']})*\" if e[\"note\"] else \"\"\n            lines.append(f\"| {e['date']} | {e['veteran_name']} | {e['event']}{note} | {resp_refs} |\")\n        \n        lines.append(\"\")\n        \n        with open(output_path, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"\\n\".join(lines))\n        \n        return output_path\n"}},"jsonrpc":"2.0","id":23} %o
