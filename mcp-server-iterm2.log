2025-12-20T16:56:01.636Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":12,"result":{"content":[{"type":"text","text":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/chunking.py\",\"content\":\"\\\"\\\"\\\"\\nText chunking utilities for the Oral History Research System.\\n\\nHandles splitting long texts into overlapping chunks that fit within\\nembedding model context windows (e.g., 8000 tokens for OpenAI text-embedding-3-large).\\n\\nKey principle: No data loss. If text is too long, we chunk with overlap\\nso semantic search can find any part of the original text.\\n\\\"\\\"\\\"\\n\\nimport re\\nfrom typing import List, Tuple\\nfrom dataclasses import dataclass\\n\\n\\n@dataclass\\nclass TextChunk:\\n    \\\"\\\"\\\"A chunk of text with position information.\\\"\\\"\\\"\\n    text: str\\n    start_char: int  # Start position in original text\\n    end_char: int    # End position in original text\\n    chunk_index: int # Which chunk this is (0-indexed)\\n    total_chunks: int # Total number of chunks\\n\\n\\ndef estimate_tokens(text: str) -> int:\\n    \\\"\\\"\\\"\\n    Estimate token count for text.\\n    \\n    Rough heuristic: ~4 characters per token for English.\\n    This is conservative (actual might be ~3.5-4.5 depending on content).\\n    \\n    Args:\\n        text: Text to estimate tokens for\\n        \\n    Returns:\\n        Estimated token count\\n    \\\"\\\"\\\"\\n    return len(text) // 4\\n\\n\\ndef chunk_text_with_overlap(\\n    text: str,\\n    max_tokens: int = 7500,\\n    overlap_tokens: int = 200,\\n    respect_sentences: bool = True\\n) -> List[TextChunk]:\\n    \\\"\\\"\\\"\\n    Split text into overlapping chunks that fit within token limits.\\n    \\n    If text fits within max_tokens, returns a single chunk (no splitting).\\n    Otherwise, creates overlapping chunks with sentence boundary respect.\\n    \\n    Args:\\n        text: Text to chunk\\n        max_tokens: Maximum tokens per chunk (default 7500, leaves buffer below 8000)\\n        overlap_tokens: Tokens of overlap between chunks (default 200)\\n        respect_sentences: Try to break at sentence boundaries (default True)\\n        \\n    Returns:\\n        List of TextChunk objects\\n    \\\"\\\"\\\"\\n    # Convert token limits to character estimates\\n    max_chars = max_tokens * 4\\n    overlap_chars = overlap_tokens * 4\\n    \\n    # If text fits, return single chunk\\n    if len(text) <= max_chars:\\n        return [TextChunk(\\n            text=text,\\n            start_char=0,\\n            end_char=len(text),\\n            chunk_index=0,\\n            total_chunks=1\\n        )]\\n    \\n    chunks = []\\n    start = 0\\n    chunk_index = 0\\n    \\n    while start < len(text):\\n        # Calculate end position\\n        end = min(start + max_chars, len(text))\\n        \\n        # If not at the end and we want sentence boundaries\\n        if end < len(text) and respect_sentences:\\n            # Look for sentence boundary in the last 30% of the chunk\\n            search_start = start + int(max_chars * 0.7)\\n            chunk_text = text[start:end]\\n            search_region = text[search_start:end]\\n            \\n            # Find last sentence boundary in search region\\n            # Look for . ! ? followed by space or end\\n            sentence_end = -1\\n            for match in re.finditer(r'[.!?][\\\"\\\\'\\u00bb]?\\\\s', search_region):\\n                sentence_end = search_start + match.end()\\n            \\n            # If found a good boundary, use it\\n            if sentence_end > search_start:\\n                end = sentence_end\\n        \\n        # Extract chunk\\n        chunk_text = text[start:end].strip()\\n        \\n        if chunk_text:  # Only add non-empty chunks\\n            chunks.append(TextChunk(\\n                text=chunk_text,\\n                start_char=start,\\n                end_char=end,\\n                chunk_index=chunk_index,\\n                total_chunks=0  # Will update after\\n            ))\\n            chunk_index += 1\\n        \\n        # Move start position with overlap\\n        # But ensure we make progress (at least half a chunk)\\n        min_progress = max_chars // 2\\n        start = max(end - overlap_chars, start + min_progress)\\n    \\n    # Update total_chunks count\\n    total = len(chunks)\\n    for chunk in chunks:\\n        chunk.total_chunks = total\\n    \\n    return chunks\\n\\n\\ndef chunk_for_embedding(\\n    text: str,\\n    max_tokens: int = 7500,\\n    overlap_tokens: int = 200\\n) -> List[str]:\\n    \\\"\\\"\\\"\\n    Simple interface: chunk text and return just the text strings.\\n    \\n    Args:\\n        text: Text to chunk\\n        max_tokens: Maximum tokens per chunk\\n        overlap_tokens: Overlap between chunks\\n        \\n    Returns:\\n        List of chunk text strings\\n    \\\"\\\"\\\"\\n    chunks = chunk_text_with_overlap(text, max_tokens, overlap_tokens)\\n    return [chunk.text for chunk in chunks]\\n\\n\\ndef safe_text_for_embedding(\\n    text: str,\\n    max_tokens: int = 7500\\n) -> Tuple[str, bool]:\\n    \\\"\\\"\\\"\\n    Prepare text for embedding, with warning if truncated.\\n    \\n    For cases where you want a single embedding (not multiple chunks),\\n    this truncates with a warning rather than silently losing data.\\n    \\n    Args:\\n        text: Text to prepare\\n        max_tokens: Maximum tokens\\n        \\n    Returns:\\n        Tuple of (processed_text, was_truncated)\\n    \\\"\\\"\\\"\\n    max_chars = max_tokens * 4\\n    \\n    if len(text) <= max_chars:\\n        return text, False\\n    \\n    # Truncate at sentence boundary if possible\\n    truncated = text[:max_chars]\\n    last_sentence = truncated.rfind('. ')\\n    \\n    if last_sentence > max_chars * 0.7:\\n        truncated = truncated[:last_sentence + 1]\\n    \\n    return truncated, True\\n\\n\\n# ============================================================================\\n# Context Window Utilities (for \\\"Journalist\\\" query mode)\\n# ============================================================================\\n\\ndef get_context_window(\\n    responses: List,  # List of Response objects\\n    target_index: int,\\n    window_before: int = 2,\\n    window_after: int = 2\\n) -> Tuple[List, int, int]:\\n    \\\"\\\"\\\"\\n    Get a window of responses around a target response.\\n    \\n    This is the \\\"Parent-Child\\\" concept from the expert:\\n    - Child = the specific response we found\\n    - Parent = the surrounding context (window)\\n    \\n    Args:\\n        responses: List of Response objects (ordered)\\n        target_index: Index of the target response (0-indexed)\\n        window_before: Number of responses to include before target\\n        window_after: Number of responses to include after target\\n        \\n    Returns:\\n        Tuple of (windowed_responses, start_index, end_index)\\n    \\\"\\\"\\\"\\n    total = len(responses)\\n    \\n    # Calculate window bounds\\n    start_idx = max(0, target_index - window_before)\\n    end_idx = min(total, target_index + window_after + 1)\\n    \\n    # Extract window\\n    window = responses[start_idx:end_idx]\\n    \\n    return window, start_idx, end_idx\\n\\n\\ndef format_context_window(\\n    responses: List,\\n    target_response_id: str,\\n    window_before: int = 2,\\n    window_after: int = 2,\\n    veteran_name: str = \\\"Veteran\\\"\\n) -> str:\\n    \\\"\\\"\\\"\\n    Format a context window as readable text with the target highlighted.\\n    \\n    Args:\\n        responses: List of Response objects (ordered)\\n        target_response_id: ID of the response we're focused on\\n        window_before: Responses before target\\n        window_after: Responses after target\\n        veteran_name: Name to use for veteran\\n        \\n    Returns:\\n        Formatted string with context\\n    \\\"\\\"\\\"\\n    # Find target index\\n    target_idx = None\\n    for i, r in enumerate(responses):\\n        if r.id == target_response_id:\\n            target_idx = i\\n            break\\n    \\n    if target_idx is None:\\n        return f\\\"Response {target_response_id} not found\\\"\\n    \\n    # Get window\\n    window, start_idx, end_idx = get_context_window(\\n        responses, target_idx, window_before, window_after\\n    )\\n    \\n    # Format output\\n    lines = []\\n    lines.append(f\\\"=== Context Window: {window_before} before, {window_after} after ===\\\\n\\\")\\n    \\n    for i, r in enumerate(window):\\n        actual_idx = start_idx + i\\n        is_target = (actual_idx == target_idx)\\n        \\n        # Marker for target response\\n        marker = \\\">>> \\\" if is_target else \\\"    \\\"\\n        highlight_start = \\\"[TARGET] \\\" if is_target else \\\"\\\"\\n        \\n        lines.append(f\\\"{marker}[{r.id}] {highlight_start}\\\")\\n        lines.append(f\\\"{marker}Q: {r.interviewer[:200]}{'...' if len(r.interviewer) > 200 else ''}\\\")\\n        lines.append(f\\\"{marker}\\\")\\n        lines.append(f\\\"{marker}{veteran_name}: {r.veteran[:500]}{'...' if len(r.veteran) > 500 else ''}\\\")\\n        lines.append(f\\\"{marker}\\\")\\n        lines.append(\\\"\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines)\\n\",\"file_size_bytes\":8296,\"content_length\":8295}"}],"structuredContent":{"result":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/chunking.py\",\"content\":\"\\\"\\\"\\\"\\nText chunking utilities for the Oral History Research System.\\n\\nHandles splitting long texts into overlapping chunks that fit within\\nembedding model context windows (e.g., 8000 tokens for OpenAI text-embedding-3-large).\\n\\nKey principle: No data loss. If text is too long, we chunk with overlap\\nso semantic search can find any part of the original text.\\n\\\"\\\"\\\"\\n\\nimport re\\nfrom typing import List, Tuple\\