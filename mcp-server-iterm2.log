riter/src/parser.py\",\n  \"content\": \"\\\"\\\"\\\"\\nTranscript parser for the Oral History Research System.\\n\\nParses interview transcripts into Q&A responses.\\nHandles various transcript formats and speaker patterns.\\n\\\"\\\"\\\"\\n\\nimport re\\nfrom typing import List, Tuple, Optional\\nfrom pathlib import Path\\nfrom dataclasses import dataclass\\n\\nfrom .models import Response, Paragraph\\n\\n\\n@dataclass\\nclass ParsedResponse:\\n    \\\"\\\"\\\"A parsed response before full processing.\\\"\\\"\\\"\\n    interviewer: str\\n    veteran: str\\n    raw_index: int  # Original position in transcript\\n\\n\\nclass TranscriptParser:\\n    \\\"\\\"\\\"\\n    Parses interview transcripts into structured Q&A responses.\\n    \\n    Supports various speaker patterns:\\n    - \\\"INTERVIEWER:\\\" / \\\"VETERAN:\\\"\\n    - \\\"Q:\\\" / \\\"A:\\\"\\n    - \\\"Interviewer:\\\" / \\\"[Name]:\\\"\\n    - Speaker names followed by colons (e.g., \\\"Jim Mitchell:\\\")\\n    \\\"\\\"\\\"\\n    \\n    # Common patterns for speaker detection\\n    INTERVIEWER_PATTERNS = [\\n        r\\\"^INTERVIEWER\\\\s*:\\\",\\n        r\\\"^Q\\\\s*:\\\",\\n        r\\\"^Interviewer\\\\s*:\\\",\\n        r\\\"^INT\\\\s*:\\\",\\n        r\\\"^I\\\\s*:\\\",\\n    ]\\n    \\n    VETERAN_PATTERNS = [\\n        r\\\"^VETERAN\\\\s*:\\\",\\n        r\\\"^A\\\\s*:\\\",\\n        r\\\"^(?:Mr\\\\.|Mrs\\\\.|Ms\\\\.|Sgt\\\\.|Sergeant|Captain|Lt\\\\.|Lieutenant|Private|Corporal|Staff Sergeant)\\\\s+\\\\w+\\\\s*:\\\",\\n    ]\\n    \\n    def __init__(self, min_paragraph_length: int = 50):\\n\",\n  \"file_size_bytes\": 23114,\n  \"content_length\": 1256\n}"},"isError":false}} { metadata: undefined }
2025-12-20T16:51:57.630Z [iterm2] [info] Message from client: {"method":"tools/call","params":{"name":"write_file","arguments":{"file_path":"~/Documents/Projects/Current/writer/src/json_parser.py","content":"\"\"\"\nJSON Transcript Parser for the Oral History Research System.\n\nParses turn-based JSON transcripts into Q&A responses.\nHandles the format: [{\"speaker\": \"...\", \"text\": \"...\"}, ...]\n\nKey insight from the expert:\n- A \"Question\" followed by an \"Answer\" is a single atomic unit of history\n- We parse turn-by-turn, not line-by-line\n- The veteran's words are the gold; the interviewer provides context\n\"\"\"\n\nimport json\nimport re\nfrom typing import List, Tuple, Optional, Dict, Any\nfrom pathlib import Path\nfrom dataclasses import dataclass, field\n\nfrom .models import Response, Paragraph\n\n\n# =============================================================================\n# Data Classes\n# =============================================================================\n\n@dataclass\nclass Turn:\n    \"\"\"A single turn in the conversation.\"\"\"\n    speaker: str\n    text: str\n    index: int  # Position in original transcript\n\n\n@dataclass\nclass ParsedQAPair:\n    \"\"\"A parsed Q&A pair before full processing.\"\"\"\n    interviewer_text: str\n    veteran_text: str\n    veteran_name: str\n    interviewer_name: str\n    turn_indices: List[int] = field(default_factory=list)  # Original turn positions\n\n\n# =============================================================================\n# Speaker Detection\n# =============================================================================\n\n# Common interviewer indicators\nINTERVIEWER_INDICATORS = [\n    \"interviewer\",\n    \"int \",\n    \"int.\",\n    \"q:\",\n    \"question\",\n]\n\n# Patterns that suggest someone is asking questions (interviewer behavior)\nQUESTION_PATTERNS = [\n    r'\\?$',  # Ends with question mark\n    r'^(what|where|when|who|why|how|did|do|does|can|could|would|should|are|is|was|were|have|has|had)\\b',\n    r'^(tell me|explain|describe)',\n]\n\n\ndef is_likely_interviewer(speaker: str, text: str) -> bool:\n    \"\"\"\n    Determine if a speaker is likely the interviewer based on name and text patterns.\n    \n    Args:\n        speaker: Speaker name\n        text: What they said\n        \n    Returns:\n        True if likely interviewer\n    \"\"\"\n    speaker_lower = speaker.lower().strip()\n    \n    # Check speaker name for interviewer indicators\n    for indicator in INTERVIEWER_INDICATORS:\n        if indicator in speaker_lower:\n            return True\n    \n    # Check if the text is primarily questions (interviewer behavior)\n    text_lower = text.lower().strip()\n    question_score = 0\n    \n    for pattern in QUESTION_PATTERNS:\n        if re.search(pattern, text_lower, re.IGNORECASE):\n            question_score += 1\n    \n    # Short utterances with questions are likely interviewer\n    word_count = len(text.split())\n    if question_score >= 1 and word_count < 50:\n        return True\n    \n    return False\n\n\ndef identify_speakers(turns: List[Turn]) -> Tuple[str, str]:\n    \"\"\"\n    Identify which speaker is the interviewer and which is the veteran.\n    \n    Args:\n        turns: List of conversation turns\n        \n    Returns:\n        Tuple of (interviewer_name, veteran_name)\n    \"\"\"\n    # Count speakers\n    speaker_stats: Dict[str, Dict[str, Any]] = {}\n    \n    for turn in turns:\n        speaker = turn.speaker.strip()\n        if speaker not in speaker_stats:\n            speaker_stats[speaker] = {\n                \"count\": 0,\n                \"total_words\": 0,\n                \"question_count\": 0,\n            }\n        \n        stats = speaker_stats[speaker]\n        stats[\"count\"] += 1\n        stats[\"total_words\"] += len(turn.text.split())\n        \n        # Count questions\n        if turn.text.strip().endswith(\"?\"):\n            stats[\"question_count\"] += 1\n    \n    # Score each speaker on \"interviewer-ness\"\n    interviewer_scores = {}\n    \n    for speaker, stats in speaker_stats.items():\n        score = 0\n        \n        # Interviewer indicators in name\n        if is_likely_interviewer(speaker, \"\"):\n            score += 100\n        \n        # Higher question ratio suggests interviewer\n        if stats[\"count\"] > 0:\n            question_ratio = stats[\"question_count\"] / stats[\"count\"]\n            score += question_ratio * 50\n        \n        # Lower average word count suggests interviewer (they ask, don't tell)\n        avg_words = stats[\"total_words\"] / stats[\"count\"] if stats[\"count\"] > 0 else 0\n        if avg_words < 100:\n            score += 20\n        elif avg_words > 200:\n            score -= 20\n        \n        interviewer_scores[speaker] = score\n    \n    # Sort by score\n    sorted_speakers = sorted(interviewer_scores.items(), key=lambda x: x[1], reverse=True)\n    \n    if len(sorted_speakers) >= 2:\n        interviewer_name = sorted_speakers[0][0]\n        veteran_name = sorted_speakers[1][0]\n    elif len(sorted_speakers) == 1:\n        # Only one speaker? Unusual, but handle it\n        interviewer_name = \"Interviewer\"\n        veteran_name = sorted_speakers[0][0]\n    else:\n        interviewer_name = \"Interviewer\"\n        veteran_name = \"Veteran\"\n    \n    return interviewer_name, veteran_name\n\n\n# =============================================================================\n# JSON Parser\n# =============================================================================\n\nclass JSONTranscriptParser:\n    \"\"\"\n    Parses turn-based JSON transcripts into Q&A Response objects.\n    \n    The key insight: we group consecutive veteran turns together as one \"answer\"\n    because veterans often continue speaking across multiple turns.\n    \"\"\"\n    \n    def __init__(self, min_paragraph_length: int = 50):\n        \"\"\"\n        Initialize parser.\n        \n        Args:\n            min_paragraph_length: Minimum characters for a paragraph chunk\n        \"\"\"\n        self.min_paragraph_length = min_paragraph_length\n    \n    def parse_file(self, file_path: Path) -> Tuple[List[ParsedQAPair], str, str]:\n        \"\"\"\n        Parse a JSON transcript file.\n        \n        Args:\n            file_path: Path to JSON file\n            \n        Returns:\n            Tuple of (list of Q&A pairs, interviewer_name, veteran_name)\n        \"\"\"\n        with open(file_path, \"r\", encoding=\"utf-8\") as f:\n            data = json.load(f)\n        \n        return self.parse_json(data)\n    \n    def parse_json(self, data: List[Dict[str, str]]) -> Tuple[List[ParsedQAPair], str, str]:\n        \"\"\"\n        Parse JSON data into Q&A pairs.\n        \n        Args:\n            data: List of {\"speaker\": \"...\", \"text\": \"...\"} dicts\n            \n        Returns:\n            Tuple of (list of Q&A pairs, interviewer_name, veteran_name)\n        \"\"\"\n        # Convert to Turn objects\n        turns = []\n        for i, item in enumerate(data):\n            speaker = item.get(\"speaker\", \"Unknown\").strip()\n            text = item.get(\"text\", \"\").strip()\n            if text:  # Skip empty turns\n                turns.append(Turn(speaker=speaker, text=text, index=i))\n        \n        if not turns:\n            return [], \"Interviewer\", \"Veteran\"\n        \n        # Identify speakers\n        interviewer_name, veteran_name = identify_speakers(turns)\n        \n        # Group into Q&A pairs\n        pairs = self._group_into_pairs(turns, interviewer_name, veteran_name)\n        \n        return pairs, interviewer_name, veteran_name\n    \n    def _group_into_pairs(\n        self, \n        turns: List[Turn], \n        interviewer_name: str, \n        veteran_name: str\n    ) -> List[ParsedQAPair]:\n        \"\"\"\n        Group turns into interviewer question + veteran answer pairs.\n        \n        Handles:\n        - Multiple consecutive veteran turns (merged into one answer)\n        - Multiple consecutive interviewer turns (merged into one question)\n        - Veteran answers without preceding question (uses \"[Continuation]\")\n        \n        Args:\n            turns: List of turns\n            interviewer_name: Name of interviewer\n            veteran_name: Name of veteran\n            \n        Returns:\n            List of Q&A pairs\n        \"\"\"\n        pairs = []\n        \n        current_interviewer_text = []\n        current_interviewer_indices = []\n        current_veteran_text = []\n        current_veteran_indices = []\n        \n        for turn in turns:\n            is_interviewer = turn.speaker.strip() == interviewer_name\n            \n            if is_interviewer:\n                # If we have accumulated veteran text, save the pair\n                if current_veteran_text:\n                    pairs.append(ParsedQAPair(\n                        interviewer_text=\" \".join(current_interviewer_text) if current_interviewer_text else \"[Continuation]\",\n                        veteran_text=\" \".join(current_veteran_text),\n                        veteran_name=veteran_name,\n                        interviewer_name=interviewer_name,\n                        turn_indices=current_interviewer_indices + current_veteran_indices\n                    ))\n                    current_veteran_text = []\n                    current_veteran_indices = []\n                    current_interviewer_text = []\n                    current_interviewer_indices = []\n                \n                # Accumulate interviewer text\n                current_interviewer_text.append(turn.text)\n                current_interviewer_indices.append(turn.index)\n            \n            else:\n                # Accumulate veteran text (could be multiple consecutive turns)\n                current_veteran_text.append(turn.text)\n                current_veteran_indices.append(turn.index)\n        \n        # Don't forget the last pair\n        if current_veteran_text:\n            pairs.append(ParsedQAPair(\n                interviewer_text=\" \".join(current_interviewer_text) if current_interviewer_text else \"[Continuation]\",\n                veteran_text=\" \".join(current_veteran_text),\n                veteran_name=veteran_name,\n                interviewer_name=interviewer_name,\n                turn_indices=current_interviewer_indices + current_veteran_indices\n            ))\n        \n        return pairs\n    \n    def split_into_paragraphs(self, text: str) -> List[str]:\n        \"\"\"\n        Split text into paragraphs for embedding.\n        \n        Uses sentence boundaries to create meaningful chunks.\n        \n        Args:\n            text: Text to split\n            \n        Returns:\n            List of paragraph strings\n        \"\"\"\n        # For oral history, we want meaningful chunks but not too small\n        # Split on sentence boundaries, then merge small ones\n        \n        # Simple sentence split (handles ., !, ?)\n        sentences = re.split(r'(?<=[.!?])\\s+', text)\n        \n        paragraphs = []\n        current = []\n        current_length = 0\n        \n        for sentence in sentences:\n            sentence = sentence.strip()\n            if not sentence:\n                continue\n            \n            current.append(sentence)\n            current_length += len(sentence)\n            \n            # Target ~500 chars per paragraph (good for embeddings)\n            if current_length >= 400:\n                paragraphs.append(\" \".join(current))\n                current = []\n                current_length = 0\n        \n        # Don't forget remainder\n        if current:\n            if paragraphs and current_length < self.min_paragraph_length:\n                # Merge with previous if too short\n                paragraphs[-1] += \" \" + \" \".join(current)\n            else:\n                paragraphs.append(\" \".join(current))\n        \n        return paragraphs if paragraphs else [text]\n    \n    def create_responses(\n        self, \n        pairs: List[ParsedQAPair], \n        id_prefix: str = \"\"\n    ) -> List[Response]:\n        \"\"\"\n        Convert parsed Q&A pairs to Response objects.\n        \n        Args:\n            pairs: List of parsed Q&A pairs\n            id_prefix: Optional prefix for response IDs\n            \n        Returns:\n            List of Response objects\n        \"\"\"\n        responses = []\n        \n        for i, pair in enumerate(pairs):\n            response_id = f\"{id_prefix}{str(i + 1).zfill(3)}\"\n            \n            # Split veteran's answer into paragraphs for embedding\n            paragraph_texts = self.split_into_paragraphs(pair.veteran_text)\n            paragraphs = []\n            \n            for j, para_text in enumerate(paragraph_texts):\n                para_id = f\"{response_id}_p{j + 1}\"\n                paragraphs.append(Paragraph(id=para_id, text=para_text))\n            \n            responses.append(Response(\n                id=response_id,\n                interviewer=pair.interviewer_text,\n                veteran=pair.veteran_text,\n                paragraphs=paragraphs\n            ))\n        \n        return responses\n\n\n# =============================================================================\n# Chunking for Embeddings (with overlap)\n# =============================================================================\n\ndef chunk_for_embedding(\n    text: str, \n    max_tokens: int = 7500, \n    overlap_tokens: int = 200\n) -> List[str]:\n    \"\"\"\n    Split text into overlapping chunks that fit embedding context window.\n    \n    We use 7500 as buffer below 8000 limit for text-embedding-3-large.\n    \n    Args:\n        text: Text to chunk\n        max_tokens: Maximum tokens per chunk (default 7500)\n        overlap_tokens: Tokens to overlap between chunks (default 200)\n        \n    Returns:\n        List of chunks. If text fits, returns [text].\n    \"\"\"\n    # Rough estimate: 1 token ≈ 4 chars for English\n    chars_per_token = 4\n    max_chars = max_tokens * chars_per_token\n    overlap_chars = overlap_tokens * chars_per_token\n    \n    if len(text) <= max_chars:\n        return [text]\n    \n    chunks = []\n    start = 0\n    \n    while start < len(text):\n        end = start + max_chars\n        chunk = text[start:end]\n        \n        # Try to break at sentence boundary (., !, ?)\n        if end < len(text):\n            # Look for last sentence boundary in the last 20% of the chunk\n            search_start = int(len(chunk) * 0.8)\n            search_region = chunk[search_start:]\n            \n            # Find last sentence-ending punctuation\n            last_boundary = -1\n            for match in re.finditer(r'[.!?]\\s+', search_region):\n                last_boundary = search_start + match.end()\n            \n            if last_boundary > 0:\n                chunk = chunk[:last_boundary]\n                end = start + last_boundary\n        \n        chunks.append(chunk.strip())\n        \n        # Move forward with overlap\n        start = end - overlap_chars\n        \n        # Prevent infinite loop if overlap is larger than progress\n        if start <= chunks[-1] and len(chunks) > 1:\n            start = end\n    \n    return chunks\n\n\n# =============================================================================\n# Convenience Functions\n# =============================================================================\n\ndef parse_json_transcript(\n    file_path: Path,\n    min_paragraph_length: int = 50\n) -> Tuple[List[Response], str, str]:\n    \"\"\"\n    Parse a JSON transcript file into Response objects.\n    \n    Args:\n        file_path: Path to JSON file\n        min_paragraph_length: Minimum paragraph length\n        \n    Returns:\n        Tuple of (responses, interviewer_name, veteran_name)\n    \"\"\"\n    parser = JSONTranscriptParser(min_paragraph_length=min_paragraph_length)\n    pairs, interviewer_name, veteran_name = parser.parse_file(file_path)\n    responses = parser.create_responses(pairs)\n    \n    return responses, interviewer_name, veteran_name\n\n\ndef extract_veteran_name_from_filename(filename: str) -> Optional[str]:\n    \"\"\"\n    Try to extract veteran name from filename.\n    \n    Handles patterns like:\n    - \"Lavere-E-Watson-69th.json\" -> \"Lavere E Watson\"\n    - \"john_smith_interview.json\" -> \"John Smith\"\n    \n    Args:\n        filename: Filename (with or without path)\n        \n    Returns:\n        Extracted name or None\n    \"\"\"\n    # Get just the filename without extension\n    name = Path(filename).stem\n    \n    # Remove common suffixes\n    for suffix in [\"-69th\", \"-6th\", \"_interview\", \"_transcript\", \"-interview\", \"-transcript\"]:\n        name = re.sub(re.escape(suffix) + r\"$\", \"\", name, flags=re.IGNORECASE)\n    \n    # Replace separators with spaces\n    name = re.sub(r\"[-_]+\", \" \", name)\n    \n    # Title case\n    name = \" \".join(word.capitalize() for word in name.split())\n    \n    # Clean up\n    name = name.strip()\n    \n    return name if name else None\n\n\ndef extract_unit_from_filename(filename: str) -> Optional[str]:\n    \"\"\"\n    Try to extract unit from filename.\n    \n    Handles patterns like:\n    - \"Lavere-E-Watson-69th.json\" -> \"69th\"\n    - \"john_smith_6th_armored.json\" -> \"6th Armored\"\n    \n    Args:\n        filename: Filename\n        \n    Returns:\n        Extracted unit or None\n    \"\"\"\n    name = Path(filename).stem\n    \n    # Look for unit patterns\n    patterns = [\n        r\"(\\d+(?:st|nd|rd|th))\",  # 69th, 6th, etc.\n        r\"(\\d+(?:st|nd|rd|th)\\s*(?:armored|infantry|tank|artillery))\",\n    ]\n    \n    for pattern in patterns:\n        match = re.search(pattern, name, re.IGNORECASE)\n        if match:\n            unit = match.group(1)\n            # Title case\n            return unit.title()\n    \n    return None\n"}},"jsonrpc":"2.0","id":7} { metadata: undefined }
