               veteran_id=veteran_id\\n            )\\n        else:\\n            raw_results_basic = self.index.search_hybrid(\\n                query, \\n                limit=limit * 3,\\n                hybrid_weight=hybrid_weight,\\n                veteran_id=veteran_id\\n            )\\n            # Add None for segment_topic to match the signature\\n            raw_results = [(v, r, s, None) for v, r, s in raw_results_basic]\\n        \\n        # Minimum relevance score threshold - filter out weak matches\\n        MIN_SCORE = 0.25\\n        \\n        # Build search hits\\n        hits = []\\n        seen_veterans = set()\\n        \\n        # Lowercase query for text presence check\\n        query_lower = query.lower()\\n        query_terms = [t.strip() for t in query_lower.split() if len(t.strip()) > 2]\\n        \\n        for vet_id, resp_id, score, segment_topic in raw_results:\\n            # Skip results below minimum score threshold\\n            if score < MIN_SCORE:\\n                continue\\n            # Load veteran\\n            veteran = self.veteran_storage.load(vet_id)\\n            if not veteran:\\n                continue\\n            \\n            # Find response\\n            response = None\\n            for r in veteran.responses:\\n                if r.id == resp_id:\\n                    response = r\\n                    break\\n            \\n            if not response:\\n                continue\\n            \\n            # For mid-range scores without segment boost, require at least one query term in the text\\n            # This filters out \\\"thematically similar but actually irrelevant\\\" results\\n            if score < 0.5 and segment_topic is None:\\n                combined_text = (response.interviewer + \\\" \\\" + response.veteran).lower()\\n                has_query_term = any(term in combined_text for term in query_terms)\\n                if not has_query_term:\\n                    continue\\n          