2025-12-21T17:09:40.687Z [iterm2] [info] Message from server: {"jsonrpc":"2.0","id":20,"result":{"content":[{"type":"text","text":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/cli.py\",\"content\":\"# ============================================================================\\n# Advanced Search Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"query\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=15, help=\\\"Maximum results\\\")\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", help=\\\"Filter to specific veteran\\\")\\n@click.option(\\\"--mode\\\", \\\"-m\\\", type=click.Choice([\\\"fast\\\", \\\"balanced\\\", \\\"thorough\\\"]), default=\\\"balanced\\\",\\n              help=\\\"Search mode: fast (rerank only), balanced (rerank + expansion), thorough (all features)\\\")\\n@click.option(\\\"--export\\\", \\\"export_name\\\", help=\\\"Export results to file\\\")\\n@click.option(\\\"--debug\\\", is_flag=True, help=\\\"Show pipeline debug info\\\")\\ndef advanced(\\n    query: str,\\n    limit: int,\\n    veteran: Optional[str],\\n    mode: str,\\n    export_name: Optional[str],\\n    debug: bool\\n):\\n    \\\"\\\"\\\"Advanced search with query expansion, reranking, and self-reflection.\\n    \\n    This uses the full RAG pipeline for higher quality results:\\n    - Query Expansion: Generates search variants to catch different phrasings\\n    - Re-ranking: Cross-encoder model scores results more accurately  \\n    - Self-Reflection: Grades results and retries if poor (thorough mode)\\n    \\n    Examples:\\n        oralhistory advanced \\\"Bastogne cold\\\"              # Balanced search\\n        oralhistory advanced \\\"tank battle\\\" --mode fast    # Quick rerank only\\n        oralhistory advanced \\\"artillery\\\" --mode thorough  # Full pipeline\\n    \\\"\\\"\\\"\\n    from .rag_pipeline import create_advanced_pipeline\\n    \\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    # Get LLM client for expansion/reflection\\n    llm_client = None\\n    if mode in [\\\"balanced\\\", \\\"thorough\\\"]:\\n        try:\\n            config = ctx.config\\n            llm_client = get_llm_client(\\n                provider=config.llm.provider,\\n                model=config.llm.model\\n            )\\n        except Exception as e:\\n            console.print(f\\\"[yellow]LLM unavailable, falling back to fast mode: {e}[/yellow]\\\")\\n            mode = \\\"fast\\\"\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        # Stage indicators\\n        if mode == \\\"fast\\\":\\n            stages = [\\\"Searching...\\\", \\\"Re-ranking...\\\"]\\n        elif mode == \\\"balanced\\\":\\n            stages = [\\\"Expanding query...\\\", \\\"Searching variants...\\\", \\\"Re-ranking...\\\"]\\n        else:  # thorough\\n            stages = [\\\"Expanding query...\\\", \\\"Searching variants...\\\", \\\"Re-ranking...\\\", \\\"Reflecting...\\\"]\\n        \\n        task = progress.add_task(stages[0], total=None)\\n        \\n        try:\\n            pipeline = create_advanced_pipeline(ctx, llm_client=llm_client, preset=mode)\\n            results = pipeline.search(\\n                query=query,\\n                limit=limit,\\n                veteran_id=veteran\\n            )\\n        except ImportError as e:\\n            if \\\"sentence-transformers\\\" in str(e):\\n                console.print(\\\"[red]Re-ranking requires sentence-transformers.[/red]\\\")\\n                console.print(\\\"[dim]Install with: pip install sentence-transformers[/dim]\\\")\\n                return\\n            raise\\n    \\n    if not results.hits:\\n        console.print(f\\\"[yellow]No results found for:[/yellow] {query}\\\")\\n        return\\n    \\n    # Debug info\\n    if debug and hasattr(results, '_pipeline_info'):\\n        info = results._pipeline_info\\n        console.print(\\\"\\\")\\n        console.print(Panel(\\n            f\\\"[dim]Original: {info['original_query']}\\\\n\\\"\\n            f\\\"Variants: {info.get('expanded_queries', [])}\\\\n\\\"\\n            f\\\"Candidates before rerank: {info.get('candidates_before_rerank', '?')}\\\\n\\\"\\n            f\\\"Reflection score: {info.get('reflection_score', 'N/A')}\\\\n\\\"\\n            f\\\"Retries: {info.get('retries', 0)}[/dim]\\\",\\n            title=\\\"[cyan]Pipeline Debug[/cyan]\\\",\\n            box=box.ROUNDED\\n        ))\\n    \\n    # Display results - same format as regular search\\n    console.print(\\\"\\\")\\n    mode_label = {\\\"fast\\\": \\\"\\u26a1 Fast\\\", \\\"balanced\\\": \\\"\\u2696\\ufe0f Balanced\\\", \\\"thorough\\\": \\\"\\ud83d\\udd0d Thorough\\\"}[mode]\\n    console.print(Panel(\\n        f\\\"[bold]SEARCH+[/bold] \\\\\\\"{query}\\\\\\\" ({results.veteran_count} veterans, {results.total_hits} responses) [{mode_label}]\\\",\\n        box=box.DOUBLE\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Group by veteran\\n    from collections import defaultdict\\n    grouped_hits = defaultdict(list)\\n    for hit in results.hits:\\n        grouped_hits[hit.veteran_id].append(hit)\\n    \\n    sorted_veterans = sorted(\\n        grouped_hits.items(), \\n        key=lambda x: max(h.score for h in x[1]), \\n        reverse=True\\n    )\\n    \\n    for _, hits in sorted_veterans:\\n        first_hit = hits[0]\\n        \\n        header = f\\\"[bold cyan]{first_hit.veteran_name}[/bold cyan]\\\"\\n        if first_hit.unit or first_hit.rank:\\n            parts = []\\n            if first_hit.unit:\\n                parts.append(first_hit.unit)\\n            if first_hit.rank:\\n                parts.append(first_hit.rank)\\n            header += f\\\" [dim]({' | '.join(parts)})[/dim]\\\"\\n        \\n\",\"file_size_bytes\":114628,\"content_length\":5155}"}],"structuredContent":{"result":"{\"success\":true,\"file_path\":\"/Users/happyhawking/Documents/Projects/Current/writer/src/cli.py\",\"content\":\"# ============================================================================\\n# Advanced Search Command\\n# ============================================================================\\n\\n@cli.command()\\n@click.argument(\\\"query\\\")\\n@click.option(\\\"--limit\\\", \\\"-l\\\", default=15, help=\\\"Maximum results\\\")\\n@click.option(\\\"--veteran\\\", \\\"-v\\\", help=\\\"Filter to specific veteran\\\")\\n@click.option(\\\"--mode\\\", \\\"-m\\\", type=click.Choice([\\\"fast\\\", \\\"balanced\\\", \\\"thorough\\\"]), default=\\\"balanced\\\",\\n              help=\\\"Search mode: fast (rerank only), balanced (rerank + expansion), thorough (all features)\\\")\\n@click.option(\\\"--export\\\", \\\"export_name\\\", help=\\\"Export results to file\\\")\\n@click.option(\\\"--debug\\\", is_flag=True, help=\\\"Show pipeline debug info\\\")\\ndef advanced(\\n    query: str,\\n    limit: int,\\n    veteran: Optional[str],\\n    mode: str,\\n    export_name: Optional[str],\\n    debug: bool\\n):\\n    \\\"\\\"\\\"Advanced search with query expansion, reranking, and self-reflection.\\n    \\n    This uses the full RAG pipeline for higher quality results:\\n    - Query Expansion: Generates search variants to catch different phrasings\\n    - Re-ranking: Cross-encoder model scores results more accurately  \\n    - Self-Reflection: Grades results and retries if poor (thorough mode)\\n    \\n    Examples:\\n        oralhistory advanced \\\"Bastogne cold\\\"              # Balanced search\\n        oralhistory advanced \\\"tank battle\\\" --mode fast    # Quick rerank only\\n        oralhistory advanced \\\"artillery\\\" --mode thorough  # Full pipeline\\n    \\\"\\\"\\\"\\n    from .rag_pipeline import create_advanced_pipeline\\n    \\n    try:\\n        ctx = ProjectContext()\\n    except ValueError:\\n        console.print(\\\"[red]Not in an oralhistory project. Run 'oralhistory init' first.[/red]\\\")\\n        return\\n    \\n    # Get LLM client for expansion/reflection\\n    llm_client = None\\n    if mode in [\\\"balanced\\\", \\\"thorough\\\"]:\\n        try:\\n            config = ctx.config\\n            llm_client = get_llm_client(\\n                provider=config.llm.provider,\\n                model=config.llm.model\\n            )\\n        except Exception as e:\\n            console.print(f\\\"[yellow]LLM unavailable, falling back to fast mode: {e}[/yellow]\\\")\\n            mode = \\\"fast\\\"\\n    \\n    with Progress(\\n        SpinnerColumn(),\\n        TextColumn(\\\"[progress.description]{task.description}\\\"),\\n        transient=True,\\n    ) as progress:\\n        # Stage indicators\\n        if mode == \\\"fast\\\":\\n            stages = [\\\"Searching...\\\", \\\"Re-ranking...\\\"]\\n        elif mode == \\\"balanced\\\":\\n            stages = [\\\"Expanding query...\\\", \\\"Searching variants...\\\", \\\"Re-ranking...\\\"]\\n        else:  # thorough\\n            stages = [\\\"Expanding query...\\\", \\\"Searching variants...\\\", \\\"Re-ranking...\\\", \\\"Reflecting...\\\"]\\n        \\n        task = progress.add_task(stages[0], total=None)\\n        \\n        try:\\n            pipeline = create_advanced_pipeline(ctx, llm_client=llm_client, preset=mode)\\n            results = pipeline.search(\\n                query=query,\\n                limit=limit,\\n                veteran_id=veteran\\n            )\\n        except ImportError as e:\\n            if \\\"sentence-transformers\\\" in str(e):\\n                console.print(\\\"[red]Re-ranking requires sentence-transformers.[/red]\\\")\\n                console.print(\\\"[dim]Install with: pip install sentence-transformers[/dim]\\\")\\n                return\\n            raise\\n    \\n    if not results.hits:\\n        console.print(f\\\"[yellow]No results found for:[/yellow] {query}\\\")\\n        return\\n    \\n    # Debug info\\n    if debug and hasattr(results, '_pipeline_info'):\\n        info = results._pipeline_info\\n        console.print(\\\"\\\")\\n        console.print(Panel(\\n            f\\\"[dim]Original: {info['original_query']}\\\\n\\\"\\n            f\\\"Variants: {info.get('expanded_queries', [])}\\\\n\\\"\\n            f\\\"Candidates before rerank: {info.get('candidates_before_rerank', '?')}\\\\n\\\"\\n            f\\\"Reflection score: {info.get('reflection_score', 'N/A')}\\\\n\\\"\\n            f\\\"Retries: {info.get('retries', 0)}[/dim]\\\",\\n            title=\\\"[cyan]Pipeline Debug[/cyan]\\\",\\n            box=box.ROUNDED\\n        ))\\n    \\n    # Display results - same format as regular search\\n    console.print(\\\"\\\")\\n    mode_label = {\\\"fast\\\": \\\"\\u26a1 Fast\\\", \\\"balanced\\\": \\\"\\u2696\\ufe0f Balanced\\\", \\\"thorough\\\": \\\"\\ud83d\\udd0d Thorough\\\"}[mode]\\n    console.print(Panel(\\n        f\\\"[bold]SEARCH+[/bold] \\\\\\\"{query}\\\\\\\" ({results.veteran_count} veterans, {results.total_hits} responses) [{mode_label}]\\\",\\n        box=box.DOUBLE\\n    ))\\n    console.print(\\\"\\\")\\n    \\n    # Group by veteran\\n    from collections import defaultdict\\n    grouped_hits = defaultdict(list)\\n    for hit in results.hits:\\n        grouped_hits[hit.veteran_id].append(hit)\\n    \\n    sorted_veterans = sorted(\\n        grouped_hits.items(), \\n        key=lambda x: max(h.score for h in x[1]), \\n        reverse=True\\n    )\\n    \\n    for _, hits in sorted_veterans:\\n        first_hit = hits[0]\\n        \\n        header = f\\\"[bold cyan]{first_hit.veteran_name}[/bold cyan]\\\"\\n        if first_hit.unit or first_hit.rank:\\n            parts = []\\n            if first_hit.unit:\\n                parts.append(first_hit.unit)\\n            if first_hit.rank:\\n                parts.append(first_hit.rank)\\n            header += f\\\" [dim]({' | '.join(parts)})[/dim]\\\"\\n        \\n\",\"file_size_bytes\":114628,\"content_length\":5155}"},"isError":false}} { metadata: undefined }
